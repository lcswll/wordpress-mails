msgid "“%1$s” (%2$s) is being sent again."
msgstr "„%1$s“ (%2$s) wird wieder versendet."

msgid "“%1$s” (%2$s) was last sent %3$s ago. Until then it was sent at least every %4$s days."
msgstr "„%1$s“ (%2$s) wurde zuletzt vor %3$s versendet. Bis dahin kam der Typ mindestens alle %4$s Tage."
