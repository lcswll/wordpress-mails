msgstr "Personvern"

msgid "Privacy & security"
msgstr "Personvern og sikkerhet"

msgid "Probably yes: %s email type has stopped."
msgid_plural "Probably yes: %s email types have stopped."
msgstr[0] "Sannsynligvis ja: %s e-posttype har stoppet opp."
msgstr[1] "Sannsynligvis ja: %s e-posttyper har stoppet opp."

msgid "Probe emails are only sent to an administrator."
msgstr "Test-e-poster sendes bare til en administrator."

msgid "Problem"
msgstr "Problem"

msgid "Problem recipients"
msgstr "Problemmottakere"

msgid "Protects your domain when far more emails leave than usual, e.g. because spam bots abuse a contact form. Alerts use the channels of the monitoring alerts; password reset emails are never held."
msgstr "Beskytter domenet ditt når langt flere e-poster enn vanlig sendes, f.eks. fordi spamroboter misbruker et kontaktskjema. Varsler bruker kanalene til overvåkingsvarslene; e-poster for tilbakestilling av passord holdes aldri tilbake."

msgid "Provider status"
msgstr "Leverandørstatus"

msgid "Providers like %2$s publish a strict DMARC policy. An email \"from\" their domain that was sent by your web server fails that check and is rejected or lands in spam."
msgstr "Leverandører som %2$s publiserer en streng DMARC-policy. En e-post «fra» domenet deres som er sendt av webserveren din, feiler den kontrollen og avvises eller havner i søppelpost."

msgid "Put the important content into real text and use images only in addition to it."
msgstr "Legg det viktige innholdet i ekte tekst og bruk bilder bare som et supplement."

msgid "Put the important information first and keep the subject under about 80 characters."
msgstr "Sett den viktige informasjonen først og hold emnet under omtrent 80 tegn."

msgid "REST API"
msgstr "REST API"

msgid "REST route"
msgstr "REST-rute"

msgid "Rarely"
msgstr "Sjelden"

