msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: nb_NO\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "«Last ned .eml» gjenoppbygger meldingen fra de loggede, maskerte dataene (uten vedlegg)."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (forrige uke: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (planlagt til %2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s e-posttype har stoppet opp: %2$s."
msgstr[1] "%1$s e-posttyper har stoppet opp, f.eks. %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "%1$s e-posttyper fra %2$s avsendere"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "%1$s e-poster mislyktes i løpet av de siste %2$s minuttene."

msgid "%1$s emails in %2$s days"
msgstr "%1$s e-poster på %2$s dager"

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "%1$s e-poster de siste 30 dagene, %2$s mislyktes"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "%1$s e-poster ble sendt i løpet av én time – langt flere enn vanlig (terskel: %2$s per time). Et kontaktskjema kan bli misbrukt, eller nettstedet kan være kompromittert."

msgid "%1$s entries, %2$s"
msgstr "%1$s oppføringer, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "%1$s importert, %2$s duplikater, %3$s for gamle"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "%1$s av %2$s avvist (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "%1$s av %2$s e-poster de siste %3$s dagene kunne ikke sendes."

msgid "%1$s of %2$s entries processed …"
msgstr "%1$s av %2$s oppføringer behandlet …"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s prosentpoeng mot %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "%1$s sendte sin første e-post den %2$s og har skrevet til %3$s forskjellige eksterne adresser de siste 24 timene. Hvis du ikke har installert eller satt opp noe som sender slike e-poster, bør du sjekke nettstedet: en ny avsender kan være et tegn på et hacket nettsted."

msgid "%1$s sent, %2$s still held …"
msgstr "%1$s sendt, %2$s fortsatt holdt tilbake …"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s mot %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · %2$s e-poster samlet siden forrige sammendrag"

msgid "%1$s · as of %2$s"
msgstr "%1$s · per %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – feilrate %2$s %% (forrige uke: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – rapportert av %2$s, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (must-use-utvidelse)"

msgid "%s (theme)"
msgstr "%s (tema)"

msgid "%s ago"
msgstr "for %s siden"

msgid "%s days"
msgstr "%s dager"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "%s e-post mislyktes de siste 7 dagene."
msgstr[1] "%s e-poster mislyktes de siste 7 dagene."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s e-post venter på avgjørelsen din."
msgstr[1] "%s e-poster venter på avgjørelsen din."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "%s e-post ble holdt tilbake og ikke sendt de siste 7 dagene."
msgstr[1] "%s e-poster ble holdt tilbake og ikke sendt de siste 7 dagene."

msgid "%s emails are held by the emergency brake."
msgstr "%s e-poster holdes tilbake av nødbremsen."

msgid "%s emails are waiting and have not been delivered."
msgstr "%s e-poster venter og er ikke levert."

msgid "%s entries"
msgstr "%s oppføringer"

msgid "%s failed"
msgstr "%s mislyktes"

msgid "%s held emails discarded."
msgstr "%s tilbakeholdte e-poster forkastet."

msgid "%s imported entries removed."
msgstr "%s importerte oppføringer fjernet."

msgid "%s in 30 days"
msgstr "%s på 30 dager"

msgid "%s marked as spam"
msgstr "%s merket som søppelpost"

msgid "%s more on the Email types page."
msgstr "%s til på siden E-posttyper."

msgid "%s notes"
msgstr "%s merknader"

msgid "%s of all emails"
msgstr "%s av all e-post"

msgid "%s of them in the last 24 hours."
msgstr "%s av dem de siste 24 timene."

msgid "%s s"
msgstr "%s s"

msgid "%s selected"
msgstr "%s valgt"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s ting trenger oppmerksomhet:"
msgstr[1] "%s ting trenger oppmerksomhet:"

msgid "%s to administrators in 30 days"
msgstr "%s til administratorer på 30 dager"

msgid "%s unchanged lines"
msgstr "%s uendrede linjer"

msgid "(no subject)"
msgstr "(uten emne)"

msgid "(no text content)"
msgstr "(uten tekstinnhold)"

msgid "(the emails are no longer in the log)"
msgstr "(e-postene er ikke lenger i loggen)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "-all er strengere; ~all er vanlig og greit sammen med DMARC."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "0 beholder oppføringer for alltid. Oppryddingen kjøres én gang om dagen."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "0 betyr ingen grense. De eldste oppføringene fjernes først."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "0 slår det av. Fjerner innhold, hoder og vedlegg fra eldre oppføringer og maskerer adressene (a***@example.com). Dato, status, kilde, format, størrelse og merknader beholdes for statistikken. Kjøres sammen med den daglige oppryddingen, før oppføringer slettes – har derfor bare effekt hvis perioden er kortere enn sletteperioden ovenfor."

msgid "12 months"
msgstr "12 måneder"

msgid "30 days"
msgstr "30 dager"

msgid "7 days"
msgstr "7 dager"

msgid "90 days"
msgstr "90 dager"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "En DKIM-selektor kan bare inneholde bokstaver, sifre, punktum, bindestreker og understreker."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "En e-postutvidelse som sender via et API, tok over leveringen og rapporterte at sendingen mislyktes, uten å oppgi noen årsak."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "En publisert nøkkel beviser ikke at e-postene dine signeres med den – sjekk DKIM-resultatet i hodene til en mottatt e-post."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "En mottaker eller avsenderadressen er ikke en gyldig e-postadresse, så PHPMailer nektet å sende."

msgid "API key or private key in plain text: %1$s"
msgstr "API-nøkkel eller privat nøkkel i klartekst: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "Omtrent %1$s DNS-oppslag kreves for å evaluere denne posten – flere enn de tillatte %2$s, så mottakere kan ignorere den (PermError). Fjern ubrukte include:-oppføringer."

msgid "Access"
msgstr "Tilgang"

msgid "Actions"
msgstr "Handlinger"

msgid "Active: alerts on %s."
msgstr "Aktiv: varsler ved %s."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "Legg til et kort alt-attributt på hvert bilde i malen, f.eks. alt=\"Logo Eksempelbutikk\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "Legg til include: for e-postleverandøren din (f.eks. include:_spf.google.com) hvis du sender via en."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "Legg til e-postserveren eller e-posttjenesten din i SPF-posten for avsenderdomenet."

msgid "Added:"
msgstr "Lagt til:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "Adresser med minst %s harde feil: mottakerserveren avviste postboksen, domenet har ingen e-postserver, eller e-postleverandøren din rapporterte en hard bounce. Oppføringene utløper med loggens lagringstid."

msgid "Admin screen"
msgstr "Administrasjonsskjerm"

msgid "Administrators"
msgstr "Administratorer"

msgid "Aggregate reports go to %s."
msgstr "Samlerapporter går til %s."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "Varsel"

msgid "Alert and hold further emails"
msgstr "Varsle og hold tilbake flere e-poster"

msgid "Alert only"
msgstr "Bare varsle"

msgid "Alert when an email type that is sent regularly stops"
msgstr "Varsle når en e-posttype som sendes jevnlig, stopper opp"

msgid "Alert when emails fail repeatedly"
msgstr "Varsle når e-post mislykkes gjentatte ganger"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "Varsle når nettstedet uventet slutter å sende e-post"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "Varsler er slått på, men har ingen kanal: skriv inn en e-postadresse eller en webhook-URL."

msgid "Alerts are off."
msgstr "Varsler er slått av."

msgid "All"
msgstr "Alle"

msgid "All email types look healthy."
msgstr "Alle e-posttyper ser bra ut."

msgid "All emails are redirected to test addresses."
msgstr "All e-post omdirigeres til testadresser."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "All e-post går til testadresser i stedet for de virkelige mottakerne."

msgid "All sources"
msgstr "Alle kilder"

msgid "Allow again"
msgstr "Tillat igjen"

msgid "Allowed again."
msgstr "Tillatt igjen."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "Varsler også én gang når en utvidelse eller et tema som aldri har sendt e-post før, skriver til mange forskjellige eksterne adresser i løpet av en dag – et mulig tegn på et hacket nettsted. De to første ukene etter at Mailspur ble installert, er utgangspunktet."

msgid "Also remove the subject when anonymising"
msgstr "Fjern også emnet ved anonymisering"

msgid "Also search content"
msgstr "Søk også i innhold"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "Alternativt kan du be webhotellet ditt om å aktivere mail() / sendmail for dette nettstedet."

msgid "Always load remote images and fonts in the preview"
msgstr "Last alltid inn eksterne bilder og skrifter i forhåndsvisningen"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (via SNS)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "En e-postleverandør med et HTTP-API i stedet for SMTP trenger færre rundturer per e-post."

msgid "Anonymisation"
msgstr "Anonymisering"

msgid "Anonymise entries after"
msgstr "Anonymiser oppføringer etter"

msgid "Anonymised"
msgstr "Anonymisert"

msgid "Any format"
msgstr "Alle formater"

msgid "Any status"
msgstr "Alle statuser"

msgid "Apply"
msgstr "Bruk"

msgid "Ask the recipient for a working address."
msgstr "Be mottakeren om en adresse som fungerer."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "Be webhotellet ditt om å aktivere openssl-utvidelsen (eller aktiver den i PHP-innstillingene i kontrollpanelet)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "Be webhotellet ditt om å oppdatere serverens CA-sertifikater og OpenSSL."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "Spør webhotellet ditt om utgående SMTP-tilkoblinger er blokkert."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "Spør webhotellet ditt om utgående tilkoblinger til den porten er tillatt (brannmur)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "Minst %1$s mislykkede e-poster innen %2$s minutter"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "Maksimalt ett varsel per type innenfor dette tidsrommet, selv om problemet vedvarer."

msgid "Attachments"
msgstr "Vedlegg"

msgid "Attachments no longer available: %s"
msgstr "Vedlegg er ikke lenger tilgjengelige: %s"

msgid "Authentication"
msgstr "Autentisering"

msgid "Automatic TLS"
msgstr "Automatisk TLS"

msgid "Average per day"
msgstr "Gjennomsnitt per dag"

msgid "Back to the email types"
msgstr "Tilbake til e-posttypene"

msgid "Belongs to"
msgstr "Hører til"

msgid "Block again"
msgstr "Blokker igjen"

msgid "Blocked as spam or by a blocklist"
msgstr "Blokkert som søppelpost eller av en blokkeringsliste"

msgid "Bounced (permanent)"
msgstr "Avvist (permanent)"

msgid "Bounced (temporary)"
msgstr "Avvist (midlertidig)"

msgid "Broken characters (encoding): %1$s"
msgstr "Ødelagte tegn (koding): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "Masseutsendelse uten avmeldingshode (%1$s mottakere)"

msgid "Bundle into one daily email"
msgstr "Samle i én daglig e-post"

msgid "Bundled into one daily email"
msgstr "Samlet i én daglig e-post"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "Samling er slått av. E-poster som ventet, er nå sendt i ett sammendrag."

msgid "Busiest day"
msgstr "Travleste dag"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "Avbryt"

msgid "Careful: emails to this address failed several times before."
msgstr "Obs: e-post til denne adressen har mislyktes flere ganger før."

msgid "Change in the email types"
msgstr "Endring i e-posttypene"

msgid "Change staging mode"
msgstr "Endre staging-modus"

msgid "Check"
msgstr "Sjekk"

msgid "Check again"
msgstr "Sjekk på nytt"

msgid "Check emails"
msgstr "Kontroller e-post"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "Sjekk vert og port; prøv 587 (TLS) i stedet for 465 (SSL) eller omvendt."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "Sjekk vert, port, kryptering, brukernavn og passord i SMTP-utvidelsen din, og send en test-e-post derfra."

msgid "Check sender domains"
msgstr "Sjekk avsenderdomener"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "Sjekk at krypteringen passer til porten: TLS for 587, SSL for 465."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "Sjekk at nøkkelen hører til riktig region / konto (f.eks. EU- vs. US-endepunkt)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "Sjekk SMTP-verten og porten: feil port eller en blokkert tilkobling ender ofte i tidsavbrudd før en reserveløsning virker."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "Sjekk SPF-, DKIM- og DMARC-postene for avsenderdomenet, eller bruk en avsenderadresse på domenet du sender fra."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "Sjekk adressen for skrivefeil – eller så ble e-posten aldri sendt av nettstedet ditt."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "Sjekk adressen med mottakeren og rett den der den er lagret (brukerprofil, bestilling, skjemainnsending)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "Sjekk adressen med mottakeren og rett den der den er lagret."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "Sjekk vertsnavn og port: 587 med STARTTLS (TLS) eller 465 med SSL. Port 25 blokkeres av de fleste webhoteller."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "Sjekk grensene og nåværende bruk i kontoen din hos e-posttjenesten; oppgrader planen ved behov."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "Sjekk mottakeradressene i denne oppføringen for skrivefeil, mellomrom eller manglende deler."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
msgstr "Sjekk avsenderadressen i SMTP-utvidelsen din og filteret wp_mail_from."

msgid "Check the sending limits of your mail account and the notes of this email."
msgstr "Sjekk sendegrensene for e-postkontoen din og merknadene til denne e-posten."

msgid "Check the server IP on a blocklist checker and request delisting."
msgstr "Sjekk serverens IP-adresse i et verktøy for blokkeringslister og be om å bli fjernet."

msgid "Check the spelling of the placeholder in the template and whether the plugin supports it for this email type. Shortcodes are not processed in emails unless the sending plugin runs do_shortcode()."
msgstr "Sjekk stavingen av plassholderen i malen og om utvidelsen støtter den for denne e-posttypen. Kortkoder behandles ikke i e-post med mindre utvidelsen som sender, kjører do_shortcode()."

msgid "Checked %s."
msgstr "Sjekket %s."

msgid "Checked just now"
msgstr "Sjekket akkurat nå"

msgid "Checking DNS records …"
msgstr "Sjekker DNS-poster …"

msgid "Checks the DNS records of the domains your site sends from: the default sender address and the most frequent senders in the log. Missing or weak records are the most common reason why emails land in spam. Only your server's own DNS resolver is used; results are kept for one hour."
msgstr "Sjekker DNS-postene for domenene nettstedet ditt sender fra: standard avsenderadresse og de vanligste avsenderne i loggen. Manglende eller svake poster er den vanligste årsaken til at e-post havner i søppelpost. Bare serverens egen DNS-resolver brukes; resultatene lagres i én time."

msgid "Choose a range of at most %s days."
msgstr "Velg et tidsrom på maksimalt %s dager."

msgid "Clear selection"
msgstr "Fjern utvalg"

msgid "Click a bar to open these emails in the log."
msgstr "Klikk på en stolpe for å åpne disse e-postene i loggen."

msgid "Close"
msgstr "Lukk"

msgid "Close (Esc)"
msgstr "Lukk (Esc)"

msgid "Colour scheme"
msgstr "Fargeskjema"

msgid "Command line"
msgstr "Kommandolinje"

msgid "Compare"
msgstr "Sammenlign"

msgid "Compare the sources of these entries. Check whether two plugins send the same notification, or whether a hook (e.g. order status change) fires more than once."
msgstr "Sammenlign kildene til disse oppføringene. Sjekk om to utvidelser sender det samme varselet, eller om en krok (f.eks. endret bestillingsstatus) utløses mer enn én gang."

msgid "Component"
msgstr "Komponent"

msgid "Configure alerts"
msgstr "Konfigurer varsler"

msgid "Content anonymised after %1$s days, %2$s"
msgstr "Innhold anonymisert etter %1$s dager, %2$s"

msgid "Content change marked as seen."
msgstr "Innholdsendring merket som sett."

msgid "Content changed"
msgstr "Innhold endret"

msgid "Content changed on %1$s, after the %2$s update."
msgstr "Innhold endret den %1$s, etter oppdateringen av %2$s."

msgid "Content changed on %s."
msgstr "Innhold endret den %s."

msgid "Content removed"
msgstr "Innhold fjernet"

msgid "Content removed after %s days"
msgstr "Innhold fjernet etter %s dager"

msgid "Content, headers and attachments were removed and the addresses masked by the anonymisation setting."
msgstr "Innhold, hoder og vedlegg er fjernet og adressene maskert av innstillingen for anonymisering."

msgid "Copied"
msgstr "Kopiert"

msgid "Copied – paste it into your reply."
msgstr "Kopiert – lim det inn i svaret ditt."

msgid "Copies a short sentence for answering the customer: when the email was sent to whom and whether it arrived – without technical details."
msgstr "Kopierer en kort setning til svaret til kunden: når e-posten ble sendt til hvem, og om den kom frem – uten tekniske detaljer."

msgid "Copies the existing log of another mail logging plugin into Mailspur, so old emails can be searched and previewed here. The other plugin and its data stay untouched; running the import again only adds new entries."
msgstr "Kopierer den eksisterende loggen fra en annen utvidelse for e-postlogging inn i Mailspur, slik at gamle e-poster kan søkes i og forhåndsvises her. Den andre utvidelsen og dataene dens forblir urørt; kjører du importen på nytt, legges bare nye oppføringer til."

msgid "Copy"
msgstr "Kopier"

msgid "Copy for support"
msgstr "Kopier for kundestøtte"

msgid "Copying is not possible in this browser. Select the text and copy it:"
msgstr "Kopiering er ikke mulig i denne nettleseren. Merk teksten og kopier den:"

msgid "Correct the address (e.g. in the user profile or order) and consider an email validation in your forms."
msgstr "Rett adressen (f.eks. i brukerprofilen eller bestillingen) og vurder e-postvalidering i skjemaene dine."

msgid "Counted once per email."
msgstr "Telles én gang per e-post."

msgid "Create a new API key with send permission at your mail service and enter it in the mailer plugin."
msgstr "Opprett en ny API-nøkkel med sendetillatelse hos e-posttjenesten din og skriv den inn i e-postutvidelsen."

msgid "Create a new webhook URL? The current URL stops working at once – paste the new URL into the webhook settings of your email provider."
msgstr "Opprette en ny webhook-URL? Den nåværende URL-en slutter å virke umiddelbart – lim inn den nye URL-en i webhook-innstillingene hos e-postleverandøren din."

msgid "Create new URL"
msgstr "Opprett ny URL"

msgid "Current page"
msgstr "Gjeldende side"

msgid "Current record"
msgstr "Nåværende post"

msgid "Current size"
msgstr "Nåværende størrelse"

msgid "Custom"
msgstr "Egendefinert"

msgid "DKIM key found (selector: %s)."
msgstr "DKIM-nøkkel funnet (selektor: %s)."

msgid "DMARC record found with p=none: reports only, spoofed mail is still delivered."
msgstr "DMARC-post funnet med p=none: bare rapporter, forfalsket e-post leveres fortsatt."

msgid "DMARC record found with policy p=%s."
msgstr "DMARC-post funnet med policy p=%s."

msgid "DMARC record has no valid policy (p=none, quarantine or reject)."
msgstr "DMARC-posten har ingen gyldig policy (p=none, quarantine eller reject)."

msgid "DNS lookup failed or timed out. Try again later."
msgstr "DNS-oppslaget mislyktes eller fikk tidsavbrudd. Prøv igjen senere."

msgid "DNS lookups are not available on this server (dns_get_record() is disabled), so the sender check cannot run here."
msgstr "DNS-oppslag er ikke tilgjengelige på denne serveren (dns_get_record() er deaktivert), så avsenderkontrollen kan ikke kjøres her."

msgid "DNS lookups needed: about %1$s of %2$s allowed."
msgstr "Nødvendige DNS-oppslag: omtrent %1$s av %2$s tillatte."

msgid "Daily"
msgstr "Daglig"

msgid "Daily digest"
msgstr "Daglig sammendrag"

msgid "Dark"
msgstr "Mørk"

msgid "Date"
msgstr "Dato"

msgid "Default (%s days)"
msgstr "Standard (%s dager)"

msgid "Default (no time limit)"
msgstr "Standard (ingen tidsgrense)"

msgid "Default sender"
