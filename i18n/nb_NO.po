msgstr "Telefonbredde (375 px). Hvis du kan rulle sidelengs, er e-posten bredere enn de fleste telefonskjermer."

msgid "Plain text"
msgstr "Ren tekst"

msgid "Please enter valid email addresses."
msgstr "Skriv inn gyldige e-postadresser."

msgid "Plugin"
msgstr "Utvidelse"

msgid "Plugin or theme that sent the email."
msgstr "Utvidelse eller tema som sendte e-posten."

msgid "Point out problems that keep emails from arriving or displaying correctly"
msgstr "Påpek problemer som hindrer e-post i å komme frem eller vises riktig"

