msgstr "Send e-posten på nytt fra loggen senere."

msgid "Resend the email from the log once delivery works."
msgstr "Send e-posten på nytt fra loggen når leveringen fungerer."

msgid "Resend the failed emails once the limit resets."
msgstr "Send de mislykkede e-postene på nytt når grensen tilbakestilles."

msgid "Resent from log"
msgstr "Sendt på nytt fra loggen"

msgid "Reset filters"
msgstr "Tilbakestill filtre"

msgid "Result"
msgstr "Resultat"

