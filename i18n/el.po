msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: el\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "Η «Λήψη .eml» αναδημιουργεί το μήνυμα από τα καταγεγραμμένα, λογοκριμένα δεδομένα (χωρίς συνημμένα)."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (προηγούμενη εβδομάδα: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (προγραμματισμένο για %2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s τύπος email σταμάτησε να αποστέλλεται: %2$s."
msgstr[1] "%1$s τύποι email σταμάτησαν να αποστέλλονται, π.χ. %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "%1$s τύποι email από %2$s αποστολείς"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "%1$s email απέτυχαν μέσα στα τελευταία %2$s λεπτά."

msgid "%1$s emails in %2$s days"
msgstr "%1$s email σε %2$s ημέρες"

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "%1$s email τις τελευταίες 30 ημέρες, %2$s απέτυχαν"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "Στάλθηκαν %1$s email μέσα σε μία ώρα – πολύ περισσότερα από το συνηθισμένο (όριο: %2$s ανά ώρα). Ίσως γίνεται κατάχρηση μιας φόρμας επικοινωνίας ή ο ιστότοπος έχει παραβιαστεί."

msgid "%1$s entries, %2$s"
msgstr "%1$s καταχωρίσεις, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "%1$s εισήχθησαν, %2$s διπλότυπα, %3$s πολύ παλιά"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "%1$s από %2$s επιστράφηκαν (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "%1$s από %2$s email τις τελευταίες %3$s ημέρες δεν ήταν δυνατό να σταλούν."

msgid "%1$s of %2$s entries processed …"
msgstr "Επεξεργάστηκαν %1$s από %2$s καταχωρίσεις …"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s π.μ. έναντι %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "Το %1$s έστειλε το πρώτο του email στις %2$s και έχει γράψει σε %3$s διαφορετικές εξωτερικές διευθύνσεις τις τελευταίες 24 ώρες. Αν δεν εγκαταστήσατε ή ρυθμίσατε κάτι που στέλνει τέτοια email, ελέγξτε τον ιστότοπο: ένας νέος αποστολέας μπορεί να είναι ένδειξη παραβιασμένου ιστότοπου."

msgid "%1$s sent, %2$s still held …"
msgstr "%1$s στάλθηκαν, %2$s ακόμη σε αναμονή …"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s έναντι %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · %2$s email ομαδοποιήθηκαν από την τελευταία σύνοψη"

msgid "%1$s · as of %2$s"
msgstr "%1$s · στις %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – ποσοστό αποτυχίας %2$s %% (προηγούμενη εβδομάδα: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – αναφέρθηκε από %2$s, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (πρόσθετο must-use)"

msgid "%s (theme)"
msgstr "%s (θέμα)"

msgid "%s ago"
msgstr "πριν από %s"

msgid "%s days"
msgstr "%s ημέρες"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "%s email απέτυχε τις τελευταίες 7 ημέρες."
msgstr[1] "%s email απέτυχαν τις τελευταίες 7 ημέρες."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s email περιμένει την απόφασή σας."
msgstr[1] "%s email περιμένουν την απόφασή σας."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "%s email κρατήθηκε και δεν στάλθηκε τις τελευταίες 7 ημέρες."
msgstr[1] "%s email κρατήθηκαν και δεν στάλθηκαν τις τελευταίες 7 ημέρες."

msgid "%s emails are held by the emergency brake."
msgstr "%s email κρατούνται από το φρένο έκτακτης ανάγκης."

msgid "%s emails are waiting and have not been delivered."
msgstr "%s email βρίσκονται σε αναμονή και δεν έχουν παραδοθεί."

msgid "%s entries"
msgstr "%s καταχωρίσεις"

msgid "%s failed"
msgstr "%s απέτυχαν"

msgid "%s held emails discarded."
msgstr "Απορρίφθηκαν %s email σε αναμονή."

msgid "%s imported entries removed."
msgstr "Αφαιρέθηκαν %s εισαγόμενες καταχωρίσεις."

msgid "%s in 30 days"
msgstr "%s σε 30 ημέρες"

msgid "%s marked as spam"
msgstr "Σημειώθηκαν ως ανεπιθύμητα: %s"

msgid "%s more on the Email types page."
msgstr "%s ακόμη στη σελίδα «Τύποι email»."

msgid "%s notes"
msgstr "%s σημειώσεις"

msgid "%s of all emails"
msgstr "%s του συνόλου των email"

msgid "%s of them in the last 24 hours."
msgstr "%s από αυτά τις τελευταίες 24 ώρες."

msgid "%s s"
msgstr "%s δ"

msgid "%s selected"
msgstr "%s επιλεγμένα"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s θέμα χρειάζεται προσοχή:"
msgstr[1] "%s θέματα χρειάζονται προσοχή:"

msgid "%s to administrators in 30 days"
msgstr "%s προς διαχειριστές σε 30 ημέρες"

msgid "%s unchanged lines"
msgstr "%s αμετάβλητες γραμμές"

msgid "(no subject)"
msgstr "(χωρίς θέμα)"

msgid "(no text content)"
msgstr "(χωρίς περιεχόμενο κειμένου)"

msgid "(the emails are no longer in the log)"
msgstr "(τα email δεν βρίσκονται πλέον στο αρχείο καταγραφής)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "Το -all είναι αυστηρότερο· το ~all είναι συνηθισμένο και αρκετό σε συνδυασμό με DMARC."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "Το 0 διατηρεί τις καταχωρίσεις για πάντα. Ο καθαρισμός εκτελείται μία φορά την ημέρα."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "Το 0 σημαίνει χωρίς όριο. Οι παλαιότερες καταχωρίσεις αφαιρούνται πρώτες."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "Το 0 το απενεργοποιεί. Αφαιρεί το περιεχόμενο, τις κεφαλίδες και τα συνημμένα των παλαιότερων καταχωρίσεων και αποκρύπτει τις διευθύνσεις (a***@example.com). Η ημερομηνία, η κατάσταση, η πηγή, η μορφή, το μέγεθος και οι σημειώσεις παραμένουν για τα στατιστικά. Εκτελείται με τον ημερήσιο καθαρισμό, πριν διαγραφούν οι καταχωρίσεις – επομένως έχει αποτέλεσμα μόνο αν είναι μικρότερο από την περίοδο διαγραφής παραπάνω."

msgid "12 months"
msgstr "12 μήνες"

msgid "30 days"
msgstr "30 ημέρες"

msgid "7 days"
msgstr "7 ημέρες"

msgid "90 days"
msgstr "90 ημέρες"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "Ένας επιλογέας DKIM μπορεί να περιέχει μόνο γράμματα, ψηφία, τελείες, παύλες και κάτω παύλες."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "Ένα πρόσθετο αποστολής email που στέλνει μέσω API ανέλαβε την παράδοση και ανέφερε ότι η αποστολή απέτυχε, χωρίς να δώσει αιτία."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "Ένα δημοσιευμένο κλειδί δεν αποδεικνύει ότι τα email σας υπογράφονται με αυτό – ελέγξτε το αποτέλεσμα DKIM στις κεφαλίδες ενός ληφθέντος email."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "Μια διεύθυνση παραλήπτη ή η διεύθυνση αποστολέα δεν είναι έγκυρη διεύθυνση email, οπότε το PHPMailer αρνήθηκε την αποστολή."

msgid "API key or private key in plain text: %1$s"
msgstr "Κλειδί API ή ιδιωτικό κλειδί σε απλό κείμενο: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "Χρειάζονται περίπου %1$s αναζητήσεις DNS για την αξιολόγηση αυτής της εγγραφής – περισσότερες από τις επιτρεπόμενες %2$s, οπότε οι παραλήπτες ενδέχεται να την αγνοήσουν (PermError). Αφαιρέστε τις αχρησιμοποίητες καταχωρίσεις include:."

msgid "Access"
msgstr "Πρόσβαση"

msgid "Actions"
msgstr "Ενέργειες"

msgid "Active: alerts on %s."
msgstr "Ενεργό: ειδοποιήσεις για %s."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "Προσθέστε ένα σύντομο χαρακτηριστικό alt σε κάθε εικόνα του προτύπου, π.χ. alt=\"Logo Example Shop\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "Προσθέστε το include: του παρόχου αλληλογραφίας σας (π.χ. include:_spf.google.com) αν στέλνετε μέσω αυτού."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "Προσθέστε τον διακομιστή αλληλογραφίας ή την υπηρεσία email σας στην εγγραφή SPF του τομέα του αποστολέα."

msgid "Added:"
msgstr "Προστέθηκαν:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "Διευθύνσεις με τουλάχιστον %s μόνιμες αποτυχίες: ο διακομιστής παραλαβής απέρριψε το γραμματοκιβώτιο, ο τομέας δεν έχει διακομιστή αλληλογραφίας ή ο πάροχος email σας ανέφερε μόνιμη επιστροφή (hard bounce). Οι καταχωρίσεις λήγουν με την περίοδο διατήρησης του αρχείου καταγραφής."

msgid "Admin screen"
msgstr "Οθόνη διαχείρισης"

msgid "Administrators"
msgstr "Διαχειριστές"

msgid "Aggregate reports go to %s."
msgstr "Οι συγκεντρωτικές αναφορές πηγαίνουν στο %s."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "Ειδοποίηση"

msgid "Alert and hold further emails"
msgstr "Ειδοποίηση και αναμονή επόμενων email"

msgid "Alert only"
msgstr "Μόνο ειδοποίηση"

msgid "Alert when an email type that is sent regularly stops"
msgstr "Ειδοποίηση όταν ένας τύπος email που αποστέλλεται τακτικά σταματήσει"

msgid "Alert when emails fail repeatedly"
msgstr "Ειδοποίηση όταν τα email αποτυγχάνουν επανειλημμένα"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "Ειδοποίηση όταν ο ιστότοπος σταματά απροσδόκητα να στέλνει email"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "Οι ειδοποιήσεις είναι ενεργές αλλά δεν έχουν κανάλι: εισαγάγετε μια διεύθυνση email ή ένα URL webhook."

msgid "Alerts are off."
msgstr "Οι ειδοποιήσεις είναι ανενεργές."

msgid "All"
msgstr "Όλα"

msgid "All email types look healthy."
msgstr "Όλοι οι τύποι email φαίνονται υγιείς."

msgid "All emails are redirected to test addresses."
msgstr "Όλα τα email ανακατευθύνονται σε δοκιμαστικές διευθύνσεις."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "Όλα τα email πηγαίνουν σε δοκιμαστικές διευθύνσεις αντί για τους πραγματικούς παραλήπτες."

msgid "All sources"
msgstr "Όλες οι πηγές"

msgid "Allow again"
msgstr "Επιτρέπεται ξανά"

msgid "Allowed again."
msgstr "Επιτρέπεται ξανά."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "Ειδοποιεί επίσης μία φορά όταν ένα πρόσθετο ή θέμα που δεν είχε στείλει ποτέ email γράφει σε πολλές διαφορετικές εξωτερικές διευθύνσεις μέσα σε μία ημέρα – πιθανή ένδειξη παραβιασμένου ιστότοπου. Οι πρώτες δύο εβδομάδες μετά την εγκατάσταση του Mailspur αποτελούν τη βάση αναφοράς."

msgid "Also remove the subject when anonymising"
msgstr "Αφαίρεση και του θέματος κατά την ανωνυμοποίηση"

msgid "Also search content"
msgstr "Αναζήτηση και στο περιεχόμενο"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "Εναλλακτικά, ζητήστε από τον πάροχο φιλοξενίας να ενεργοποιήσει τα mail() / sendmail για αυτόν τον ιστότοπο."

msgid "Always load remote images and fonts in the preview"
msgstr "Πάντα φόρτωση απομακρυσμένων εικόνων και γραμματοσειρών στην προεπισκόπηση"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (μέσω SNS)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "Ένας πάροχος email με HTTP API αντί για SMTP χρειάζεται λιγότερες ανταλλαγές ανά email."

msgid "Anonymisation"
msgstr "Ανωνυμοποίηση"

msgid "Anonymise entries after"
msgstr "Ανωνυμοποίηση καταχωρίσεων μετά από"

msgid "Anonymised"
msgstr "Ανωνυμοποιήθηκε"

msgid "Any format"
msgstr "Οποιαδήποτε μορφή"

msgid "Any status"
msgstr "Οποιαδήποτε κατάσταση"

msgid "Apply"
msgstr "Εφαρμογή"

msgid "Ask the recipient for a working address."
msgstr "Ζητήστε από τον παραλήπτη μια διεύθυνση που λειτουργεί."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "Ζητήστε από τον πάροχο φιλοξενίας να ενεργοποιήσει την επέκταση openssl (ή ενεργοποιήστε την στις ρυθμίσεις PHP του πίνακα φιλοξενίας)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "Ζητήστε από τον πάροχο φιλοξενίας να ενημερώσει τα πιστοποιητικά CA και το OpenSSL του διακομιστή."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "Ρωτήστε τον πάροχο φιλοξενίας αν οι εξερχόμενες συνδέσεις SMTP είναι αποκλεισμένες."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "Ρωτήστε τον πάροχο φιλοξενίας αν επιτρέπονται εξερχόμενες συνδέσεις προς αυτή τη θύρα (τείχος προστασίας)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "Τουλάχιστον %1$s αποτυχημένα email μέσα σε %2$s λεπτά"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "Το πολύ μία ειδοποίηση ανά τύπο μέσα σε αυτό το διάστημα, ακόμη κι αν το πρόβλημα παραμένει."

msgid "Attachments"
msgstr "Συνημμένα"

msgid "Attachments no longer available: %s"
msgstr "Τα συνημμένα δεν είναι πλέον διαθέσιμα: %s"

msgid "Authentication"
msgstr "Ταυτοποίηση"

msgid "Automatic TLS"
msgstr "Αυτόματο TLS"

msgid "Average per day"
msgstr "Μέσος όρος ανά ημέρα"

msgid "Back to the email types"
msgstr "Επιστροφή στους τύπους email"

msgid "Belongs to"
msgstr "Ανήκει σε"

msgid "Block again"
msgstr "Αποκλεισμός ξανά"

msgid "Blocked as spam or by a blocklist"
msgstr "Αποκλείστηκε ως ανεπιθύμητο ή από λίστα αποκλεισμού"

msgid "Bounced (permanent)"
msgstr "Επεστράφη (μόνιμα)"

msgid "Bounced (temporary)"
msgstr "Επεστράφη (προσωρινά)"

msgid "Broken characters (encoding): %1$s"
msgstr "Αλλοιωμένοι χαρακτήρες (κωδικοποίηση): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "Μαζικό email χωρίς κεφαλίδα διαγραφής (παραλήπτες: %1$s)"

msgid "Bundle into one daily email"
msgstr "Ομαδοποίηση σε ένα ημερήσιο email"

msgid "Bundled into one daily email"
msgstr "Ομαδοποιημένα σε ένα ημερήσιο email"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "Η ομαδοποίηση απενεργοποιήθηκε. Τα email σε αναμονή στάλθηκαν τώρα σε μία σύνοψη."

msgid "Busiest day"
msgstr "Πιο φορτωμένη ημέρα"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "Ακύρωση"

msgid "Careful: emails to this address failed several times before."
msgstr "Προσοχή: τα email προς αυτή τη διεύθυνση έχουν αποτύχει αρκετές φορές στο παρελθόν."

msgid "Change in the email types"
msgstr "Αλλαγή στους τύπους email"

msgid "Change staging mode"
msgstr "Αλλαγή δοκιμαστικής λειτουργίας"

msgid "Check"
msgstr "Έλεγχος"

msgid "Check again"
msgstr "Έλεγχος ξανά"

msgid "Check emails"
msgstr "Έλεγχος email"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "Ελέγξτε τον διακομιστή και τη θύρα· δοκιμάστε 587 (TLS) αντί για 465 (SSL) ή αντίστροφα."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "Ελέγξτε διακομιστή, θύρα, κρυπτογράφηση, όνομα χρήστη και συνθηματικό στο πρόσθετο SMTP και στείλτε από εκεί ένα δοκιμαστικό email."

msgid "Check sender domains"
msgstr "Έλεγχος τομέων αποστολέα"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "Ελέγξτε ότι η κρυπτογράφηση ταιριάζει με τη θύρα: TLS για 587, SSL για 465."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "Ελέγξτε ότι το κλειδί ανήκει στη σωστή περιοχή / στον σωστό λογαριασμό (π.χ. τελικό σημείο EU ή US)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "Ελέγξτε τον διακομιστή και τη θύρα SMTP: μια λάθος θύρα ή μια αποκλεισμένη σύνδεση συχνά καταλήγει σε λήξη χρονικού ορίου πριν λειτουργήσει μια εναλλακτική λύση."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "Ελέγξτε τις εγγραφές SPF, DKIM και DMARC του τομέα του αποστολέα ή χρησιμοποιήστε διεύθυνση αποστολέα στον τομέα από τον οποίο στέλνετε."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "Ελέγξτε τη διεύθυνση για λάθη – ή το email δεν στάλθηκε ποτέ από τον ιστότοπό σας."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "Επιβεβαιώστε τη διεύθυνση με τον παραλήπτη και διορθώστε την εκεί όπου είναι αποθηκευμένη (προφίλ χρήστη, παραγγελία, καταχώριση φόρμας)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "Επιβεβαιώστε τη διεύθυνση με τον παραλήπτη και διορθώστε την εκεί όπου είναι αποθηκευμένη."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "Ελέγξτε το όνομα διακομιστή και τη θύρα: 587 με STARTTLS (TLS) ή 465 με SSL. Η θύρα 25 είναι αποκλεισμένη από τους περισσότερους παρόχους φιλοξενίας."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "Ελέγξτε τα όρια και την τρέχουσα χρήση στον λογαριασμό της υπηρεσίας email· αναβαθμίστε το πρόγραμμα αν χρειάζεται."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "Ελέγξτε τις διευθύνσεις παραληπτών αυτής της καταχώρισης για λάθη, κενά ή τμήματα που λείπουν."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
msgstr "Ελέγξτε τη διεύθυνση αποστολέα στο πρόσθετο SMTP και το φίλτρο wp_mail_from."

msgid "Check the sending limits of your mail account and the notes of this email."
msgstr "Ελέγξτε τα όρια αποστολής του λογαριασμού email σας και τις σημειώσεις αυτού του email."

msgid "Check the server IP on a blocklist checker and request delisting."
msgstr "Ελέγξτε την IP του διακομιστή σε έναν ελεγκτή λιστών αποκλεισμού και ζητήστε τη διαγραφή της."

msgid "Check the spelling of the placeholder in the template and whether the plugin supports it for this email type. Shortcodes are not processed in emails unless the sending plugin runs do_shortcode()."
msgstr "Ελέγξτε την ορθογραφία του δεσμευτικού θέσης στο πρότυπο και αν το πρόσθετο το υποστηρίζει για αυτόν τον τύπο email. Τα shortcodes δεν επεξεργάζονται στα email, εκτός αν το πρόσθετο που στέλνει εκτελεί do_shortcode()."

msgid "Checked %s."
msgstr "Ελέγχθηκε %s."

msgid "Checked just now"
msgstr "Ελέγχθηκε μόλις τώρα"

msgid "Checking DNS records …"
msgstr "Έλεγχος εγγραφών DNS …"

msgid "Checks the DNS records of the domains your site sends from: the default sender address and the most frequent senders in the log. Missing or weak records are the most common reason why emails land in spam. Only your server's own DNS resolver is used; results are kept for one hour."
msgstr "Ελέγχει τις εγγραφές DNS των τομέων από τους οποίους στέλνει ο ιστότοπός σας: την προεπιλεγμένη διεύθυνση αποστολέα και τους συχνότερους αποστολείς στο αρχείο καταγραφής. Οι εγγραφές που λείπουν ή είναι αδύναμες είναι η συχνότερη αιτία που τα email καταλήγουν στα ανεπιθύμητα. Χρησιμοποιείται μόνο ο επιλυτής DNS του διακομιστή σας· τα αποτελέσματα διατηρούνται για μία ώρα."

msgid "Choose a range of at most %s days."
msgstr "Επιλέξτε εύρος έως %s ημερών."

msgid "Clear selection"
msgstr "Εκκαθάριση επιλογής"

