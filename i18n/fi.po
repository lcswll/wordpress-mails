msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: fi\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "”Lataa .eml” muodostaa viestin uudelleen kirjatuista, peitetyistä tiedoista (ilman liitteitä)."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (edellinen viikko: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (ajastettu: %2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s sähköpostityyppi on lakannut: %2$s."
msgstr[1] "%1$s sähköpostityyppiä on lakannut, esim. %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "%1$s sähköpostityyppiä %2$s lähettäjältä"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "%1$s sähköpostia epäonnistui viimeisten %2$s minuutin aikana."

msgid "%1$s emails in %2$s days"
msgstr "%1$s sähköpostia %2$s päivässä"

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "%1$s sähköpostia viimeisten 30 päivän aikana, %2$s epäonnistui"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "Tunnin sisällä lähetettiin %1$s sähköpostia – paljon tavallista enemmän (raja: %2$s tunnissa). Yhteydenottolomaketta saatetaan käyttää väärin tai sivusto voi olla murrettu."

msgid "%1$s entries, %2$s"
msgstr "%1$s merkintää, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "%1$s tuotu, %2$s kaksoiskappaletta, %3$s liian vanhaa"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "%1$s/%2$s palautui (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "%1$s/%2$s sähköpostia viimeisen %3$s päivän ajalta ei voitu lähettää."

msgid "%1$s of %2$s entries processed …"
msgstr "%1$s/%2$s merkintää käsitelty …"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s prosenttiyksikköä vs. %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "%1$s lähetti ensimmäisen sähköpostinsa %2$s ja on kirjoittanut %3$s eri ulkoiseen osoitteeseen viimeisten 24 tunnin aikana. Jos et ole asentanut tai määrittänyt mitään, mikä lähettää tällaisia sähköposteja, tarkista sivusto: uusi lähettäjä voi olla merkki murretusta sivustosta."

msgid "%1$s sent, %2$s still held …"
msgstr "%1$s lähetetty, %2$s yhä pidätettynä …"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s vs. %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · %2$s sähköpostia koottu edellisen koosteen jälkeen"

msgid "%1$s · as of %2$s"
msgstr "%1$s · tilanne %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – epäonnistumisaste %2$s %% (edellinen viikko: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – ilmoittaja: %2$s, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (must-use-lisäosa)"

msgid "%s (theme)"
msgstr "%s (teema)"

msgid "%s ago"
msgstr "%s sitten"

msgid "%s days"
msgstr "%s päivää"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "%s sähköposti epäonnistui viimeisten 7 päivän aikana."
msgstr[1] "%s sähköpostia epäonnistui viimeisten 7 päivän aikana."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s sähköposti odottaa päätöstäsi."
msgstr[1] "%s sähköpostia odottaa päätöstäsi."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "%s sähköposti pidätettiin eikä sitä lähetetty viimeisten 7 päivän aikana."
msgstr[1] "%s sähköpostia pidätettiin eikä niitä lähetetty viimeisten 7 päivän aikana."

msgid "%s emails are held by the emergency brake."
msgstr "Hätäjarru pidättää %s sähköpostia."

msgid "%s emails are waiting and have not been delivered."
msgstr "%s sähköpostia odottaa eikä niitä ole toimitettu."

msgid "%s entries"
msgstr "%s merkintää"

msgid "%s failed"
msgstr "%s epäonnistui"

msgid "%s held emails discarded."
msgstr "%s pidätettyä sähköpostia hylätty."

msgid "%s imported entries removed."
msgstr "%s tuotua merkintää poistettu."

msgid "%s in 30 days"
msgstr "%s 30 päivässä"

msgid "%s marked as spam"
msgstr "%s merkitty roskapostiksi"

msgid "%s more on the Email types page."
msgstr "%s lisää Sähköpostityypit-sivulla."

msgid "%s notes"
msgstr "%s huomautusta"

msgid "%s of all emails"
msgstr "%s kaikista sähköposteista"

msgid "%s of them in the last 24 hours."
msgstr "Niistä %s viimeisten 24 tunnin aikana."

msgid "%s s"
msgstr "%s s"

msgid "%s selected"
msgstr "%s valittu"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s asia vaatii huomiota:"
msgstr[1] "%s asiaa vaatii huomiota:"

msgid "%s to administrators in 30 days"
msgstr "%s ylläpitäjille 30 päivässä"

msgid "%s unchanged lines"
msgstr "%s muuttumatonta riviä"

msgid "(no subject)"
msgstr "(ei aihetta)"

msgid "(no text content)"
msgstr "(ei tekstisisältöä)"

msgid "(the emails are no longer in the log)"
msgstr "(sähköpostit eivät ole enää lokissa)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "-all on tiukempi; ~all on yleinen ja riittää yhdessä DMARCin kanssa."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "0 säilyttää merkinnät ikuisesti. Siivous suoritetaan kerran päivässä."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "0 tarkoittaa, ettei rajaa ole. Vanhimmat merkinnät poistetaan ensin."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "0 poistaa toiminnon käytöstä. Poistaa vanhempien merkintöjen sisällön, otsakkeet ja liitteet sekä peittää osoitteet (a***@example.com). Päiväys, tila, lähde, muoto, koko ja huomautukset säilyvät tilastoja varten. Suoritetaan päivittäisen siivouksen yhteydessä ennen merkintöjen poistamista – vaikuttaa siis vain, jos aika on lyhyempi kuin yllä oleva poistoaika."

msgid "12 months"
msgstr "12 kuukautta"

msgid "30 days"
msgstr "30 päivää"

msgid "7 days"
msgstr "7 päivää"

msgid "90 days"
msgstr "90 päivää"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "DKIM-valitsin voi sisältää vain kirjaimia, numeroita, pisteitä, yhdysmerkkejä ja alaviivoja."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "API:n kautta lähettävä lähetyslisäosa otti toimituksen hoitaakseen ja ilmoitti lähetyksen epäonnistuneen kertomatta syytä."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "Julkaistu avain ei todista, että sähköpostisi allekirjoitetaan sillä – tarkista DKIM-tulos vastaanotetun viestin otsakkeista."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "Vastaanottaja tai lähettäjän osoite ei ole kelvollinen sähköpostiosoite, joten PHPMailer kieltäytyi lähettämästä."

msgid "API key or private key in plain text: %1$s"
msgstr "API-avain tai yksityinen avain selkotekstinä: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "Tämän tietueen arviointiin tarvitaan noin %1$s DNS-hakua – enemmän kuin sallitut %2$s, joten vastaanottajat voivat ohittaa sen (PermError). Poista käyttämättömät include:-merkinnät."

msgid "Access"
msgstr "Käyttöoikeus"

msgid "Actions"
msgstr "Toiminnot"

msgid "Active: alerts on %s."
msgstr "Käytössä: hälytykset (%s)."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "Lisää jokaiseen mallin kuvaan lyhyt alt-määrite, esim. alt=\"Esimerkkikaupan logo\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "Lisää sähköpostipalveluntarjoajasi include: (esim. include:_spf.google.com), jos lähetät sen kautta."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "Lisää postipalvelimesi tai sähköpostipalvelusi lähettäjän verkkotunnuksen SPF-tietueeseen."

msgid "Added:"
msgstr "Lisätty:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "Osoitteet, joilla on vähintään %s pysyvää virhettä: vastaanottava palvelin hylkäsi postilaatikon, verkkotunnuksella ei ole postipalvelinta tai sähköpostipalveluntarjoajasi ilmoitti pysyvästä palautuksesta. Merkinnät vanhenevat lokin säilytysajan mukana."

msgid "Admin screen"
msgstr "Hallintanäkymä"

msgid "Administrators"
msgstr "Ylläpitäjät"

msgid "Aggregate reports go to %s."
msgstr "Koosteraportit menevät osoitteeseen %s."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "Hälytys"

msgid "Alert and hold further emails"
msgstr "Hälytä ja pidätä uudet sähköpostit"

msgid "Alert only"
msgstr "Vain hälytys"

msgid "Alert when an email type that is sent regularly stops"
msgstr "Hälytä, kun säännöllisesti lähetettävä sähköpostityyppi lakkaa"

msgid "Alert when emails fail repeatedly"
msgstr "Hälytä, kun sähköpostit epäonnistuvat toistuvasti"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "Hälytä, kun sivusto lakkaa yllättäen lähettämästä sähköposteja"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "Hälytykset ovat käytössä, mutta niillä ei ole kanavaa: anna sähköpostiosoite tai webhook-URL."

msgid "Alerts are off."
msgstr "Hälytykset ovat pois päältä."

msgid "All"
msgstr "Kaikki"

msgid "All email types look healthy."
msgstr "Kaikki sähköpostityypit näyttävät olevan kunnossa."

msgid "All emails are redirected to test addresses."
msgstr "Kaikki sähköpostit ohjataan testiosoitteisiin."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "Kaikki sähköpostit menevät testiosoitteisiin todellisten vastaanottajien sijaan."

msgid "All sources"
msgstr "Kaikki lähteet"

msgid "Allow again"
msgstr "Salli uudelleen"

msgid "Allowed again."
msgstr "Sallittu uudelleen."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "Hälyttää myös kerran, kun lisäosa tai teema, joka ei ole koskaan aiemmin lähettänyt sähköpostia, kirjoittaa vuorokauden sisällä moniin eri ulkoisiin osoitteisiin – mahdollinen merkki murretusta sivustosta. Kaksi ensimmäistä viikkoa Mailspurin asentamisen jälkeen toimivat vertailukohtana."

msgid "Also remove the subject when anonymising"
msgstr "Poista anonymisoinnissa myös aihe"

msgid "Also search content"
msgstr "Hae myös sisällöstä"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "Vaihtoehtoisesti pyydä webhotelliasi ottamaan mail() / sendmail käyttöön tälle sivustolle."

msgid "Always load remote images and fonts in the preview"
msgstr "Lataa aina ulkoiset kuvat ja fontit esikatselussa"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (SNS:n kautta)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "HTTP-rajapintaa SMTP:n sijaan käyttävä sähköpostipalveluntarjoaja tarvitsee vähemmän edestakaisia yhteyksiä sähköpostia kohden."

msgid "Anonymisation"
msgstr "Anonymisointi"

msgid "Anonymise entries after"
msgstr "Anonymisoi merkinnät, kun ne ovat vanhempia kuin"

msgid "Anonymised"
msgstr "Anonymisoitu"

msgid "Any format"
msgstr "Mikä tahansa muoto"

msgid "Any status"
msgstr "Mikä tahansa tila"

msgid "Apply"
msgstr "Käytä"

msgid "Ask the recipient for a working address."
msgstr "Pyydä vastaanottajalta toimiva osoite."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "Pyydä webhotelliasi ottamaan openssl-laajennus käyttöön (tai ota se käyttöön hallintapaneelin PHP-asetuksista)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "Pyydä webhotelliasi päivittämään palvelimen CA-varmenteet ja OpenSSL."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "Kysy webhotelliltasi, onko lähtevät SMTP-yhteydet estetty."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "Kysy webhotelliltasi, sallitaanko lähtevät yhteydet kyseiseen porttiin (palomuuri)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "Vähintään %1$s epäonnistunutta sähköpostia %2$s minuutin sisällä"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "Enintään yksi hälytys tyyppiä kohden tämän ajan sisällä, vaikka ongelma jatkuisi."

msgid "Attachments"
msgstr "Liitteet"

msgid "Attachments no longer available: %s"
msgstr "Liitteet eivät ole enää saatavilla: %s"

msgid "Authentication"
msgstr "Tunnistautuminen"

msgid "Automatic TLS"
msgstr "Automaattinen TLS"

msgid "Average per day"
msgstr "Keskimäärin päivässä"

msgid "Back to the email types"
msgstr "Takaisin sähköpostityyppeihin"

msgid "Belongs to"
msgstr "Kuuluu"

msgid "Block again"
msgstr "Estä uudelleen"

msgid "Blocked as spam or by a blocklist"
msgstr "Estetty roskapostina tai estolistan perusteella"

msgid "Bounced (permanent)"
msgstr "Palautettu (pysyvä)"

msgid "Bounced (temporary)"
msgstr "Palautettu (tilapäinen)"

msgid "Broken characters (encoding): %1$s"
msgstr "Rikkinäisiä merkkejä (merkistökoodaus): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "Joukkoposti ilman peruutusotsaketta (%1$s vastaanottajaa)"

msgid "Bundle into one daily email"
msgstr "Kokoa yhdeksi päivittäiseksi sähköpostiksi"

msgid "Bundled into one daily email"
msgstr "Koottu yhdeksi päivittäiseksi sähköpostiksi"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "Kokoaminen on pois päältä. Odottaneet sähköpostit lähetettiin nyt yhtenä koosteena."

msgid "Busiest day"
msgstr "Vilkkain päivä"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "Peruuta"

msgid "Careful: emails to this address failed several times before."
msgstr "Huomio: sähköpostit tähän osoitteeseen ovat epäonnistuneet aiemmin useita kertoja."

msgid "Change in the email types"
msgstr "Muutos sähköpostityypeissä"

msgid "Change staging mode"
msgstr "Muuta staging-tilaa"

msgid "Check"
msgstr "Tarkista"

msgid "Check again"
msgstr "Tarkista uudelleen"

msgid "Check emails"
msgstr "Tarkista sähköpostit"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "Tarkista palvelin ja portti; kokeile porttia 587 (TLS) portin 465 (SSL) sijaan tai päinvastoin."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "Tarkista palvelin, portti, salaus, käyttäjätunnus ja salasana SMTP-lisäosassasi ja lähetä sieltä testisähköposti."

msgid "Check sender domains"
msgstr "Tarkista lähettäjien verkkotunnukset"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "Tarkista, että salaus vastaa porttia: TLS portille 587, SSL portille 465."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "Tarkista, että avain kuuluu oikealle alueelle / tilille (esim. EU- vs. US-päätepiste)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "Tarkista SMTP-palvelin ja portti: väärä portti tai estetty yhteys päättyy usein aikakatkaisuun ennen kuin varavaihtoehto toimii."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "Tarkista lähettäjän verkkotunnuksen SPF-, DKIM- ja DMARC-tietueet tai käytä lähettäjäosoitetta siinä verkkotunnuksessa, josta lähetät."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "Tarkista osoite kirjoitusvirheiden varalta – tai sivustosi ei koskaan lähettänyt sähköpostia."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "Tarkista osoite vastaanottajalta ja korjaa se siellä, minne se on tallennettu (käyttäjäprofiili, tilaus, lomakemerkintä)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "Tarkista osoite vastaanottajalta ja korjaa se siellä, minne se on tallennettu."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "Tarkista palvelimen nimi ja portti: 587 ja STARTTLS (TLS) tai 465 ja SSL. Useimmat webhotellit estävät portin 25."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "Tarkista rajat ja nykyinen käyttö sähköpostipalvelusi tilillä; päivitä tilaus tarvittaessa."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "Tarkista tämän merkinnän vastaanottajaosoitteet kirjoitusvirheiden, välilyöntien tai puuttuvien osien varalta."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
msgstr "Tarkista lähettäjäosoite SMTP-lisäosassasi ja wp_mail_from-suodatin."

msgid "Check the sending limits of your mail account and the notes of this email."
msgstr "Tarkista sähköpostitilisi lähetysrajat ja tämän sähköpostin huomautukset."

msgid "Check the server IP on a blocklist checker and request delisting."
msgstr "Tarkista palvelimen IP-osoite estolistatarkistimella ja pyydä poistoa listalta."

msgid "Check the spelling of the placeholder in the template and whether the plugin supports it for this email type. Shortcodes are not processed in emails unless the sending plugin runs do_shortcode()."
msgstr "Tarkista paikkamerkin kirjoitusasu mallissa ja tukeeko lisäosa sitä tälle sähköpostityypille. Lyhytkoodeja ei käsitellä sähköposteissa, ellei lähettävä lisäosa suorita do_shortcode()-funktiota."

msgid "Checked %s."
msgstr "Tarkistettu %s."

msgid "Checked just now"
msgstr "Tarkistettu juuri äsken"

msgid "Checking DNS records …"
msgstr "Tarkistetaan DNS-tietueita …"

msgid "Checks the DNS records of the domains your site sends from: the default sender address and the most frequent senders in the log. Missing or weak records are the most common reason why emails land in spam. Only your server's own DNS resolver is used; results are kept for one hour."
msgstr "Tarkistaa niiden verkkotunnusten DNS-tietueet, joista sivustosi lähettää: oletuslähettäjäosoitteen ja lokin yleisimmät lähettäjät. Puuttuvat tai heikot tietueet ovat yleisin syy sähköpostien päätymiseen roskapostiin. Vain palvelimesi omaa DNS-selvitintä käytetään; tulokset säilytetään tunnin."

msgid "Choose a range of at most %s days."
msgstr "Valitse enintään %s päivän jakso."

msgid "Clear selection"
msgstr "Tyhjennä valinta"

msgid "Click a bar to open these emails in the log."
msgstr "Napsauta palkkia avataksesi nämä sähköpostit lokissa."

msgid "Close"
msgstr "Sulje"

msgid "Close (Esc)"
msgstr "Sulje (Esc)"

msgid "Colour scheme"
msgstr "Värimaailma"

msgid "Command line"
msgstr "Komentorivi"

msgid "Compare"
msgstr "Vertaa"

msgid "Compare the sources of these entries. Check whether two plugins send the same notification, or whether a hook (e.g. order status change) fires more than once."
msgstr "Vertaa näiden merkintöjen lähteitä. Tarkista, lähettävätkö kaksi lisäosaa saman ilmoituksen tai laukeaako jokin koukku (esim. tilauksen tilan muutos) useammin kuin kerran."

msgid "Component"
msgstr "Komponentti"

msgid "Configure alerts"
msgstr "Määritä hälytykset"

msgid "Content anonymised after %1$s days, %2$s"
msgstr "Sisältö anonymisoidaan %1$s päivän jälkeen, %2$s"

msgid "Content change marked as seen."
msgstr "Sisällön muutos merkitty nähdyksi."

msgid "Content changed"
msgstr "Sisältö muuttunut"

msgid "Content changed on %1$s, after the %2$s update."
msgstr "Sisältö muuttui %1$s, päivityksen %2$s jälkeen."

msgid "Content changed on %s."
msgstr "Sisältö muuttui %s."

msgid "Content removed"
msgstr "Sisältö poistettu"

msgid "Content removed after %s days"
msgstr "Sisältö poistettu %s päivän jälkeen"

msgid "Content, headers and attachments were removed and the addresses masked by the anonymisation setting."
msgstr "Anonymisointiasetus on poistanut sisällön, otsakkeet ja liitteet sekä peittänyt osoitteet."

msgid "Copied"
msgstr "Kopioitu"

msgid "Copied – paste it into your reply."
msgstr "Kopioitu – liitä se vastaukseesi."

msgid "Copies a short sentence for answering the customer: when the email was sent to whom and whether it arrived – without technical details."
msgstr "Kopioi lyhyen lauseen asiakkaalle vastaamista varten: milloin sähköposti lähetettiin kenelle ja tuliko se perille – ilman teknisiä yksityiskohtia."

msgid "Copies the existing log of another mail logging plugin into Mailspur, so old emails can be searched and previewed here. The other plugin and its data stay untouched; running the import again only adds new entries."
msgstr "Kopioi toisen sähköpostien kirjauslisäosan olemassa olevan lokin Mailspuriin, jotta vanhoja sähköposteja voi hakea ja esikatsella täällä. Toinen lisäosa ja sen tiedot säilyvät koskemattomina; tuonnin suorittaminen uudelleen lisää vain uudet merkinnät."

msgid "Copy"
msgstr "Kopioi"

msgid "Copy for support"
msgstr "Kopioi tukea varten"

msgid "Copying is not possible in this browser. Select the text and copy it:"
