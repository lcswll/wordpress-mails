msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: it_IT\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "\"Scarica .eml\" ricostruisce il messaggio dai dati registrati e oscurati (senza allegati)."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (settimana precedente: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (pianificata per %2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s tipo di email non viene più inviato: %2$s."
msgstr[1] "%1$s tipi di email non vengono più inviati, ad esempio %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "%1$s tipi di email da %2$s mittenti"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "%1$s email non sono state inviate negli ultimi %2$s minuti."

msgid "%1$s emails in %2$s days"
msgstr "%1$s email in %2$s giorni"

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "%1$s email negli ultimi 30 giorni, %2$s non riuscite"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "Nell'arco di un'ora sono state inviate %1$s email, molte più del solito (soglia: %2$s all'ora). Forse un modulo di contatto viene usato in modo improprio o il sito è stato compromesso."

msgid "%1$s entries, %2$s"
msgstr "%1$s voci, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "%1$s importate, %2$s duplicate, %3$s troppo vecchie"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "%1$s su %2$s respinte (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "%1$s email su %2$s negli ultimi %3$s giorni non sono state inviate."

msgid "%1$s of %2$s entries processed …"
msgstr "%1$s di %2$s voci elaborate …"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s p.p. rispetto a %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "%1$s ha inviato la sua prima email il %2$s e nelle ultime 24 ore ha scritto a %3$s indirizzi esterni diversi. Se non hai installato o configurato nulla che invii questo tipo di email, controlla il sito: un nuovo mittente può essere il segnale di un sito violato."

msgid "%1$s sent, %2$s still held …"
msgstr "%1$s inviate, %2$s ancora trattenute …"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s rispetto a %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · %2$s email raggruppate dall'ultimo riepilogo"

msgid "%1$s · as of %2$s"
msgstr "%1$s · aggiornato al %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – tasso di errore %2$s %% (settimana precedente: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – segnalato da %2$s, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (plugin must-use)"

msgid "%s (theme)"
msgstr "%s (tema)"

msgid "%s ago"
msgstr "%s fa"

msgid "%s days"
msgstr "%s giorni"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "%s email non è stata inviata negli ultimi 7 giorni."
msgstr[1] "%s email non sono state inviate negli ultimi 7 giorni."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s email è in attesa di una tua decisione."
msgstr[1] "%s email sono in attesa di una tua decisione."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "%s email è stata trattenuta e non inviata negli ultimi 7 giorni."
msgstr[1] "%s email sono state trattenute e non inviate negli ultimi 7 giorni."

msgid "%s emails are held by the emergency brake."
msgstr "%s email sono trattenute dal freno di emergenza."

msgid "%s emails are waiting and have not been delivered."
msgstr "%s email sono in attesa e non sono state consegnate."

msgid "%s entries"
msgstr "%s voci"

msgid "%s failed"
msgstr "%s non riuscite"

msgid "%s held emails discarded."
msgstr "%s email trattenute scartate."

msgid "%s imported entries removed."
msgstr "%s voci importate rimosse."

msgid "%s in 30 days"
msgstr "%s in 30 giorni"

msgid "%s marked as spam"
msgstr "%s segnate come spam"

msgid "%s more on the Email types page."
msgstr "Altri %s nella pagina Tipi di email."

msgid "%s notes"
msgstr "%s note"

msgid "%s of all emails"
msgstr "%s di tutte le email"

msgid "%s of them in the last 24 hours."
msgstr "Di queste, %s nelle ultime 24 ore."

msgid "%s s"
msgstr "%s s"

msgid "%s selected"
msgstr "%s selezionate"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s cosa richiede la tua attenzione:"
msgstr[1] "%s cose richiedono la tua attenzione:"

msgid "%s to administrators in 30 days"
msgstr "%s agli amministratori in 30 giorni"

msgid "%s unchanged lines"
msgstr "%s righe invariate"

msgid "(no subject)"
msgstr "(nessun oggetto)"

msgid "(no text content)"
msgstr "(nessun contenuto testuale)"

msgid "(the emails are no longer in the log)"
msgstr "(le email non sono più nel registro)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "-all è più restrittivo; ~all è comune e va bene insieme a DMARC."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "0 conserva le voci per sempre. La pulizia viene eseguita una volta al giorno."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "0 significa nessun limite. Le voci più vecchie vengono rimosse per prime."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "0 la disattiva. Rimuove contenuto, intestazioni e allegati delle voci più vecchie e maschera gli indirizzi (a***@example.com). Data, stato, origine, formato, dimensione e note restano per le statistiche. Viene eseguita con la pulizia giornaliera, prima che le voci vengano eliminate: ha quindi effetto solo se il periodo è più breve del termine di eliminazione indicato sopra."

msgid "12 months"
msgstr "12 mesi"

msgid "30 days"
msgstr "30 giorni"

msgid "7 days"
msgstr "7 giorni"

msgid "90 days"
msgstr "90 giorni"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "Un selettore DKIM può contenere solo lettere, cifre, punti, trattini e trattini bassi."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "Un plugin di invio che invia tramite API ha preso in carico la consegna e ha segnalato che l'invio non è riuscito, senza indicare un motivo."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "Una chiave pubblicata non dimostra che le tue email siano firmate con essa: controlla il risultato DKIM nelle intestazioni di un'email ricevuta."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "Un destinatario o l'indirizzo mittente non è un indirizzo email valido, quindi PHPMailer ha rifiutato l'invio."

msgid "API key or private key in plain text: %1$s"
msgstr "Chiave API o chiave privata in chiaro: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "Per valutare questo record servono circa %1$s ricerche DNS, più delle %2$s consentite, quindi i destinatari potrebbero ignorarlo (PermError). Rimuovi le voci include: inutilizzate."

msgid "Access"
msgstr "Accesso"

msgid "Actions"
msgstr "Azioni"

msgid "Active: alerts on %s."
msgstr "Attivo: avvisi per %s."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "Aggiungi un breve attributo alt a ogni immagine del template, ad esempio alt=\"Logo Negozio di esempio\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "Se invii tramite un provider di posta, aggiungi il suo include: (ad esempio include:_spf.google.com)."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "Aggiungi il tuo server di posta o servizio di posta al record SPF del dominio mittente."

msgid "Added:"
msgstr "Aggiunto:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "Indirizzi con almeno %s errori permanenti: il server di destinazione ha rifiutato la casella di posta, il dominio non ha un server di posta oppure il tuo provider email ha segnalato un hard bounce. Le voci scadono con il periodo di conservazione del registro."

msgid "Admin screen"
msgstr "Schermata di amministrazione"

msgid "Administrators"
msgstr "Amministratori"

msgid "Aggregate reports go to %s."
msgstr "I report aggregati vengono inviati a %s."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "Avviso"

msgid "Alert and hold further emails"
msgstr "Avvisa e trattieni le email successive"

msgid "Alert only"
msgstr "Solo avviso"

msgid "Alert when an email type that is sent regularly stops"
msgstr "Avvisa quando un tipo di email inviato regolarmente si interrompe"

msgid "Alert when emails fail repeatedly"
msgstr "Avvisa quando le email non vengono inviate ripetutamente"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "Avvisa quando il sito smette inaspettatamente di inviare email"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "Gli avvisi sono attivi ma non hanno un canale: inserisci un indirizzo email o un URL webhook."

msgid "Alerts are off."
msgstr "Gli avvisi sono disattivati."

msgid "All"
msgstr "Tutte"

msgid "All email types look healthy."
msgstr "Tutti i tipi di email sembrano in ordine."

msgid "All emails are redirected to test addresses."
msgstr "Tutte le email vengono reindirizzate agli indirizzi di test."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "Tutte le email vanno a indirizzi di test invece che ai destinatari reali."

msgid "All sources"
msgstr "Tutte le origini"

msgid "Allow again"
msgstr "Consenti di nuovo"

msgid "Allowed again."
msgstr "Consentito di nuovo."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "Avvisa anche una volta quando un plugin o un tema che non ha mai inviato un'email scrive in un giorno a molti indirizzi esterni diversi: un possibile segnale di un sito violato. Le prime due settimane dopo l'installazione di Mailspur servono come riferimento."

msgid "Also remove the subject when anonymising"
msgstr "Durante l'anonimizzazione rimuovi anche l'oggetto"

msgid "Also search content"
msgstr "Cerca anche nel contenuto"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "In alternativa chiedi al tuo hosting di abilitare mail() / sendmail per questo sito."

msgid "Always load remote images and fonts in the preview"
msgstr "Carica sempre immagini e font remoti nell'anteprima"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (tramite SNS)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "Un provider email con un'API HTTP invece di SMTP richiede meno scambi per ogni email."

msgid "Anonymisation"
msgstr "Anonimizzazione"

msgid "Anonymise entries after"
msgstr "Anonimizza le voci dopo"

msgid "Anonymised"
msgstr "Anonimizzata"

msgid "Any format"
msgstr "Qualsiasi formato"

msgid "Any status"
msgstr "Qualsiasi stato"

msgid "Apply"
msgstr "Applica"

msgid "Ask the recipient for a working address."
msgstr "Chiedi al destinatario un indirizzo funzionante."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "Chiedi al tuo hosting di abilitare l'estensione openssl (o abilitala nelle impostazioni PHP del pannello di hosting)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "Chiedi al tuo hosting di aggiornare i certificati CA e OpenSSL del server."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "Chiedi al tuo hosting se le connessioni SMTP in uscita sono bloccate."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "Chiedi al tuo hosting se le connessioni in uscita verso quella porta sono consentite (firewall)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "Almeno %1$s email non riuscite entro %2$s minuti"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "Al massimo un avviso per tipo in questo intervallo, anche se il problema persiste."

msgid "Attachments"
msgstr "Allegati"

msgid "Attachments no longer available: %s"
msgstr "Allegati non più disponibili: %s"

msgid "Authentication"
msgstr "Autenticazione"

msgid "Automatic TLS"
msgstr "TLS automatico"

msgid "Average per day"
msgstr "Media al giorno"

msgid "Back to the email types"
msgstr "Torna ai tipi di email"

msgid "Belongs to"
msgstr "Appartiene a"

msgid "Block again"
msgstr "Blocca di nuovo"

msgid "Blocked as spam or by a blocklist"
msgstr "Bloccata come spam o da una blocklist"

msgid "Bounced (permanent)"
msgstr "Respinta (permanente)"

msgid "Bounced (temporary)"
msgstr "Respinta (temporaneo)"

msgid "Broken characters (encoding): %1$s"
msgstr "Caratteri danneggiati (codifica): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "Email di massa senza intestazione di disiscrizione (%1$s destinatari)"

msgid "Bundle into one daily email"
msgstr "Raggruppa in un'unica email giornaliera"

msgid "Bundled into one daily email"
msgstr "Raggruppato in un'unica email giornaliera"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "Il raggruppamento è disattivato. Le email in attesa sono appena partite in un unico riepilogo."

msgid "Busiest day"
msgstr "Giorno più intenso"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "Annulla"

msgid "Careful: emails to this address failed several times before."
msgstr "Attenzione: le email a questo indirizzo non sono state inviate già più volte."

msgid "Change in the email types"
msgstr "Modifica nei tipi di email"

msgid "Change staging mode"
msgstr "Modifica la modalità staging"

msgid "Check"
msgstr "Verifica"

msgid "Check again"
msgstr "Verifica di nuovo"

msgid "Check emails"
msgstr "Controlla le email"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "Controlla host e porta; prova 587 (TLS) invece di 465 (SSL) o viceversa."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "Controlla host, porta, crittografia, nome utente e password nel tuo plugin SMTP e invia da lì un'email di prova."

msgid "Check sender domains"
msgstr "Verifica i domini mittente"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "Controlla che la crittografia corrisponda alla porta: TLS per 587, SSL per 465."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "Controlla che la chiave appartenga alla regione o all'account giusti (ad esempio endpoint UE o USA)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "Controlla host e porta SMTP: una porta errata o una connessione bloccata finisce spesso in un timeout prima che un'alternativa entri in funzione."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "Controlla i record SPF, DKIM e DMARC del dominio mittente, oppure usa un indirizzo mittente del dominio da cui invii."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "Controlla che l'indirizzo non contenga errori di battitura, oppure il tuo sito non ha mai inviato l'email."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "Verifica l'indirizzo con il destinatario e correggilo dove è salvato (profilo utente, ordine, invio del modulo)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "Verifica l'indirizzo con il destinatario e correggilo dove è salvato."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "Controlla il nome host e la porta: 587 con STARTTLS (TLS) o 465 con SSL. La porta 25 è bloccata dalla maggior parte degli hosting."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "Controlla i limiti e l'utilizzo attuale nel tuo account del servizio di posta; se necessario passa a un piano superiore."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "Controlla che gli indirizzi dei destinatari di questa voce non contengano errori di battitura, spazi o parti mancanti."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
msgstr "Controlla l'indirizzo mittente nel tuo plugin SMTP e il filtro wp_mail_from."

msgid "Check the sending limits of your mail account and the notes of this email."
msgstr "Controlla i limiti di invio del tuo account di posta e le note di questa email."

msgid "Check the server IP on a blocklist checker and request delisting."
msgstr "Controlla l'IP del server con un servizio di verifica delle blocklist e richiedi la rimozione."

msgid "Check the spelling of the placeholder in the template and whether the plugin supports it for this email type. Shortcodes are not processed in emails unless the sending plugin runs do_shortcode()."
msgstr "Controlla come è scritto il segnaposto nel template e se il plugin lo supporta per questo tipo di email. Gli shortcode non vengono elaborati nelle email, a meno che il plugin che invia non esegua do_shortcode()."

msgid "Checked %s."
msgstr "Verificato %s."

msgid "Checked just now"
msgstr "Verificato proprio ora"

msgid "Checking DNS records …"
msgstr "Verifica dei record DNS in corso …"

msgid "Checks the DNS records of the domains your site sends from: the default sender address and the most frequent senders in the log. Missing or weak records are the most common reason why emails land in spam. Only your server's own DNS resolver is used; results are kept for one hour."
msgstr "Verifica i record DNS dei domini da cui il tuo sito invia: l'indirizzo mittente predefinito e i mittenti più frequenti nel registro. Record mancanti o deboli sono il motivo più comune per cui le email finiscono nello spam. Viene usato solo il resolver DNS del tuo server; i risultati vengono conservati per un'ora."

msgid "Choose a range of at most %s days."
msgstr "Scegli un intervallo di al massimo %s giorni."

msgid "Clear selection"
msgstr "Annulla la selezione"

msgid "Click a bar to open these emails in the log."
msgstr "Fai clic su una barra per aprire queste email nel registro."

msgid "Close"
msgstr "Chiudi"

msgid "Close (Esc)"
msgstr "Chiudi (Esc)"

msgid "Colour scheme"
msgstr "Combinazione di colori"

msgid "Command line"
msgstr "Riga di comando"

msgid "Compare"
msgstr "Confronta"

msgid "Compare the sources of these entries. Check whether two plugins send the same notification, or whether a hook (e.g. order status change) fires more than once."
msgstr "Confronta le origini di queste voci. Verifica se due plugin inviano la stessa notifica o se un hook (ad esempio il cambio di stato dell'ordine) viene eseguito più di una volta."

msgid "Component"
msgstr "Componente"

msgid "Configure alerts"
msgstr "Configura gli avvisi"

msgid "Content anonymised after %1$s days, %2$s"
msgstr "Contenuto anonimizzato dopo %1$s giorni, %2$s"

msgid "Content change marked as seen."
msgstr "Modifica del contenuto segnata come vista."

msgid "Content changed"
msgstr "Contenuto modificato"

msgid "Content changed on %1$s, after the %2$s update."
msgstr "Contenuto modificato il %1$s, dopo l'aggiornamento di %2$s."

msgid "Content changed on %s."
msgstr "Contenuto modificato il %s."

msgid "Content removed"
msgstr "Contenuto rimosso"

msgid "Content removed after %s days"
msgstr "Contenuto rimosso dopo %s giorni"

msgid "Content, headers and attachments were removed and the addresses masked by the anonymisation setting."
msgstr "Contenuto, intestazioni e allegati sono stati rimossi e gli indirizzi mascherati dall'impostazione di anonimizzazione."

msgid "Copied"
msgstr "Copiato"

msgid "Copied – paste it into your reply."
msgstr "Copiato: incollalo nella tua risposta."

msgid "Copies a short sentence for answering the customer: when the email was sent to whom and whether it arrived – without technical details."
msgstr "Copia una breve frase per rispondere al cliente: quando l'email è stata inviata, a chi e se è arrivata, senza dettagli tecnici."

msgid "Copies the existing log of another mail logging plugin into Mailspur, so old emails can be searched and previewed here. The other plugin and its data stay untouched; running the import again only adds new entries."
msgstr "Copia in Mailspur il registro esistente di un altro plugin di registrazione email, così le email meno recenti possono essere cercate e visualizzate qui. L'altro plugin e i suoi dati restano invariati; ripetendo l'importazione vengono aggiunte solo le nuove voci."

msgid "Copy"
msgstr "Copia"

msgid "Copy for support"
msgstr "Copia per l'assistenza"

msgid "Copying is not possible in this browser. Select the text and copy it:"
msgstr "In questo browser non è possibile copiare. Seleziona il testo e copialo:"

msgid "Correct the address (e.g. in the user profile or order) and consider an email validation in your forms."
msgstr "Correggi l'indirizzo (ad esempio nel profilo utente o nell'ordine) e valuta una convalida degli indirizzi email nei tuoi moduli."

msgid "Counted once per email."
msgstr "Conteggiata una volta per email."

msgid "Create a new API key with send permission at your mail service and enter it in the mailer plugin."
msgstr "Crea una nuova chiave API con permesso di invio presso il tuo servizio di posta e inseriscila nel plugin di invio."

msgid "Create a new webhook URL? The current URL stops working at once – paste the new URL into the webhook settings of your email provider."
msgstr "Creare un nuovo URL webhook? L'URL attuale smette subito di funzionare: incolla il nuovo URL nelle impostazioni webhook del tuo provider email."

msgid "Create new URL"
msgstr "Crea un nuovo URL"

msgid "Current page"
msgstr "Pagina corrente"

msgid "Current record"
msgstr "Record attuale"

msgid "Current size"
msgstr "Dimensione attuale"

msgid "Custom"
msgstr "Personalizzato"

msgid "DKIM key found (selector: %s)."
msgstr "Chiave DKIM trovata (selettore: %s)."

msgid "DMARC record found with p=none: reports only, spoofed mail is still delivered."
msgstr "Record DMARC trovato con p=none: solo report, le email contraffatte vengono comunque consegnate."

msgid "DMARC record found with policy p=%s."
msgstr "Record DMARC trovato con criterio p=%s."

msgid "DMARC record has no valid policy (p=none, quarantine or reject)."
msgstr "Il record DMARC non ha un criterio valido (p=none, quarantine o reject)."

msgid "DNS lookup failed or timed out. Try again later."
msgstr "La ricerca DNS non è riuscita o è scaduta. Riprova più tardi."

msgid "DNS lookups are not available on this server (dns_get_record() is disabled), so the sender check cannot run here."
msgstr "Su questo server le ricerche DNS non sono disponibili (dns_get_record() è disattivata), quindi la verifica mittente non può essere eseguita qui."

msgid "DNS lookups needed: about %1$s of %2$s allowed."
msgstr "Ricerche DNS necessarie: circa %1$s su %2$s consentite."

msgid "Daily"
msgstr "Giornaliero"

msgid "Daily digest"
msgstr "Riepilogo giornaliero"

msgid "Dark"
msgstr "Scuro"

msgid "Date"
msgstr "Data"

msgid "Default (%s days)"
msgstr "Predefinito (%s giorni)"

msgid "Default (no time limit)"
msgstr "Predefinito (nessun limite di tempo)"

msgid "Default sender"
msgstr "Mittente predefinito"

msgid "Delete"
msgstr "Elimina"

msgid "Delete %s selected log entries?"
