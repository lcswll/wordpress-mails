msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: cs_CZ\n"
"Plural-Forms: nplurals=3; plural=(n == 1) ? 0 : ((n >= 2 && n <= 4) ? 1 : 2);\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "„Stáhnout .eml“ sestaví zprávu znovu ze zaznamenaných, maskovaných dat (bez příloh)."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (předchozí týden: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (naplánováno na %2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s typ e-mailu se přestal odesílat: %2$s."
msgstr[1] "%1$s typy e-mailů se přestaly odesílat, např. %2$s."
msgstr[2] "%1$s typů e-mailů se přestalo odesílat, např. %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "Typy e-mailů: %1$s, odesílatelé: %2$s"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "Za posledních %2$s minut selhalo %1$s e-mailů."

msgid "%1$s emails in %2$s days"
msgstr "E-maily: %1$s za %2$s dní"

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "E-maily za posledních 30 dní: %1$s, neúspěšné: %2$s"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "Během jedné hodiny bylo odesláno %1$s e-mailů – mnohem více než obvykle (limit: %2$s za hodinu). Kontaktní formulář může být zneužíván nebo může být web napaden."

msgid "%1$s entries, %2$s"
msgstr "Záznamy: %1$s, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "Importováno: %1$s, duplicity: %2$s, příliš staré: %3$s"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "Vráceno %1$s z %2$s (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "Za posledních %3$s dní se nepodařilo odeslat %1$s z %2$s e-mailů."

msgid "%1$s of %2$s entries processed …"
msgstr "Zpracováno %1$s z %2$s záznamů …"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s p. b. oproti %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "%1$s odeslal první e-mail %2$s a za posledních 24 hodin napsal na %3$s různých externích adres. Pokud jste neinstalovali ani nenastavovali nic, co takové e-maily odesílá, zkontrolujte web: nový odesílatel může být známkou napadeného webu."

msgid "%1$s sent, %2$s still held …"
msgstr "Odesláno %1$s, stále zadrženo %2$s …"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s oproti %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · e-maily shromážděné od posledního souhrnu: %2$s"

msgid "%1$s · as of %2$s"
msgstr "%1$s · stav k %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – míra selhání %2$s %% (předchozí týden: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – nahlásil %2$s, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (plugin must-use)"

msgid "%s (theme)"
msgstr "%s (šablona)"

msgid "%s ago"
msgstr "před %s"

msgid "%s days"
msgstr "%s dní"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "%s e-mail se za posledních 7 dní nepodařilo odeslat."
msgstr[1] "%s e-maily se za posledních 7 dní nepodařilo odeslat."
msgstr[2] "%s e-mailů se za posledních 7 dní nepodařilo odeslat."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s e-mail čeká na vaše rozhodnutí."
msgstr[1] "%s e-maily čekají na vaše rozhodnutí."
msgstr[2] "%s e-mailů čeká na vaše rozhodnutí."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "%s e-mail byl za posledních 7 dní zadržen a neodeslán."
msgstr[1] "%s e-maily byly za posledních 7 dní zadrženy a neodeslány."
msgstr[2] "%s e-mailů bylo za posledních 7 dní zadrženo a neodesláno."

msgid "%s emails are held by the emergency brake."
msgstr "Nouzová brzda zadržuje e-maily: %s."

msgid "%s emails are waiting and have not been delivered."
msgstr "Čekající a nedoručené e-maily: %s."

msgid "%s entries"
msgstr "Záznamy: %s"

msgid "%s failed"
msgstr "Neúspěšné: %s"

msgid "%s held emails discarded."
msgstr "Zahozené zadržené e-maily: %s."

msgid "%s imported entries removed."
msgstr "Odstraněné importované záznamy: %s."

msgid "%s in 30 days"
msgstr "%s za 30 dní"

msgid "%s marked as spam"
msgstr "Označeno jako spam: %s"

msgid "%s more on the Email types page."
msgstr "Dalších %s na stránce Typy e-mailů."

msgid "%s notes"
msgstr "Poznámky: %s"

msgid "%s of all emails"
msgstr "%s všech e-mailů"

msgid "%s of them in the last 24 hours."
msgstr "Z toho %s za posledních 24 hodin."

msgid "%s s"
msgstr "%s s"

msgid "%s selected"
msgstr "Vybráno: %s"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s věc vyžaduje pozornost:"
msgstr[1] "%s věci vyžadují pozornost:"
msgstr[2] "%s věcí vyžaduje pozornost:"

msgid "%s to administrators in 30 days"
msgstr "%s administrátorům za 30 dní"

msgid "%s unchanged lines"
msgstr "Nezměněné řádky: %s"

msgid "(no subject)"
msgstr "(bez předmětu)"

msgid "(no text content)"
msgstr "(bez textového obsahu)"

msgid "(the emails are no longer in the log)"
msgstr "(tyto e-maily už nejsou v protokolu)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "-all je přísnější; ~all je běžné a ve spojení s DMARC v pořádku."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "0 uchovává záznamy navždy. Čištění probíhá jednou denně."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "0 znamená bez omezení. Nejstarší záznamy se odstraňují jako první."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "0 ji vypne. Odstraní obsah, hlavičky a přílohy starších záznamů a zamaskuje adresy (a***@example.com). Datum, stav, zdroj, formát, velikost a poznámky zůstanou pro statistiky. Běží s denním čištěním, před smazáním záznamů – má tedy účinek jen tehdy, je-li kratší než výše uvedená doba pro mazání."

msgid "12 months"
msgstr "12 měsíců"

msgid "30 days"
msgstr "30 dní"

msgid "7 days"
msgstr "7 dní"

msgid "90 days"
msgstr "90 dní"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "Selektor DKIM smí obsahovat jen písmena, číslice, tečky, pomlčky a podtržítka."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "Plugin maileru, který odesílá přes API, převzal doručení a nahlásil, že odeslání selhalo, aniž by uvedl důvod."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "Zveřejněný klíč nedokazuje, že jsou jím vaše e-maily podepsány – zkontrolujte výsledek DKIM v hlavičkách přijaté zprávy."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "Příjemce nebo adresa odesílatele není platná e-mailová adresa, takže PHPMailer odmítl odeslat."

msgid "API key or private key in plain text: %1$s"
msgstr "Klíč API nebo soukromý klíč v prostém textu: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "K vyhodnocení tohoto záznamu je potřeba asi %1$s dotazů DNS – více než povolených %2$s, takže ho příjemci mohou ignorovat (PermError). Odstraňte nepoužívané položky include:."

msgid "Access"
msgstr "Přístup"

msgid "Actions"
msgstr "Akce"

msgid "Active: alerts on %s."
msgstr "Aktivní: upozornění při %s."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "Ke každému obrázku v šabloně přidejte krátký atribut alt, např. alt=\"Logo Ukázkový obchod\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "Pokud odesíláte přes poskytovatele e-mailu, přidejte jeho include: (např. include:_spf.google.com)."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "Přidejte svůj poštovní server nebo poštovní službu do záznamu SPF domény odesílatele."

msgid "Added:"
msgstr "Přidáno:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "Adresy s alespoň %s trvalými selháními: přijímající server odmítl schránku, doména nemá poštovní server nebo váš poskytovatel e-mailu nahlásil tvrdý bounce. Položky vyprší s dobou uchovávání protokolu."

msgid "Admin screen"
msgstr "Obrazovka administrace"

msgid "Administrators"
msgstr "Administrátoři"

msgid "Aggregate reports go to %s."
msgstr "Souhrnné zprávy chodí na %s."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "Upozornění"

msgid "Alert and hold further emails"
msgstr "Upozornit a zadržet další e-maily"

msgid "Alert only"
msgstr "Pouze upozornit"

msgid "Alert when an email type that is sent regularly stops"
msgstr "Upozornit, když se pravidelně odesílaný typ e-mailu přestane odesílat"

msgid "Alert when emails fail repeatedly"
msgstr "Upozornit, když e-maily opakovaně selhávají"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "Upozornit, když web nečekaně přestane odesílat e-maily"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "Upozornění jsou zapnutá, ale nemají žádný kanál: zadejte e-mailovou adresu nebo URL webhooku."

msgid "Alerts are off."
msgstr "Upozornění jsou vypnutá."

msgid "All"
msgstr "Vše"

msgid "All email types look healthy."
msgstr "Všechny typy e-mailů vypadají v pořádku."

msgid "All emails are redirected to test addresses."
msgstr "Všechny e-maily jsou přesměrovány na testovací adresy."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "Všechny e-maily jdou na testovací adresy místo skutečným příjemcům."

msgid "All sources"
msgstr "Všechny zdroje"

msgid "Allow again"
msgstr "Znovu povolit"

msgid "Allowed again."
msgstr "Znovu povoleno."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "Upozorní také jednou, když plugin nebo šablona, která dosud nikdy neodeslala e-mail, během dne napíše na mnoho různých externích adres – možná známka napadeného webu. První dva týdny po instalaci Mailspuru slouží jako výchozí stav."

msgid "Also remove the subject when anonymising"
msgstr "Při anonymizaci odstranit i předmět"

msgid "Also search content"
msgstr "Prohledávat i obsah"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "Případně požádejte hostitele o povolení mail() / sendmail pro tento web."

msgid "Always load remote images and fonts in the preview"
msgstr "V náhledu vždy načítat externí obrázky a písma"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (přes SNS)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "Poskytovatel e-mailu s HTTP API místo SMTP potřebuje na jeden e-mail méně výměn."

msgid "Anonymisation"
msgstr "Anonymizace"

msgid "Anonymise entries after"
msgstr "Anonymizovat záznamy po"

msgid "Anonymised"
msgstr "Anonymizováno"

msgid "Any format"
msgstr "Libovolný formát"

msgid "Any status"
msgstr "Libovolný stav"

msgid "Apply"
msgstr "Použít"

msgid "Ask the recipient for a working address."
msgstr "Požádejte příjemce o funkční adresu."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "Požádejte hostitele o povolení rozšíření openssl (nebo ho povolte v nastavení PHP v panelu hostingu)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "Požádejte hostitele o aktualizaci certifikátů CA a OpenSSL na serveru."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "Zeptejte se hostitele, zda nejsou blokována odchozí připojení SMTP."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "Zeptejte se hostitele, zda jsou odchozí připojení na tento port povolena (firewall)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "Alespoň %1$s neúspěšných e-mailů během %2$s minut"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "Nejvýše jedno upozornění daného druhu v této době, i když problém trvá."

msgid "Attachments"
msgstr "Přílohy"

msgid "Attachments no longer available: %s"
msgstr "Přílohy již nejsou k dispozici: %s"

msgid "Authentication"
msgstr "Ověřování"

msgid "Automatic TLS"
msgstr "Automatické TLS"

msgid "Average per day"
msgstr "Průměr za den"

msgid "Back to the email types"
msgstr "Zpět na typy e-mailů"

msgid "Belongs to"
msgstr "Patří k"

msgid "Block again"
msgstr "Znovu blokovat"

msgid "Blocked as spam or by a blocklist"
msgstr "Zablokováno jako spam nebo blocklistem"

msgid "Bounced (permanent)"
msgstr "Nedoručitelné (trvale)"

msgid "Bounced (temporary)"
msgstr "Nedoručitelné (dočasně)"

msgid "Broken characters (encoding): %1$s"
msgstr "Poškozené znaky (kódování): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "Hromadný e-mail bez hlavičky pro odhlášení (příjemců: %1$s)"

msgid "Bundle into one daily email"
msgstr "Shromažďovat do jednoho denního e-mailu"

msgid "Bundled into one daily email"
msgstr "Shromažďováno do jednoho denního e-mailu"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "Shromažďování je vypnuté. Čekající e-maily právě odešly v jednom souhrnu."

msgid "Busiest day"
msgstr "Nejrušnější den"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "Zrušit"

msgid "Careful: emails to this address failed several times before."
msgstr "Pozor: e-maily na tuto adresu už několikrát selhaly."

msgid "Change in the email types"
msgstr "Změnit v typech e-mailů"

msgid "Change staging mode"
msgstr "Změnit testovací režim"

msgid "Check"
msgstr "Zkontrolovat"

msgid "Check again"
msgstr "Zkontrolovat znovu"

msgid "Check emails"
msgstr "Zkontrolovat e-maily"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "Zkontrolujte hostitele a port; zkuste 587 (TLS) místo 465 (SSL) nebo naopak."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "Zkontrolujte hostitele, port, šifrování, uživatelské jméno a heslo ve svém pluginu SMTP a odešlete z něj testovací e-mail."

msgid "Check sender domains"
msgstr "Zkontrolovat domény odesílatele"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "Zkontrolujte, zda šifrování odpovídá portu: TLS pro 587, SSL pro 465."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "Zkontrolujte, zda klíč patří ke správnému regionu / účtu (např. koncový bod EU vs. US)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "Zkontrolujte hostitele a port SMTP: chybný port nebo blokované připojení často skončí vypršením časového limitu dříve, než zafunguje záložní řešení."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "Zkontrolujte záznamy SPF, DKIM a DMARC domény odesílatele nebo použijte adresu odesílatele v doméně, ze které odesíláte."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "Zkontrolujte, zda adresa neobsahuje překlep – nebo váš web e-mail nikdy neodeslal."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "Ověřte adresu u příjemce a opravte ji tam, kde je uložena (uživatelský profil, objednávka, záznam formuláře)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "Ověřte adresu u příjemce a opravte ji tam, kde je uložena."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "Zkontrolujte název hostitele a port: 587 se STARTTLS (TLS) nebo 465 se SSL. Port 25 většina hostitelů blokuje."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "Zkontrolujte limity a aktuální využití v účtu poštovní služby; v případě potřeby přejděte na vyšší tarif."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "Zkontrolujte adresy příjemců tohoto záznamu, zda neobsahují překlepy, mezery nebo chybějící části."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
msgstr "Zkontrolujte adresu odesílatele ve svém pluginu SMTP a filtr wp_mail_from."

msgid "Check the sending limits of your mail account and the notes of this email."
msgstr "Zkontrolujte limity odesílání svého poštovního účtu a poznámky k tomuto e-mailu."

msgid "Check the server IP on a blocklist checker and request delisting."
msgstr "Zkontrolujte IP adresu serveru v nástroji pro kontrolu blocklistů a požádejte o vyřazení."

msgid "Check the spelling of the placeholder in the template and whether the plugin supports it for this email type. Shortcodes are not processed in emails unless the sending plugin runs do_shortcode()."
msgstr "Zkontrolujte pravopis zástupného symbolu v šabloně a zda ho plugin pro tento typ e-mailu podporuje. Shortcody se v e-mailech nezpracovávají, pokud odesílající plugin nespouští do_shortcode()."

msgid "Checked %s."
msgstr "Zkontrolováno %s."

msgid "Checked just now"
msgstr "Zkontrolováno právě teď"

msgid "Checking DNS records …"
msgstr "Kontrola záznamů DNS …"

msgid "Checks the DNS records of the domains your site sends from: the default sender address and the most frequent senders in the log. Missing or weak records are the most common reason why emails land in spam. Only your server's own DNS resolver is used; results are kept for one hour."
msgstr "Kontroluje záznamy DNS domén, ze kterých váš web odesílá: výchozí adresu odesílatele a nejčastější odesílatele v protokolu. Chybějící nebo slabé záznamy jsou nejčastějším důvodem, proč e-maily končí ve spamu. Používá se pouze DNS resolver vašeho serveru; výsledky se uchovávají jednu hodinu."

msgid "Choose a range of at most %s days."
msgstr "Zvolte rozsah nejvýše %s dní."

msgid "Clear selection"
msgstr "Zrušit výběr"

msgid "Click a bar to open these emails in the log."
msgstr "Kliknutím na sloupec otevřete tyto e-maily v protokolu."

msgid "Close"
msgstr "Zavřít"

msgid "Close (Esc)"
msgstr "Zavřít (Esc)"

msgid "Colour scheme"
msgstr "Barevné schéma"

msgid "Command line"
msgstr "Příkazový řádek"

msgid "Compare"
msgstr "Porovnat"

msgid "Compare the sources of these entries. Check whether two plugins send the same notification, or whether a hook (e.g. order status change) fires more than once."
msgstr "Porovnejte zdroje těchto záznamů. Zkontrolujte, zda dva pluginy neposílají stejné oznámení nebo zda se hook (např. změna stavu objednávky) nespouští vícekrát."

msgid "Component"
msgstr "Komponenta"

msgid "Configure alerts"
msgstr "Nastavit upozornění"

msgid "Content anonymised after %1$s days, %2$s"
msgstr "Obsah anonymizován po %1$s dnech, %2$s"

msgid "Content change marked as seen."
msgstr "Změna obsahu označena jako zobrazená."

msgid "Content changed"
msgstr "Obsah změněn"

msgid "Content changed on %1$s, after the %2$s update."
msgstr "Obsah změněn %1$s, po aktualizaci %2$s."

msgid "Content changed on %s."
msgstr "Obsah změněn %s."

msgid "Content removed"
msgstr "Obsah odstraněn"

msgid "Content removed after %s days"
msgstr "Obsah odstraněn po %s dnech"

msgid "Content, headers and attachments were removed and the addresses masked by the anonymisation setting."
msgstr "Obsah, hlavičky a přílohy byly odstraněny a adresy zamaskovány nastavením anonymizace."

msgid "Copied"
msgstr "Zkopírováno"

msgid "Copied – paste it into your reply."
msgstr "Zkopírováno – vložte to do své odpovědi."

msgid "Copies a short sentence for answering the customer: when the email was sent to whom and whether it arrived – without technical details."
