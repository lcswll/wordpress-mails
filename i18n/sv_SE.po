msgstr "Telefonnummer"

msgid "Phone width (375 px). If you can scroll sideways, the email is wider than most phone screens."
msgstr "Telefonbredd (375 px). Om du kan skrolla i sidled är e-postmeddelandet bredare än de flesta telefonskärmar."

msgid "Plain text"
msgstr "Oformaterad text"

msgid "Please enter valid email addresses."
msgstr "Ange giltiga e-postadresser."

msgid "Plugin"
msgstr "Tillägg"

