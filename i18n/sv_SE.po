msgstr "WP-Cron har inte körts på %s (DISABLE_WP_CRON är satt – kontrollera serverns cron-jobb)."

msgid "WP-Cron has not run for %s – it only runs when the site gets visits, or it fails with an error."
msgstr "WP-Cron har inte körts på %s – den körs bara när webbplatsen får besök, eller så misslyckas den med ett fel."

msgid "WP-Cron runs normally."
msgstr "WP-Cron körs normalt."

msgid "Waiting for the daily digest – not sent on its own."
msgstr "Väntar på den dagliga sammanfattningen – skickas inte separat."

msgid "Waits %s s for the mail server"
msgstr "Väntar %s s på e-postservern"

msgid "Warnings"
msgstr "Varningar"

