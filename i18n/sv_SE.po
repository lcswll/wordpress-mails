msgstr "Ingen avsändaradress registrerad"

msgid "No trace is available for this entry. It was logged before the trace existed or by a version without it."
msgstr "Ingen spårning finns för den här posten. Den loggades innan spårningen fanns eller av en version utan den."

msgid "No unusual email failures"
msgstr "Inga ovanliga e-postfel"

msgid "No, on purpose. “%1$s” to %2$s was held %3$s and not sent. Reason: %4$s."
msgstr "Nej, avsiktligt. ”%1$s” till %2$s hölls kvar %3$s och skickades inte. Orsak: %4$s."

msgid "No. Every email that goes out regularly arrived on schedule."
msgstr "Nej. All e-post som skickas regelbundet har gått iväg enligt schemat."

msgid "No. “%1$s” to %2$s failed %3$s. Reason: %4$s."
msgstr "Nej. ”%1$s” till %2$s misslyckades %3$s. Orsak: %4$s."

msgid "No. “%1$s” to %2$s left your site %3$s, but %4$s reports that the receiving server rejected it."
msgstr "Nej. ”%1$s” till %2$s lämnade din webbplats %3$s, men %4$s rapporterar att den mottagande servern avvisade det."

msgid "None"
msgstr "Ingen"

msgid "Normally sent at least every %1$s days, now overdue by %2$s."
msgstr "Skickas normalt minst var %1$s:e dag, nu %2$s försenad."

msgid "Not all selectors could be checked in time."
msgstr "Alla selektorer kunde inte kontrolleras i tid."

msgid "Not recorded: another plugin had SMTP debugging switched on."
msgstr "Inte registrerat: ett annat tillägg hade SMTP-felsökning påslagen."

msgid "Not recorded: the SMTP transcript is switched off in the settings."
msgstr "Inte registrerat: SMTP-utskriften är avstängd i inställningarna."

