msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: sv_SE\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "”Ladda ner .eml” återskapar meddelandet från de loggade, maskerade uppgifterna (utan bilagor)."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (föregående vecka: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (schemalagt till %2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s e-posttyp har upphört: %2$s."
msgstr[1] "%1$s e-posttyper har upphört, t.ex. %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "%1$s e-posttyper från %2$s avsändare"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "%1$s e-postmeddelanden misslyckades under de senaste %2$s minuterna."

msgid "%1$s emails in %2$s days"
msgstr "%1$s e-postmeddelanden på %2$s dagar"

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "%1$s e-postmeddelanden de senaste 30 dagarna, %2$s misslyckades"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "%1$s e-postmeddelanden skickades inom en timme – långt fler än vanligt (tröskel: %2$s per timme). Ett kontaktformulär kan missbrukas eller webbplatsen kan vara komprometterad."

msgid "%1$s entries, %2$s"
msgstr "%1$s poster, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "%1$s importerade, %2$s dubbletter, %3$s för gamla"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "%1$s av %2$s studsade (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "%1$s av %2$s e-postmeddelanden under de senaste %3$s dagarna kunde inte skickas."

msgid "%1$s of %2$s entries processed …"
msgstr "%1$s av %2$s poster behandlade …"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s procentenheter mot %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "%1$s skickade sitt första e-postmeddelande den %2$s och har skrivit till %3$s olika externa adresser under de senaste 24 timmarna. Om du inte har installerat eller konfigurerat något som skickar sådan e-post, kontrollera webbplatsen: en ny avsändare kan vara ett tecken på en hackad webbplats."

msgid "%1$s sent, %2$s still held …"
msgstr "%1$s skickade, %2$s fortfarande kvarhållna …"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s mot %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · %2$s e-postmeddelanden samlade sedan den senaste sammanfattningen"

msgid "%1$s · as of %2$s"
msgstr "%1$s · per %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – felfrekvens %2$s %% (föregående vecka: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – rapporterat av %2$s, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (must-use-tillägg)"

msgid "%s (theme)"
msgstr "%s (tema)"

msgid "%s ago"
msgstr "för %s sedan"

msgid "%s days"
msgstr "%s dagar"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "%s e-postmeddelande misslyckades de senaste 7 dagarna."
msgstr[1] "%s e-postmeddelanden misslyckades de senaste 7 dagarna."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s e-postmeddelande väntar på ditt beslut."
msgstr[1] "%s e-postmeddelanden väntar på ditt beslut."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "%s e-postmeddelande hölls kvar och skickades inte de senaste 7 dagarna."
msgstr[1] "%s e-postmeddelanden hölls kvar och skickades inte de senaste 7 dagarna."

msgid "%s emails are held by the emergency brake."
msgstr "%s e-postmeddelanden hålls kvar av nödbromsen."

msgid "%s emails are waiting and have not been delivered."
msgstr "%s e-postmeddelanden väntar och har inte levererats."

msgid "%s entries"
msgstr "%s poster"

msgid "%s failed"
msgstr "%s misslyckades"

msgid "%s held emails discarded."
msgstr "%s kvarhållna e-postmeddelanden kasserade."

msgid "%s imported entries removed."
msgstr "%s importerade poster borttagna."

msgid "%s in 30 days"
msgstr "%s på 30 dagar"

msgid "%s marked as spam"
msgstr "%s markerade som skräppost"

msgid "%s more on the Email types page."
msgstr "%s till på sidan E-posttyper."

msgid "%s notes"
msgstr "%s anmärkningar"

msgid "%s of all emails"
msgstr "%s av all e-post"

msgid "%s of them in the last 24 hours."
msgstr "%s av dem under de senaste 24 timmarna."

msgid "%s s"
msgstr "%s s"

msgid "%s selected"
msgstr "%s markerade"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s sak behöver uppmärksamhet:"
msgstr[1] "%s saker behöver uppmärksamhet:"

msgid "%s to administrators in 30 days"
msgstr "%s till administratörer på 30 dagar"

msgid "%s unchanged lines"
msgstr "%s oförändrade rader"

msgid "(no subject)"
msgstr "(inget ämne)"

msgid "(no text content)"
msgstr "(inget textinnehåll)"

msgid "(the emails are no longer in the log)"
msgstr "(e-postmeddelandena finns inte längre i loggen)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "-all är striktare; ~all är vanligt och fungerar bra tillsammans med DMARC."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "0 behåller poster för alltid. Rensningen körs en gång om dagen."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "0 betyder ingen gräns. De äldsta posterna tas bort först."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "0 stänger av det. Tar bort innehåll, e-posthuvuden och bilagor från äldre poster och maskerar adresserna (a***@example.com). Datum, status, källa, format, storlek och anmärkningar sparas för statistiken. Körs med den dagliga rensningen, innan poster raderas – har alltså bara effekt om tiden är kortare än raderingstiden ovan."

msgid "12 months"
msgstr "12 månader"

msgid "30 days"
msgstr "30 dagar"

msgid "7 days"
msgstr "7 dagar"

msgid "90 days"
msgstr "90 dagar"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "En DKIM-selektor får bara innehålla bokstäver, siffror, punkter, bindestreck och understreck."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "Ett e-posttillägg som skickar via ett API tog över leveransen och rapporterade att sändningen misslyckades, utan att ange någon orsak."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "En publicerad nyckel bevisar inte att din e-post signeras med den – kontrollera DKIM-resultatet i e-posthuvudena för ett mottaget meddelande."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "En mottagare eller avsändaradressen är inte en giltig e-postadress, så PHPMailer vägrade skicka."

msgid "API key or private key in plain text: %1$s"
msgstr "API-nyckel eller privat nyckel i klartext: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "Cirka %1$s DNS-uppslag krävs för att utvärdera den här posten – fler än de tillåtna %2$s, så mottagare kan ignorera den (PermError). Ta bort oanvända include:-poster."

msgid "Access"
msgstr "Åtkomst"

msgid "Actions"
msgstr "Åtgärder"

msgid "Active: alerts on %s."
msgstr "Aktivt: aviseringar vid %s."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "Lägg till ett kort alt-attribut på varje bild i mallen, t.ex. alt=\"Logotyp Exempelbutik\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "Lägg till din e-postleverantörs include: (t.ex. include:_spf.google.com) om du skickar via en."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "Lägg till din e-postserver eller e-posttjänst i SPF-posten för avsändardomänen."

msgid "Added:"
msgstr "Tillagt:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "Adresser med minst %s hårda fel: den mottagande servern avvisade brevlådan, domänen har ingen e-postserver eller din e-postleverantör rapporterade en hård studs. Posterna upphör med loggens lagringstid."

msgid "Admin screen"
msgstr "Adminskärm"

msgid "Administrators"
msgstr "Administratörer"

msgid "Aggregate reports go to %s."
msgstr "Sammanställda rapporter går till %s."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "Avisering"

msgid "Alert and hold further emails"
msgstr "Avisera och håll kvar ytterligare e-post"

msgid "Alert only"
msgstr "Endast avisering"

msgid "Alert when an email type that is sent regularly stops"
msgstr "Avisera när en e-posttyp som skickas regelbundet upphör"

msgid "Alert when emails fail repeatedly"
msgstr "Avisera när e-post misslyckas upprepade gånger"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "Avisera när webbplatsen oväntat slutar skicka e-post"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "Aviseringar är aktiverade men saknar kanal: ange en e-postadress eller en webhook-URL."

msgid "Alerts are off."
msgstr "Aviseringar är avstängda."

msgid "All"
msgstr "Alla"

msgid "All email types look healthy."
msgstr "Alla e-posttyper ser bra ut."

msgid "All emails are redirected to test addresses."
msgstr "All e-post omdirigeras till testadresser."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "All e-post går till testadresser i stället för till de riktiga mottagarna."

msgid "All sources"
msgstr "Alla källor"

msgid "Allow again"
msgstr "Tillåt igen"

msgid "Allowed again."
msgstr "Tillåten igen."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "Aviserar också en gång när ett tillägg eller tema som aldrig tidigare skickat e-post skriver till många olika externa adresser inom ett dygn – ett möjligt tecken på en hackad webbplats. De första två veckorna efter att Mailspur installerats utgör baslinjen."

msgid "Also remove the subject when anonymising"
msgstr "Ta även bort ämnesraden vid anonymisering"

msgid "Also search content"
msgstr "Sök även i innehåll"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "Be annars ditt webbhotell att aktivera mail() / sendmail för den här webbplatsen."

msgid "Always load remote images and fonts in the preview"
msgstr "Läs alltid in externa bilder och typsnitt i förhandsgranskningen"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (via SNS)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "En e-postleverantör med ett HTTP-API i stället för SMTP behöver färre rundturer per e-postmeddelande."

msgid "Anonymisation"
msgstr "Anonymisering"

msgid "Anonymise entries after"
msgstr "Anonymisera poster efter"

msgid "Anonymised"
msgstr "Anonymiserad"

msgid "Any format"
msgstr "Alla format"

msgid "Any status"
msgstr "Alla statusar"

msgid "Apply"
msgstr "Verkställ"

msgid "Ask the recipient for a working address."
msgstr "Be mottagaren om en fungerande adress."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "Be ditt webbhotell att aktivera tillägget openssl (eller aktivera det i PHP-inställningarna i din kontrollpanel)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "Be ditt webbhotell att uppdatera serverns CA-certifikat och OpenSSL."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "Fråga ditt webbhotell om utgående SMTP-anslutningar är blockerade."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "Fråga ditt webbhotell om utgående anslutningar till den porten är tillåtna (brandvägg)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "Minst %1$s misslyckade e-postmeddelanden inom %2$s minuter"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "Högst en avisering per typ inom denna tid, även om problemet kvarstår."

msgid "Attachments"
msgstr "Bilagor"

msgid "Attachments no longer available: %s"
msgstr "Bilagor finns inte längre: %s"

msgid "Authentication"
msgstr "Autentisering"

msgid "Automatic TLS"
msgstr "Automatisk TLS"

msgid "Average per day"
msgstr "Genomsnitt per dag"

msgid "Back to the email types"
msgstr "Tillbaka till e-posttyperna"

msgid "Belongs to"
msgstr "Hör till"

msgid "Block again"
msgstr "Blockera igen"

msgid "Blocked as spam or by a blocklist"
msgstr "Blockerad som skräppost eller av en spärrlista"

msgid "Bounced (permanent)"
msgstr "Studsad (permanent)"

msgid "Bounced (temporary)"
msgstr "Studsad (tillfälligt)"

msgid "Broken characters (encoding): %1$s"
msgstr "Trasiga tecken (kodning): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "Massutskick utan avregistreringshuvud (%1$s mottagare)"

msgid "Bundle into one daily email"
msgstr "Samla i ett dagligt e-postmeddelande"

msgid "Bundled into one daily email"
msgstr "Samlad i ett dagligt e-postmeddelande"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "Samlingen är avstängd. E-post som väntade har nu skickats i en sammanfattning."

msgid "Busiest day"
msgstr "Mest aktiva dag"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "Avbryt"

msgid "Careful: emails to this address failed several times before."
msgstr "Obs! E-post till den här adressen har misslyckats flera gånger tidigare."

msgid "Change in the email types"
msgstr "Ändring i e-posttyperna"

msgid "Change staging mode"
msgstr "Ändra staging-läge"

msgid "Check"
msgstr "Kontrollera"

msgid "Check again"
msgstr "Kontrollera igen"

msgid "Check emails"
msgstr "Kontrollera e-post"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "Kontrollera värd och port; prova 587 (TLS) i stället för 465 (SSL) eller tvärtom."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "Kontrollera värd, port, kryptering, användarnamn och lösenord i ditt SMTP-tillägg och skicka ett testmeddelande därifrån."

msgid "Check sender domains"
msgstr "Kontrollera avsändardomäner"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "Kontrollera att krypteringen matchar porten: TLS för 587, SSL för 465."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "Kontrollera att nyckeln hör till rätt region / konto (t.ex. EU- kontra US-slutpunkt)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "Kontrollera SMTP-värden och porten: en felaktig port eller en blockerad anslutning slutar ofta i en tidsgräns innan en reservlösning fungerar."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "Kontrollera SPF-, DKIM- och DMARC-posterna för avsändardomänen, eller använd en avsändaradress på den domän du skickar från."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "Kontrollera adressen efter stavfel – eller så skickades e-postmeddelandet aldrig av din webbplats."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "Kontrollera adressen med mottagaren och rätta den där den är sparad (användarprofil, beställning, formulärpost)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "Kontrollera adressen med mottagaren och rätta den där den är sparad."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "Kontrollera värdnamn och port: 587 med STARTTLS (TLS) eller 465 med SSL. Port 25 blockeras av de flesta webbhotell."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "Kontrollera gränserna och aktuell användning i ditt konto hos e-posttjänsten; uppgradera planen vid behov."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "Kontrollera mottagaradresserna i den här posten efter stavfel, mellanslag eller saknade delar."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
msgstr "Kontrollera avsändaradressen i ditt SMTP-tillägg och filtret wp_mail_from."

msgid "Check the sending limits of your mail account and the notes of this email."
msgstr "Kontrollera sändningsgränserna för ditt e-postkonto och anmärkningarna för det här e-postmeddelandet."

msgid "Check the server IP on a blocklist checker and request delisting."
msgstr "Kontrollera serverns IP-adress i en spärrlistekontroll och begär avlistning."

msgid "Check the spelling of the placeholder in the template and whether the plugin supports it for this email type. Shortcodes are not processed in emails unless the sending plugin runs do_shortcode()."
msgstr "Kontrollera stavningen av platshållaren i mallen och om tillägget stöder den för den här e-posttypen. Kortkoder bearbetas inte i e-post om inte det sändande tillägget kör do_shortcode()."

msgid "Checked %s."
msgstr "Kontrollerad %s."

msgid "Checked just now"
msgstr "Kontrollerad nyss"

msgid "Checking DNS records …"
msgstr "Kontrollerar DNS-poster …"

msgid "Checks the DNS records of the domains your site sends from: the default sender address and the most frequent senders in the log. Missing or weak records are the most common reason why emails land in spam. Only your server's own DNS resolver is used; results are kept for one hour."
msgstr "Kontrollerar DNS-posterna för de domäner din webbplats skickar från: standardavsändaradressen och de vanligaste avsändarna i loggen. Saknade eller svaga poster är den vanligaste orsaken till att e-post hamnar i skräpposten. Endast serverns egen DNS-resolver används; resultaten sparas i en timme."

msgid "Choose a range of at most %s days."
msgstr "Välj ett intervall på högst %s dagar."

msgid "Clear selection"
msgstr "Rensa markering"

msgid "Click a bar to open these emails in the log."
msgstr "Klicka på en stapel för att öppna denna e-post i loggen."

msgid "Close"
msgstr "Stäng"

msgid "Close (Esc)"
msgstr "Stäng (Esc)"

msgid "Colour scheme"
msgstr "Färgschema"

msgid "Command line"
msgstr "Kommandorad"

msgid "Compare"
msgstr "Jämför"

msgid "Compare the sources of these entries. Check whether two plugins send the same notification, or whether a hook (e.g. order status change) fires more than once."
msgstr "Jämför källorna för dessa poster. Kontrollera om två tillägg skickar samma avisering, eller om en hook (t.ex. ändrad orderstatus) körs mer än en gång."

msgid "Component"
msgstr "Komponent"

msgid "Configure alerts"
msgstr "Konfigurera aviseringar"

msgid "Content anonymised after %1$s days, %2$s"
msgstr "Innehåll anonymiserat efter %1$s dagar, %2$s"

msgid "Content change marked as seen."
msgstr "Innehållsändringen markerad som sedd."

msgid "Content changed"
msgstr "Innehållet har ändrats"

msgid "Content changed on %1$s, after the %2$s update."
msgstr "Innehållet ändrades den %1$s, efter uppdateringen av %2$s."

msgid "Content changed on %s."
msgstr "Innehållet ändrades den %s."

msgid "Content removed"
msgstr "Innehåll borttaget"

msgid "Content removed after %s days"
msgstr "Innehåll borttaget efter %s dagar"

msgid "Content, headers and attachments were removed and the addresses masked by the anonymisation setting."
msgstr "Innehåll, e-posthuvuden och bilagor har tagits bort och adresserna maskerats av inställningen för anonymisering."

msgid "Copied"
msgstr "Kopierat"

msgid "Copied – paste it into your reply."
msgstr "Kopierat – klistra in det i ditt svar."

msgid "Copies a short sentence for answering the customer: when the email was sent to whom and whether it arrived – without technical details."
msgstr "Kopierar en kort mening för att svara kunden: när e-postmeddelandet skickades till vem och om det kom fram – utan tekniska detaljer."

msgid "Copies the existing log of another mail logging plugin into Mailspur, so old emails can be searched and previewed here. The other plugin and its data stay untouched; running the import again only adds new entries."
msgstr "Kopierar den befintliga loggen från ett annat tillägg för e-postloggning till Mailspur, så att gammal e-post kan sökas och förhandsgranskas här. Det andra tillägget och dess data lämnas orörda; om du kör importen igen läggs bara nya poster till."

msgid "Copy"
msgstr "Kopiera"

msgid "Copy for support"
msgstr "Kopiera för support"

msgid "Copying is not possible in this browser. Select the text and copy it:"
msgstr "Kopiering är inte möjlig i den här webbläsaren. Markera texten och kopiera den:"

msgid "Correct the address (e.g. in the user profile or order) and consider an email validation in your forms."
msgstr "Rätta adressen (t.ex. i användarprofilen eller beställningen) och överväg e-postvalidering i dina formulär."

msgid "Counted once per email."
msgstr "Räknas en gång per e-postmeddelande."

msgid "Create a new API key with send permission at your mail service and enter it in the mailer plugin."
msgstr "Skapa en ny API-nyckel med sändningsbehörighet hos din e-posttjänst och ange den i e-posttillägget."

msgid "Create a new webhook URL? The current URL stops working at once – paste the new URL into the webhook settings of your email provider."
msgstr "Skapa en ny webhook-URL? Den nuvarande URL:en slutar fungera direkt – klistra in den nya URL:en i webhook-inställningarna hos din e-postleverantör."

msgid "Create new URL"
msgstr "Skapa ny URL"

msgid "Current page"
msgstr "Aktuell sida"

msgid "Current record"
msgstr "Aktuell post"

msgid "Current size"
msgstr "Aktuell storlek"

msgid "Custom"
msgstr "Anpassat"

msgid "DKIM key found (selector: %s)."
msgstr "DKIM-nyckel hittad (selektor: %s)."

msgid "DMARC record found with p=none: reports only, spoofed mail is still delivered."
msgstr "DMARC-post hittad med p=none: endast rapporter, förfalskad e-post levereras fortfarande."

msgid "DMARC record found with policy p=%s."
msgstr "DMARC-post hittad med policy p=%s."

msgid "DMARC record has no valid policy (p=none, quarantine or reject)."
msgstr "DMARC-posten har ingen giltig policy (p=none, quarantine eller reject)."

msgid "DNS lookup failed or timed out. Try again later."
msgstr "DNS-uppslaget misslyckades eller tog för lång tid. Försök igen senare."

msgid "DNS lookups are not available on this server (dns_get_record() is disabled), so the sender check cannot run here."
msgstr "DNS-uppslag är inte tillgängliga på den här servern (dns_get_record() är inaktiverad), så avsändarkontrollen kan inte köras här."

msgid "DNS lookups needed: about %1$s of %2$s allowed."
