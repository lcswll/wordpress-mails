msgstr "Ingen logg från detta tillägg hittades på den här webbplatsen."

msgid "No problem recipients."
msgstr "Inga problemmottagare."

msgid "No problems found in this email."
msgstr "Inga problem hittades i det här e-postmeddelandet."

msgid "No public sender domain found (the site address is not a domain name and the log has no senders yet)."
msgstr "Ingen offentlig avsändardomän hittades (webbplatsens adress är inget domännamn och loggen har inga avsändare ännu)."

