msgid "Close"
msgstr "ปิด"

msgid "Close (Esc)"
msgstr "ปิด (Esc)"

msgid "Colour scheme"
msgstr "ชุดสี"

msgid "Command line"
msgstr "บรรทัดคำสั่ง"

msgid "Compare"
msgstr "เปรียบเทียบ"

