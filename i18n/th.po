msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: th\n"
"Plural-Forms: nplurals=1; plural=0;\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "\"ดาวน์โหลด .eml\" จะสร้างข้อความขึ้นใหม่จากข้อมูลที่บันทึกไว้และปกปิดแล้ว (ไม่รวมไฟล์แนบ)"

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (สัปดาห์ก่อน: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (กำหนดไว้ %2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "ประเภทอีเมล %1$s ประเภทหยุดส่งแล้ว เช่น %2$s"

msgid "%1$s email types from %2$s senders"
msgstr "ประเภทอีเมล %1$s ประเภทจากผู้ส่ง %2$s ราย"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "อีเมล %1$s ฉบับส่งไม่สำเร็จภายใน %2$s นาทีที่ผ่านมา"

msgid "%1$s emails in %2$s days"
msgstr "อีเมล %1$s ฉบับใน %2$s วัน"

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "อีเมล %1$s ฉบับใน 30 วันที่ผ่านมา ส่งไม่สำเร็จ %2$s ฉบับ"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "มีการส่งอีเมล %1$s ฉบับภายในหนึ่งชั่วโมง – มากกว่าปกติมาก (เกณฑ์: %2$s ต่อชั่วโมง) แบบฟอร์มติดต่ออาจถูกใช้ในทางที่ผิด หรือเว็บไซต์อาจถูกเจาะระบบ"

msgid "%1$s entries, %2$s"
msgstr "%1$s รายการ, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "นำเข้า %1$s, ซ้ำ %2$s, เก่าเกินไป %3$s"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "ตีกลับ %1$s จาก %2$s (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "อีเมล %1$s จาก %2$s ฉบับใน %3$s วันที่ผ่านมาส่งไม่สำเร็จ"

msgid "%1$s of %2$s entries processed …"
msgstr "ประมวลผลแล้ว %1$s จาก %2$s รายการ …"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s จุดเปอร์เซ็นต์ เทียบกับ %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "%1$s ส่งอีเมลฉบับแรกเมื่อ %2$s และส่งไปยังที่อยู่ภายนอกที่แตกต่างกัน %3$s ที่อยู่ภายใน 24 ชั่วโมงที่ผ่านมา หากคุณไม่ได้ติดตั้งหรือตั้งค่าสิ่งใดที่ส่งอีเมลลักษณะนี้ ให้ตรวจสอบเว็บไซต์: ผู้ส่งรายใหม่อาจเป็นสัญญาณว่าเว็บไซต์ถูกแฮ็ก"

msgid "%1$s sent, %2$s still held …"
msgstr "ส่งแล้ว %1$s, ยังระงับไว้ %2$s …"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s เทียบกับ %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · รวมอีเมล %2$s ฉบับตั้งแต่อีเมลสรุปครั้งล่าสุด"

msgid "%1$s · as of %2$s"
msgstr "%1$s · ณ วันที่ %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – อัตราการส่งไม่สำเร็จ %2$s %% (สัปดาห์ก่อน: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – รายงานโดย %2$s, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (ปลั๊กอิน must-use)"

msgid "%s (theme)"
msgstr "%s (ธีม)"

msgid "%s ago"
msgstr "%s ที่แล้ว"

msgid "%s days"
msgstr "%s วัน"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "มีอีเมล %s ฉบับที่ส่งไม่สำเร็จใน 7 วันที่ผ่านมา"

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "มีอีเมล %s ฉบับที่รอการตัดสินใจของคุณ"

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "มีอีเมล %s ฉบับที่ถูกระงับไว้และไม่ได้ส่งใน 7 วันที่ผ่านมา"

msgid "%s emails are held by the emergency brake."
msgstr "มีอีเมล %s ฉบับที่ถูกเบรกฉุกเฉินระงับไว้"

msgid "%s emails are waiting and have not been delivered."
msgstr "มีอีเมล %s ฉบับที่รออยู่และยังไม่ได้จัดส่ง"

msgid "%s entries"
msgstr "%s รายการ"

msgid "%s failed"
msgstr "ส่งไม่สำเร็จ %s"

msgid "%s held emails discarded."
msgstr "ทิ้งอีเมลที่ถูกระงับไว้ %s ฉบับแล้ว"

msgid "%s imported entries removed."
msgstr "ลบรายการที่นำเข้าแล้ว %s รายการ"

msgid "%s in 30 days"
msgstr "%s ใน 30 วัน"

msgid "%s marked as spam"
msgstr "ถูกทำเครื่องหมายเป็นสแปม %s"

msgid "%s more on the Email types page."
msgstr "อีก %s รายการในหน้าประเภทอีเมล"

msgid "%s notes"
msgstr "หมายเหตุ %s รายการ"

msgid "%s of all emails"
msgstr "%s ของอีเมลทั้งหมด"

msgid "%s of them in the last 24 hours."
msgstr "ในจำนวนนี้ %s ฉบับอยู่ใน 24 ชั่วโมงที่ผ่านมา"

msgid "%s s"
msgstr "%s วินาที"

msgid "%s selected"
msgstr "เลือกไว้ %s"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "มี %s เรื่องที่ต้องดูแล:"

msgid "%s to administrators in 30 days"
msgstr "%s ถึงผู้ดูแลระบบใน 30 วัน"

msgid "%s unchanged lines"
msgstr "%s บรรทัดที่ไม่เปลี่ยนแปลง"

msgid "(no subject)"
msgstr "(ไม่มีหัวเรื่อง)"

msgid "(no text content)"
msgstr "(ไม่มีเนื้อหาข้อความ)"

msgid "(the emails are no longer in the log)"
msgstr "(อีเมลไม่อยู่ในบันทึกแล้ว)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "-all เข้มงวดกว่า ส่วน ~all เป็นที่นิยมและใช้ได้ดีร่วมกับ DMARC"

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "0 คือเก็บรายการไว้ตลอดไป การล้างข้อมูลจะทำงานวันละครั้ง"

msgid "0 means no limit. The oldest entries are removed first."
msgstr "0 คือไม่จำกัด รายการที่เก่าที่สุดจะถูกลบก่อน"

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "0 คือปิดการทำงาน ลบเนื้อหา ส่วนหัว และไฟล์แนบของรายการเก่า และปกปิดที่อยู่อีเมล (a***@example.com) วันที่ สถานะ แหล่งที่มา รูปแบบ ขนาด และหมายเหตุยังคงเก็บไว้สำหรับสถิติ ทำงานพร้อมการล้างข้อมูลรายวันก่อนลบรายการ – จึงมีผลเฉพาะเมื่อระยะเวลานี้สั้นกว่าระยะเวลาการลบด้านบน"

msgid "12 months"
msgstr "12 เดือน"

msgid "30 days"
msgstr "30 วัน"

msgid "7 days"
msgstr "7 วัน"

msgid "90 days"
msgstr "90 วัน"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "ตัวเลือก DKIM (selector) ต้องมีเฉพาะตัวอักษร ตัวเลข จุด ขีดกลาง และขีดล่างเท่านั้น"

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "ปลั๊กอินส่งอีเมลที่ส่งผ่าน API รับหน้าที่จัดส่งแทนและรายงานว่าส่งไม่สำเร็จ โดยไม่ได้แจ้งสาเหตุ"

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "คีย์ที่เผยแพร่ไม่ได้พิสูจน์ว่าอีเมลของคุณถูกลงนามด้วยคีย์นั้น – ตรวจสอบผลลัพธ์ DKIM ในส่วนหัวของอีเมลที่ได้รับ"

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "ผู้รับหรือที่อยู่ผู้ส่งไม่ใช่ที่อยู่อีเมลที่ถูกต้อง PHPMailer จึงปฏิเสธการส่ง"

msgid "API key or private key in plain text: %1$s"
msgstr "คีย์ API หรือคีย์ส่วนตัวเป็นข้อความธรรมดา: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "ต้องใช้การค้นหา DNS ประมาณ %1$s ครั้งเพื่อประเมินระเบียนนี้ – มากกว่าที่อนุญาต %2$s ครั้ง ผู้รับจึงอาจละเว้นระเบียนนี้ (PermError) ลบรายการ include: ที่ไม่ได้ใช้ออก"

msgid "Access"
msgstr "การเข้าถึง"

msgid "Actions"
msgstr "การกระทำ"

msgid "Active: alerts on %s."
msgstr "ใช้งานอยู่: แจ้งเตือนเมื่อเกิด%s"

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "เพิ่มแอตทริบิวต์ alt สั้นๆ ให้กับทุกรูปภาพในเทมเพลต เช่น alt=\"Logo Example Shop\""

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "เพิ่ม include: ของผู้ให้บริการอีเมลของคุณ (เช่น include:_spf.google.com) หากคุณส่งอีเมลผ่านผู้ให้บริการ"

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "เพิ่มเซิร์ฟเวอร์อีเมลหรือบริการอีเมลของคุณลงในระเบียน SPF ของโดเมนผู้ส่ง"

msgid "Added:"
msgstr "เพิ่ม:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "ที่อยู่ที่ส่งไม่สำเร็จแบบถาวรอย่างน้อย %s ครั้ง: เซิร์ฟเวอร์ปลายทางปฏิเสธกล่องจดหมาย โดเมนไม่มีเซิร์ฟเวอร์อีเมล หรือผู้ให้บริการอีเมลของคุณรายงานการตีกลับแบบถาวร รายการจะหมดอายุตามระยะเวลาเก็บรักษาของบันทึก"

msgid "Admin screen"
msgstr "หน้าผู้ดูแล"

msgid "Administrators"
msgstr "ผู้ดูแลระบบ"

msgid "Aggregate reports go to %s."
msgstr "รายงานสรุปจะส่งไปที่ %s"

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "การแจ้งเตือน"

msgid "Alert and hold further emails"
msgstr "แจ้งเตือนและระงับอีเมลถัดไป"

msgid "Alert only"
msgstr "แจ้งเตือนเท่านั้น"

msgid "Alert when an email type that is sent regularly stops"
msgstr "แจ้งเตือนเมื่อประเภทอีเมลที่ส่งเป็นประจำหยุดส่ง"

msgid "Alert when emails fail repeatedly"
msgstr "แจ้งเตือนเมื่ออีเมลส่งไม่สำเร็จซ้ำๆ"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "แจ้งเตือนเมื่อเว็บไซต์หยุดส่งอีเมลโดยไม่คาดคิด"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "เปิดการแจ้งเตือนอยู่แต่ไม่มีช่องทาง: ป้อนที่อยู่อีเมลหรือ URL ของ webhook"

msgid "Alerts are off."
msgstr "การแจ้งเตือนปิดอยู่"

msgid "All"
msgstr "ทั้งหมด"

msgid "All email types look healthy."
msgstr "ประเภทอีเมลทั้งหมดดูปกติดี"

msgid "All emails are redirected to test addresses."
msgstr "อีเมลทั้งหมดถูกเปลี่ยนเส้นทางไปยังที่อยู่ทดสอบ"

msgid "All emails go to test addresses instead of the real recipients."
msgstr "อีเมลทั้งหมดจะส่งไปยังที่อยู่ทดสอบแทนผู้รับจริง"

msgid "All sources"
msgstr "ทุกแหล่งที่มา"

msgid "Allow again"
msgstr "อนุญาตอีกครั้ง"

msgid "Allowed again."
msgstr "อนุญาตอีกครั้งแล้ว"

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "แจ้งเตือนหนึ่งครั้งด้วยเมื่อปลั๊กอินหรือธีมที่ไม่เคยส่งอีเมลมาก่อนส่งไปยังที่อยู่ภายนอกที่แตกต่างกันจำนวนมากภายในหนึ่งวัน – ซึ่งอาจเป็นสัญญาณว่าเว็บไซต์ถูกแฮ็ก สองสัปดาห์แรกหลังติดตั้ง Mailspur จะใช้เป็นข้อมูลพื้นฐาน"

msgid "Also remove the subject when anonymising"
msgstr "ลบหัวเรื่องด้วยเมื่อทำให้เป็นข้อมูลนิรนาม"

msgid "Also search content"
msgstr "ค้นหาในเนื้อหาด้วย"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "หรือขอให้โฮสต์ของคุณเปิดใช้ mail() / sendmail สำหรับเว็บไซต์นี้"

msgid "Always load remote images and fonts in the preview"
msgstr "โหลดรูปภาพและฟอนต์ภายนอกในตัวอย่างเสมอ"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (ผ่าน SNS)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "ผู้ให้บริการอีเมลที่ใช้ HTTP API แทน SMTP ต้องติดต่อไปกลับน้อยกว่าต่ออีเมลหนึ่งฉบับ"

msgid "Anonymisation"
msgstr "การทำให้เป็นข้อมูลนิรนาม"

msgid "Anonymise entries after"
msgstr "ทำให้รายการเป็นข้อมูลนิรนามหลังจาก"

msgid "Anonymised"
msgstr "เป็นข้อมูลนิรนามแล้ว"

msgid "Any format"
msgstr "ทุกรูปแบบ"

msgid "Any status"
msgstr "ทุกสถานะ"

msgid "Apply"
msgstr "นำไปใช้"

msgid "Ask the recipient for a working address."
msgstr "ขอที่อยู่ที่ใช้งานได้จากผู้รับ"

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "ขอให้โฮสต์ของคุณเปิดใช้ส่วนขยาย openssl (หรือเปิดใช้ในการตั้งค่า PHP ของแผงควบคุมโฮสติ้ง)"

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "ขอให้โฮสต์ของคุณอัปเดตใบรับรอง CA และ OpenSSL ของเซิร์ฟเวอร์"

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "สอบถามโฮสต์ของคุณว่าการเชื่อมต่อ SMTP ขาออกถูกบล็อกหรือไม่"

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "สอบถามโฮสต์ของคุณว่าอนุญาตการเชื่อมต่อขาออกไปยังพอร์ตนั้นหรือไม่ (ไฟร์วอลล์)"

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "อีเมลที่ส่งไม่สำเร็จอย่างน้อย %1$s ฉบับภายใน %2$s นาที"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "แจ้งเตือนไม่เกินหนึ่งครั้งต่อประเภทในช่วงเวลานี้ แม้ปัญหายังคงอยู่"

msgid "Attachments"
msgstr "ไฟล์แนบ"

msgid "Attachments no longer available: %s"
msgstr "ไฟล์แนบไม่มีอยู่แล้ว: %s"

msgid "Authentication"
msgstr "การยืนยันตัวตน"

msgid "Automatic TLS"
msgstr "TLS อัตโนมัติ"

msgid "Average per day"
msgstr "เฉลี่ยต่อวัน"

msgid "Back to the email types"
msgstr "กลับไปที่ประเภทอีเมล"

msgid "Belongs to"
msgstr "เป็นของ"

msgid "Block again"
msgstr "บล็อกอีกครั้ง"

msgid "Blocked as spam or by a blocklist"
msgstr "ถูกบล็อกว่าเป็นสแปมหรือโดยรายการบล็อก"

msgid "Bounced (permanent)"
msgstr "ตีกลับ (ถาวร)"

msgid "Bounced (temporary)"
msgstr "ตีกลับ (ชั่วคราว)"

msgid "Broken characters (encoding): %1$s"
msgstr "อักขระเสีย (การเข้ารหัสอักขระ): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "อีเมลจำนวนมากที่ไม่มีส่วนหัวยกเลิกการรับ (ผู้รับ %1$s ราย)"

msgid "Bundle into one daily email"
msgstr "รวมเป็นอีเมลเดียวต่อวัน"

msgid "Bundled into one daily email"
msgstr "รวมเป็นอีเมลเดียวต่อวันแล้ว"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "ปิดการรวมอีเมลแล้ว อีเมลที่รออยู่ถูกส่งออกไปในอีเมลสรุปฉบับเดียวแล้ว"

msgid "Busiest day"
msgstr "วันที่มีอีเมลมากที่สุด"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "ยกเลิก"

msgid "Careful: emails to this address failed several times before."
msgstr "โปรดระวัง: อีเมลถึงที่อยู่นี้เคยส่งไม่สำเร็จมาแล้วหลายครั้ง"

msgid "Change in the email types"
msgstr "เปลี่ยนในประเภทอีเมล"

msgid "Change staging mode"
msgstr "เปลี่ยนโหมด Staging"

msgid "Check"
msgstr "ตรวจสอบ"

msgid "Check again"
msgstr "ตรวจสอบอีกครั้ง"

msgid "Check emails"
msgstr "ตรวจสอบอีเมล"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "ตรวจสอบโฮสต์และพอร์ต ลองใช้ 587 (TLS) แทน 465 (SSL) หรือกลับกัน"

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "ตรวจสอบโฮสต์ พอร์ต การเข้ารหัส ชื่อผู้ใช้ และรหัสผ่านในปลั๊กอิน SMTP ของคุณ แล้วส่งอีเมลทดสอบจากที่นั่น"

msgid "Check sender domains"
msgstr "ตรวจสอบโดเมนผู้ส่ง"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "ตรวจสอบว่าการเข้ารหัสตรงกับพอร์ต: TLS สำหรับ 587, SSL สำหรับ 465"

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "ตรวจสอบว่าคีย์เป็นของภูมิภาค / บัญชีที่ถูกต้อง (เช่น ปลายทาง EU หรือ US)"

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "ตรวจสอบโฮสต์และพอร์ต SMTP: พอร์ตที่ผิดหรือการเชื่อมต่อที่ถูกบล็อกมักจบลงด้วยการหมดเวลาก่อนที่ทางเลือกสำรองจะทำงาน"

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "ตรวจสอบระเบียน SPF, DKIM และ DMARC ของโดเมนผู้ส่ง หรือใช้ที่อยู่ผู้ส่งบนโดเมนที่คุณใช้ส่ง"

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "ตรวจสอบว่าที่อยู่พิมพ์ผิดหรือไม่ – หรือเว็บไซต์ของคุณอาจไม่เคยส่งอีเมลนี้เลย"

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "ตรวจสอบที่อยู่กับผู้รับ แล้วแก้ไขในจุดที่จัดเก็บไว้ (โปรไฟล์ผู้ใช้ คำสั่งซื้อ ข้อมูลในแบบฟอร์ม)"

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "ตรวจสอบที่อยู่กับผู้รับ แล้วแก้ไขในจุดที่จัดเก็บไว้"

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "ตรวจสอบชื่อโฮสต์และพอร์ต: 587 กับ STARTTLS (TLS) หรือ 465 กับ SSL โฮสต์ส่วนใหญ่บล็อกพอร์ต 25"

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "ตรวจสอบขีดจำกัดและการใช้งานปัจจุบันในบัญชีบริการอีเมลของคุณ อัปเกรดแพ็กเกจหากจำเป็น"

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "ตรวจสอบที่อยู่ผู้รับของรายการนี้ว่ามีการพิมพ์ผิด ช่องว่าง หรือส่วนที่ขาดหายหรือไม่"

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
msgstr "ตรวจสอบที่อยู่ผู้ส่งในปลั๊กอิน SMTP ของคุณและฟิลเตอร์ wp_mail_from"

msgid "Check the sending limits of your mail account and the notes of this email."
msgstr "ตรวจสอบขีดจำกัดการส่งของบัญชีอีเมลของคุณและหมายเหตุของอีเมลนี้"

msgid "Check the server IP on a blocklist checker and request delisting."
msgstr "ตรวจสอบ IP ของเซิร์ฟเวอร์ด้วยเครื่องมือตรวจสอบรายการบล็อก แล้วขอให้นำออกจากรายการ"

msgid "Check the spelling of the placeholder in the template and whether the plugin supports it for this email type. Shortcodes are not processed in emails unless the sending plugin runs do_shortcode()."
msgstr "ตรวจสอบการสะกดของตัวยึดตำแหน่งในเทมเพลต และตรวจสอบว่าปลั๊กอินรองรับตัวยึดตำแหน่งนั้นสำหรับประเภทอีเมลนี้หรือไม่ Shortcode จะไม่ถูกประมวลผลในอีเมล เว้นแต่ปลั๊กอินที่ส่งจะเรียกใช้ do_shortcode()"

msgid "Checked %s."
msgstr "ตรวจสอบเมื่อ %s"

msgid "Checked just now"
msgstr "ตรวจสอบเมื่อสักครู่"

msgid "Checking DNS records …"
msgstr "กำลังตรวจสอบระเบียน DNS …"

msgid "Checks the DNS records of the domains your site sends from: the default sender address and the most frequent senders in the log. Missing or weak records are the most common reason why emails land in spam. Only your server's own DNS resolver is used; results are kept for one hour."
msgstr "ตรวจสอบระเบียน DNS ของโดเมนที่เว็บไซต์ของคุณใช้ส่งอีเมล: ที่อยู่ผู้ส่งเริ่มต้นและผู้ส่งที่พบบ่อยที่สุดในบันทึก ระเบียนที่ขาดหายหรืออ่อนแอเป็นสาเหตุที่พบบ่อยที่สุดที่ทำให้อีเมลไปอยู่ในสแปม ใช้เฉพาะ DNS resolver ของเซิร์ฟเวอร์คุณเองเท่านั้น ผลลัพธ์จะเก็บไว้หนึ่งชั่วโมง"

msgid "Choose a range of at most %s days."
msgstr "เลือกช่วงเวลาไม่เกิน %s วัน"

msgid "Clear selection"
msgstr "ล้างการเลือก"

