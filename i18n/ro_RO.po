msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ro_RO\n"
"Plural-Forms: nplurals=3; plural=(n == 1) ? 0 : ((n == 0 || n % 100 >= 2 && n % 100 <= 19) ? 1 : 2);\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "„Descarcă .eml” reconstruiește mesajul din datele înregistrate și mascate (fără atașamente)."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (săptămâna anterioară: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (programat pentru %2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s tip de email nu se mai trimite: %2$s."
msgstr[1] "%1$s tipuri de email nu se mai trimit, de ex. %2$s."
msgstr[2] "%1$s de tipuri de email nu se mai trimit, de ex. %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "%1$s tipuri de email de la %2$s expeditori"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "%1$s emailuri au eșuat în ultimele %2$s minute."

msgid "%1$s emails in %2$s days"
msgstr "%1$s emailuri în %2$s zile"

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "%1$s emailuri în ultimele 30 de zile, %2$s eșuate"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "În decurs de o oră au fost trimise %1$s emailuri – mult mai multe decât de obicei (prag: %2$s pe oră). Un formular de contact poate fi folosit abuziv sau site-ul poate fi compromis."

msgid "%1$s entries, %2$s"
msgstr "%1$s intrări, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "%1$s importate, %2$s duplicate, %3$s prea vechi"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "%1$s din %2$s respinse (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "%1$s din %2$s emailuri din ultimele %3$s zile nu au putut fi trimise."

msgid "%1$s of %2$s entries processed …"
msgstr "%1$s din %2$s intrări procesate …"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s pp față de %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "%1$s a trimis primul email pe %2$s și a scris către %3$s adrese externe diferite în ultimele 24 de ore. Dacă nu ai instalat sau configurat nimic care trimite astfel de emailuri, verifică site-ul: un expeditor nou poate fi semnul unui site spart."

msgid "%1$s sent, %2$s still held …"
msgstr "%1$s trimise, %2$s încă reținute …"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s față de %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · %2$s emailuri adunate de la ultimul rezumat"

msgid "%1$s · as of %2$s"
msgstr "%1$s · la data de %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – rata de eșec %2$s %% (săptămâna anterioară: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – raportat de %2$s, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (modul must-use)"

msgid "%s (theme)"
msgstr "%s (temă)"

msgid "%s ago"
msgstr "acum %s"

msgid "%s days"
msgstr "%s zile"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "%s email a eșuat în ultimele 7 zile."
msgstr[1] "%s emailuri au eșuat în ultimele 7 zile."
msgstr[2] "%s de emailuri au eșuat în ultimele 7 zile."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s email așteaptă decizia ta."
msgstr[1] "%s emailuri așteaptă decizia ta."
msgstr[2] "%s de emailuri așteaptă decizia ta."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "%s email a fost reținut și netrimis în ultimele 7 zile."
msgstr[1] "%s emailuri au fost reținute și netrimise în ultimele 7 zile."
msgstr[2] "%s de emailuri au fost reținute și netrimise în ultimele 7 zile."

msgid "%s emails are held by the emergency brake."
msgstr "Emailuri reținute de frâna de urgență: %s."

msgid "%s emails are waiting and have not been delivered."
msgstr "Emailuri în așteptare, nelivrate: %s."

msgid "%s entries"
msgstr "%s intrări"

msgid "%s failed"
msgstr "%s eșuate"

msgid "%s held emails discarded."
msgstr "Emailuri reținute eliminate: %s."

msgid "%s imported entries removed."
msgstr "%s intrări importate au fost eliminate."

msgid "%s in 30 days"
msgstr "%s în 30 de zile"

msgid "%s marked as spam"
msgstr "%s marcate ca spam"

msgid "%s more on the Email types page."
msgstr "Încă %s pe pagina Tipuri de email."

msgid "%s notes"
msgstr "Note: %s"

msgid "%s of all emails"
msgstr "%s din toate emailurile"

msgid "%s of them in the last 24 hours."
msgstr "Dintre acestea, %s în ultimele 24 de ore."

msgid "%s s"
msgstr "%s s"

msgid "%s selected"
msgstr "%s selectate"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s lucru necesită atenție:"
msgstr[1] "%s lucruri necesită atenție:"
msgstr[2] "%s de lucruri necesită atenție:"

msgid "%s to administrators in 30 days"
msgstr "%s către administratori în 30 de zile"

msgid "%s unchanged lines"
msgstr "%s rânduri neschimbate"

msgid "(no subject)"
msgstr "(fără subiect)"

msgid "(no text content)"
msgstr "(fără conținut text)"

msgid "(the emails are no longer in the log)"
msgstr "(emailurile nu mai sunt în jurnal)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "-all este mai strict; ~all este obișnuit și în regulă împreună cu DMARC."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "0 păstrează intrările pentru totdeauna. Curățarea rulează o dată pe zi."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "0 înseamnă fără limită. Cele mai vechi intrări sunt eliminate primele."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "0 o dezactivează. Elimină conținutul, antetele și atașamentele intrărilor mai vechi și maschează adresele (a***@example.com). Data, starea, sursa, formatul, dimensiunea și notele rămân pentru statistici. Rulează odată cu curățarea zilnică, înainte ca intrările să fie șterse – deci are efect doar dacă este mai scurtă decât perioada de ștergere de mai sus."

msgid "12 months"
msgstr "12 luni"

msgid "30 days"
msgstr "30 de zile"

msgid "7 days"
msgstr "7 zile"

msgid "90 days"
msgstr "90 de zile"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "Un selector DKIM poate conține doar litere, cifre, puncte, cratime și liniuțe de subliniere."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "Un modul de trimitere care folosește un API a preluat livrarea și a raportat că trimiterea a eșuat, fără să transmită un motiv."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "O cheie publicată nu dovedește că emailurile tale sunt semnate cu ea – verifică rezultatul DKIM în antetele unui email primit."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "Un destinatar sau adresa expeditorului nu este o adresă de email validă, așa că PHPMailer a refuzat trimiterea."

msgid "API key or private key in plain text: %1$s"
msgstr "Cheie API sau cheie privată în text simplu: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "Pentru evaluarea acestei înregistrări sunt necesare aproximativ %1$s interogări DNS – mai mult decât cele %2$s permise, așa că destinatarii o pot ignora (PermError). Elimină intrările include: nefolosite."

msgid "Access"
msgstr "Acces"

msgid "Actions"
msgstr "Acțiuni"

msgid "Active: alerts on %s."
msgstr "Activ: alerte la %s."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "Adaugă un atribut alt scurt fiecărei imagini din șablon, de ex. alt=\"Logo Magazin Exemplu\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "Adaugă include: al furnizorului tău de email (de ex. include:_spf.google.com) dacă trimiți prin el."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "Adaugă serverul tău de email sau serviciul de email în înregistrarea SPF a domeniului expeditorului."

msgid "Added:"
msgstr "Adăugat:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "Adrese cu cel puțin %s eșecuri permanente: serverul destinatarului a respins căsuța poștală, domeniul nu are server de email sau furnizorul tău de email a raportat un hard bounce. Intrările expiră odată cu perioada de păstrare a jurnalului."

msgid "Admin screen"
msgstr "Ecran de administrare"

msgid "Administrators"
msgstr "Administratori"

msgid "Aggregate reports go to %s."
msgstr "Rapoartele agregate merg la %s."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "Alertă"

msgid "Alert and hold further emails"
msgstr "Alertează și reține emailurile următoare"

msgid "Alert only"
msgstr "Doar alertă"

msgid "Alert when an email type that is sent regularly stops"
msgstr "Alertează când un tip de email trimis regulat nu se mai trimite"

msgid "Alert when emails fail repeatedly"
msgstr "Alertează când emailurile eșuează repetat"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "Alertează când site-ul nu mai trimite emailuri în mod neașteptat"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "Alertele sunt activate, dar nu au niciun canal: introdu o adresă de email sau un URL de webhook."

msgid "Alerts are off."
msgstr "Alertele sunt dezactivate."

msgid "All"
msgstr "Toate"

msgid "All email types look healthy."
msgstr "Toate tipurile de email arată în regulă."

msgid "All emails are redirected to test addresses."
msgstr "Toate emailurile sunt redirecționate către adrese de test."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "Toate emailurile merg la adrese de test în loc de destinatarii reali."

msgid "All sources"
msgstr "Toate sursele"

msgid "Allow again"
msgstr "Permite din nou"

msgid "Allowed again."
msgstr "Permis din nou."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "Alertează și o dată când un modul sau o temă care nu a trimis niciodată un email scrie într-o zi către multe adrese externe diferite – un posibil semn al unui site spart. Primele două săptămâni după instalarea Mailspur servesc drept referință."

msgid "Also remove the subject when anonymising"
msgstr "Elimină și subiectul la anonimizare"

msgid "Also search content"
msgstr "Caută și în conținut"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "Alternativ, cere furnizorului de găzduire să activeze mail() / sendmail pentru acest site."

msgid "Always load remote images and fonts in the preview"
msgstr "Încarcă întotdeauna imaginile și fonturile externe în previzualizare"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (prin SNS)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "Un furnizor de email cu API HTTP în loc de SMTP are nevoie de mai puține schimburi per email."

msgid "Anonymisation"
msgstr "Anonimizare"

msgid "Anonymise entries after"
msgstr "Anonimizează intrările după"

msgid "Anonymised"
msgstr "Anonimizat"

msgid "Any format"
msgstr "Orice format"

msgid "Any status"
msgstr "Orice stare"

msgid "Apply"
msgstr "Aplică"

msgid "Ask the recipient for a working address."
msgstr "Cere destinatarului o adresă funcțională."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "Cere furnizorului de găzduire să activeze extensia openssl (sau activeaz-o în setările PHP din panoul de găzduire)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "Cere furnizorului de găzduire să actualizeze certificatele CA și OpenSSL de pe server."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "Întreabă furnizorul de găzduire dacă conexiunile SMTP de ieșire sunt blocate."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "Întreabă furnizorul de găzduire dacă sunt permise conexiunile de ieșire către acel port (firewall)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "Cel puțin %1$s emailuri eșuate în %2$s minute"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "Cel mult o alertă de fiecare tip în acest interval, chiar dacă problema persistă."

msgid "Attachments"
msgstr "Atașamente"

msgid "Attachments no longer available: %s"
msgstr "Atașamente care nu mai sunt disponibile: %s"

msgid "Authentication"
msgstr "Autentificare"

msgid "Automatic TLS"
msgstr "TLS automat"

msgid "Average per day"
msgstr "Medie pe zi"

msgid "Back to the email types"
msgstr "Înapoi la tipurile de email"

msgid "Belongs to"
msgstr "Aparține de"

msgid "Block again"
msgstr "Blochează din nou"

msgid "Blocked as spam or by a blocklist"
msgstr "Blocat ca spam sau de o listă de blocare"

msgid "Bounced (permanent)"
msgstr "Respins (permanent)"

msgid "Bounced (temporary)"
msgstr "Respins (temporar)"

msgid "Broken characters (encoding): %1$s"
msgstr "Caractere stricate (codificare): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "Email în masă fără antet de dezabonare (%1$s destinatari)"

msgid "Bundle into one daily email"
msgstr "Adună într-un singur email zilnic"

msgid "Bundled into one daily email"
msgstr "Adunat într-un singur email zilnic"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "Adunarea este dezactivată. Emailurile care așteptau au plecat acum într-un singur rezumat."

msgid "Busiest day"
msgstr "Ziua cea mai aglomerată"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "Anulează"

msgid "Careful: emails to this address failed several times before."
msgstr "Atenție: emailurile către această adresă au eșuat de mai multe ori până acum."

msgid "Change in the email types"
msgstr "Modifică în tipurile de email"

msgid "Change staging mode"
msgstr "Modifică modul de test"

msgid "Check"
msgstr "Verifică"

msgid "Check again"
msgstr "Verifică din nou"

msgid "Check emails"
msgstr "Verifică emailurile"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "Verifică gazda și portul; încearcă 587 (TLS) în loc de 465 (SSL) sau invers."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "Verifică gazda, portul, criptarea, numele de utilizator și parola în modulul SMTP și trimite de acolo un email de test."

msgid "Check sender domains"
msgstr "Verifică domeniile expeditorului"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "Verifică dacă criptarea se potrivește cu portul: TLS pentru 587, SSL pentru 465."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "Verifică dacă cheia aparține regiunii / contului corect (de ex. endpoint UE vs. SUA)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "Verifică gazda și portul SMTP: un port greșit sau o conexiune blocată se termină adesea cu o depășire a timpului înainte ca o soluție de rezervă să funcționeze."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "Verifică înregistrările SPF, DKIM și DMARC ale domeniului expeditorului sau folosește o adresă de expeditor pe domeniul de pe care trimiți."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "Verifică adresa pentru greșeli de scriere – sau site-ul tău nu a trimis niciodată emailul."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "Verifică adresa cu destinatarul și corecteaz-o acolo unde este stocată (profil de utilizator, comandă, intrare de formular)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "Verifică adresa cu destinatarul și corecteaz-o acolo unde este stocată."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "Verifică numele gazdei și portul: 587 cu STARTTLS (TLS) sau 465 cu SSL. Portul 25 este blocat de majoritatea furnizorilor de găzduire."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "Verifică limitele și utilizarea curentă în contul serviciului de email; trece la un plan superior dacă e nevoie."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "Verifică adresele destinatarilor acestei intrări pentru greșeli de scriere, spații sau părți lipsă."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
msgstr "Verifică adresa expeditorului în modulul SMTP și filtrul wp_mail_from."

msgid "Check the sending limits of your mail account and the notes of this email."
msgstr "Verifică limitele de trimitere ale contului tău de email și notele acestui email."

msgid "Check the server IP on a blocklist checker and request delisting."
msgstr "Verifică IP-ul serverului cu un instrument de verificare a listelor de blocare și cere eliminarea din listă."

msgid "Check the spelling of the placeholder in the template and whether the plugin supports it for this email type. Shortcodes are not processed in emails unless the sending plugin runs do_shortcode()."
msgstr "Verifică ortografia substituentului din șablon și dacă modulul îl acceptă pentru acest tip de email. Shortcode-urile nu sunt procesate în emailuri decât dacă modulul care trimite rulează do_shortcode()."

msgid "Checked %s."
msgstr "Verificat %s."

msgid "Checked just now"
msgstr "Verificat chiar acum"

msgid "Checking DNS records …"
msgstr "Se verifică înregistrările DNS …"

msgid "Checks the DNS records of the domains your site sends from: the default sender address and the most frequent senders in the log. Missing or weak records are the most common reason why emails land in spam. Only your server's own DNS resolver is used; results are kept for one hour."
msgstr "Verifică înregistrările DNS ale domeniilor de pe care trimite site-ul tău: adresa implicită a expeditorului și cei mai frecvenți expeditori din jurnal. Înregistrările lipsă sau slabe sunt cel mai frecvent motiv pentru care emailurile ajung în spam. Se folosește doar resolverul DNS propriu al serverului tău; rezultatele sunt păstrate o oră."

msgid "Choose a range of at most %s days."
msgstr "Alege un interval de cel mult %s zile."

msgid "Clear selection"
msgstr "Golește selecția"

msgid "Click a bar to open these emails in the log."
msgstr "Dă clic pe o bară pentru a deschide aceste emailuri în jurnal."

msgid "Close"
msgstr "Închide"

msgid "Close (Esc)"
msgstr "Închide (Esc)"

msgid "Colour scheme"
msgstr "Schemă de culori"

msgid "Command line"
msgstr "Linie de comandă"

msgid "Compare"
msgstr "Compară"

msgid "Compare the sources of these entries. Check whether two plugins send the same notification, or whether a hook (e.g. order status change) fires more than once."
msgstr "Compară sursele acestor intrări. Verifică dacă două module trimit aceeași notificare sau dacă un hook (de ex. schimbarea stării comenzii) se declanșează de mai multe ori."

msgid "Component"
msgstr "Componentă"

msgid "Configure alerts"
msgstr "Configurează alertele"

msgid "Content anonymised after %1$s days, %2$s"
msgstr "Conținut anonimizat după %1$s zile, %2$s"

msgid "Content change marked as seen."
msgstr "Modificarea conținutului a fost marcată ca văzută."

msgid "Content changed"
msgstr "Conținut modificat"

msgid "Content changed on %1$s, after the %2$s update."
msgstr "Conținut modificat pe %1$s, după actualizarea %2$s."

msgid "Content changed on %s."
msgstr "Conținut modificat pe %s."

msgid "Content removed"
msgstr "Conținut eliminat"

msgid "Content removed after %s days"
msgstr "Conținut eliminat după %s zile"

msgid "Content, headers and attachments were removed and the addresses masked by the anonymisation setting."
msgstr "Conținutul, antetele și atașamentele au fost eliminate, iar adresele mascate de setarea de anonimizare."

msgid "Copied"
msgstr "Copiat"

msgid "Copied – paste it into your reply."
msgstr "Copiat – lipește-l în răspunsul tău."

msgid "Copies a short sentence for answering the customer: when the email was sent to whom and whether it arrived – without technical details."
msgstr "Copiază o propoziție scurtă pentru a-i răspunde clientului: când și cui a fost trimis emailul și dacă a ajuns – fără detalii tehnice."

msgid "Copies the existing log of another mail logging plugin into Mailspur, so old emails can be searched and previewed here. The other plugin and its data stay untouched; running the import again only adds new entries."
msgstr "Copiază jurnalul existent al altui modul de jurnalizare a emailurilor în Mailspur, astfel încât emailurile vechi să poată fi căutate și previzualizate aici. Celălalt modul și datele lui rămân neatinse; rularea din nou a importului adaugă doar intrările noi."

msgid "Copy"
msgstr "Copiază"

msgid "Copy for support"
msgstr "Copiază pentru suport"

msgid "Copying is not possible in this browser. Select the text and copy it:"
msgstr "Copierea nu este posibilă în acest browser. Selectează textul și copiază-l:"

msgid "Correct the address (e.g. in the user profile or order) and consider an email validation in your forms."
msgstr "Corectează adresa (de ex. în profilul utilizatorului sau în comandă) și ia în considerare o validare a emailului în formulare."

msgid "Counted once per email."
msgstr "Numărat o dată pe email."

msgid "Create a new API key with send permission at your mail service and enter it in the mailer plugin."
msgstr "Creează o nouă cheie API cu permisiune de trimitere la serviciul de email și introdu-o în modulul de trimitere."

msgid "Create a new webhook URL? The current URL stops working at once – paste the new URL into the webhook settings of your email provider."
msgstr "Creezi un URL nou pentru webhook? URL-ul actual nu mai funcționează imediat – lipește noul URL în setările de webhook ale furnizorului tău de email."

msgid "Create new URL"
msgstr "Creează un URL nou"

msgid "Current page"
msgstr "Pagina curentă"

msgid "Current record"
msgstr "Înregistrarea curentă"

msgid "Current size"
msgstr "Dimensiunea curentă"

msgid "Custom"
msgstr "Personalizat"

msgid "DKIM key found (selector: %s)."
msgstr "Cheie DKIM găsită (selector: %s)."

msgid "DMARC record found with p=none: reports only, spoofed mail is still delivered."
msgstr "Înregistrare DMARC găsită cu p=none: doar rapoarte, emailurile falsificate sunt încă livrate."

msgid "DMARC record found with policy p=%s."
msgstr "Înregistrare DMARC găsită cu politica p=%s."

