msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: pt_BR\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "\"Baixar .eml\" reconstrói a mensagem a partir dos dados registrados e ocultados (sem anexos)."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (semana anterior: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (agendado para %2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s tipo de e-mail parou: %2$s."
msgstr[1] "%1$s tipos de e-mail pararam, por exemplo, %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "%1$s tipos de e-mail de %2$s remetentes"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "%1$s e-mails falharam nos últimos %2$s minutos."

msgid "%1$s emails in %2$s days"
msgstr "%1$s e-mails em %2$s dias"

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "%1$s e-mails nos últimos 30 dias, %2$s com falha"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "%1$s e-mails foram enviados em uma hora – muito mais que o normal (limite: %2$s por hora). Um formulário de contato pode estar sendo usado de forma abusiva ou o site pode estar comprometido."

msgid "%1$s entries, %2$s"
msgstr "%1$s entradas, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "%1$s importadas, %2$s duplicadas, %3$s antigas demais"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "%1$s de %2$s devolvidos (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "%1$s de %2$s e-mails nos últimos %3$s dias não puderam ser enviados."

msgid "%1$s of %2$s entries processed …"
msgstr "%1$s de %2$s entradas processadas…"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s p.p. vs. %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "%1$s enviou seu primeiro e-mail em %2$s e escreveu para %3$s endereços externos diferentes nas últimas 24 horas. Se você não instalou nem configurou nada que envie esse tipo de e-mail, verifique o site: um novo remetente pode ser sinal de um site invadido."

msgid "%1$s sent, %2$s still held …"
msgstr "%1$s enviados, %2$s ainda retidos…"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s vs. %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · %2$s e-mails agrupados desde o último resumo"

msgid "%1$s · as of %2$s"
msgstr "%1$s · em %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – taxa de falhas %2$s %% (semana anterior: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – informado por %2$s, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (plugin obrigatório)"

msgid "%s (theme)"
msgstr "%s (tema)"

msgid "%s ago"
msgstr "há %s"

msgid "%s days"
msgstr "%s dias"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "%s e-mail falhou nos últimos 7 dias."
msgstr[1] "%s e-mails falharam nos últimos 7 dias."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s e-mail está aguardando sua decisão."
msgstr[1] "%s e-mails estão aguardando sua decisão."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "%s e-mail foi retido e não enviado nos últimos 7 dias."
msgstr[1] "%s e-mails foram retidos e não enviados nos últimos 7 dias."

msgid "%s emails are held by the emergency brake."
msgstr "%s e-mails estão retidos pelo freio de emergência."

msgid "%s emails are waiting and have not been delivered."
msgstr "%s e-mails estão aguardando e não foram entregues."

msgid "%s entries"
msgstr "%s entradas"

msgid "%s failed"
msgstr "%s com falha"

msgid "%s held emails discarded."
msgstr "%s e-mails retidos descartados."

msgid "%s imported entries removed."
msgstr "%s entradas importadas removidas."

msgid "%s in 30 days"
msgstr "%s em 30 dias"

msgid "%s marked as spam"
msgstr "%s marcados como spam"

msgid "%s more on the Email types page."
msgstr "Mais %s na página Tipos de e-mail."

msgid "%s notes"
msgstr "%s notas"

msgid "%s of all emails"
msgstr "%s de todos os e-mails"

msgid "%s of them in the last 24 hours."
msgstr "%s deles nas últimas 24 horas."

msgid "%s s"
msgstr "%s s"

msgid "%s selected"
msgstr "%s selecionadas"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s item precisa de atenção:"
msgstr[1] "%s itens precisam de atenção:"

msgid "%s to administrators in 30 days"
msgstr "%s para administradores em 30 dias"

msgid "%s unchanged lines"
msgstr "%s linhas inalteradas"

msgid "(no subject)"
msgstr "(sem assunto)"

msgid "(no text content)"
msgstr "(sem conteúdo de texto)"

msgid "(the emails are no longer in the log)"
msgstr "(os e-mails não estão mais no registro)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "-all é mais rigoroso; ~all é comum e adequado em conjunto com DMARC."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "0 mantém as entradas para sempre. A limpeza é executada uma vez por dia."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "0 significa sem limite. As entradas mais antigas são removidas primeiro."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "0 desativa. Remove o conteúdo, os cabeçalhos e os anexos das entradas mais antigas e mascara os endereços (a***@example.com). Data, status, origem, formato, tamanho e notas são mantidos para as estatísticas. É executado com a limpeza diária, antes de as entradas serem excluídas – portanto, só tem efeito se for menor que o período de exclusão acima."

msgid "12 months"
msgstr "12 meses"

msgid "30 days"
msgstr "30 dias"

msgid "7 days"
msgstr "7 dias"

msgid "90 days"
msgstr "90 dias"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "Um seletor DKIM só pode conter letras, dígitos, pontos, hifens e sublinhados."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "Um plugin de envio que usa uma API assumiu a entrega e informou que o envio falhou, sem indicar um motivo."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "Uma chave publicada não prova que seus e-mails são assinados com ela – verifique o resultado DKIM nos cabeçalhos de um e-mail recebido."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "Um destinatário ou o endereço do remetente não é um endereço de e-mail válido, por isso o PHPMailer se recusou a enviar."

msgid "API key or private key in plain text: %1$s"
msgstr "Chave de API ou chave privada em texto simples: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "São necessárias cerca de %1$s consultas DNS para avaliar este registro – mais que as %2$s permitidas, então os destinatários podem ignorá-lo (PermError). Remova as entradas include: não utilizadas."

msgid "Access"
msgstr "Acesso"

msgid "Actions"
msgstr "Ações"

msgid "Active: alerts on %s."
msgstr "Ativo: alertas sobre %s."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "Adicione um atributo alt curto a cada imagem do modelo, por exemplo, alt=\"Logo Loja Exemplo\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "Adicione o include: do seu provedor de e-mail (por exemplo, include:_spf.google.com) se você envia por meio de um."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "Adicione seu servidor ou serviço de e-mail ao registro SPF do domínio do remetente."

msgid "Added:"
msgstr "Adicionado:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "Endereços com pelo menos %s falhas permanentes: o servidor de destino rejeitou a caixa de correio, o domínio não tem servidor de e-mail ou seu provedor de e-mail informou um hard bounce. As entradas expiram com o período de retenção do registro."

msgid "Admin screen"
msgstr "Tela de administração"

msgid "Administrators"
msgstr "Administradores"

msgid "Aggregate reports go to %s."
msgstr "Os relatórios agregados vão para %s."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "Alerta"

msgid "Alert and hold further emails"
msgstr "Alertar e reter os próximos e-mails"

msgid "Alert only"
msgstr "Somente alertar"

msgid "Alert when an email type that is sent regularly stops"
msgstr "Alertar quando um tipo de e-mail enviado regularmente parar"

msgid "Alert when emails fail repeatedly"
msgstr "Alertar quando e-mails falharem repetidamente"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "Alertar quando o site parar de enviar e-mails inesperadamente"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "Os alertas estão ativados, mas não têm canal: digite um endereço de e-mail ou uma URL de webhook."

msgid "Alerts are off."
msgstr "Os alertas estão desativados."

msgid "All"
msgstr "Todos"

msgid "All email types look healthy."
msgstr "Todos os tipos de e-mail parecem saudáveis."

msgid "All emails are redirected to test addresses."
msgstr "Todos os e-mails são redirecionados para endereços de teste."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "Todos os e-mails vão para endereços de teste em vez dos destinatários reais."

msgid "All sources"
msgstr "Todas as origens"

msgid "Allow again"
msgstr "Permitir novamente"

msgid "Allowed again."
msgstr "Permitido novamente."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "Também alerta uma vez quando um plugin ou tema que nunca enviou um e-mail antes escreve para muitos endereços externos diferentes em um dia – um possível sinal de site invadido. As duas primeiras semanas após a instalação do Mailspur servem como referência."

msgid "Also remove the subject when anonymising"
msgstr "Remover também o assunto ao anonimizar"

msgid "Also search content"
msgstr "Pesquisar também no conteúdo"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "Como alternativa, peça à sua hospedagem para ativar mail() / sendmail para este site."

msgid "Always load remote images and fonts in the preview"
msgstr "Sempre carregar imagens e fontes remotas na pré-visualização"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (via SNS)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "Um provedor de e-mail com API HTTP em vez de SMTP precisa de menos idas e voltas por e-mail."

msgid "Anonymisation"
msgstr "Anonimização"

msgid "Anonymise entries after"
msgstr "Anonimizar entradas após"

msgid "Anonymised"
msgstr "Anonimizado"

msgid "Any format"
msgstr "Qualquer formato"

msgid "Any status"
msgstr "Qualquer status"

msgid "Apply"
msgstr "Aplicar"

msgid "Ask the recipient for a working address."
msgstr "Peça ao destinatário um endereço que funcione."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "Peça à sua hospedagem para ativar a extensão openssl (ou ative-a nas configurações de PHP do seu painel de hospedagem)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "Peça à sua hospedagem para atualizar os certificados de CA e o OpenSSL do servidor."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "Pergunte à sua hospedagem se as conexões SMTP de saída estão bloqueadas."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "Pergunte à sua hospedagem se as conexões de saída para essa porta são permitidas (firewall)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "Pelo menos %1$s e-mails com falha em %2$s minutos"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "No máximo um alerta por tipo nesse período, mesmo que o problema persista."

msgid "Attachments"
msgstr "Anexos"

msgid "Attachments no longer available: %s"
msgstr "Anexos não disponíveis mais: %s"

msgid "Authentication"
msgstr "Autenticação"

msgid "Automatic TLS"
msgstr "TLS automático"

msgid "Average per day"
msgstr "Média por dia"

msgid "Back to the email types"
msgstr "Voltar para os tipos de e-mail"

msgid "Belongs to"
msgstr "Pertence a"

msgid "Block again"
msgstr "Bloquear novamente"

msgid "Blocked as spam or by a blocklist"
msgstr "Bloqueado como spam ou por uma lista de bloqueio"

msgid "Bounced (permanent)"
msgstr "Devolvido (permanente)"

msgid "Bounced (temporary)"
msgstr "Devolvido (temporário)"

msgid "Broken characters (encoding): %1$s"
msgstr "Caracteres corrompidos (codificação): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "E-mail em massa sem cabeçalho de cancelamento de inscrição (%1$s destinatários)"

msgid "Bundle into one daily email"
msgstr "Agrupar em um e-mail diário"

msgid "Bundled into one daily email"
msgstr "Agrupado em um e-mail diário"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "O agrupamento está desativado. Os e-mails que estavam aguardando foram enviados agora em um resumo."

msgid "Busiest day"
msgstr "Dia mais movimentado"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "Cancelar"

msgid "Careful: emails to this address failed several times before."
msgstr "Atenção: e-mails para este endereço já falharam várias vezes antes."

msgid "Change in the email types"
msgstr "Mudança nos tipos de e-mail"

msgid "Change staging mode"
msgstr "Alterar modo de homologação"

msgid "Check"
msgstr "Verificar"

msgid "Check again"
msgstr "Verificar novamente"

msgid "Check emails"
msgstr "Verificar e-mails"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "Verifique o host e a porta; tente 587 (TLS) em vez de 465 (SSL) ou o contrário."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "Verifique host, porta, criptografia, nome de usuário e senha no seu plugin SMTP e envie um e-mail de teste a partir dele."

msgid "Check sender domains"
msgstr "Verificar domínios de remetente"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "Verifique se a criptografia corresponde à porta: TLS para 587, SSL para 465."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "Verifique se a chave pertence à região / conta correta (por exemplo, endpoint da UE vs. dos EUA)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "Verifique o host e a porta SMTP: uma porta errada ou uma conexão bloqueada muitas vezes termina em tempo esgotado antes que uma alternativa funcione."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "Verifique os registros SPF, DKIM e DMARC do domínio do remetente ou use um endereço de remetente no domínio a partir do qual você envia."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "Verifique se há erros de digitação no endereço – ou o e-mail nunca foi enviado pelo seu site."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "Confirme o endereço com o destinatário e corrija-o onde ele está armazenado (perfil do usuário, pedido, envio de formulário)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "Confirme o endereço com o destinatário e corrija-o onde ele está armazenado."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "Verifique o nome do host e a porta: 587 com STARTTLS (TLS) ou 465 com SSL. A porta 25 é bloqueada pela maioria das hospedagens."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "Verifique os limites e o uso atual na conta do seu serviço de e-mail; mude para um plano maior, se necessário."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "Verifique se os endereços de destinatário desta entrada têm erros de digitação, espaços ou partes faltando."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
msgstr "Verifique o endereço do remetente no seu plugin SMTP e o filtro wp_mail_from."

msgid "Check the sending limits of your mail account and the notes of this email."
msgstr "Verifique os limites de envio da sua conta de e-mail e as notas deste e-mail."

msgid "Check the server IP on a blocklist checker and request delisting."
msgstr "Verifique o IP do servidor em um verificador de listas de bloqueio e solicite a remoção."

msgid "Check the spelling of the placeholder in the template and whether the plugin supports it for this email type. Shortcodes are not processed in emails unless the sending plugin runs do_shortcode()."
msgstr "Verifique a grafia do marcador no modelo e se o plugin o suporta para este tipo de e-mail. Shortcodes não são processados em e-mails, a menos que o plugin que envia execute do_shortcode()."

msgid "Checked %s."
msgstr "Verificado %s."

msgid "Checked just now"
msgstr "Verificado agora mesmo"

msgid "Checking DNS records …"
msgstr "Verificando registros DNS…"

msgid "Checks the DNS records of the domains your site sends from: the default sender address and the most frequent senders in the log. Missing or weak records are the most common reason why emails land in spam. Only your server's own DNS resolver is used; results are kept for one hour."
msgstr "Verifica os registros DNS dos domínios dos quais seu site envia: o endereço de remetente padrão e os remetentes mais frequentes no registro. Registros ausentes ou fracos são o motivo mais comum para os e-mails caírem no spam. Somente o resolvedor DNS do seu próprio servidor é usado; os resultados são mantidos por uma hora."

msgid "Choose a range of at most %s days."
msgstr "Escolha um intervalo de no máximo %s dias."

msgid "Clear selection"
msgstr "Limpar seleção"

msgid "Click a bar to open these emails in the log."
msgstr "Clique em uma barra para abrir estes e-mails no registro."

msgid "Close"
msgstr "Fechar"

msgid "Close (Esc)"
msgstr "Fechar (Esc)"

msgid "Colour scheme"
msgstr "Esquema de cores"

msgid "Command line"
msgstr "Linha de comando"

msgid "Compare"
msgstr "Comparar"

msgid "Compare the sources of these entries. Check whether two plugins send the same notification, or whether a hook (e.g. order status change) fires more than once."
msgstr "Compare as origens destas entradas. Verifique se dois plugins enviam a mesma notificação ou se um hook (por exemplo, mudança de status do pedido) é disparado mais de uma vez."

msgid "Component"
msgstr "Componente"

msgid "Configure alerts"
msgstr "Configurar alertas"

msgid "Content anonymised after %1$s days, %2$s"
msgstr "Conteúdo anonimizado após %1$s dias, %2$s"

msgid "Content change marked as seen."
msgstr "Mudança de conteúdo marcada como vista."

msgid "Content changed"
msgstr "Conteúdo alterado"

msgid "Content changed on %1$s, after the %2$s update."
msgstr "Conteúdo alterado em %1$s, após a atualização de %2$s."

msgid "Content changed on %s."
msgstr "Conteúdo alterado em %s."

msgid "Content removed"
msgstr "Conteúdo removido"

msgid "Content removed after %s days"
msgstr "Conteúdo removido após %s dias"

msgid "Content, headers and attachments were removed and the addresses masked by the anonymisation setting."
msgstr "O conteúdo, os cabeçalhos e os anexos foram removidos e os endereços foram mascarados pela configuração de anonimização."

msgid "Copied"
msgstr "Copiado"

msgid "Copied – paste it into your reply."
msgstr "Copiado – cole na sua resposta."

msgid "Copies a short sentence for answering the customer: when the email was sent to whom and whether it arrived – without technical details."
msgstr "Copia uma frase curta para responder ao cliente: quando o e-mail foi enviado, para quem e se chegou – sem detalhes técnicos."

msgid "Copies the existing log of another mail logging plugin into Mailspur, so old emails can be searched and previewed here. The other plugin and its data stay untouched; running the import again only adds new entries."
msgstr "Copia o registro existente de outro plugin de registro de e-mails para o Mailspur, para que e-mails antigos possam ser pesquisados e pré-visualizados aqui. O outro plugin e seus dados não são alterados; executar a importação novamente só adiciona novas entradas."

msgid "Copy"
msgstr "Copiar"

msgid "Copy for support"
msgstr "Copiar para o suporte"

msgid "Copying is not possible in this browser. Select the text and copy it:"
msgstr "Não é possível copiar neste navegador. Selecione o texto e copie:"

msgid "Correct the address (e.g. in the user profile or order) and consider an email validation in your forms."
msgstr "Corrija o endereço (por exemplo, no perfil do usuário ou no pedido) e considere uma validação de e-mail nos seus formulários."

msgid "Counted once per email."
msgstr "Contado uma vez por e-mail."

msgid "Create a new API key with send permission at your mail service and enter it in the mailer plugin."
msgstr "Crie uma nova chave de API com permissão de envio no seu serviço de e-mail e insira-a no plugin de envio."

msgid "Create a new webhook URL? The current URL stops working at once – paste the new URL into the webhook settings of your email provider."
msgstr "Criar uma nova URL de webhook? A URL atual deixa de funcionar imediatamente – cole a nova URL nas configurações de webhook do seu provedor de e-mail."

msgid "Create new URL"
msgstr "Criar nova URL"

msgid "Current page"
msgstr "Página atual"

msgid "Current record"
msgstr "Registro atual"

msgid "Current size"
msgstr "Tamanho atual"

msgid "Custom"
msgstr "Personalizado"

msgid "DKIM key found (selector: %s)."
msgstr "Chave DKIM encontrada (seletor: %s)."

msgid "DMARC record found with p=none: reports only, spoofed mail is still delivered."
msgstr "Registro DMARC encontrado com p=none: só gera relatórios, e-mails falsificados ainda são entregues."

msgid "DMARC record found with policy p=%s."
msgstr "Registro DMARC encontrado com a política p=%s."

msgid "DMARC record has no valid policy (p=none, quarantine or reject)."
msgstr "O registro DMARC não tem uma política válida (p=none, quarantine ou reject)."

msgid "DNS lookup failed or timed out. Try again later."
msgstr "A consulta DNS falhou ou expirou. Tente novamente mais tarde."

msgid "DNS lookups are not available on this server (dns_get_record() is disabled), so the sender check cannot run here."
msgstr "Consultas DNS não estão disponíveis neste servidor (dns_get_record() está desativada), então a verificação do remetente não pode ser executada aqui."

msgid "DNS lookups needed: about %1$s of %2$s allowed."
msgstr "Consultas DNS necessárias: cerca de %1$s de %2$s permitidas."

msgid "Daily"
msgstr "Diariamente"

msgid "Daily digest"
msgstr "Resumo diário"

msgid "Dark"
msgstr "Escuro"

msgid "Date"
msgstr "Data"

msgid "Default (%s days)"
msgstr "Padrão (%s dias)"

msgid "Default (no time limit)"
msgstr "Padrão (sem limite de tempo)"

msgid "Default sender"
msgstr "Remetente padrão"

msgid "Delete"
msgstr "Excluir"

msgid "Delete %s selected log entries?"
msgstr "Excluir %s entradas selecionadas do registro?"

