msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: uk\n"
"Plural-Forms: nplurals=3; plural=(n % 10 == 1 && n % 100 != 11) ? 0 : ((n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14)) ? 1 : 2);\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "«Завантажити .eml» відтворює повідомлення із записаних, знеособлених даних (без вкладень)."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (попередній тиждень: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (заплановано на %2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s тип листа більше не надсилається: %2$s."
msgstr[1] "%1$s типи листів більше не надсилаються, напр. %2$s."
msgstr[2] "%1$s типів листів більше не надсилаються, напр. %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "Типів листів: %1$s, відправників: %2$s"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "За останні %2$s хв не вдалося надіслати листів: %1$s."

msgid "%1$s emails in %2$s days"
msgstr "Листів: %1$s за %2$s дн."

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "Листів за останні 30 днів: %1$s, невдалих: %2$s"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "Протягом однієї години надіслано листів: %1$s – набагато більше, ніж зазвичай (поріг: %2$s на годину). Можливо, хтось зловживає контактною формою або сайт зламано."

msgid "%1$s entries, %2$s"
msgstr "Записів: %1$s, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "імпортовано: %1$s, дублікатів: %2$s, застарілих: %3$s"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "%1$s з %2$s повернуто (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "За останні %3$s днів не вдалося надіслати %1$s із %2$s листів."

msgid "%1$s of %2$s entries processed …"
msgstr "Оброблено %1$s із %2$s записів …"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s в. п. порівняно з %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "%1$s надіслав свій перший лист %2$s і за останні 24 години написав на різні зовнішні адреси (кількість: %3$s). Якщо ви не встановлювали й не налаштовували нічого, що надсилає такі листи, перевірте сайт: новий відправник може бути ознакою зламу сайту."

msgid "%1$s sent, %2$s still held …"
msgstr "Надіслано: %1$s, ще затримано: %2$s …"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s порівняно з %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · листів, об’єднаних від останнього дайджесту: %2$s"

msgid "%1$s · as of %2$s"
msgstr "%1$s · станом на %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – частка збоїв %2$s %% (попередній тиждень: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – повідомлено %2$s, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (обов'язковий плагін)"

msgid "%s (theme)"
msgstr "%s (тема)"

msgid "%s ago"
msgstr "%s тому"

msgid "%s days"
msgstr "%s днів"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "За останні 7 днів не вдалося надіслати %s лист."
msgstr[1] "За останні 7 днів не вдалося надіслати %s листи."
msgstr[2] "За останні 7 днів не вдалося надіслати %s листів."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s лист очікує на ваше рішення."
msgstr[1] "%s листи очікують на ваше рішення."
msgstr[2] "%s листів очікують на ваше рішення."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "За останні 7 днів %s лист було затримано й не надіслано."
msgstr[1] "За останні 7 днів %s листи було затримано й не надіслано."
msgstr[2] "За останні 7 днів %s листів було затримано й не надіслано."

msgid "%s emails are held by the emergency brake."
msgstr "Аварійне гальмо затримує листів: %s."

msgid "%s emails are waiting and have not been delivered."
msgstr "%s листів очікують і не доставлені."

msgid "%s entries"
msgstr "Записів: %s"

msgid "%s failed"
msgstr "Невдалих: %s"

msgid "%s held emails discarded."
msgstr "Відхилено затриманих листів: %s."

msgid "%s imported entries removed."
msgstr "Видалено імпортованих записів: %s."

msgid "%s in 30 days"
msgstr "%s за 30 днів"

msgid "%s marked as spam"
msgstr "Позначено як спам: %s"

msgid "%s more on the Email types page."
msgstr "Ще %s на сторінці «Типи листів»."

msgid "%s notes"
msgstr "%s приміток"

msgid "%s of all emails"
msgstr "%s від усіх листів"

msgid "%s of them in the last 24 hours."
msgstr "З них %s – за останні 24 години."

msgid "%s s"
msgstr "%s с"

msgid "%s selected"
msgstr "Вибрано: %s"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s пункт потребує уваги:"
msgstr[1] "%s пункти потребують уваги:"
msgstr[2] "%s пунктів потребують уваги:"

msgid "%s to administrators in 30 days"
msgstr "Адміністраторам за 30 днів: %s"

msgid "%s unchanged lines"
msgstr "Незмінених рядків: %s"

msgid "(no subject)"
msgstr "(без теми)"

msgid "(no text content)"
msgstr "(немає текстового вмісту)"

msgid "(the emails are no longer in the log)"
msgstr "(листів уже немає в журналі)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "-all суворіший; ~all поширений і разом із DMARC цілком підходить."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "0 – зберігати записи назавжди. Очищення виконується раз на день."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "0 – без обмежень. Найстаріші записи видаляються першими."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "0 вимикає цю функцію. Видаляє вміст, заголовки та вкладення старіших записів і маскує адреси (a***@example.com). Дата, статус, джерело, формат, розмір і примітки залишаються для статистики. Виконується під час щоденного очищення, перед видаленням записів, – тому діє, лише якщо цей строк коротший за період видалення вище."

msgid "12 months"
msgstr "12 місяців"

msgid "30 days"
msgstr "30 днів"

msgid "7 days"
msgstr "7 днів"

msgid "90 days"
msgstr "90 днів"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "Селектор DKIM може містити лише літери, цифри, крапки, дефіси та підкреслення."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "Поштовий плагін, що надсилає через API, перебрав доставку й повідомив, що надіслати не вдалося, не вказавши причини."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "Опублікований ключ не доводить, що ваші листи ним підписуються – перевірте результат DKIM у заголовках отриманого листа."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "Адреса одержувача або відправника не є дійсною адресою ел. пошти, тому PHPMailer відмовився надсилати."

msgid "API key or private key in plain text: %1$s"
msgstr "Ключ API або приватний ключ у відкритому вигляді: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "Для перевірки цього запису потрібно близько %1$s запитів DNS – більше за дозволені %2$s, тож одержувачі можуть його ігнорувати (PermError). Видаліть непотрібні записи include:."

msgid "Access"
msgstr "Доступ"

msgid "Actions"
msgstr "Дії"

msgid "Active: alerts on %s."
msgstr "Активно: попередження про %s."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "Додайте короткий атрибут alt до кожного зображення в шаблоні, напр. alt=\"Logo Example Shop\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "Додайте include: вашого поштового провайдера (напр. include:_spf.google.com), якщо надсилаєте через нього."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "Додайте свій поштовий сервер або поштовий сервіс до запису SPF домену відправника."

msgid "Added:"
msgstr "Додано:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "Адреси з щонайменше %s остаточними збоями: сервер одержувача відхилив поштову скриньку, домен не має поштового сервера або ваш поштовий провайдер повідомив про жорстке повернення. Записи зникають разом зі строком зберігання журналу."

msgid "Admin screen"
msgstr "Екран адмінки"

msgid "Administrators"
msgstr "Адміністратори"

msgid "Aggregate reports go to %s."
msgstr "Зведені звіти надходять на %s."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "Попередження"

msgid "Alert and hold further emails"
msgstr "Попередити й затримувати подальші листи"

msgid "Alert only"
msgstr "Лише попередити"

msgid "Alert when an email type that is sent regularly stops"
msgstr "Сповіщати, коли тип листа, що надсилається регулярно, перестає надсилатися"

msgid "Alert when emails fail repeatedly"
msgstr "Попереджати, коли листи неодноразово не вдається надіслати"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "Попереджати, коли сайт несподівано припиняє надсилати листи"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "Попередження ввімкнено, але канал не задано: введіть адресу ел. пошти або URL-адресу вебхука."

msgid "Alerts are off."
msgstr "Попередження вимкнено."

msgid "All"
msgstr "Усі"

msgid "All email types look healthy."
msgstr "Усі типи листів виглядають справними."

msgid "All emails are redirected to test addresses."
msgstr "Усі листи переспрямовуються на тестові адреси."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "Усі листи надходять на тестові адреси замість справжніх одержувачів."

msgid "All sources"
msgstr "Усі джерела"

msgid "Allow again"
msgstr "Знову дозволити"

msgid "Allowed again."
msgstr "Знову дозволено."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "Також один раз сповіщає, коли плагін або тема, які раніше ніколи не надсилали листів, протягом доби пишуть на багато різних зовнішніх адрес, – можлива ознака зламу сайту. Перші два тижні після встановлення Mailspur слугують базою для порівняння."

msgid "Also remove the subject when anonymising"
msgstr "Також видаляти тему під час анонімізації"

msgid "Also search content"
msgstr "Шукати також у вмісті"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "Або попросіть хостинг-провайдера ввімкнути mail() / sendmail для цього сайту."

msgid "Always load remote images and fonts in the preview"
msgstr "Завжди завантажувати зовнішні зображення та шрифти в попередньому перегляді"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (через SNS)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "Поштовому провайдеру з HTTP API замість SMTP потрібно менше обмінів даними на кожен лист."

msgid "Anonymisation"
msgstr "Анонімізація"

msgid "Anonymise entries after"
msgstr "Анонімізувати записи через"

msgid "Anonymised"
msgstr "Анонімізовано"

msgid "Any format"
msgstr "Будь-який формат"

msgid "Any status"
msgstr "Будь-який статус"

msgid "Apply"
msgstr "Застосувати"

msgid "Ask the recipient for a working address."
msgstr "Попросіть одержувача надати робочу адресу."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "Попросіть хостинг-провайдера ввімкнути розширення openssl (або ввімкніть його в налаштуваннях PHP у панелі хостингу)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "Попросіть хостинг-провайдера оновити сертифікати CA та OpenSSL на сервері."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "Запитайте хостинг-провайдера, чи не заблоковано вихідні SMTP-з’єднання."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "Запитайте хостинг-провайдера, чи дозволено вихідні з’єднання на цей порт (брандмауер)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "Щонайменше %1$s невдалих листів протягом %2$s хв"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "Не більше одного попередження кожного типу за цей час, навіть якщо проблема залишається."

msgid "Attachments"
msgstr "Вкладення"

msgid "Attachments no longer available: %s"
msgstr "Вкладення більше недоступні: %s"

msgid "Authentication"
msgstr "Автентифікація"

msgid "Automatic TLS"
msgstr "Автоматичний TLS"

msgid "Average per day"
msgstr "Середнє за день"

msgid "Back to the email types"
msgstr "Назад до типів листів"

msgid "Belongs to"
msgstr "Належить до"

msgid "Block again"
msgstr "Знову блокувати"

msgid "Blocked as spam or by a blocklist"
msgstr "Заблоковано як спам або через чорний список"

msgid "Bounced (permanent)"
msgstr "Повернено (остаточно)"

msgid "Bounced (temporary)"
msgstr "Повернено (тимчасово)"

msgid "Broken characters (encoding): %1$s"
msgstr "Пошкоджені символи (кодування): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "Масова розсилка без заголовка відписки (одержувачів: %1$s)"

msgid "Bundle into one daily email"
msgstr "Об’єднувати в один щоденний лист"

msgid "Bundled into one daily email"
msgstr "Об’єднано в один щоденний лист"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "Об’єднання вимкнено. Листи, що очікували, щойно надіслано одним дайджестом."

msgid "Busiest day"
msgstr "Найнавантаженіший день"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "Скасувати"

msgid "Careful: emails to this address failed several times before."
msgstr "Увага: листи на цю адресу вже кілька разів не вдавалося надіслати."

msgid "Change in the email types"
msgstr "Змінити в типах листів"

msgid "Change staging mode"
msgstr "Змінити тестовий режим"

msgid "Check"
msgstr "Перевірити"

msgid "Check again"
msgstr "Перевірити знову"

msgid "Check emails"
msgstr "Перевіряти листи"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "Перевірте хост і порт; спробуйте 587 (TLS) замість 465 (SSL) або навпаки."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "Перевірте хост, порт, шифрування, ім’я користувача та пароль у своєму SMTP-плагіні й надішліть звідти тестовий лист."

msgid "Check sender domains"
msgstr "Перевірити домени відправників"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "Переконайтеся, що шифрування відповідає порту: TLS для 587, SSL для 465."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "Перевірте, чи належить ключ до правильного регіону / облікового запису (напр. кінцева точка EU чи US)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "Перевірте хост і порт SMTP: неправильний порт або заблоковане з’єднання часто закінчуються тайм-аутом, перш ніж спрацює запасний варіант."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "Перевірте записи SPF, DKIM і DMARC домену відправника або використовуйте адресу відправника на домені, з якого ви надсилаєте."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "Перевірте адресу на помилки – або ж ваш сайт ніколи не надсилав цей лист."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "Уточніть адресу в одержувача й виправте її там, де її збережено (профіль користувача, замовлення, запис форми)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "Уточніть адресу в одержувача й виправте її там, де її збережено."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "Перевірте ім’я хоста й порт: 587 зі STARTTLS (TLS) або 465 з SSL. Порт 25 блокує більшість хостинг-провайдерів."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "Перевірте ліміти й поточне використання в обліковому записі поштового сервісу; за потреби змініть тариф на вищий."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "Перевірте адреси одержувачів цього запису на помилки, пробіли або пропущені частини."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
msgstr "Перевірте адресу відправника у своєму SMTP-плагіні та фільтр wp_mail_from."

msgid "Check the sending limits of your mail account and the notes of this email."
msgstr "Перевірте ліміти надсилання свого поштового облікового запису та примітки до цього листа."

msgid "Check the server IP on a blocklist checker and request delisting."
msgstr "Перевірте IP сервера в сервісі перевірки чорних списків і подайте запит на вилучення з них."

msgid "Check the spelling of the placeholder in the template and whether the plugin supports it for this email type. Shortcodes are not processed in emails unless the sending plugin runs do_shortcode()."
msgstr "Перевірте написання заповнювача в шаблоні та чи підтримує його плагін для цього типу листа. Шорткоди в листах не обробляються, якщо плагін-відправник не викликає do_shortcode()."

msgid "Checked %s."
msgstr "Перевірено %s."

msgid "Checked just now"
msgstr "Щойно перевірено"

msgid "Checking DNS records …"
msgstr "Перевірка записів DNS …"

msgid "Checks the DNS records of the domains your site sends from: the default sender address and the most frequent senders in the log. Missing or weak records are the most common reason why emails land in spam. Only your server's own DNS resolver is used; results are kept for one hour."
msgstr "Перевіряє записи DNS доменів, з яких надсилає ваш сайт: типової адреси відправника та найчастіших відправників у журналі. Відсутні або слабкі записи – найпоширеніша причина потрапляння листів у спам. Використовується лише власний DNS-резолвер вашого сервера; результати зберігаються одну годину."

msgid "Choose a range of at most %s days."
msgstr "Виберіть діапазон не більше %s днів."

msgid "Clear selection"
msgstr "Скасувати вибір"

msgid "Click a bar to open these emails in the log."
msgstr "Натисніть на стовпчик, щоб відкрити ці листи в журналі."

msgid "Close"
msgstr "Закрити"

msgid "Close (Esc)"
msgstr "Закрити (Esc)"

msgid "Colour scheme"
msgstr "Колірна схема"

msgid "Command line"
msgstr "Командний рядок"

msgid "Compare"
msgstr "Порівняти"

msgid "Compare the sources of these entries. Check whether two plugins send the same notification, or whether a hook (e.g. order status change) fires more than once."
msgstr "Порівняйте джерела цих записів. Перевірте, чи не надсилають два плагіни те саме сповіщення або чи не спрацьовує хук (напр. зміна статусу замовлення) більше одного разу."

msgid "Component"
msgstr "Компонент"

msgid "Configure alerts"
msgstr "Налаштувати попередження"

msgid "Content anonymised after %1$s days, %2$s"
msgstr "Вміст анонімізовано через %1$s дн., %2$s"

msgid "Content change marked as seen."
msgstr "Зміну вмісту позначено як переглянуту."

msgid "Content changed"
msgstr "Вміст змінився"

msgid "Content changed on %1$s, after the %2$s update."
msgstr "Вміст змінився %1$s, після оновлення %2$s."

msgid "Content changed on %s."
msgstr "Вміст змінився %s."

msgid "Content removed"
msgstr "Вміст видалено"

msgid "Content removed after %s days"
msgstr "Вміст видалено через %s днів"

msgid "Content, headers and attachments were removed and the addresses masked by the anonymisation setting."
msgstr "Вміст, заголовки та вкладення видалено, а адреси замасковано згідно з налаштуванням анонімізації."

msgid "Copied"
msgstr "Скопійовано"

msgid "Copied – paste it into your reply."
msgstr "Скопійовано – вставте у свою відповідь."

msgid "Copies a short sentence for answering the customer: when the email was sent to whom and whether it arrived – without technical details."
msgstr "Копіює коротке речення для відповіді клієнту: коли й кому надіслано лист і чи він дійшов – без технічних подробиць."

msgid "Copies the existing log of another mail logging plugin into Mailspur, so old emails can be searched and previewed here. The other plugin and its data stay untouched; running the import again only adds new entries."
msgstr "Копіює наявний журнал іншого плагіна журналювання листів у Mailspur, щоб старі листи можна було шукати й переглядати тут. Інший плагін і його дані залишаються без змін; повторний імпорт додає лише нові записи."

msgid "Copy"
msgstr "Копіювати"

msgid "Copy for support"
msgstr "Копіювати для підтримки"

msgid "Copying is not possible in this browser. Select the text and copy it:"
msgstr "У цьому браузері копіювання неможливе. Виділіть текст і скопіюйте його:"

msgid "Correct the address (e.g. in the user profile or order) and consider an email validation in your forms."
msgstr "Виправте адресу (напр. у профілі користувача або замовленні) і подумайте про перевірку адрес ел. пошти у своїх формах."

msgid "Counted once per email."
msgstr "Враховується один раз на лист."

msgid "Create a new API key with send permission at your mail service and enter it in the mailer plugin."
msgstr "Створіть у поштовому сервісі новий ключ API з дозволом на надсилання й введіть його в поштовому плагіні."

msgid "Create a new webhook URL? The current URL stops working at once – paste the new URL into the webhook settings of your email provider."
msgstr "Створити нову URL-адресу вебхука? Поточна адреса одразу перестане працювати – вставте нову адресу в налаштування вебхука вашого поштового провайдера."

msgid "Create new URL"
msgstr "Створити нову URL-адресу"

msgid "Current page"
msgstr "Поточна сторінка"

msgid "Current record"
msgstr "Поточний запис"

msgid "Current size"
msgstr "Поточний розмір"

msgid "Custom"
msgstr "Власний"

msgid "DKIM key found (selector: %s)."
msgstr "Знайдено ключ DKIM (селектор: %s)."

msgid "DMARC record found with p=none: reports only, spoofed mail is still delivered."
msgstr "Знайдено запис DMARC із p=none: лише звіти, підроблені листи все одно доставляються."

msgid "DMARC record found with policy p=%s."
msgstr "Знайдено запис DMARC із політикою p=%s."

msgid "DMARC record has no valid policy (p=none, quarantine or reject)."
msgstr "Запис DMARC не має дійсної політики (p=none, quarantine або reject)."

msgid "DNS lookup failed or timed out. Try again later."
msgstr "Запит DNS не вдався або перевищив час очікування. Спробуйте пізніше."

msgid "DNS lookups are not available on this server (dns_get_record() is disabled), so the sender check cannot run here."
msgstr "Запити DNS недоступні на цьому сервері (dns_get_record() вимкнено), тому перевірка відправника тут не може працювати."

msgid "DNS lookups needed: about %1$s of %2$s allowed."
msgstr "Потрібно запитів DNS: близько %1$s із дозволених %2$s."

msgid "Daily"
msgstr "Щодня"

msgid "Daily digest"
msgstr "Щоденний дайджест"

msgid "Dark"
msgstr "Темна"

msgid "Date"
msgstr "Дата"

msgid "Default (%s days)"
msgstr "Типово (%s дн.)"

msgid "Default (no time limit)"
msgstr "Типово (без обмеження часу)"

msgid "Default sender"
msgstr "Типовий відправник"

msgid "Delete"
msgstr "Видалити"

msgid "Delete %s selected log entries?"
msgstr "Видалити вибрані записи журналу (%s)?"

msgid "Delete ALL log entries? This cannot be undone."
msgstr "Видалити ВСІ записи журналу? Цю дію неможливо скасувати."

msgid "Delete entries after"
msgstr "Видаляти записи через"

msgid "Delete selected"
msgstr "Видалити вибрані"

msgid "Delete the log table and settings when the plugin is deleted"
msgstr "Видаляти таблицю журналу й налаштування під час видалення плагіна"

msgid "Delete this log entry?"
msgstr "Видалити цей запис журналу?"

msgid "Deleted."
msgstr "Видалено."

msgid "Delivered"
msgstr "Доставлено"

msgid "Delivered by %s (API)"
msgstr "Доставлено через %s (API)"

msgid "Delivered by code hooked into pre_wp_mail (API)"
msgstr "Доставлено кодом, підключеним до pre_wp_mail (API)"

msgid "Delivered in the daily digest on %s."
msgstr "Доставлено в щоденному дайджесті %s."

msgid "Delivery"
msgstr "Доставка"

msgid "Delivery status from your email provider"
msgstr "Статус доставки від вашого поштового провайдера"

msgid "Desktop"
msgstr "Комп'ютер"

msgid "Did my email arrive?"
msgstr "Чи дійшов мій лист?"

msgid "Disable the email or change its recipient"
msgstr "Вимкнути лист або змінити його одержувача"

msgid "Discard all held emails? They stay in the log but are not sent."
msgstr "Відхилити всі затримані листи? Вони залишаться в журналі, але не будуть надіслані."

msgid "Discard held emails"
msgstr "Відхилити затримані листи"

msgid "Do not send \"from\" free mail addresses (gmail.com, gmx.de …) through your own server."
msgstr "Не надсилайте листи «від імені» безкоштовних поштових адрес (gmail.com, gmx.de …) через власний сервер."

msgid "Done: %1$s emails sent, %2$s failed."
msgstr "Готово: надіслано листів: %1$s, невдалих: %2$s."

msgid "Done: %1$s imported, %2$s duplicates, %3$s too old."
msgstr "Готово: імпортовано: %1$s, дублікатів: %2$s, застарілих: %3$s."

msgid "Download .eml"
msgstr "Завантажити .eml"

msgid "Download as CSV"
msgstr "Завантажити як CSV"

msgid "Download started."
msgstr "Завантаження почалося."

msgid "Download the entries matching the current filters as %s"
msgstr "Завантажити записи, що відповідають поточним фільтрам, як %s"

msgid "Each email is checked once when it is logged or imported (no external requests). Changes here only affect emails logged afterwards; older entries are not checked again. DNS and repeated-sending checks run when you open an entry."
msgstr "Кожен лист перевіряється один раз під час запису до журналу або імпорту (без зовнішніх запитів). Зміни тут стосуються лише листів, записаних після цього; старіші записи повторно не перевіряються. Перевірки DNS і повторного надсилання виконуються, коли ви відкриваєте запис."

msgid "Earlier emails to %s failed hard more than once."
msgstr "Попередні листи на %s неодноразово мали остаточні збої."

msgid "Edit template"
msgstr "Редагувати шаблон"

msgid "Editors and above"
msgstr "Редактори й вище"

msgid "Email address"
msgstr "Адреса ел. пошти"

msgid "Email address (the latest email is no longer in the log)"
msgstr "Адреса ел. пошти (останнього листа вже немає в журналі)"

msgid "Email address or order number"
msgstr "Адреса ел. пошти або номер замовлення"

msgid "Email consists almost only of images"
msgstr "Лист складається майже лише із зображень"

msgid "Email failure spike"
msgstr "Сплеск збоїв листів"

msgid "Email failures"
msgstr "Збої листів"

msgid "Email failures resolved"
msgstr "Збої листів усунено"

msgid "Email inventory"
msgstr "Реєстр листів"

msgid "Email log"
msgstr "Журнал листів"

msgid "Email log: problem recipients"
msgstr "Журнал листів: проблемні одержувачі"

msgid "Email me whenever a comment is held for moderation"
msgstr "Надсилати мені лист, коли коментар очікує на модерацію"

msgid "Email me whenever anyone posts a comment"
msgstr "Надсилати мені лист, коли хтось залишає коментар"

msgid "Email provider"
msgstr "Поштовий провайдер"

msgid "Email sent again."
msgstr "Лист надіслано повторно."

msgid "Email sent to %s."
msgstr "Лист надіслано на %s."

msgid "Email type"
msgstr "Тип листа"

msgid "Email type is sent again"
msgstr "Тип листа знову надсилається"

msgid "Email type stopped"
msgstr "Тип листа більше не надсилається"

msgid "Email types"
msgstr "Типи листів"

msgid "Email volume back to normal"
msgstr "Кількість листів повернулася до норми"

msgid "Email volume is back to normal: the emergency brake is no longer active."
msgstr "Кількість листів повернулася до норми: аварійне гальмо більше не активне."

msgid "Email: failed"
msgstr "Лист: невдалий"

msgid "Email: failed – see the log"
msgstr "Лист: невдалий – див. журнал"

msgid "Email: sent"
msgstr "Лист: надіслано"

msgid "Emails"
msgstr "Листи"

msgid "Emails are being logged again."
msgstr "Листи знову записуються в журнал."

msgid "Emails are delivered to their recipients."
msgstr "Листи доставляються одержувачам."

msgid "Emails are flowing again"
msgstr "Листи знову надсилаються"

msgid "Emails are logged but not delivered."
msgstr "Листи записуються в журнал, але не доставляються."

msgid "Emails are still being sent."
msgstr "Листи все ще надсилаються."

msgid "Emails are still being sent. Check the main source; switch the emergency brake to \"Alert and hold further emails\" to stop them."
msgstr "Листи все ще надсилаються. Перевірте головне джерело; щоб зупинити їх, перемкніть аварійне гальмо на «Попередити й затримувати подальші листи»."

msgid "Emails in 30 days"
msgstr "Листи за 30 днів"

msgid "Emails of this type that go only to administrators are now collected and sent once a day in one digest."
msgstr "Листи цього типу, що надходять лише адміністраторам, тепер збираються й надсилаються раз на день одним дайджестом."

msgid "Emails over time"
msgstr "Листи з часом"

msgid "Emails per day and status"
msgstr "Листи за днями та статусом"

msgid "Emails per weekday and hour (site time zone)."
msgstr "Листи за днями тижня й годинами (часовий пояс сайту)."

msgid "Emails that are already in the log – logged by Mailspur itself or imported from another plugin – are recognized by recipients, subject and send time and skipped as duplicates."
msgstr "Листи, які вже є в журналі (записані самим Mailspur або імпортовані з іншого плагіна), розпізнаються за одержувачами, темою й часом надсилання та пропускаються як дублікати."

msgid "Emails that are sent regularly have stopped (%s)"
msgstr "Регулярні листи більше не надсилаються (%s)"

msgid "Emails to this user"
msgstr "Листи цьому користувачу"

msgid "Emails with notes"
msgstr "Листи з примітками"

msgid "Emails without a subject look like spam and are hard to find in the inbox."
msgstr "Листи без теми схожі на спам, і їх важко знайти у вхідних."

msgid "Emails – last 7 days"
msgstr "Листи – останні 7 днів"

msgid "Emergency brake"
msgstr "Аварійне гальмо"

msgid "Emergency brake reset."
msgstr "Аварійне гальмо скинуто."

msgid "Emergency brake settings"
msgstr "Налаштування аварійного гальма"

msgid "Emergency brake: %1$s emails in the last hour – far more than usual (threshold: %2$s per hour)."
msgstr "Аварійне гальмо: листів за останню годину: %1$s – набагато більше, ніж зазвичай (поріг: %2$s на годину)."

msgid "Emergency brake: unusual email flood"
msgstr "Аварійне гальмо: незвичний потік листів"

msgid "Empty = automatic: three times the busiest hour of the last 14 days, at least 50 – currently %s."
msgstr "Порожньо = автоматично: утричі більше за найнавантаженішу годину за останні 14 днів, щонайменше 50 – зараз %s."

msgid "Empty log"
msgstr "Очистити журнал"

msgid "Empty subject"
msgstr "Порожня тема"

msgid "Enable 2-step verification for the Google account and create an app password (Google account → Security → App passwords)."
msgstr "Увімкніть двоетапну перевірку для облікового запису Google і створіть пароль застосунку (Google account → Security → App passwords)."

msgid "Enable DKIM signing at your mail provider or host and publish the key it gives you. If you already sign, enter your selector (the s= value of the DKIM-Signature header) and check again."
msgstr "Увімкніть підписування DKIM у свого поштового провайдера або хостингу й опублікуйте наданий ключ. Якщо ви вже підписуєте листи, введіть свій селектор (значення s= заголовка DKIM-Signature) і перевірте знову."

msgid "Enable DKIM signing at your mail service and publish its DNS record."
msgstr "Увімкніть підпис DKIM у поштовому сервісі й опублікуйте його DNS-запис."

msgid "Enable authentication in your SMTP plugin and enter user name and password."
msgstr "Увімкніть автентифікацію у своєму SMTP-плагіні та введіть ім’я користувача й пароль."

msgid "Enable authentication in your SMTP plugin."
msgstr "Увімкніть автентифікацію у своєму SMTP-плагіні."

msgid "Encrypted SMTP connections (TLS/SSL) need the PHP extension openssl, which is not installed or not enabled on this server."
msgstr "Шифровані SMTP-з’єднання (TLS/SSL) потребують розширення PHP openssl, яке на цьому сервері не встановлено або не ввімкнено."

msgid "Encryption"
msgstr "Шифрування"

msgid "Encryption (TLS/SSL) failed"
msgstr "Помилка шифрування (TLS/SSL)"

msgid "Enter an email address or a webhook URL and save the settings first."
msgstr "Спершу введіть адресу ел. пошти або URL-адресу вебхука й збережіть налаштування."

msgid "Enter an email address or an order number."
msgstr "Введіть адресу ел. пошти або номер замовлення."

msgid "Enter an email address under “Send alerts by email to” and save the settings first."
msgstr "Спершу введіть адресу ел. пошти в полі «Надсилати попередження ел. поштою на» й збережіть налаштування."

msgid "Enter between 1 and 10 email addresses."
msgstr "Введіть від 1 до 10 адрес ел. пошти."

msgid "Enter one or more email addresses."
msgstr "Введіть одну або кілька адрес ел. пошти."

msgid "Enter the app password in your SMTP plugin, or use the plugin's \"Sign in with Google\" (OAuth) connection."
msgstr "Введіть пароль застосунку у своєму SMTP-плагіні або скористайтеся підключенням плагіна «Sign in with Google» (OAuth)."

msgid "Entries"
msgstr "Записи"

msgid "Entries older than %s days are skipped because the retention setting would delete them anyway. Change the retention above first to import everything."
msgstr "Записи, старші за %s днів, пропускаються, оскільки налаштування строку зберігання однаково їх видалило б. Щоб імпортувати все, спершу змініть строк зберігання вище."

msgid "Error"
msgstr "Помилка"

msgid "Errors"
msgstr "Помилки"

msgid "Every %s days"
msgstr "Кожні %s дн."

msgid "Every 15 minutes (Mailspur alerts)"
msgstr "Кожні 15 хвилин (попередження Mailspur)"

msgid "Every Monday morning, only when there is something to report: emails and failure rate compared with the previous week, new, stopped and changed email types, emails with notes and emergency-brake incidents. Counts and subject patterns only."
msgstr "Щопонеділка вранці, лише коли є про що повідомити: листи й частка збоїв порівняно з попереднім тижнем, нові, зупинені та змінені типи листів, листи з примітками та спрацювання аварійного гальма. Лише кількості й шаблони тем."

msgid "Every kind of email this site sends, generated from the Mailspur email log – e.g. for a record of processing activities or a handover. Recipient groups are derived from the latest emails of each sender, data categories from the latest email of each type. The list contains no email contents and no addresses."
msgstr "Усі види листів, які надсилає цей сайт, згенеровані з журналу листів Mailspur, – напр. для реєстру операцій обробки даних або передавання справ. Групи одержувачів визначаються за останніми листами кожного відправника, категорії даних – за останнім листом кожного типу. Список не містить вмісту листів і адрес."

msgid "Every kind of email your site sends, found automatically in the log: grouped by the plugin that sends it and by subject, with numbers, addresses and names as placeholders. Mailspur learns how often each type is sent and notices when one stops – for example after a plugin update."
msgstr "Усі види листів, які надсилає ваш сайт, автоматично знайдені в журналі: згруповані за плагіном, що їх надсилає, і за темою, з числами, адресами й іменами як заповнювачами. Mailspur дізнається, як часто надсилається кожен тип, і помічає, коли якийсь перестає надсилатися, – наприклад, після оновлення плагіна."

msgid "Everything looks fine: %s email in the last 7 days, without errors."
msgid_plural "Everything looks fine: %s emails in the last 7 days, none failed."
msgstr[0] "Усе гаразд: %s лист за останні 7 днів, без помилок."
msgstr[1] "Усе гаразд: %s листи за останні 7 днів, жодного невдалого."
msgstr[2] "Усе гаразд: %s листів за останні 7 днів, жодного невдалого."

msgid "Expected today and not sent yet:"
msgstr "Очікувалися сьогодні й ще не надіслані:"

msgid "Export"
msgstr "Експорт"

msgid "Export started – your download begins shortly."
msgstr "Експорт розпочато – завантаження незабаром почнеться."

msgid "Failed"
msgstr "Невдалі"

msgid "Failed (%s %%)"
msgstr "Невдалі (%s %%)"

msgid "Failing"
msgstr "З помилками"

msgid "Failure rate"
msgstr "Частка збоїв"

msgid "Failure spike"
msgstr "Сплеск збоїв"

msgid "Far more emails than usual were sent"
msgstr "Надіслано набагато більше листів, ніж зазвичай"

msgid "Far more emails than usual were sent, so Mailspur holds further emails until you release or discard them."
msgstr "Надіслано набагато більше листів, ніж зазвичай, тому Mailspur затримує подальші листи, доки ви їх не випустите або не відхилите."

msgid "Fewer"
msgstr "Менше"

msgid "File"
msgstr "Файл"

msgid "Filter by status"
msgstr "Фільтрувати за статусом"

msgid "Filter email types"
msgstr "Фільтрувати типи листів"

msgid "First email after the change"
msgstr "Перший лист після зміни"

msgid "First email from this sender on %s. With type alerts on, Mailspur alerts when a new sender writes to many external addresses."
msgstr "Перший лист від цього відправника – %s. Якщо сповіщення про типи ввімкнено, Mailspur сповіщає, коли новий відправник пише на багато зовнішніх адрес."

msgid "First page"
msgstr "Перша сторінка"

msgid "For large attachments the timeout can also be hit during the transfer – send smaller files or links."
msgstr "Для великих вкладень тайм-аут може настати й під час передавання – надсилайте менші файли або посилання."

msgid "For staging and development copies of a site: make sure customers never get emails from the copy. Every email is still logged."
msgstr "Для тестових і розробницьких копій сайту: гарантує, що клієнти ніколи не отримають листів із копії. Кожен лист однаково записується в журнал."

msgid "Forced dark"
msgstr "Примусово темна"

msgid "Format"
msgstr "Формат"

msgid "Free text from forms"
msgstr "Довільний текст із форм"

msgid "Friday"
msgstr "П'ятниця"

msgid "From"
msgstr "Від"

msgid "From date"
msgstr "З дати"

msgid "Front end"
msgstr "Фронтенд"

msgid "Function"
msgstr "Функція"

msgid "Further emails are held until an administrator releases or discards them."
msgstr "Подальші листи затримуються, доки адміністратор їх не звільнить або не відхилить."

msgid "Gmail and Google Workspace no longer accept the normal account password for SMTP."
msgstr "Gmail і Google Workspace більше не приймають звичайний пароль облікового запису для SMTP."

msgid "Gmail cuts off HTML emails larger than 102 KB and shows \"[Message clipped]\". Everything after the cut – often the footer, unsubscribe link or legal notice – is hidden."
msgstr "Gmail обрізає HTML-листи, більші за 102 КБ, і показує «[Message clipped]». Усе після місця обрізання – часто нижній колонтитул, посилання для відписки або юридична інформація – приховано."

msgid "Gmail will clip this email (%1$s KB)"
msgstr "Gmail обріже цей лист (%1$s КБ)"

msgid "Google rejected the login"
msgstr "Google відхилив вхід"

msgid "HTML"
msgstr "HTML"

msgid "HTML sent as plain text"
msgstr "HTML надіслано як звичайний текст"

msgid "Handler"
msgstr "Обробник"

msgid "Hard bounce reported by your email provider"
msgstr "Ваш поштовий провайдер повідомив про жорстке повернення"

msgid "Hard failures"
msgstr "Остаточні збої"

msgid "Headers"
msgstr "Заголовки"

msgid "Held"
msgstr "Затримано"

msgid "Held by emergency brake – discarded."
msgstr "Затримано аварійним гальмом – відхилено."

msgid "Held by emergency brake – not delivered."
msgstr "Затримано аварійним гальмом – не доставлено."

msgid "Held by emergency brake – released later."
msgstr "Затримано аварійним гальмом – згодом звільнено."

msgid "Held by staging mode – not delivered."
msgstr "Затримано тестовим режимом – не доставлено."

msgid "Held email sent. It is logged as a new entry."
msgstr "Затриманий лист надіслано. Його записано як новий запис."

msgid "Held emails get the status \"Held\" and can still be sent one by one from the log (\"Send now\")."
msgstr "Затримані листи отримують статус «Затримано», і їх усе ще можна надіслати по одному з журналу («Надіслати зараз»)."

msgid "Held: every recipient failed hard before (problem recipients)."
msgstr "Затримано: у кожного одержувача раніше були остаточні збої (проблемні одержувачі)."

msgid "Held: staging mode is set to redirect, but no valid redirect address is configured."
msgstr "Затримано: тестовий режим налаштовано на переспрямування, але дійсну адресу переспрямування не задано."

msgid "Hints about problems that can keep this email from arriving or displaying correctly."
msgstr "Підказки щодо проблем, через які цей лист може не дійти або відображатися неправильно."

msgid "Hold further emails to problem recipients"
msgstr "Затримувати подальші листи проблемним одержувачам"

msgid "Hooks"
msgstr "Хуки"

msgid "Hours"
msgstr "Години"

msgid "How to fix:"
msgstr "Як виправити:"

msgid "I already did"
msgstr "Я вже це зробив"

msgid "I understand that the raw source is NOT redacted and roughly doubles the storage per email"
msgstr "Я розумію, що необроблене джерело НЕ знеособлюється і приблизно подвоює обсяг зберігання на кожен лист"

msgid "If it happens often, check the sending limits of your mail provider."
msgstr "Якщо це трапляється часто, перевірте ліміти надсилання свого поштового провайдера."

msgid "If it keeps happening, send fewer emails at once or through a mail service with a queue."
msgstr "Якщо це повторюється, надсилайте менше листів одночасно або через поштовий сервіс із чергою."

msgid "If security defaults block it, use your SMTP plugin's Microsoft (OAuth / Graph API) connection instead."
msgstr "Якщо це блокують стандартні параметри безпеки (security defaults), використайте натомість підключення Microsoft (OAuth / Graph API) у своєму SMTP-плагіні."

msgid "If several recipients failed, the server reply after the address names the reason."
msgstr "Якщо не вдалося надіслати кільком одержувачам, причину вказано у відповіді сервера після адреси."

msgid "If the account uses two-factor authentication, create an app password and use it instead."
msgstr "Якщо обліковий запис використовує двофакторну автентифікацію, створіть пароль застосунку й використовуйте його."

msgid "Ignore"
msgstr "Ігнорувати"

msgid "Ignored"
msgstr "Ігнорується"

msgid "Ignored notes"
msgstr "Ігноровані примітки"

msgid "Ignored notes are no longer recorded for new emails and are hidden for existing entries."
msgstr "Ігноровані примітки більше не записуються для нових листів і приховуються для наявних записів."

msgid "Images without alt text (%1$s)"
msgstr "Зображення без альтернативного тексту (%1$s)"

msgid "Import"
msgstr "Імпорт"

msgid "Import failed: %s"
msgstr "Помилка імпорту: %s"

msgid "Import from other plugins"
msgstr "Імпорт з інших плагінів"

msgid "Import new entries"
msgstr "Імпортувати нові записи"

msgid "Imported"
msgstr "Імпортовано"

msgid "Imported entries have no trace: the other plugin did not record these details."
msgstr "Імпортовані записи не мають трасування: інший плагін не записував ці дані."

msgid "Imported from %s"
msgstr "Імпортовано з %s"

msgid "In Amazon SNS, subscribe the URL (protocol HTTPS) to the topic that receives the Delivery, Bounce and Complaint notifications of Amazon SES. Mailspur confirms the subscription automatically."
msgstr "В Amazon SNS підпишіть URL-адресу (протокол HTTPS) на тему, яка отримує сповіщення Delivery, Bounce і Complaint від Amazon SES. Mailspur підтверджує підписку автоматично."

msgid "In Brevo, open Transactional → Settings → Webhook, add the URL and select Delivered, Hard bounce, Soft bounce, Invalid email and Complaint."
msgstr "У Brevo відкрийте Transactional → Settings → Webhook, додайте URL-адресу й виберіть Delivered, Hard bounce, Soft bounce, Invalid email і Complaint."

msgid "In Mailgun, open Sending → Webhooks, add the URL for Delivered, Permanent failure, Temporary failure and Spam complaints, and paste the HTTP webhook signing key below."
msgstr "У Mailgun відкрийте Sending → Webhooks, додайте URL-адресу для Delivered, Permanent failure, Temporary failure і Spam complaints та вставте нижче HTTP webhook signing key."

msgid "In Postmark, open your server → Webhooks → Add webhook, paste the URL and select Delivery, Bounce and Spam complaint."
msgstr "У Postmark відкрийте свій сервер → Webhooks → Add webhook, вставте URL-адресу й виберіть Delivery, Bounce і Spam complaint."

msgid "In the Microsoft 365 admin center, open the user → Mail → Manage email apps and enable \"Authenticated SMTP\"."
msgstr "У центрі адміністрування Microsoft 365 відкрийте користувача → Mail → Manage email apps і ввімкніть «Authenticated SMTP»."

msgid "Inboxes show roughly the first 40–80 characters; the rest is cut off, on phones even earlier."
msgstr "Поштові скриньки показують приблизно перші 40–80 символів; решту обрізано, на телефонах – ще раніше."

msgid "Include content"
msgstr "Включити вміст"

msgid "Information"
msgstr "Інформація"

msgid "Install an SMTP plugin and send through a real mailbox or a mail service of your domain."
msgstr "Установіть SMTP-плагін і надсилайте через справжню поштову скриньку або поштовий сервіс свого домену."

msgid "Invalid date."
msgstr "Недійсна дата."

msgid "Invalid email address"
msgstr "Недійсна адреса ел. пошти"

msgid "Invalid email address: %s"
msgstr "Недійсна адреса ел. пошти: %s"

msgid "Invalid sender address: %1$s"
msgstr "Недійсна адреса відправника: %1$s"

msgid "Irregular"
msgstr "Нерегулярно"

msgid "Is Mailspur helping you?"
msgstr "Mailspur вам допомагає?"

msgid "Is an email missing?"
msgstr "Чи бракує якогось листа?"

msgid "Is everything running?"
msgstr "Чи все працює?"

msgid "JSON"
msgstr "JSON"

msgid "Keep at most"
msgstr "Зберігати не більше"

msgid "Keep for"
msgstr "Зберігати"

msgid "Keep this URL private: it contains a secret key of this site. Save the settings before you test the webhook."
msgstr "Тримайте цю URL-адресу в таємниці: вона містить секретний ключ цього сайту. Збережіть налаштування, перш ніж тестувати вебхук."

msgid "Kept: %s"
msgstr "Зберігається: %s"

msgid "Key figures"
msgstr "Ключові показники"

msgid "Last 30 days"
msgstr "Останні 30 днів"

msgid "Last email before the change"
msgstr "Останній лист перед зміною"

msgid "Last failure"
msgstr "Останній збій"

msgid "Last page"
msgstr "Остання сторінка"

msgid "Last sent"
msgstr "Востаннє надіслано"

msgid "Leave a review"
msgstr "Залишити відгук"

msgid "Light"
msgstr "Світла"

msgid "Link text shows %1$s but leads to %2$s"
msgstr "Текст посилання показує %1$s, але веде на %2$s"

msgid "Link to a development address: %1$s"
msgstr "Посилання на адресу розробки: %1$s"

msgid "Link to a page that does not exist on your site: %1$s"
msgstr "Посилання на сторінку, якої немає на вашому сайті: %1$s"

msgid "Link to the full address directly. For click tracking, use UTM parameters on your own domain instead."
msgstr "Посилайтеся безпосередньо на повну адресу. Для відстеження кліків використовуйте натомість параметри UTM на власному домені."

msgid "Link via a URL shortener: %1$s"
msgstr "Посилання через скорочувач URL: %1$s"

msgid "Links and images starting with \"/\" only work on the website. In a mail client there is no website address to complete them, so images stay empty and links lead nowhere."
msgstr "Посилання й зображення, що починаються з «/», працюють лише на вебсайті. У поштовому клієнті немає адреси сайту, щоб їх доповнити, тому зображення залишаються порожніми, а посилання нікуди не ведуть."

msgid "Links to another copy of the site: %1$s (this site: %2$s)"
msgstr "Посилання на іншу копію сайту: %1$s (цей сайт: %2$s)"

msgid "Links whose visible address differs from the real target look like phishing. Spam filters penalize them and some mail clients warn the reader."
msgstr "Посилання, видима адреса яких відрізняється від справжньої цілі, схожі на фішинг. Спам-фільтри за них штрафують, а деякі поштові клієнти попереджають читача."

msgid "Load remote content"
msgstr "Завантажити зовнішній вміст"

msgid "Loading…"
msgstr "Завантаження…"

msgid "Log"
msgstr "Журнал"

msgid "Log entries %s"
msgstr "Записи журналу %s"

msgid "Log entry not found."
msgstr "Запис журналу не знайдено."

msgid "Log only – do not send any email"
msgstr "Лише записувати – не надсилати жодних листів"

msgid "Log size"
msgstr "Розмір журналу"

msgid "Logged emails"
msgstr "Записані листи"

msgid "Logged emails can contain personal data. Grant access as narrowly as possible. Settings always require administrator rights."
msgstr "Записані листи можуть містити персональні дані. Надавайте доступ якомога вужчому колу. Для налаштувань завжди потрібні права адміністратора."

msgid "Login and recipients were accepted, but the email itself was refused – typically spam filtering, a sending limit or a policy of the provider (reply code 554)."
msgstr "Вхід і одержувачів прийнято, але сам лист відхилено – зазвичай через спам-фільтр, ліміт надсилання або політику провайдера (код відповіді 554)."

msgid "Logs outgoing emails, maps the types of email your site sends and alerts you when one stops. Safe preview, delivery diagnostics, statistics."
msgstr "Записує вихідні листи, визначає типи листів, які надсилає ваш сайт, і попереджає, коли якийсь із них перестає надсилатися. Безпечний перегляд, діагностика доставки, статистика."

msgid "Look for an option to switch it off or to change its recipient in the email settings of %s – or ignore the type here."
msgstr "Пошукайте в налаштуваннях листів %s опцію, щоб вимкнути його або змінити одержувача, – або ігноруйте цей тип тут."

msgid "Look for the server reply in the error message; it usually names the reason."
msgstr "Знайдіть відповідь сервера в повідомленні про помилку; зазвичай у ній указано причину."

msgid "Look for unexpected mass sending (spam form submissions, loops) in the log."
msgstr "Пошукайте в журналі неочікуване масове надсилання (спам через форми, цикли)."

msgid "Looking it up …"
msgstr "Шукаємо …"

msgid "Lucas Wille"
msgstr "Lucas Wille"

msgid "Mail Log"
msgstr "Журнал листів"

msgid "Mail Log sections"
msgstr "Розділи журналу листів"

msgid "Mail servers for replies and bounces are set up."
msgstr "Поштові сервери для відповідей і повернень налаштовано."

msgid "Mailbox providers can verify that your site may send emails for this domain. The full sender check also looks at DKIM."
msgstr "Поштові провайдери можуть перевірити, що ваш сайт має право надсилати листи від імені цього домену. Повна перевірка відправника також перевіряє DKIM."

msgid "Mailbox unknown or unavailable"
msgstr "Поштова скринька невідома або недоступна"

msgid "Mailer"
msgstr "Поштовий модуль"

msgid "Mailgun signs every webhook with this key (Sending → Webhooks → HTTP webhook signing key); reports without a valid signature are rejected."
msgstr "Mailgun підписує кожен вебхук цим ключем (Sending → Webhooks → HTTP webhook signing key); звіти без дійсного підпису відхиляються."

msgid "Mailspur alerts"
msgstr "Попередження Mailspur"

msgid "Mailspur checks the log for emails that could not be sent."
msgstr "Mailspur перевіряє журнал на листи, які не вдалося надіслати."

msgid "Mailspur found no order #%s in your shop."
msgstr "Mailspur не знайшов у вашому магазині замовлення #%s."

msgid "Mailspur has logged %s delivered emails on this site so far. If it saves you time, a short review on WordPress.org would mean a lot – it helps others find the plugin and keeps it free."
msgstr "На цьому сайті Mailspur уже записав доставлених листів: %s. Якщо він заощаджує вам час, короткий відгук на WordPress.org дуже допоможе – так інші знайдуть плагін, і він залишиться безкоштовним."

msgid "Mailspur has no email for order #%s in the log."
msgstr "У журналі Mailspur немає листа для замовлення #%s."

msgid "Mailspur has no email to %s in the log."
msgstr "У журналі Mailspur немає листа для %s."

msgid "Mailspur is made by %1$s. Enjoying it? %2$s"
msgstr "Mailspur створив %1$s. Подобається? %2$s"

msgid "Mailspur learns how often each kind of email is sent, e.g. order confirmations, and reports here when one stops."
msgstr "Mailspur дізнається, як часто надсилається кожен вид листів, наприклад підтвердження замовлень, і повідомляє тут, коли якийсь із них припиняється."

msgid "Mailspur learns the rhythm of every email type from the last 8 weeks – a daily order confirmation is overdue after 2 days, a weekly report after 2 weeks. The alert names the type, its sender and the plugins updated since its last email. Uses the channels above; ignored types never alert."
msgstr "Mailspur вивчає ритм кожного типу листа за останні 8 тижнів – щоденне підтвердження замовлення вважається простроченим через 2 дні, щотижневий звіт – через 2 тижні. Сповіщення вказує тип, його відправника та плагіни, оновлені після його останнього листа. Використовує канали вище; ігноровані типи ніколи не надсилають сповіщень."

msgid "Mailspur sees that your site sent it, not the inbox itself. If it is not there, ask the recipient to check the spam folder."
msgstr "Mailspur бачить, що ваш сайт його надіслав, але не бачить саму поштову скриньку. Якщо листа там немає, попросіть одержувача перевірити папку «Спам»."

msgid "Mailspur stops these emails now; their email type is ignored."
msgstr "Mailspur тепер зупиняє ці листи; їхній тип листа ігнорується."

msgid "Mailspur – Email Log"
msgstr "Mailspur – Журнал листів"

msgid "Mailspur: emails held"
msgstr "Mailspur: листи затримано"

msgid "Mailspur: staging mode"
msgstr "Mailspur: тестовий режим"

msgid "Main source: %1$s (%2$s emails)."
msgstr "Головне джерело: %1$s (листів: %2$s)."

msgid "Make sure the From address in the mailer plugin matches the verified domain."
msgstr "Переконайтеся, що адреса From у поштовому плагіні відповідає підтвердженому домену."

msgid "Make sure the email is sent with \"charset=UTF-8\", template files are saved as UTF-8 and the database tables use utf8mb4. Fix texts that were already stored broken."
msgstr "Переконайтеся, що лист надсилається з «charset=UTF-8», файли шаблонів збережено в UTF-8, а таблиці бази даних використовують utf8mb4. Виправте тексти, які вже збережено пошкодженими."

msgid "Make sure the encryption setting matches the port."
msgstr "Переконайтеся, що налаштування шифрування відповідає порту."

msgid "Many emails could not be sent recently"
msgstr "Останнім часом багато листів не вдалося надіслати"

msgid "Many exclamation marks in the subject (%1$s)"
msgstr "Багато знаків оклику в темі (%1$s)"

msgid "Many mail clients block images until the reader allows them. Without alt text the reader only sees empty boxes; screen readers announce nothing useful."
msgstr "Багато поштових клієнтів блокують зображення, доки читач їх не дозволить. Без альтернативного тексту читач бачить лише порожні рамки, а програми зчитування з екрана не озвучують нічого корисного."

msgid "Mark as resolved"
msgstr "Позначити як вирішене"

msgid "Marked as spam"
msgstr "Позначено як спам"

msgid "Marked as spam by the recipient"
msgstr "Одержувач позначив як спам"

msgid "Mask password-reset, activation and access keys in logged links as well as passwords, API keys and card numbers sent in plain text"
msgstr "Маскувати ключі скидання пароля, активації та доступу в записаних посиланнях, а також паролі, ключі API й номери карток, надіслані відкритим текстом"

msgid "Maybe later"
msgstr "Можливо, пізніше"

msgid "Maybe the email was never sent – check the order status and the settings of your shop’s emails."
msgstr "Можливо, лист так і не було надіслано – перевірте статус замовлення та налаштування листів вашого магазину."

msgid "Menu position"
msgstr "Розташування в меню"

msgid "Message"
msgstr "Повідомлення"

msgid "Method"
msgstr "Метод"

msgid "Microsoft 365 / Exchange Online blocks SMTP login (basic authentication) for this mailbox or the whole organization."
msgstr "Microsoft 365 / Exchange Online блокує вхід SMTP (базову автентифікацію) для цієї поштової скриньки або всієї організації."

msgid "Minutes"
msgstr "Хвилини"

msgid "Monday"
msgstr "Понеділок"

msgid "Monitor again"
msgstr "Знову відстежувати"

msgid "Monitoring alerts"
msgstr "Попередження моніторингу"

msgid "More"
msgstr "Більше"

msgid "More actions"
msgstr "Інші дії"

msgid "More filters"
msgstr "Більше фільтрів"

msgid "Most common reason (%1$s of them): %2$s."
msgstr "Найчастіша причина (%1$s з них): %2$s."

msgid "Most servers accept 10–25 MB in total."
msgstr "Більшість серверів приймають загалом 10–25 МБ."

msgid "Multiple DMARC records found. Receivers ignore DMARC in this case – keep only one."
msgstr "Знайдено кілька записів DMARC. У такому разі одержувачі ігнорують DMARC – залиште лише один."

msgid "Multiple SPF records found. Receivers treat this as an error (PermError) – merge them into one record."
msgstr "Знайдено кілька записів SPF. Одержувачі вважають це помилкою (PermError) – об'єднайте їх в один запис."

msgid "Needs attention"
msgstr "Потребує уваги"

msgid "Neither a From header nor a sender was recorded. The mailer falls back to its default, often wordpress@yourdomain."
msgstr "Не записано ні заголовка From, ні відправника. Поштова програма використає значення за замовчуванням, часто wordpress@yourdomain."

msgid "Never"
msgstr "Ніколи"

msgid "New"
msgstr "Новий"

msgid "New URL created. Update it at your email provider."
msgstr "Нову URL-адресу створено. Оновіть її у свого поштового провайдера."

msgid "New email types"
msgstr "Нові типи листів"

msgid "New emails are held until you release or discard them. Password reset emails still go out."
msgstr "Нові листи затримуються, доки ви їх не звільните або не відхилите. Листи для скидання пароля все одно надсилаються."

msgid "New sender"
msgstr "Новий відправник"

msgid "New sender writes to many addresses"
msgstr "Новий відправник пише на багато адрес"

msgid "Next email"
msgstr "Наступний лист"

msgid "Next email (j)"
msgstr "Наступний лист (j)"

msgid "Next page"
msgstr "Наступна сторінка"

msgid "No DKIM key found under the common selectors."
msgstr "Під поширеними селекторами ключ DKIM не знайдено."

msgid "No DMARC record for the sender domain %s"
msgstr "Немає запису DMARC для домену відправника %s"

msgid "No DMARC record found. Large mailbox providers expect one, and without it anyone can spoof this domain unnoticed."
msgstr "Запис DMARC не знайдено. Великі поштові провайдери очікують його наявності, а без нього будь-хто може непомітно підробити цей домен."

msgid "No MX record: this domain cannot receive replies or bounces, and some receivers reject such senders."
msgstr "Немає запису MX: цей домен не може отримувати відповіді чи повернення, і деякі одержувачі відхиляють таких відправників."

msgid "No SMTP transcript for this email."
msgstr "Для цього листа немає протоколу SMTP."

msgid "No SPF and no DMARC record for the sender domain %s"
msgstr "Немає записів SPF і DMARC для домену відправника %s"

msgid "No SPF record for the sender domain %s"
msgstr "Немає запису SPF для домену відправника %s"

msgid "No SPF record found. Receivers cannot tell which servers may send for this domain."
msgstr "Запис SPF не знайдено. Одержувачі не можуть визначити, які сервери мають право надсилати від імені цього домену."

msgid "No alerts sent yet."
msgstr "Попереджень ще не надсилалося."

msgid "No connection to the SMTP server"
msgstr "Немає з’єднання із сервером SMTP"

msgid "No email logged for %s hours"
msgstr "Жодного листа не записано вже %s год"

msgid "No email was logged in the last %1$s hours, although this site sent emails in this time window on %2$s of the last %3$s days (on average %4$s)."
msgstr "За останні %1$s год не записано жодного листа, хоча цей сайт надсилав листи в цьому проміжку часу в %2$s з останніх %3$s днів (у середньому %4$s)."

msgid "No emails"
msgstr "Немає листів"

msgid "No emails found."
msgstr "Листів не знайдено."

msgid "No emails in this period."
msgstr "За цей період листів немає."

msgid "No emails logged for this order yet."
msgstr "Для цього замовлення ще не записано жодного листа."

msgid "No emails logged yet. Email types appear here as soon as your site sends emails."
msgstr "Ще не записано жодного листа. Типи листів з’являться тут, щойно ваш сайт почне надсилати листи."

msgid "No emails match these filters."
msgstr "Жоден лист не відповідає цим фільтрам."

msgid "No emails sent"
msgstr "Листи не надсилалися"

msgid "No emails to this user in the log."
msgstr "У журналі немає листів цьому користувачу."

msgid "No emails were logged in the last two weeks."
msgstr "За останні два тижні не записано жодного листа."

msgid "No limit"
msgstr "Без обмежень"

msgid "No log of another mail logging plugin was found on this site."
msgstr "На цьому сайті не знайдено журналу іншого плагіна журналювання листів."

msgid "No log of this plugin was found on this site."
msgstr "На цьому сайті не знайдено журналу цього плагіна."

msgid "No problem recipients."
msgstr "Немає проблемних одержувачів."

msgid "No problems found in this email."
msgstr "У цьому листі проблем не знайдено."

msgid "No public sender domain found (the site address is not a domain name and the log has no senders yet)."
msgstr "Публічний домен відправника не знайдено (адреса сайту не є доменним ім'ям, а в журналі ще немає відправників)."

msgid "No public sender domain to check"
msgstr "Немає публічного домену відправника для перевірки"

msgid "No regularly sent email has stopped"
msgstr "Жоден регулярний лист не припинився"

msgid "No report address (rua) – you will not see who sends in your name."
msgstr "Немає адреси для звітів (rua) – ви не бачитимете, хто надсилає від вашого імені."

msgid "No sender address recorded"
msgstr "Адресу відправника не записано"

msgid "No trace is available for this entry. It was logged before the trace existed or by a version without it."
msgstr "Для цього запису трасування недоступне. Його записано до появи трасування або версією без нього."

msgid "No unusual email failures"
msgstr "Немає незвичних збоїв листів"

msgid "No, on purpose. “%1$s” to %2$s was held %3$s and not sent. Reason: %4$s."
msgstr "Ні, навмисно. «%1$s» для %2$s було затримано %3$s і не надіслано. Причина: %4$s."

msgid "No. Every email that goes out regularly arrived on schedule."
msgstr "Ні. Усі регулярні листи надійшли за графіком."

msgid "No. “%1$s” to %2$s failed %3$s. Reason: %4$s."
msgstr "Ні. «%1$s» для %2$s не вдалося надіслати %3$s. Причина: %4$s."

msgid "No. “%1$s” to %2$s left your site %3$s, but %4$s reports that the receiving server rejected it."
msgstr "Ні. «%1$s» для %2$s залишив ваш сайт %3$s, але %4$s повідомляє, що сервер одержувача його відхилив."

msgid "None"
msgstr "Немає"

msgid "Normally sent at least every %1$s days, now overdue by %2$s."
msgstr "Зазвичай надсилається щонайменше кожні %1$s дн., зараз запізнюється на %2$s."

msgid "Not all selectors could be checked in time."
msgstr "Не всі селектори вдалося перевірити вчасно."

msgid "Not recorded: another plugin had SMTP debugging switched on."
msgstr "Не записано: в іншому плагіні було ввімкнено налагодження SMTP."

msgid "Not recorded: the SMTP transcript is switched off in the settings."
msgstr "Не записано: протокол SMTP вимкнено в налаштуваннях."

msgid "Not recorded: this email was not sent via SMTP."
msgstr "Не записано: цей лист надіслано не через SMTP."

msgid "Not set up"
msgstr "Не налаштовано"

msgid "Not stored: transcripts are only kept for failed emails."
msgstr "Не збережено: протоколи зберігаються лише для невдалих листів."

msgid "Not yet. “%1$s” to %2$s left your site %3$s, but %4$s reports a temporary problem."
msgstr "Ще ні. «%1$s» для %2$s залишив ваш сайт %3$s, але %4$s повідомляє про тимчасову проблему."

msgid "Notes"
msgstr "Примітки"

msgid "Notes in the latest email: %s"
msgstr "Примітки в останньому листі: %s"

msgid "Notes: %1$s. %2$s"
msgstr "Примітки: %1$s. %2$s"

msgid "Notes: %s"
msgstr "Примітки: %s"

msgid "Nothing else is expected today."
msgstr "Сьогодні більше нічого не очікується."

msgid "Nothing failed in the last 7 days."
msgstr "За останні 7 днів збоїв не було."

msgid "Nothing to compare yet: no email goes out regularly enough for Mailspur to notice a gap."
msgstr "Поки що немає з чим порівнювати: жоден лист не надсилається достатньо регулярно, щоб Mailspur помітив перерву."

msgid "Number of failed emails"
msgstr "Кількість невдалих листів"

msgid "Numbers are ignored, so “Order #123” and “Order #124” count together."
msgstr "Числа ігноруються, тому «Замовлення #123» і «Замовлення #124» рахуються разом."

msgid "OK"
msgstr "OK"

msgid "Of the last %1$s emails sent while someone waited for the page, half took longer than %2$s s (average %3$s s)."
msgstr "З останніх листів (%1$s), надісланих, поки хтось чекав на сторінку, половина тривала довше за %2$s с (у середньому %3$s с)."

msgid "Off"
msgstr "Вимкнено"

msgid "Off by default. Without it, \"Download .eml\" rebuilds the message from the logged (redacted) data. The raw source contains password-reset links and other secrets exactly as sent – only enable it when you need it and both boxes are checked."
msgstr "Типово вимкнено. Без цього «Завантажити .eml» відтворює повідомлення із записаних (знеособлених) даних. Необроблене джерело містить посилання для скидання пароля та інші секрети точно в тому вигляді, як їх надіслано, – вмикайте лише за потреби, коли позначено обидва прапорці."

msgid "Off – deliver emails normally"
msgstr "Вимкнено – доставляти листи як зазвичай"

msgid "Once the cause is fixed, you can send the email again from the log."
msgstr "Коли причину буде усунено, ви зможете знову надіслати лист із журналу."

msgid "Once your reports show that legitimate mail passes, switch to p=quarantine (or p=reject)."
msgstr "Коли звіти покажуть, що легітимні листи проходять перевірку, перейдіть на p=quarantine (або p=reject)."

msgid "One of the two emails was deleted or anonymised by the retention settings, so they can no longer be compared."
msgstr "Один із двох листів було видалено або анонімізовано відповідно до налаштувань зберігання, тому їх більше не можна порівняти."

msgid "Only administrators can empty the log."
msgstr "Лише адміністратори можуть очищувати журнал."

msgid "Only administrators can send emails to other addresses."
msgstr "Лише адміністратори можуть надсилати листи на інші адреси."

msgid "Only alerts when the last 14 days show that emails are normally sent in this time window (on at least 10 of 14 days, including the same weekday), so quiet nights or weekends do not trigger it."
msgstr "Попереджає лише тоді, коли останні 14 днів показують, що в цьому проміжку часу листи зазвичай надсилаються (щонайменше в 10 із 14 днів, зокрема в той самий день тижня), тож тихі ночі чи вихідні його не спрацьовують."

msgid "Only emails whose recipients are all problem recipients. Password reset emails always go out; held emails can still be sent from the log (\"Send now\")."
msgstr "Лише листи, усі одержувачі яких є проблемними. Листи для скидання пароля надсилаються завжди; затримані листи все ще можна надіслати з журналу («Надіслати зараз»)."

msgid "Only held emails can be released."
msgstr "Звільнити можна лише затримані листи."

msgid "Open distribution list: %1$s external recipients see each other's addresses"
msgstr "Відкритий список розсилки: зовнішні одержувачі (%1$s) бачать адреси одне одного"

msgid "Open in log"
msgstr "Відкрити в журналі"

msgid "Open latest"
msgstr "Відкрити останній"

msgid "Open staging mode"
msgstr "Відкрити тестовий режим"

msgid "Open the email types"
msgstr "Відкрити типи листів"

msgid "Open the emergency brake"
msgstr "Відкрити аварійне гальмо"

msgid "Open the log"
msgstr "Відкрити журнал"

msgid "Open the log or debug view of your mailer plugin for the exact error."
msgstr "Відкрийте журнал або режим налагодження свого поштового плагіна, щоб побачити точну помилку."

msgid "Open the mail log"
msgstr "Відкрити журнал листів"

msgid "Open the sender check"
msgstr "Відкрити перевірку відправника"

msgid "Optional and off by default. When enabled, Mailspur checks the log regularly and notifies you about failure spikes, unusual silence or stopped email types. Alerts go only to the addresses and the webhook you enter here; they contain the site name, the alert text (for a stopped email type: its sender and subject pattern) and a link to the log – never email contents or recipients."
msgstr "Необов'язково й типово вимкнено. Якщо ввімкнено, Mailspur регулярно перевіряє журнал і повідомляє вас про сплески збоїв, незвичну тишу або типи листів, що перестали надсилатися. Попередження надходять лише на адреси та вебхук, які ви тут вкажете; вони містять назву сайту, текст попередження (для типу листа, що перестав надсилатися: його відправника й шаблон теми) і посилання на журнал – ніколи не вміст листів чи одержувачів."

msgid "Optional, https only. Slack and Discord webhook URLs receive a chat message, any other URL a JSON POST request. The request is made by your server to exactly this URL – no other service is involved."
msgstr "Необов'язково, лише https. URL-адреси вебхуків Slack і Discord отримують повідомлення в чат, будь-яка інша URL-адреса – запит JSON POST. Запит надсилає ваш сервер саме на цю URL-адресу – інші сервіси не залучаються."

msgid "Or add the address as an alias / \"send as\" permission at your mail provider."
msgstr "Або додайте адресу як псевдонім / дозвіл «надсилати як» у свого поштового провайдера."

msgid "Order #%s"
msgstr "Замовлення #%s"

msgid "Order data"
msgstr "Дані замовлення"

