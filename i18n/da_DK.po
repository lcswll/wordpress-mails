msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: da_DK\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "»Download .eml« genopbygger beskeden ud fra de loggede, maskerede data (uden vedhæftede filer)."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (forrige uge: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (planlagt til %2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s e-mailtype er stoppet: %2$s."
msgstr[1] "%1$s e-mailtyper er stoppet, fx %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "%1$s e-mailtyper fra %2$s afsendere"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "%1$s e-mails mislykkedes inden for de seneste %2$s minutter."

msgid "%1$s emails in %2$s days"
msgstr "%1$s e-mails på %2$s dage"

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "%1$s e-mails inden for de seneste 30 dage, %2$s mislykkedes"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "Der blev sendt %1$s e-mails inden for en time – langt flere end normalt (grænse: %2$s pr. time). En kontaktformular kan være misbrugt, eller webstedet kan være kompromitteret."

msgid "%1$s entries, %2$s"
msgstr "%1$s poster, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "%1$s importeret, %2$s dubletter, %3$s for gamle"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "%1$s af %2$s afvist (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "%1$s af %2$s e-mails i de seneste %3$s dage kunne ikke sendes."

msgid "%1$s of %2$s entries processed …"
msgstr "%1$s af %2$s poster behandlet …"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s procentpoint vs. %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "%1$s sendte sin første e-mail den %2$s og har skrevet til %3$s forskellige eksterne adresser inden for de seneste 24 timer. Hvis du ikke har installeret eller sat noget op, der sender sådanne e-mails, så tjek webstedet: en ny afsender kan være tegn på et hacket websted."

msgid "%1$s sent, %2$s still held …"
msgstr "%1$s sendt, %2$s stadig tilbageholdt …"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s vs. %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · %2$s e-mails samlet siden den seneste oversigt"

msgid "%1$s · as of %2$s"
msgstr "%1$s · pr. %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – fejlrate %2$s %% (forrige uge: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – rapporteret af %2$s, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (must-use-plugin)"

msgid "%s (theme)"
msgstr "%s (tema)"

msgid "%s ago"
msgstr "for %s siden"

msgid "%s days"
msgstr "%s dage"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "%s e-mail mislykkedes inden for de seneste 7 dage."
msgstr[1] "%s e-mails mislykkedes inden for de seneste 7 dage."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s e-mail venter på din beslutning."
msgstr[1] "%s e-mails venter på din beslutning."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "%s e-mail blev tilbageholdt og ikke sendt inden for de seneste 7 dage."
msgstr[1] "%s e-mails blev tilbageholdt og ikke sendt inden for de seneste 7 dage."

msgid "%s emails are held by the emergency brake."
msgstr "%s e-mails er tilbageholdt af nødbremsen."

msgid "%s emails are waiting and have not been delivered."
msgstr "%s e-mails venter og er ikke blevet leveret."

msgid "%s entries"
msgstr "%s poster"

msgid "%s failed"
msgstr "%s mislykkedes"

msgid "%s held emails discarded."
msgstr "%s tilbageholdte e-mails kasseret."

msgid "%s imported entries removed."
msgstr "%s importerede poster fjernet."

msgid "%s in 30 days"
msgstr "%s på 30 dage"

msgid "%s marked as spam"
msgstr "%s markeret som spam"

msgid "%s more on the Email types page."
msgstr "%s mere på siden E-mailtyper."

msgid "%s notes"
msgstr "%s bemærkninger"

msgid "%s of all emails"
msgstr "%s af alle e-mails"

msgid "%s of them in the last 24 hours."
msgstr "%s af dem inden for de seneste 24 timer."

msgid "%s s"
msgstr "%s s"

msgid "%s selected"
msgstr "%s valgt"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s ting kræver opmærksomhed:"
msgstr[1] "%s ting kræver opmærksomhed:"

msgid "%s to administrators in 30 days"
msgstr "%s til administratorer på 30 dage"

msgid "%s unchanged lines"
msgstr "%s uændrede linjer"

msgid "(no subject)"
msgstr "(intet emne)"

msgid "(no text content)"
msgstr "(intet tekstindhold)"

msgid "(the emails are no longer in the log)"
msgstr "(e-mailene er ikke længere i loggen)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "-all er strengere; ~all er almindeligt og fint sammen med DMARC."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "0 beholder poster for altid. Oprydningen kører én gang om dagen."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "0 betyder ingen grænse. De ældste poster fjernes først."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "0 slår det fra. Fjerner indhold, headers og vedhæftede filer fra ældre poster og maskerer adresserne (a***@example.com). Dato, status, kilde, format, størrelse og bemærkninger bevares til statistikken. Kører sammen med den daglige oprydning, før poster slettes – så det har kun effekt, hvis perioden er kortere end sletteperioden ovenfor."

msgid "12 months"
msgstr "12 måneder"

msgid "30 days"
msgstr "30 dage"

msgid "7 days"
msgstr "7 dage"

msgid "90 days"
msgstr "90 dage"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "En DKIM-selektor må kun indeholde bogstaver, cifre, punktummer, bindestreger og understregninger."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "Et mailer-plugin, der sender via en API, overtog leveringen og rapporterede, at afsendelsen mislykkedes, uden at angive en årsag."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "En offentliggjort nøgle beviser ikke, at dine e-mails signeres med den – tjek DKIM-resultatet i headerne på en modtaget e-mail."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "En modtager eller afsenderadressen er ikke en gyldig e-mailadresse, så PHPMailer nægtede at sende."

msgid "API key or private key in plain text: %1$s"
msgstr "API-nøgle eller privat nøgle i ren tekst: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "Der kræves ca. %1$s DNS-opslag for at evaluere denne post – flere end de tilladte %2$s, så modtagere kan ignorere den (PermError). Fjern ubrugte include:-angivelser."

msgid "Access"
msgstr "Adgang"

msgid "Actions"
msgstr "Handlinger"

msgid "Active: alerts on %s."
msgstr "Aktiv: advarsler ved %s."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "Tilføj en kort alt-attribut til hvert billede i skabelonen, fx alt=\"Logo Eksempelbutik\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "Tilføj din mailudbyders include: (fx include:_spf.google.com), hvis du sender via en udbyder."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "Tilføj din mailserver eller mailtjeneste til SPF-posten for afsenderdomænet."

msgid "Added:"
msgstr "Tilføjet:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "Adresser med mindst %s hårde fejl: den modtagende server afviste postkassen, domænet har ingen mailserver, eller din e-mailudbyder rapporterede en hard bounce. Posterne udløber med loggens opbevaringsperiode."

msgid "Admin screen"
msgstr "Administrationsskærm"

msgid "Administrators"
msgstr "Administratorer"

msgid "Aggregate reports go to %s."
msgstr "Samlede rapporter sendes til %s."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "Advarsel"

msgid "Alert and hold further emails"
msgstr "Advar og tilbagehold yderligere e-mails"

msgid "Alert only"
msgstr "Kun advarsel"

msgid "Alert when an email type that is sent regularly stops"
msgstr "Advar, når en e-mailtype, der sendes regelmæssigt, stopper"

msgid "Alert when emails fail repeatedly"
msgstr "Advar, når e-mails mislykkes gentagne gange"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "Advar, når webstedet uventet holder op med at sende e-mails"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "Advarsler er slået til, men har ingen kanal: indtast en e-mailadresse eller en webhook-URL."

msgid "Alerts are off."
msgstr "Advarsler er slået fra."

msgid "All"
msgstr "Alle"

msgid "All email types look healthy."
msgstr "Alle e-mailtyper ser sunde ud."

msgid "All emails are redirected to test addresses."
msgstr "Alle e-mails omdirigeres til testadresser."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "Alle e-mails går til testadresser i stedet for de rigtige modtagere."

msgid "All sources"
msgstr "Alle kilder"

msgid "Allow again"
msgstr "Tillad igen"

msgid "Allowed again."
msgstr "Tilladt igen."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "Advarer også én gang, når et plugin eller tema, der aldrig før har sendt en e-mail, skriver til mange forskellige eksterne adresser inden for en dag – et muligt tegn på et hacket websted. De første to uger efter installation af Mailspur er udgangspunktet."

msgid "Also remove the subject when anonymising"
msgstr "Fjern også emnet ved anonymisering"

msgid "Also search content"
msgstr "Søg også i indhold"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "Alternativt kan du bede din webhost om at aktivere mail() / sendmail for dette websted."

msgid "Always load remote images and fonts in the preview"
msgstr "Indlæs altid eksterne billeder og skrifttyper i forhåndsvisningen"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (via SNS)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "En e-mailudbyder med en HTTP-API i stedet for SMTP kræver færre forespørgsler frem og tilbage pr. e-mail."

msgid "Anonymisation"
msgstr "Anonymisering"

msgid "Anonymise entries after"
msgstr "Anonymisér poster efter"

msgid "Anonymised"
msgstr "Anonymiseret"

msgid "Any format"
msgstr "Alle formater"

msgid "Any status"
msgstr "Alle statusser"

msgid "Apply"
msgstr "Anvend"

msgid "Ask the recipient for a working address."
msgstr "Bed modtageren om en adresse, der virker."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "Bed din webhost om at aktivere openssl-udvidelsen (eller aktivér den i PHP-indstillingerne i dit hostingpanel)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "Bed din webhost om at opdatere serverens CA-certifikater og OpenSSL."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "Spørg din webhost, om udgående SMTP-forbindelser er blokeret."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "Spørg din webhost, om udgående forbindelser til den port er tilladt (firewall)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "Mindst %1$s mislykkede e-mails inden for %2$s minutter"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "Højst én advarsel pr. type inden for dette tidsrum, selv hvis problemet fortsætter."

msgid "Attachments"
msgstr "Vedhæftede filer"

msgid "Attachments no longer available: %s"
msgstr "Vedhæftede filer er ikke længere tilgængelige: %s"

msgid "Authentication"
msgstr "Godkendelse"

msgid "Automatic TLS"
msgstr "Automatisk TLS"

msgid "Average per day"
msgstr "Gennemsnit pr. dag"

msgid "Back to the email types"
msgstr "Tilbage til e-mailtyperne"

msgid "Belongs to"
msgstr "Hører til"

msgid "Block again"
msgstr "Bloker igen"

msgid "Blocked as spam or by a blocklist"
msgstr "Blokeret som spam eller af en blokeringsliste"

msgid "Bounced (permanent)"
msgstr "Afvist (permanent)"

msgid "Bounced (temporary)"
msgstr "Afvist (midlertidigt)"

msgid "Broken characters (encoding): %1$s"
msgstr "Ødelagte tegn (kodning): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "Masseudsendelse uden afmeldingsheader (%1$s modtagere)"

msgid "Bundle into one daily email"
msgstr "Saml i én daglig e-mail"

msgid "Bundled into one daily email"
msgstr "Samlet i én daglig e-mail"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "Samling er slået fra. E-mails, der ventede, er nu sendt i én oversigt."

msgid "Busiest day"
msgstr "Travleste dag"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "Annullér"

msgid "Careful: emails to this address failed several times before."
msgstr "Bemærk: e-mails til denne adresse er mislykkedes flere gange før."

msgid "Change in the email types"
msgstr "Ændring i e-mailtyperne"

msgid "Change staging mode"
msgstr "Skift staging-tilstand"

msgid "Check"
msgstr "Tjek"

msgid "Check again"
msgstr "Tjek igen"

msgid "Check emails"
msgstr "Kontrollér e-mails"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "Tjek vært og port; prøv 587 (TLS) i stedet for 465 (SSL) eller omvendt."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "Tjek vært, port, kryptering, brugernavn og adgangskode i dit SMTP-plugin, og send en test-e-mail derfra."

msgid "Check sender domains"
msgstr "Tjek afsenderdomæner"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "Tjek, at krypteringen passer til porten: TLS til 587, SSL til 465."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "Tjek, at nøglen hører til den rigtige region / konto (fx EU- vs. US-endpoint)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "Tjek SMTP-værten og porten: en forkert port eller en blokeret forbindelse ender ofte i timeout, før en reserveløsning virker."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "Tjek SPF-, DKIM- og DMARC-posterne for afsenderdomænet, eller brug en afsenderadresse på det domæne, du sender fra."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "Tjek adressen for slåfejl – eller også blev e-mailen aldrig sendt af dit websted."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "Tjek adressen med modtageren, og ret den der, hvor den er gemt (brugerprofil, ordre, formularindsendelse)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "Tjek adressen med modtageren, og ret den der, hvor den er gemt."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "Tjek værtsnavn og port: 587 med STARTTLS (TLS) eller 465 med SSL. Port 25 blokeres af de fleste webhosts."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "Tjek grænserne og det aktuelle forbrug på din konto hos mailtjenesten; opgradér planen om nødvendigt."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "Tjek modtageradresserne i denne post for slåfejl, mellemrum eller manglende dele."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
msgstr "Tjek afsenderadressen i dit SMTP-plugin og filteret wp_mail_from."

msgid "Check the sending limits of your mail account and the notes of this email."
msgstr "Tjek afsendelsesgrænserne for din mailkonto og bemærkningerne til denne e-mail."

msgid "Check the server IP on a blocklist checker and request delisting."
msgstr "Tjek serverens IP-adresse med et blokeringslisteværktøj, og anmod om fjernelse."

msgid "Check the spelling of the placeholder in the template and whether the plugin supports it for this email type. Shortcodes are not processed in emails unless the sending plugin runs do_shortcode()."
msgstr "Tjek stavningen af pladsholderen i skabelonen, og om pluginnet understøtter den for denne e-mailtype. Shortcodes behandles ikke i e-mails, medmindre det afsendende plugin kører do_shortcode()."

msgid "Checked %s."
msgstr "Tjekket %s."

msgid "Checked just now"
msgstr "Tjekket for et øjeblik siden"

msgid "Checking DNS records …"
msgstr "Tjekker DNS-poster …"

msgid "Checks the DNS records of the domains your site sends from: the default sender address and the most frequent senders in the log. Missing or weak records are the most common reason why emails land in spam. Only your server's own DNS resolver is used; results are kept for one hour."
msgstr "Tjekker DNS-posterne for de domæner, dit websted sender fra: standardafsenderadressen og de hyppigste afsendere i loggen. Manglende eller svage poster er den mest almindelige årsag til, at e-mails havner i spam. Kun din servers egen DNS-resolver bruges; resultaterne gemmes i en time."

msgid "Choose a range of at most %s days."
msgstr "Vælg et interval på højst %s dage."

msgid "Clear selection"
msgstr "Ryd markering"

msgid "Click a bar to open these emails in the log."
msgstr "Klik på en søjle for at åbne disse e-mails i loggen."

msgid "Close"
msgstr "Luk"

msgid "Close (Esc)"
msgstr "Luk (Esc)"

msgid "Colour scheme"
msgstr "Farveskema"

msgid "Command line"
msgstr "Kommandolinje"

msgid "Compare"
msgstr "Sammenlign"

msgid "Compare the sources of these entries. Check whether two plugins send the same notification, or whether a hook (e.g. order status change) fires more than once."
msgstr "Sammenlign kilderne for disse poster. Tjek, om to plugins sender den samme notifikation, eller om en hook (fx ændring af ordrestatus) udløses mere end én gang."

msgid "Component"
msgstr "Komponent"

msgid "Configure alerts"
msgstr "Konfigurér advarsler"

msgid "Content anonymised after %1$s days, %2$s"
msgstr "Indhold anonymiseret efter %1$s dage, %2$s"

msgid "Content change marked as seen."
msgstr "Indholdsændring markeret som set."

msgid "Content changed"
msgstr "Indhold ændret"

msgid "Content changed on %1$s, after the %2$s update."
msgstr "Indhold ændret den %1$s efter opdateringen af %2$s."

msgid "Content changed on %s."
msgstr "Indhold ændret den %s."

msgid "Content removed"
msgstr "Indhold fjernet"

msgid "Content removed after %s days"
msgstr "Indhold fjernet efter %s dage"

msgid "Content, headers and attachments were removed and the addresses masked by the anonymisation setting."
msgstr "Indhold, headers og vedhæftede filer er fjernet, og adresserne er maskeret af indstillingen for anonymisering."

msgid "Copied"
msgstr "Kopieret"

msgid "Copied – paste it into your reply."
msgstr "Kopieret – indsæt det i dit svar."

msgid "Copies a short sentence for answering the customer: when the email was sent to whom and whether it arrived – without technical details."
msgstr "Kopierer en kort sætning til dit svar til kunden: hvornår e-mailen blev sendt til hvem, og om den kom frem – uden tekniske detaljer."

msgid "Copies the existing log of another mail logging plugin into Mailspur, so old emails can be searched and previewed here. The other plugin and its data stay untouched; running the import again only adds new entries."
msgstr "Kopierer den eksisterende log fra et andet plugin til e-maillogning ind i Mailspur, så gamle e-mails kan søges i og forhåndsvises her. Det andet plugin og dets data forbliver urørt; kører du importen igen, tilføjes kun nye poster."

msgid "Copy"
msgstr "Kopiér"

msgid "Copy for support"
msgstr "Kopiér til support"

msgid "Copying is not possible in this browser. Select the text and copy it:"
msgstr "Kopiering er ikke mulig i denne browser. Markér teksten, og kopiér den:"

msgid "Correct the address (e.g. in the user profile or order) and consider an email validation in your forms."
msgstr "Ret adressen (fx i brugerprofilen eller ordren), og overvej validering af e-mailadresser i dine formularer."

msgid "Counted once per email."
msgstr "Tælles én gang pr. e-mail."

msgid "Create a new API key with send permission at your mail service and enter it in the mailer plugin."
msgstr "Opret en ny API-nøgle med afsendelsestilladelse hos din mailtjeneste, og indtast den i mailer-pluginnet."

msgid "Create a new webhook URL? The current URL stops working at once – paste the new URL into the webhook settings of your email provider."
msgstr "Opret en ny webhook-URL? Den nuværende URL holder straks op med at virke – indsæt den nye URL i webhook-indstillingerne hos din e-mailudbyder."

msgid "Create new URL"
msgstr "Opret ny URL"

msgid "Current page"
msgstr "Nuværende side"

msgid "Current record"
msgstr "Nuværende post"

msgid "Current size"
msgstr "Nuværende størrelse"

msgid "Custom"
msgstr "Brugerdefineret"

msgid "DKIM key found (selector: %s)."
msgstr "DKIM-nøgle fundet (selektor: %s)."

msgid "DMARC record found with p=none: reports only, spoofed mail is still delivered."
msgstr "DMARC-post fundet med p=none: kun rapporter, forfalskede e-mails leveres stadig."

msgid "DMARC record found with policy p=%s."
msgstr "DMARC-post fundet med politik p=%s."

msgid "DMARC record has no valid policy (p=none, quarantine or reject)."
msgstr "DMARC-posten har ingen gyldig politik (p=none, quarantine eller reject)."

msgid "DNS lookup failed or timed out. Try again later."
msgstr "DNS-opslag mislykkedes eller fik timeout. Prøv igen senere."

msgid "DNS lookups are not available on this server (dns_get_record() is disabled), so the sender check cannot run here."
msgstr "DNS-opslag er ikke tilgængelige på denne server (dns_get_record() er deaktiveret), så afsendertjekket kan ikke køre her."

msgid "DNS lookups needed: about %1$s of %2$s allowed."
msgstr "Nødvendige DNS-opslag: ca. %1$s af %2$s tilladte."

msgid "Daily"
msgstr "Dagligt"

msgid "Daily digest"
msgstr "Daglig oversigt"

msgid "Dark"
msgstr "Mørk"

msgid "Date"
msgstr "Dato"

msgid "Default (%s days)"
msgstr "Standard (%s dage)"

msgid "Default (no time limit)"
msgstr "Standard (ingen tidsgrænse)"

msgid "Default sender"
msgstr "Standardafsender"

msgid "Delete"
msgstr "Slet"

msgid "Delete %s selected log entries?"
msgstr "Slet %s valgte logposter?"

