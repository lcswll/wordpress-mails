msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: fa_IR\n"
"Plural-Forms: nplurals=1; plural=0;\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "«دانلود .eml» پیام را از داده‌های ثبت‌شده و پالایش‌شده (بدون پیوست‌ها) بازسازی می‌کند."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (هفته قبل: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (زمان‌بندی‌شده برای %2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s نوع ایمیل متوقف شده است، برای نمونه %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "%1$s نوع ایمیل از %2$s فرستنده"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "%1$s ایمیل در %2$s دقیقه گذشته ناموفق بودند."

msgid "%1$s emails in %2$s days"
msgstr "%1$s ایمیل در %2$s روز"

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "%1$s ایمیل در ۳۰ روز گذشته، %2$s ناموفق"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "%1$s ایمیل در یک ساعت ارسال شد – خیلی بیشتر از معمول (آستانه: %2$s در ساعت). ممکن است از یک فرم تماس سوءاستفاده شده یا سایت به خطر افتاده باشد."

msgid "%1$s entries, %2$s"
msgstr "%1$s مورد، %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "%1$s درون‌ریزی شد، %2$s تکراری، %3$s بیش از حد قدیمی"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "%1$s از %2$s برگشت خورد (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "%1$s از %2$s ایمیل در %3$s روز گذشته ارسال نشد."

msgid "%1$s of %2$s entries processed …"
msgstr "%1$s از %2$s مورد پردازش شد …"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s واحد درصد در مقایسه با %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "%1$s نخستین ایمیل خود را در %2$s ارسال کرد و در ۲۴ ساعت گذشته به %3$s نشانی خارجی مختلف ایمیل فرستاده است. اگر چیزی نصب یا راه‌اندازی نکرده‌اید که چنین ایمیل‌هایی بفرستد، سایت را بررسی کنید: یک فرستنده جدید می‌تواند نشانه هک شدن سایت باشد."

msgid "%1$s sent, %2$s still held …"
msgstr "%1$s ارسال شد، %2$s هنوز نگه داشته شده …"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s در مقایسه با %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · %2$s ایمیل از آخرین خلاصه تاکنون یکجا شده‌اند"

msgid "%1$s · as of %2$s"
msgstr "%1$s · تا %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – نرخ ناموفق %2$s %% (هفته قبل: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – گزارش‌شده توسط %2$s، %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s، %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (افزونه ضروری)"

msgid "%s (theme)"
msgstr "%s (پوسته)"

msgid "%s ago"
msgstr "%s پیش"

msgid "%s days"
msgstr "%s روز"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "%s ایمیل در ۷ روز گذشته ناموفق بود."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s ایمیل منتظر تصمیم شماست."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "%s ایمیل در ۷ روز گذشته نگه داشته شد و ارسال نشد."

msgid "%s emails are held by the emergency brake."
msgstr "%s ایمیل توسط ترمز اضطراری نگه داشته شده است."

msgid "%s emails are waiting and have not been delivered."
msgstr "%s ایمیل در انتظار هستند و تحویل داده نشده‌اند."

msgid "%s entries"
msgstr "%s مورد"

msgid "%s failed"
msgstr "%s ناموفق"

msgid "%s held emails discarded."
msgstr "%s ایمیل نگه‌داشته‌شده دور انداخته شد."

msgid "%s imported entries removed."
msgstr "%s مورد درون‌ریزی‌شده حذف شد."

msgid "%s in 30 days"
msgstr "%s در ۳۰ روز"

msgid "%s marked as spam"
msgstr "%s علامت‌گذاری‌شده به‌عنوان هرزنامه"

msgid "%s more on the Email types page."
msgstr "%s مورد دیگر در برگه انواع ایمیل."

msgid "%s notes"
msgstr "%s یادداشت"

msgid "%s of all emails"
msgstr "%s از همه ایمیل‌ها"

msgid "%s of them in the last 24 hours."
msgstr "%s مورد از آن‌ها در ۲۴ ساعت گذشته."

msgid "%s s"
msgstr "%s ثانیه"

msgid "%s selected"
msgstr "%s انتخاب‌شده"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s مورد نیاز به توجه دارد:"

msgid "%s to administrators in 30 days"
msgstr "%s به مدیران در ۳۰ روز"

msgid "%s unchanged lines"
msgstr "%s خط بدون تغییر"

msgid "(no subject)"
msgstr "(بدون موضوع)"

msgid "(no text content)"
msgstr "(بدون محتوای متنی)"

msgid "(the emails are no longer in the log)"
msgstr "(ایمیل‌ها دیگر در لاگ نیستند)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "-all سخت‌گیرانه‌تر است؛ ~all رایج است و همراه با DMARC مناسب است."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "۰ موارد را برای همیشه نگه می‌دارد. پاک‌سازی روزی یک بار اجرا می‌شود."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "۰ یعنی بدون محدودیت. قدیمی‌ترین موارد ابتدا حذف می‌شوند."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "۰ آن را خاموش می‌کند. محتوا، سرایندها و پیوست‌های موارد قدیمی‌تر را حذف و نشانی‌ها را پنهان می‌کند (a***@example.com). تاریخ، وضعیت، منبع، قالب، اندازه و یادداشت‌ها برای آمار باقی می‌مانند. همراه با پاک‌سازی روزانه و پیش از حذف موارد اجرا می‌شود – پس فقط زمانی اثر دارد که کوتاه‌تر از دوره حذف بالا باشد."

msgid "12 months"
msgstr "۱۲ ماه"

msgid "30 days"
msgstr "۳۰ روز"

msgid "7 days"
msgstr "۷ روز"

msgid "90 days"
msgstr "۹۰ روز"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "انتخابگر DKIM فقط می‌تواند شامل حروف، ارقام، نقطه، خط تیره و زیرخط باشد."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "یک افزونه ارسال ایمیل که از طریق API ارسال می‌کند، تحویل را بر عهده گرفت و ناموفق بودن ارسال را بدون ذکر دلیل گزارش داد."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "کلید منتشرشده ثابت نمی‌کند که ایمیل‌های شما با آن امضا می‌شوند – نتیجه DKIM را در سرایندهای یک ایمیل دریافتی بررسی کنید."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "یکی از گیرندگان یا نشانی فرستنده، نشانی ایمیل معتبری نیست، بنابراین PHPMailer از ارسال خودداری کرد."

msgid "API key or private key in plain text: %1$s"
msgstr "کلید API یا کلید خصوصی به‌صورت متن ساده: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "برای ارزیابی این رکورد حدود %1$s جستجوی DNS لازم است – بیش از %2$s مجاز، بنابراین گیرندگان ممکن است آن را نادیده بگیرند (PermError). ورودی‌های include: استفاده‌نشده را حذف کنید."

msgid "Access"
msgstr "دسترسی"

msgid "Actions"
msgstr "کارها"

msgid "Active: alerts on %s."
msgstr "فعال: هشدار برای %s."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "به هر تصویر در قالب یک ویژگی alt کوتاه اضافه کنید، مثلاً alt=\"Logo Example Shop\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "اگر از طریق یک سرویس‌دهنده ایمیل ارسال می‌کنید، include: آن را اضافه کنید (مثلاً include:_spf.google.com)."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "سرور یا سرویس ایمیل خود را به رکورد SPF دامنه فرستنده اضافه کنید."

msgid "Added:"
msgstr "افزوده‌شده:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "نشانی‌هایی با دست‌کم %s خطای قطعی: سرور گیرنده صندوق پستی را رد کرده، دامنه سرور ایمیل ندارد، یا سرویس‌دهنده ایمیل شما برگشت قطعی گزارش داده است. موارد با دوره نگهداری لاگ منقضی می‌شوند."

msgid "Admin screen"
msgstr "صفحه مدیریت"

msgid "Administrators"
msgstr "مدیران"

msgid "Aggregate reports go to %s."
msgstr "گزارش‌های تجمیعی به %s ارسال می‌شوند."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "هشدار"

msgid "Alert and hold further emails"
msgstr "هشدار و نگه داشتن ایمیل‌های بعدی"

msgid "Alert only"
msgstr "فقط هشدار"

msgid "Alert when an email type that is sent regularly stops"
msgstr "هشدار هنگامی که یک نوع ایمیل منظم متوقف می‌شود"

msgid "Alert when emails fail repeatedly"
msgstr "هشدار هنگامی که ایمیل‌ها مکرراً ناموفق می‌شوند"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "هشدار هنگامی که سایت به‌طور غیرمنتظره ارسال ایمیل را متوقف می‌کند"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "هشدارها فعال هستند اما کانالی ندارند: یک نشانی ایمیل یا نشانی وب‌هوک وارد کنید."

msgid "Alerts are off."
msgstr "هشدارها خاموش هستند."

msgid "All"
msgstr "همه"

msgid "All email types look healthy."
msgstr "همه انواع ایمیل سالم به نظر می‌رسند."

msgid "All emails are redirected to test addresses."
msgstr "همه ایمیل‌ها به نشانی‌های آزمایشی هدایت می‌شوند."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "همه ایمیل‌ها به جای گیرندگان واقعی به نشانی‌های آزمایشی می‌روند."

msgid "All sources"
msgstr "همه منابع"

msgid "Allow again"
msgstr "اجازه دوباره"

msgid "Allowed again."
msgstr "دوباره مجاز شد."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "همچنین یک بار هشدار می‌دهد وقتی افزونه یا پوسته‌ای که پیش‌تر هرگز ایمیلی نفرستاده، در یک روز به نشانی‌های خارجی متعددی ایمیل بفرستد – نشانه احتمالی هک شدن سایت. دو هفته نخست پس از نصب Mailspur مبنا قرار می‌گیرد."

msgid "Also remove the subject when anonymising"
msgstr "هنگام ناشناس‌سازی، موضوع را هم حذف کن"

msgid "Also search content"
msgstr "جستجو در محتوا نیز"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "یا از میزبان خود بخواهید mail() / sendmail را برای این سایت فعال کند."

msgid "Always load remote images and fonts in the preview"
msgstr "همیشه تصاویر و قلم‌های خارجی را در پیش‌نمایش بارگذاری کن"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (از طریق SNS)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "یک سرویس‌دهنده ایمیل با HTTP API به جای SMTP برای هر ایمیل به رفت‌وبرگشت کمتری نیاز دارد."

msgid "Anonymisation"
msgstr "ناشناس‌سازی"

msgid "Anonymise entries after"
msgstr "ناشناس‌سازی موارد پس از"

msgid "Anonymised"
msgstr "ناشناس‌شده"

msgid "Any format"
msgstr "هر قالبی"

msgid "Any status"
msgstr "هر وضعیتی"

msgid "Apply"
msgstr "اعمال"

msgid "Ask the recipient for a working address."
msgstr "از گیرنده یک نشانی فعال بخواهید."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "از میزبان خود بخواهید افزونه openssl را فعال کند (یا آن را در تنظیمات PHP کنترل‌پنل میزبانی خود فعال کنید)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "از میزبان خود بخواهید گواهی‌های CA و OpenSSL سرور را به‌روز کند."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "از میزبان خود بپرسید آیا اتصال‌های خروجی SMTP مسدود هستند."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "از میزبان خود بپرسید آیا اتصال‌های خروجی به آن درگاه مجاز هستند (دیوار آتش)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "دست‌کم %1$s ایمیل ناموفق در %2$s دقیقه"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "حداکثر یک هشدار از هر نوع در این مدت، حتی اگر مشکل ادامه داشته باشد."

msgid "Attachments"
msgstr "پیوست‌ها"

msgid "Attachments no longer available: %s"
msgstr "پیوست‌هایی که دیگر در دسترس نیستند: %s"

msgid "Authentication"
msgstr "احراز هویت"

msgid "Automatic TLS"
msgstr "TLS خودکار"

msgid "Average per day"
msgstr "میانگین روزانه"

msgid "Back to the email types"
msgstr "بازگشت به انواع ایمیل"

msgid "Belongs to"
msgstr "متعلق به"

msgid "Block again"
msgstr "مسدود کردن دوباره"

msgid "Blocked as spam or by a blocklist"
msgstr "مسدودشده به‌عنوان هرزنامه یا توسط فهرست سیاه"

msgid "Bounced (permanent)"
msgstr "برگشت‌خورده (دائمی)"

msgid "Bounced (temporary)"
msgstr "برگشت‌خورده (موقت)"

msgid "Broken characters (encoding): %1$s"
msgstr "نویسه‌های خراب (کدگذاری): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "ایمیل انبوه بدون سرایند لغو اشتراک (%1$s گیرنده)"

msgid "Bundle into one daily email"
msgstr "یکجا کردن در یک ایمیل روزانه"

msgid "Bundled into one daily email"
msgstr "یکجاشده در یک ایمیل روزانه"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "یکجاسازی خاموش است. ایمیل‌های در انتظار اکنون در یک خلاصه ارسال شدند."

msgid "Busiest day"
msgstr "شلوغ‌ترین روز"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "لغو"

msgid "Careful: emails to this address failed several times before."
msgstr "مراقب باشید: ایمیل‌ها به این نشانی پیش‌تر چندین بار ناموفق بوده‌اند."

msgid "Change in the email types"
msgstr "تغییر در انواع ایمیل"

msgid "Change staging mode"
msgstr "تغییر حالت آزمایشی"

msgid "Check"
msgstr "بررسی"

msgid "Check again"
msgstr "بررسی دوباره"

msgid "Check emails"
msgstr "بررسی ایمیل‌ها"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "میزبان و درگاه را بررسی کنید؛ 587 (TLS) را به جای 465 (SSL) یا برعکس امتحان کنید."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "میزبان، درگاه، رمزنگاری، نام کاربری و رمز عبور را در افزونه SMTP خود بررسی کنید و از همان‌جا یک ایمیل آزمایشی بفرستید."

msgid "Check sender domains"
msgstr "بررسی دامنه‌های فرستنده"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "بررسی کنید که رمزنگاری با درگاه مطابقت داشته باشد: TLS برای 587، SSL برای 465."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "بررسی کنید که کلید متعلق به منطقه / حساب درست باشد (مثلاً نقطه پایانی EU در مقابل US)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "میزبان و درگاه SMTP را بررسی کنید: درگاه نادرست یا اتصال مسدود اغلب پیش از آنکه راه جایگزین کار کند به پایان مهلت زمانی می‌انجامد."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "رکوردهای SPF، DKIM و DMARC دامنه فرستنده را بررسی کنید، یا از نشانی فرستنده‌ای روی دامنه‌ای که از آن ارسال می‌کنید استفاده کنید."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "نشانی را از نظر اشتباه تایپی بررسی کنید – یا ایمیل هرگز از سایت شما ارسال نشده است."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "نشانی را با گیرنده بررسی کنید و هر جا ذخیره شده است اصلاحش کنید (نمایه کاربر، سفارش، ورودی فرم)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "نشانی را با گیرنده بررسی کنید و هر جا ذخیره شده است اصلاحش کنید."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "نام میزبان و درگاه را بررسی کنید: 587 با STARTTLS (TLS) یا 465 با SSL. درگاه 25 توسط بیشتر میزبان‌ها مسدود است."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "محدودیت‌ها و میزان مصرف فعلی را در حساب سرویس ایمیل خود بررسی کنید؛ در صورت نیاز طرح را ارتقا دهید."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "نشانی‌های گیرنده این مورد را از نظر اشتباه تایپی، فاصله یا بخش‌های جاافتاده بررسی کنید."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
