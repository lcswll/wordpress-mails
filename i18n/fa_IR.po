msgstr "نگه‌داری به مدت"

msgid "Keep this URL private: it contains a secret key of this site. Save the settings before you test the webhook."
msgstr "این نشانی را محرمانه نگه دارید: شامل یک کلید مخفی این سایت است. پیش از آزمایش وب‌هوک، تنظیمات را ذخیره کنید."

msgid "Kept: %s"
msgstr "نگه‌داری: %s"

msgid "Key figures"
msgstr "آمار کلیدی"

msgid "Last 30 days"
msgstr "۳۰ روز گذشته"

