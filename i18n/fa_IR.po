msgid "today at %s"
msgstr "امروز ساعت %s"

msgid "triggered %s times"
msgstr "%s بار فعال شد"

msgid "unchanged"
msgstr "بدون تغییر"

msgid "unknown – the mailer gave no error message"
msgstr "نامشخص – ارسال‌کننده ایمیل پیام خطایی نداد"

msgid "unusual silence"
msgstr "سکوت غیرعادی"

msgid "usually sent: %s"
msgstr "معمولاً ارسال می‌شود: %s"

msgid "wp_mail() called"
msgstr "wp_mail() فراخوانی شد"

msgid "yes"
msgstr "بله"

msgid "yesterday at %s"
msgstr "دیروز ساعت %s"

msgid "your email provider"
msgstr "سرویس‌دهنده ایمیل شما"

msgid "“%1$s” (%2$s) at %3$s"
msgstr "«%1$s» (%2$s) در %3$s"

msgid "“%1$s” (%2$s) is being sent again."
msgstr "«%1$s» (%2$s) دوباره ارسال می‌شود."

msgid "“%1$s” (%2$s) usually goes out at least every %3$s days. The last one was sent %4$s ago."
msgstr "«%1$s» (%2$s) معمولاً دست‌کم هر %3$s روز یک بار ارسال می‌شود. آخرین مورد %4$s پیش ارسال شد."

msgid "“%1$s” (%2$s) was last sent %3$s ago. Until then it was sent at least every %4$s days."
msgstr "«%1$s» (%2$s) آخرین بار %3$s پیش ارسال شد. تا آن زمان دست‌کم هر %4$s روز ارسال می‌شد."

msgid "“%1$s” (%2$s) – usually every %4$s, last one %3$s"
msgstr "«%1$s» (%2$s) – معمولاً هر %4$s، آخرین مورد %3$s"

msgid "“%1$s” (%2$s) – usually every day, last one %3$s"
msgstr "«%1$s» (%2$s) – معمولاً هر روز، آخرین مورد %3$s"

msgid "“%1$s” – %2$s – %3$s"
msgstr "«%1$s» – %2$s – %3$s"
