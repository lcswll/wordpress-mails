msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: pl_PL\n"
"Plural-Forms: nplurals=3; plural=(n == 1) ? 0 : ((n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14)) ? 1 : 2);\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "„Pobierz .eml” odtwarza wiadomość z zapisanych, zamaskowanych danych (bez załączników)."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (poprzedni tydzień: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (zaplanowano na %2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s typ e-maila przestał być wysyłany: %2$s."
msgstr[1] "%1$s typy e-maili przestały być wysyłane, np. %2$s."
msgstr[2] "%1$s typów e-maili przestało być wysyłanych, np. %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "Typy e-maili: %1$s, nadawcy: %2$s"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "W ciągu ostatnich %2$s minut nie udało się wysłać %1$s e-maili."

msgid "%1$s emails in %2$s days"
msgstr "E-maile: %1$s w %2$s dni"

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "E-maile w ciągu ostatnich 30 dni: %1$s, nieudane: %2$s"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "W ciągu jednej godziny wysłano %1$s e-maili – znacznie więcej niż zwykle (próg: %2$s na godzinę). Formularz kontaktowy może być nadużywany albo witryna mogła zostać przejęta."

msgid "%1$s entries, %2$s"
msgstr "Wpisy: %1$s, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "Zaimportowano: %1$s, duplikaty: %2$s, zbyt stare: %3$s"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "Odbite: %1$s z %2$s (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "Nie udało się wysłać %1$s z %2$s e-maili w ciągu ostatnich %3$s dni."

msgid "%1$s of %2$s entries processed …"
msgstr "Przetworzono %1$s z %2$s wpisów …"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s pp w porównaniu z %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "%1$s wysłał pierwszy e-mail %2$s i w ciągu ostatnich 24 godzin napisał do %3$s różnych adresów zewnętrznych. Jeśli nie instalowałeś ani nie konfigurowałeś niczego, co wysyła takie e-maile, sprawdź witrynę: nowy nadawca może być oznaką włamania."

msgid "%1$s sent, %2$s still held …"
msgstr "Wysłano %1$s, nadal wstrzymanych: %2$s …"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s w porównaniu z %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · e-maile zebrane od ostatniego zestawienia: %2$s"

msgid "%1$s · as of %2$s"
msgstr "%1$s · stan na %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – odsetek błędów %2$s %% (poprzedni tydzień: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – zgłoszone przez %2$s, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (wtyczka must-use)"

msgid "%s (theme)"
msgstr "%s (motyw)"

msgid "%s ago"
msgstr "%s temu"

msgid "%s days"
msgstr "%s dni"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "%s e-mail nie został wysłany w ciągu ostatnich 7 dni."
msgstr[1] "%s e-maile nie zostały wysłane w ciągu ostatnich 7 dni."
msgstr[2] "%s e-maili nie zostało wysłanych w ciągu ostatnich 7 dni."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s e-mail czeka na twoją decyzję."
msgstr[1] "%s e-maile czekają na twoją decyzję."
msgstr[2] "%s e-maili czeka na twoją decyzję."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "%s e-mail został wstrzymany i niewysłany w ciągu ostatnich 7 dni."
msgstr[1] "%s e-maile zostały wstrzymane i niewysłane w ciągu ostatnich 7 dni."
msgstr[2] "%s e-maili zostało wstrzymanych i niewysłanych w ciągu ostatnich 7 dni."

msgid "%s emails are held by the emergency brake."
msgstr "Hamulec bezpieczeństwa wstrzymuje e-maile: %s."

msgid "%s emails are waiting and have not been delivered."
msgstr "E-maile czekające i niedoręczone: %s."

msgid "%s entries"
msgstr "Wpisy: %s"

msgid "%s failed"
msgstr "Nieudane: %s"

msgid "%s held emails discarded."
msgstr "Odrzucono wstrzymane e-maile: %s."

msgid "%s imported entries removed."
msgstr "Usunięto zaimportowane wpisy: %s."

msgid "%s in 30 days"
msgstr "%s w ciągu 30 dni"

msgid "%s marked as spam"
msgstr "Oznaczone jako spam: %s"

msgid "%s more on the Email types page."
msgstr "%s więcej na stronie Typy e-maili."

msgid "%s notes"
msgstr "Uwagi: %s"

msgid "%s of all emails"
msgstr "%s wszystkich e-maili"

msgid "%s of them in the last 24 hours."
msgstr "W tym %s w ciągu ostatnich 24 godzin."

msgid "%s s"
msgstr "%s s"

msgid "%s selected"
msgstr "Zaznaczono: %s"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s sprawa wymaga uwagi:"
msgstr[1] "%s sprawy wymagają uwagi:"
msgstr[2] "%s spraw wymaga uwagi:"

msgid "%s to administrators in 30 days"
msgstr "%s do administratorów w ciągu 30 dni"

msgid "%s unchanged lines"
msgstr "Niezmienione wiersze: %s"

msgid "(no subject)"
msgstr "(brak tematu)"

msgid "(no text content)"
msgstr "(brak treści tekstowej)"

msgid "(the emails are no longer in the log)"
msgstr "(tych e-maili nie ma już w dzienniku)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "-all jest bardziej restrykcyjne; ~all jest powszechne i w porządku w połączeniu z DMARC."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "0 oznacza przechowywanie wpisów na zawsze. Czyszczenie odbywa się raz dziennie."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "0 oznacza brak limitu. Najstarsze wpisy są usuwane jako pierwsze."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "0 wyłącza tę funkcję. Usuwa treść, nagłówki i załączniki starszych wpisów i maskuje adresy (a***@example.com). Data, status, źródło, format, rozmiar i uwagi pozostają na potrzeby statystyk. Działa razem z codziennym czyszczeniem, zanim wpisy zostaną usunięte – więc ma efekt tylko wtedy, gdy jest krótsza niż okres usuwania powyżej."

msgid "12 months"
msgstr "12 miesięcy"

msgid "30 days"
msgstr "30 dni"

msgid "7 days"
msgstr "7 dni"

msgid "90 days"
msgstr "90 dni"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "Selektor DKIM może zawierać tylko litery, cyfry, kropki, myślniki i podkreślenia."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "Wtyczka mailera wysyłająca przez API przejęła doręczanie i zgłosiła, że wysyłka się nie powiodła, nie podając przyczyny."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "Opublikowany klucz nie dowodzi, że twoje e-maile są nim podpisywane – sprawdź wynik DKIM w nagłówkach odebranej wiadomości."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "Odbiorca lub adres nadawcy nie jest prawidłowym adresem e-mail, więc PHPMailer odmówił wysyłki."

msgid "API key or private key in plain text: %1$s"
msgstr "Klucz API lub klucz prywatny zwykłym tekstem: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "Do oceny tego rekordu potrzeba około %1$s zapytań DNS – więcej niż dozwolone %2$s, więc odbiorcy mogą go zignorować (PermError). Usuń nieużywane wpisy include:."

msgid "Access"
msgstr "Dostęp"

msgid "Actions"
msgstr "Działania"

msgid "Active: alerts on %s."
msgstr "Aktywne: powiadomienia o %s."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "Dodaj krótki atrybut alt do każdego obrazka w szablonie, np. alt=\"Logo Przykładowy Sklep\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "Dodaj include: swojego dostawcy poczty (np. include:_spf.google.com), jeśli wysyłasz przez niego."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "Dodaj swój serwer poczty lub usługę pocztową do rekordu SPF domeny nadawcy."

msgid "Added:"
msgstr "Dodano:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "Adresy z co najmniej %s trwałymi błędami: serwer odbiorcy odrzucił skrzynkę, domena nie ma serwera poczty albo twój dostawca poczty zgłosił twarde odbicie. Wpisy wygasają razem z okresem przechowywania dziennika."

msgid "Admin screen"
msgstr "Ekran administracyjny"

msgid "Administrators"
msgstr "Administratorzy"

msgid "Aggregate reports go to %s."
msgstr "Raporty zbiorcze trafiają do %s."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "Powiadomienie"

msgid "Alert and hold further emails"
msgstr "Powiadom i wstrzymaj kolejne e-maile"

msgid "Alert only"
msgstr "Tylko powiadom"

msgid "Alert when an email type that is sent regularly stops"
msgstr "Powiadamiaj, gdy regularnie wysyłany typ e-maila przestaje być wysyłany"

msgid "Alert when emails fail repeatedly"
msgstr "Powiadamiaj, gdy e-maile wielokrotnie nie zostają wysłane"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "Powiadamiaj, gdy witryna nieoczekiwanie przestaje wysyłać e-maile"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "Powiadomienia są włączone, ale nie mają kanału: wpisz adres e-mail lub adres URL webhooka."

msgid "Alerts are off."
msgstr "Powiadomienia są wyłączone."

msgid "All"
msgstr "Wszystkie"

msgid "All email types look healthy."
msgstr "Wszystkie typy e-maili wyglądają w porządku."

msgid "All emails are redirected to test addresses."
msgstr "Wszystkie e-maile są przekierowywane na adresy testowe."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "Wszystkie e-maile trafiają na adresy testowe zamiast do prawdziwych odbiorców."

msgid "All sources"
msgstr "Wszystkie źródła"

msgid "Allow again"
msgstr "Zezwól ponownie"

msgid "Allowed again."
msgstr "Ponownie dozwolony."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "Powiadamia też jednorazowo, gdy wtyczka lub motyw, który nigdy wcześniej nie wysłał e-maila, w ciągu doby pisze do wielu różnych adresów zewnętrznych – to możliwa oznaka włamania. Pierwsze dwa tygodnie po instalacji Mailspur służą jako punkt odniesienia."

msgid "Also remove the subject when anonymising"
msgstr "Podczas anonimizacji usuwaj również temat"

msgid "Also search content"
msgstr "Przeszukuj również treść"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "Możesz też poprosić dostawcę hostingu o włączenie mail() / sendmail dla tej witryny."

msgid "Always load remote images and fonts in the preview"
msgstr "Zawsze ładuj zewnętrzne obrazki i czcionki w podglądzie"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (przez SNS)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "Dostawca poczty z API HTTP zamiast SMTP potrzebuje mniej wymian komunikatów na e-mail."

msgid "Anonymisation"
msgstr "Anonimizacja"

msgid "Anonymise entries after"
msgstr "Anonimizuj wpisy po"

msgid "Anonymised"
msgstr "Zanonimizowany"

msgid "Any format"
msgstr "Dowolny format"

msgid "Any status"
msgstr "Dowolny status"

msgid "Apply"
msgstr "Zastosuj"

msgid "Ask the recipient for a working address."
msgstr "Poproś odbiorcę o działający adres."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "Poproś dostawcę hostingu o włączenie rozszerzenia openssl (lub włącz je w ustawieniach PHP w panelu hostingu)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "Poproś dostawcę hostingu o aktualizację certyfikatów CA i OpenSSL na serwerze."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "Zapytaj dostawcę hostingu, czy wychodzące połączenia SMTP są blokowane."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "Zapytaj dostawcę hostingu, czy wychodzące połączenia na ten port są dozwolone (zapora)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "Co najmniej %1$s nieudanych e-maili w ciągu %2$s minut"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "Najwyżej jedno powiadomienie danego rodzaju w tym czasie, nawet jeśli problem trwa."

msgid "Attachments"
msgstr "Załączniki"

msgid "Attachments no longer available: %s"
msgstr "Załączniki nie są już dostępne: %s"

msgid "Authentication"
msgstr "Uwierzytelnianie"

msgid "Automatic TLS"
msgstr "Automatyczny TLS"

msgid "Average per day"
msgstr "Średnio dziennie"

msgid "Back to the email types"
msgstr "Wróć do typów e-maili"

msgid "Belongs to"
msgstr "Należy do"

msgid "Block again"
msgstr "Zablokuj ponownie"

msgid "Blocked as spam or by a blocklist"
msgstr "Zablokowany jako spam lub przez listę blokad"

msgid "Bounced (permanent)"
msgstr "Odbity (trwale)"

msgid "Bounced (temporary)"
msgstr "Odbity (tymczasowo)"

msgid "Broken characters (encoding): %1$s"
msgstr "Uszkodzone znaki (kodowanie): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "Masowy e-mail bez nagłówka rezygnacji z subskrypcji (odbiorcy: %1$s)"

msgid "Bundle into one daily email"
msgstr "Zbieraj w jeden dzienny e-mail"

msgid "Bundled into one daily email"
msgstr "Zbierane w jeden dzienny e-mail"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "Zbieranie jest wyłączone. Oczekujące e-maile zostały właśnie wysłane w jednym zestawieniu."

msgid "Busiest day"
msgstr "Najbardziej ruchliwy dzień"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "Anuluj"

msgid "Careful: emails to this address failed several times before."
msgstr "Uwaga: e-maile na ten adres już kilka razy nie dotarły."

msgid "Change in the email types"
msgstr "Zmień w typach e-maili"

msgid "Change staging mode"
msgstr "Zmień tryb testowy"

msgid "Check"
msgstr "Sprawdź"

msgid "Check again"
msgstr "Sprawdź ponownie"

msgid "Check emails"
msgstr "Sprawdź e-maile"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "Sprawdź host i port; spróbuj 587 (TLS) zamiast 465 (SSL) lub odwrotnie."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "Sprawdź host, port, szyfrowanie, nazwę użytkownika i hasło we wtyczce SMTP i wyślij z niej testowy e-mail."

msgid "Check sender domains"
msgstr "Sprawdź domeny nadawcy"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "Sprawdź, czy szyfrowanie pasuje do portu: TLS dla 587, SSL dla 465."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "Sprawdź, czy klucz należy do właściwego regionu / konta (np. punkt końcowy UE lub US)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "Sprawdź host i port SMTP: błędny port lub zablokowane połączenie często kończą się przekroczeniem czasu, zanim zadziała rozwiązanie zapasowe."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "Sprawdź rekordy SPF, DKIM i DMARC domeny nadawcy lub użyj adresu nadawcy w domenie, z której wysyłasz."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "Sprawdź, czy w adresie nie ma literówki – albo twoja witryna nigdy nie wysłała tego e-maila."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "Zweryfikuj adres z odbiorcą i popraw go tam, gdzie jest zapisany (profil użytkownika, zamówienie, wpis formularza)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "Zweryfikuj adres z odbiorcą i popraw go tam, gdzie jest zapisany."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "Sprawdź nazwę hosta i port: 587 ze STARTTLS (TLS) lub 465 z SSL. Port 25 jest blokowany przez większość dostawców hostingu."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "Sprawdź limity i bieżące wykorzystanie na koncie usługi pocztowej; w razie potrzeby zmień plan na wyższy."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "Sprawdź adresy odbiorców tego wpisu pod kątem literówek, spacji lub brakujących części."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
msgstr "Sprawdź adres nadawcy we wtyczce SMTP i filtr wp_mail_from."

msgid "Check the sending limits of your mail account and the notes of this email."
msgstr "Sprawdź limity wysyłki swojego konta pocztowego i uwagi do tego e-maila."

msgid "Check the server IP on a blocklist checker and request delisting."
msgstr "Sprawdź adres IP serwera w narzędziu do sprawdzania list blokad i poproś o usunięcie z listy."

msgid "Check the spelling of the placeholder in the template and whether the plugin supports it for this email type. Shortcodes are not processed in emails unless the sending plugin runs do_shortcode()."
msgstr "Sprawdź pisownię zmiennej w szablonie i czy wtyczka obsługuje ją dla tego typu e-maila. Shortcode'y nie są przetwarzane w e-mailach, chyba że wtyczka wysyłająca wywołuje do_shortcode()."

msgid "Checked %s."
msgstr "Sprawdzono %s."

msgid "Checked just now"
msgstr "Sprawdzono przed chwilą"

msgid "Checking DNS records …"
msgstr "Sprawdzanie rekordów DNS …"

msgid "Checks the DNS records of the domains your site sends from: the default sender address and the most frequent senders in the log. Missing or weak records are the most common reason why emails land in spam. Only your server's own DNS resolver is used; results are kept for one hour."
msgstr "Sprawdza rekordy DNS domen, z których wysyła twoja witryna: domyślnego adresu nadawcy i najczęstszych nadawców w dzienniku. Brakujące lub słabe rekordy to najczęstszy powód, dla którego e-maile trafiają do spamu. Używany jest tylko resolver DNS twojego serwera; wyniki są przechowywane przez godzinę."

msgid "Choose a range of at most %s days."
msgstr "Wybierz zakres najwyżej %s dni."

msgid "Clear selection"
msgstr "Wyczyść zaznaczenie"

msgid "Click a bar to open these emails in the log."
msgstr "Kliknij słupek, aby otworzyć te e-maile w dzienniku."

msgid "Close"
msgstr "Zamknij"

msgid "Close (Esc)"
msgstr "Zamknij (Esc)"

msgid "Colour scheme"
msgstr "Schemat kolorów"

msgid "Command line"
msgstr "Wiersz poleceń"

msgid "Compare"
msgstr "Porównaj"

msgid "Compare the sources of these entries. Check whether two plugins send the same notification, or whether a hook (e.g. order status change) fires more than once."
msgstr "Porównaj źródła tych wpisów. Sprawdź, czy dwie wtyczki nie wysyłają tego samego powiadomienia lub czy jakiś hook (np. zmiana statusu zamówienia) nie uruchamia się więcej niż raz."

msgid "Component"
msgstr "Komponent"

msgid "Configure alerts"
msgstr "Skonfiguruj powiadomienia"

msgid "Content anonymised after %1$s days, %2$s"
msgstr "Treść zanonimizowana po %1$s dniach, %2$s"

msgid "Content change marked as seen."
msgstr "Zmianę treści oznaczono jako widzianą."

msgid "Content changed"
msgstr "Zmieniona treść"

msgid "Content changed on %1$s, after the %2$s update."
msgstr "Treść zmieniona %1$s, po aktualizacji %2$s."

msgid "Content changed on %s."
msgstr "Treść zmieniona %s."

msgid "Content removed"
msgstr "Treść usunięta"

msgid "Content removed after %s days"
msgstr "Treść usunięta po %s dniach"

msgid "Content, headers and attachments were removed and the addresses masked by the anonymisation setting."
msgstr "Treść, nagłówki i załączniki zostały usunięte, a adresy zamaskowane przez ustawienie anonimizacji."

msgid "Copied"
msgstr "Skopiowano"

msgid "Copied – paste it into your reply."
msgstr "Skopiowano – wklej to do swojej odpowiedzi."

