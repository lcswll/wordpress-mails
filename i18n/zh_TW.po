msgstr "其他收件者 (例如訪客)"

msgid "Overview"
msgstr "概覽"

msgid "Own top-level menu item"
msgstr "獨立的頂層選單項目"

msgid "PHP extension openssl is missing"
msgstr "缺少 PHP 擴充功能 openssl"

msgid "PHPMailer ready (phpmailer_init)"
msgstr "PHPMailer 已就緒 (phpmailer_init)"

msgid "Pagination"
msgstr "分頁"

msgid "Password sent in plain text"
msgstr "以純文字傳送的密碼"

