msgstr "이 로그 항목을 삭제하시겠습니까?"

msgid "Deleted."
msgstr "삭제되었습니다."

msgid "Delivered"
msgstr "전달됨"

msgid "Delivered by %s (API)"
msgstr "%s에서 전달(API)"

msgid "Delivered by code hooked into pre_wp_mail (API)"
msgstr "pre_wp_mail에 연결된 코드가 전달(API)"

msgid "Delivered in the daily digest on %s."
msgstr "%s 일일 요약으로 전달되었습니다."

