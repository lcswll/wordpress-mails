msgstr "이메일 유형이 다시 발송됨"

msgid "Email type stopped"
msgstr "이메일 유형 중단됨"

msgid "Email types"
msgstr "이메일 유형"

msgid "Email volume back to normal"
msgstr "이메일 양이 정상으로 돌아왔습니다"

