msgid_plural "Probably yes: %s email types have stopped."
msgstr[0] "Probablemente sí: %s tipo de correo ha dejado de enviarse."
msgstr[1] "Probablemente sí: %s tipos de correo han dejado de enviarse."

msgid "Probe emails are only sent to an administrator."
msgstr "Los correos de prueba solo se envían a un administrador."

msgid "Problem"
msgstr "Problema"

msgid "Problem recipients"
msgstr "Destinatarios problemáticos"

msgid "Protects your domain when far more emails leave than usual, e.g. because spam bots abuse a contact form. Alerts use the channels of the monitoring alerts; password reset emails are never held."
msgstr "Protege tu dominio cuando salen muchos más correos de lo habitual, p. ej. porque bots de spam abusan de un formulario de contacto. Los avisos usan los canales de los avisos de supervisión; los correos de restablecimiento de contraseña nunca se retienen."

msgid "Provider status"
msgstr "Estado en el proveedor"

msgid "Providers like %2$s publish a strict DMARC policy. An email \"from\" their domain that was sent by your web server fails that check and is rejected or lands in spam."
msgstr "Proveedores como %2$s publican una política DMARC estricta. Un correo «desde» su dominio enviado por tu servidor web no supera esa comprobación y se rechaza o acaba en spam."

msgid "Put the important content into real text and use images only in addition to it."
msgstr "Pon el contenido importante como texto real y usa las imágenes solo como complemento."

msgid "Put the important information first and keep the subject under about 80 characters."
msgstr "Pon primero la información importante y mantén el asunto por debajo de unos 80 caracteres."

msgid "REST API"
msgstr "API REST"

msgid "REST route"
msgstr "Ruta REST"

msgid "Rarely"
msgstr "Rara vez"

