msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: he_IL\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "\"הורדת .eml\" בונה מחדש את ההודעה מהנתונים שתועדו ועברו השחרה (ללא קבצים מצורפים)."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (שבוע קודם: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (מתוזמן ל-%2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s סוג אימייל הפסיק להישלח: %2$s."
msgstr[1] "%1$s סוגי אימייל הפסיקו להישלח, למשל %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "%1$s סוגי אימייל מ-%2$s שולחים"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "%1$s אימיילים נכשלו ב-%2$s הדקות האחרונות."

msgid "%1$s emails in %2$s days"
msgstr "%1$s אימיילים ב-%2$s ימים"

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "%1$s אימיילים ב-30 הימים האחרונים, %2$s נכשלו"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "%1$s אימיילים נשלחו בתוך שעה אחת – הרבה יותר מהרגיל (סף: %2$s לשעה). ייתכן שנעשה שימוש לרעה בטופס יצירת קשר או שהאתר נפרץ."

msgid "%1$s entries, %2$s"
msgstr "%1$s רשומות, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "%1$s יובאו, %2$s כפולים, %3$s ישנים מדי"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "%1$s מתוך %2$s חזרו (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "%1$s מתוך %2$s אימיילים ב-%3$s הימים האחרונים לא נשלחו."

msgid "%1$s of %2$s entries processed …"
msgstr "עובדו %1$s מתוך %2$s רשומות …"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s נקודות אחוז לעומת %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "%1$s שלח את האימייל הראשון שלו ב-%2$s וכתב ל-%3$s כתובות חיצוניות שונות ב-24 השעות האחרונות. אם לא הותקן או הוגדר דבר ששולח אימיילים כאלה, יש לבדוק את האתר: שולח חדש עשוי להעיד על אתר שנפרץ."

msgid "%1$s sent, %2$s still held …"
msgstr "%1$s נשלחו, %2$s עדיין מעוכבים …"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s לעומת %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · %2$s אימיילים אוחדו מאז התקציר האחרון"

msgid "%1$s · as of %2$s"
msgstr "%1$s · נכון ל-%2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – שיעור כשלים %2$s %% (שבוע קודם: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – דווח על ידי %2$s, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (תוסף חובה)"

msgid "%s (theme)"
msgstr "%s (ערכת עיצוב)"

msgid "%s ago"
msgstr "לפני %s"

msgid "%s days"
msgstr "%s ימים"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "%s אימייל נכשל ב-7 הימים האחרונים."
msgstr[1] "%s אימיילים נכשלו ב-7 הימים האחרונים."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s אימייל ממתין להחלטה."
msgstr[1] "%s אימיילים ממתינים להחלטה."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "%s אימייל עוכב ולא נשלח ב-7 הימים האחרונים."
msgstr[1] "%s אימיילים עוכבו ולא נשלחו ב-7 הימים האחרונים."

msgid "%s emails are held by the emergency brake."
msgstr "%s אימיילים מעוכבים על ידי בלם החירום."

msgid "%s emails are waiting and have not been delivered."
msgstr "%s אימיילים ממתינים ולא נמסרו."

msgid "%s entries"
msgstr "%s רשומות"

msgid "%s failed"
msgstr "%s נכשלו"

msgid "%s held emails discarded."
msgstr "%s אימיילים שעוכבו בוטלו."

msgid "%s imported entries removed."
msgstr "%s רשומות מיובאות הוסרו."

msgid "%s in 30 days"
msgstr "%s ב-30 יום"

msgid "%s marked as spam"
msgstr "סומנו כספאם: %s"

msgid "%s more on the Email types page."
msgstr "עוד %s בעמוד \"סוגי אימייל\"."

msgid "%s notes"
msgstr "%s הערות"

msgid "%s of all emails"
msgstr "%s מכלל האימיילים"

msgid "%s of them in the last 24 hours."
msgstr "%s מהם ב-24 השעות האחרונות."

msgid "%s s"
msgstr "%s שנ׳"

msgid "%s selected"
msgstr "%s נבחרו"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s נושא דורש תשומת לב:"
msgstr[1] "%s נושאים דורשים תשומת לב:"

msgid "%s to administrators in 30 days"
msgstr "%s למנהלים ב-30 יום"

msgid "%s unchanged lines"
msgstr "%s שורות שלא השתנו"

msgid "(no subject)"
msgstr "(ללא נושא)"

msgid "(no text content)"
msgstr "(אין תוכן טקסט)"

msgid "(the emails are no longer in the log)"
msgstr "(האימיילים כבר אינם ביומן)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "-all מחמיר יותר; ~all נפוץ ומתאים יחד עם DMARC."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "0 שומר רשומות לתמיד. הניקוי רץ פעם ביום."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "0 פירושו ללא הגבלה. הרשומות הישנות ביותר מוסרות ראשונות."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "0 מכבה זאת. מסיר תוכן, כותרות וקבצים מצורפים של רשומות ישנות יותר ומסווה את הכתובות (a***@example.com). התאריך, המצב, המקור, התבנית, הגודל וההערות נשמרים לצורך סטטיסטיקה. רץ עם הניקוי היומי, לפני מחיקת הרשומות – ולכן משפיע רק אם הוא קצר מתקופת המחיקה שלמעלה."

msgid "12 months"
msgstr "12 חודשים"

msgid "30 days"
msgstr "30 ימים"

msgid "7 days"
msgstr "7 ימים"

msgid "90 days"
msgstr "90 ימים"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "בורר DKIM יכול להכיל רק אותיות, ספרות, נקודות, מקפים וקווים תחתונים."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "תוסף שליחת דואר ששולח דרך API קיבל לידיו את המסירה ודיווח שהשליחה נכשלה, בלי לציין סיבה."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "מפתח שפורסם אינו מוכיח שהאימיילים שלך נחתמים בו – יש לבדוק את תוצאת DKIM בכותרות של אימייל שהתקבל."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "כתובת של נמען או כתובת השולח אינה כתובת אימייל תקינה, ולכן PHPMailer סירב לשלוח."

msgid "API key or private key in plain text: %1$s"
msgstr "מפתח API או מפתח פרטי בטקסט גלוי: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "נדרשות כ-%1$s בדיקות DNS כדי להעריך רשומה זו – יותר מה-%2$s המותרות, ולכן שרתים מקבלים עלולים להתעלם ממנה (PermError). יש להסיר רשומות include: שאינן בשימוש."

msgid "Access"
msgstr "גישה"

msgid "Actions"
msgstr "פעולות"

msgid "Active: alerts on %s."
msgstr "פעיל: התראות על %s."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "יש להוסיף מאפיין alt קצר לכל תמונה בתבנית, למשל alt=\"Logo Example Shop\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "אם השליחה מתבצעת דרך ספק דואר, יש להוסיף את ה-include: שלו (למשל include:_spf.google.com)."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "יש להוסיף את שרת הדואר או את שירות הדואר לרשומת ה-SPF של דומיין השולח."

msgid "Added:"
msgstr "נוסף:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "כתובות עם לפחות %s כשלים קבועים: השרת המקבל דחה את תיבת הדואר, לדומיין אין שרת דואר, או שספק האימייל דיווח על החזרה קשה (hard bounce). הרשומות פגות יחד עם תקופת השמירה של היומן."

msgid "Admin screen"
msgstr "מסך ניהול"

msgid "Administrators"
msgstr "מנהלי מערכת"

msgid "Aggregate reports go to %s."
msgstr "דוחות מצטברים נשלחים אל %s."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "התראה"

msgid "Alert and hold further emails"
msgstr "התראה ועיכוב אימיילים נוספים"

msgid "Alert only"
msgstr "התראה בלבד"

msgid "Alert when an email type that is sent regularly stops"
msgstr "התראה כשסוג אימייל שנשלח באופן קבוע מפסיק להישלח"

msgid "Alert when emails fail repeatedly"
msgstr "התראה כאשר אימיילים נכשלים שוב ושוב"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "התראה כאשר האתר מפסיק לשלוח אימיילים באופן בלתי צפוי"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "ההתראות מופעלות אך אין להן ערוץ: יש להזין כתובת אימייל או כתובת URL של webhook."

msgid "Alerts are off."
msgstr "ההתראות כבויות."

msgid "All"
msgstr "הכל"

msgid "All email types look healthy."
msgstr "כל סוגי האימייל נראים תקינים."

msgid "All emails are redirected to test addresses."
msgstr "כל האימיילים מופנים לכתובות בדיקה."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "כל האימיילים נשלחים לכתובות בדיקה במקום לנמענים האמיתיים."

msgid "All sources"
msgstr "כל המקורות"

msgid "Allow again"
msgstr "אישור מחדש"

msgid "Allowed again."
msgstr "אושר מחדש."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "בנוסף, מתריע פעם אחת כשתוסף או ערכת עיצוב שמעולם לא שלחו אימייל כותבים לכתובות חיצוניות רבות ושונות בתוך יום – סימן אפשרי לאתר שנפרץ. השבועיים הראשונים אחרי התקנת Mailspur משמשים כבסיס להשוואה."

msgid "Also remove the subject when anonymising"
msgstr "הסרת הנושא גם בעת התממה"

msgid "Also search content"
msgstr "חיפוש גם בתוכן"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "לחלופין, ניתן לבקש מספק האחסון להפעיל את mail() / sendmail עבור אתר זה."

msgid "Always load remote images and fonts in the preview"
msgstr "תמיד לטעון תמונות וגופנים חיצוניים בתצוגה המקדימה"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (דרך SNS)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "ספק אימייל עם HTTP API במקום SMTP צריך פחות סבבי תקשורת לכל אימייל."

msgid "Anonymisation"
msgstr "התממה"

msgid "Anonymise entries after"
msgstr "התממת רשומות לאחר"

msgid "Anonymised"
msgstr "עבר התממה"

msgid "Any format"
msgstr "כל תבנית"

msgid "Any status"
msgstr "כל מצב"

msgid "Apply"
msgstr "החלה"

msgid "Ask the recipient for a working address."
msgstr "יש לבקש מהנמען כתובת פעילה."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "יש לבקש מספק האחסון להפעיל את הרחבת openssl (או להפעיל אותה בהגדרות ה-PHP בלוח הבקרה של האחסון)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "יש לבקש מספק האחסון לעדכן את אישורי ה-CA ואת OpenSSL בשרת."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "יש לברר עם ספק האחסון אם חיבורי SMTP יוצאים חסומים."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "יש לברר עם ספק האחסון אם חיבורים יוצאים לפורט זה מותרים (חומת אש)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "לפחות %1$s אימיילים שנכשלו בתוך %2$s דקות"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "לכל היותר התראה אחת מכל סוג בפרק זמן זה, גם אם הבעיה נמשכת."

msgid "Attachments"
msgstr "קבצים מצורפים"

msgid "Attachments no longer available: %s"
msgstr "הקבצים המצורפים כבר אינם זמינים: %s"

msgid "Authentication"
msgstr "אימות"

msgid "Automatic TLS"
msgstr "TLS אוטומטי"

msgid "Average per day"
msgstr "ממוצע ליום"

msgid "Back to the email types"
msgstr "חזרה לסוגי האימייל"

msgid "Belongs to"
msgstr "שייך ל"

msgid "Block again"
msgstr "חסימה מחדש"

msgid "Blocked as spam or by a blocklist"
msgstr "נחסם כספאם או על ידי רשימת חסימה"

msgid "Bounced (permanent)"
msgstr "הוחזר (לצמיתות)"

msgid "Bounced (temporary)"
msgstr "הוחזר (זמנית)"

msgid "Broken characters (encoding): %1$s"
msgstr "תווים משובשים (קידוד): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "אימייל המוני ללא כותרת הסרה מרשימת תפוצה (נמענים: %1$s)"

msgid "Bundle into one daily email"
msgstr "איחוד לאימייל יומי אחד"

msgid "Bundled into one daily email"
msgstr "מאוחד לאימייל יומי אחד"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "האיחוד כבוי. האימיילים שהמתינו נשלחו עכשיו בתקציר אחד."

msgid "Busiest day"
msgstr "היום העמוס ביותר"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "ביטול"

msgid "Careful: emails to this address failed several times before."
msgstr "שימו לב: אימיילים לכתובת זו נכשלו כבר כמה פעמים בעבר."

msgid "Change in the email types"
msgstr "שינוי בסוגי האימייל"

msgid "Change staging mode"
msgstr "שינוי מצב בדיקות"

msgid "Check"
msgstr "בדיקה"

msgid "Check again"
msgstr "בדיקה חוזרת"

msgid "Check emails"
msgstr "בדיקת אימיילים"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "יש לבדוק את השרת ואת הפורט; לנסות 587 (TLS) במקום 465 (SSL) או להפך."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "יש לבדוק שרת, פורט, הצפנה, שם משתמש וסיסמה בתוסף ה-SMTP ולשלוח משם אימייל בדיקה."

msgid "Check sender domains"
msgstr "בדיקת דומיינים של שולחים"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "יש לוודא שההצפנה תואמת לפורט: TLS עבור 587, SSL עבור 465."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "יש לוודא שהמפתח שייך לאזור / לחשבון הנכון (למשל נקודת קצה של EU לעומת US)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "יש לבדוק את שרת ה-SMTP ואת הפורט: פורט שגוי או חיבור חסום מסתיימים לעיתים קרובות בפסק זמן לפני שחלופה נכנסת לפעולה."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "יש לבדוק את רשומות ה-SPF, DKIM ו-DMARC של דומיין השולח, או להשתמש בכתובת שולח בדומיין שממנו נשלח הדואר."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "יש לבדוק שאין שגיאות הקלדה בכתובת – או שהאימייל מעולם לא נשלח מהאתר."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "יש לאמת את הכתובת מול הנמען ולתקן אותה במקום שבו היא שמורה (פרופיל משתמש, הזמנה, רשומת טופס)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "יש לאמת את הכתובת מול הנמען ולתקן אותה במקום שבו היא שמורה."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "יש לבדוק את שם השרת ואת הפורט: 587 עם STARTTLS (TLS) או 465 עם SSL. פורט 25 חסום אצל רוב ספקי האחסון."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "יש לבדוק את המגבלות ואת השימוש הנוכחי בחשבון שירות הדואר; במידת הצורך לשדרג את החבילה."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "יש לבדוק את כתובות הנמענים ברשומה זו לאיתור שגיאות הקלדה, רווחים או חלקים חסרים."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
