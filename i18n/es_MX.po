msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: es_MX\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "\"Descargar .eml\" reconstruye el mensaje a partir de los datos registrados con información oculta (sin archivos adjuntos)."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (semana anterior: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (programado para %2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s tipo de correo dejó de enviarse: %2$s."
msgstr[1] "%1$s tipos de correo dejaron de enviarse, p. ej., %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "%1$s tipos de correo de %2$s remitentes"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "%1$s correos fallaron en los últimos %2$s minutos."

msgid "%1$s emails in %2$s days"
msgstr "%1$s correos en %2$s días"

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "%1$s correos en los últimos 30 días, %2$s fallidos"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "Se enviaron %1$s correos en una hora, muchos más de lo normal (umbral: %2$s por hora). Es posible que se esté abusando de un formulario de contacto o que el sitio esté comprometido."

msgid "%1$s entries, %2$s"
msgstr "%1$s elementos, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "%1$s importados, %2$s duplicados, %3$s demasiado antiguos"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "%1$s de %2$s rebotados (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "%1$s de %2$s correos de los últimos %3$s días no se pudieron enviar."

msgid "%1$s of %2$s entries processed …"
msgstr "%1$s de %2$s elementos procesados …"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s puntos porcentuales vs. %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "%1$s envió su primer correo el %2$s y en las últimas 24 horas ha escrito a %3$s direcciones externas distintas. Si no instalaste ni configuraste nada que envíe este tipo de correos, revisa el sitio: un remitente nuevo puede ser señal de que hackearon el sitio."

msgid "%1$s sent, %2$s still held …"
msgstr "%1$s enviados, %2$s aún retenidos …"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s vs. %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · %2$s correos agrupados desde el último resumen"

msgid "%1$s · as of %2$s"
msgstr "%1$s · a fecha de %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – tasa de fallos %2$s %% (semana anterior: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – informado por %2$s, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (plugin imprescindible)"

msgid "%s (theme)"
msgstr "%s (tema)"

msgid "%s ago"
msgstr "hace %s"

msgid "%s days"
msgstr "%s días"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "%s correo falló en los últimos 7 días."
msgstr[1] "%s correos fallaron en los últimos 7 días."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s correo espera tu decisión."
msgstr[1] "%s correos esperan tu decisión."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "%s correo se retuvo y no se envió en los últimos 7 días."
msgstr[1] "%s correos se retuvieron y no se enviaron en los últimos 7 días."

msgid "%s emails are held by the emergency brake."
msgstr "El freno de emergencia está reteniendo %s correos."

msgid "%s emails are waiting and have not been delivered."
msgstr "%s correos están en espera y no se han entregado."

msgid "%s entries"
msgstr "%s elementos"

msgid "%s failed"
msgstr "%s fallidos"

msgid "%s held emails discarded."
msgstr "Se descartaron %s correos retenidos."

msgid "%s imported entries removed."
msgstr "Se quitaron %s elementos importados."

msgid "%s in 30 days"
msgstr "%s en 30 días"

msgid "%s marked as spam"
msgstr "%s marcados como spam"

msgid "%s more on the Email types page."
msgstr "%s más en la página Tipos de correo."

msgid "%s notes"
msgstr "%s avisos"

msgid "%s of all emails"
msgstr "%s de todos los correos"

msgid "%s of them in the last 24 hours."
msgstr "%s de ellos en las últimas 24 horas."

msgid "%s s"
msgstr "%s s"

msgid "%s selected"
msgstr "%s seleccionados"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s cosa requiere tu atención:"
msgstr[1] "%s cosas requieren tu atención:"

msgid "%s to administrators in 30 days"
msgstr "%s a administradores en 30 días"

msgid "%s unchanged lines"
msgstr "%s líneas sin cambios"

msgid "(no subject)"
msgstr "(sin asunto)"

msgid "(no text content)"
msgstr "(sin contenido de texto)"

msgid "(the emails are no longer in the log)"
msgstr "(los correos ya no están en el registro)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "-all es más estricto; ~all es común y está bien junto con DMARC."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "0 conserva los elementos para siempre. La limpieza se ejecuta una vez al día."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "0 significa sin límite. Los elementos más antiguos se quitan primero."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "0 la desactiva. Quita el contenido, los encabezados y los archivos adjuntos de los elementos más antiguos y enmascara las direcciones (a***@example.com). La fecha, el estado, el origen, el formato, el tamaño y los avisos se conservan para las estadísticas. Se ejecuta con la limpieza diaria, antes de que se eliminen los elementos, así que solo tiene efecto si el periodo es más corto que el plazo de eliminación de arriba."

msgid "12 months"
msgstr "12 meses"

msgid "30 days"
msgstr "30 días"

msgid "7 days"
msgstr "7 días"

msgid "90 days"
msgstr "90 días"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "Un selector DKIM solo puede contener letras, números, puntos, guiones y guiones bajos."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "Un plugin de envío que usa una API se encargó de la entrega e informó que el envío falló, sin indicar el motivo."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "Una clave publicada no prueba que tus correos se firmen con ella: revisa el resultado de DKIM en los encabezados de un correo recibido."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "Un destinatario o la dirección del remitente no es una dirección de correo electrónico válida, por lo que PHPMailer se negó a enviar."

msgid "API key or private key in plain text: %1$s"
msgstr "Clave API o clave privada en texto sin cifrar: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "Se necesitan unas %1$s consultas DNS para evaluar este registro, más de las %2$s permitidas, por lo que los receptores podrían ignorarlo (PermError). Quita las entradas include: que no uses."

msgid "Access"
msgstr "Acceso"

msgid "Actions"
msgstr "Acciones"

msgid "Active: alerts on %s."
msgstr "Activo: alertas por %s."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "Agrega un atributo alt breve a cada imagen de la plantilla, p. ej., alt=\"Logo Tienda de ejemplo\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "Agrega el include: de tu proveedor de correo (p. ej., include:_spf.google.com) si envías a través de uno."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "Agrega tu servidor o servicio de correo al registro SPF del dominio del remitente."

msgid "Added:"
msgstr "Agregado:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "Direcciones con al menos %s fallos permanentes: el servidor de destino rechazó el buzón, el dominio no tiene servidor de correo o tu proveedor de correo informó un rebote permanente. Los elementos caducan con el periodo de conservación del registro."

msgid "Admin screen"
msgstr "Pantalla de administración"

msgid "Administrators"
msgstr "Administradores"

msgid "Aggregate reports go to %s."
msgstr "Los informes agregados se envían a %s."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "Alerta"

msgid "Alert and hold further emails"
msgstr "Alertar y retener los siguientes correos"

msgid "Alert only"
msgstr "Solo alertar"

msgid "Alert when an email type that is sent regularly stops"
msgstr "Alertar cuando un tipo de correo que se envía con regularidad deje de enviarse"

msgid "Alert when emails fail repeatedly"
msgstr "Alertar cuando los correos fallen repetidamente"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "Alertar cuando el sitio deje de enviar correos de forma inesperada"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "Las alertas están activadas, pero no tienen canal: escribe un correo electrónico o una URL de webhook."

msgid "Alerts are off."
msgstr "Las alertas están desactivadas."

msgid "All"
msgstr "Todos"

msgid "All email types look healthy."
msgstr "Todos los tipos de correo se ven bien."

msgid "All emails are redirected to test addresses."
msgstr "Todos los correos se redirigen a direcciones de prueba."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "Todos los correos van a direcciones de prueba en lugar de a los destinatarios reales."

msgid "All sources"
msgstr "Todos los orígenes"

msgid "Allow again"
msgstr "Volver a permitir"

msgid "Allowed again."
msgstr "Permitido de nuevo."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "También alerta una vez cuando un plugin o tema que nunca había enviado un correo escribe a muchas direcciones externas distintas en un día, una posible señal de que hackearon el sitio. Las primeras dos semanas después de instalar Mailspur sirven como referencia."

msgid "Also remove the subject when anonymising"
msgstr "Quitar también el asunto al anonimizar"

msgid "Also search content"
msgstr "Buscar también en el contenido"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "Como alternativa, pide a tu proveedor de hosting que active mail() / sendmail para este sitio."

msgid "Always load remote images and fonts in the preview"
msgstr "Cargar siempre imágenes y fuentes externas en la vista previa"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (a través de SNS)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "Un proveedor de correo con API HTTP en lugar de SMTP necesita menos idas y vueltas por correo."

msgid "Anonymisation"
msgstr "Anonimización"

msgid "Anonymise entries after"
msgstr "Anonimizar elementos después de"

msgid "Anonymised"
msgstr "Anonimizado"

msgid "Any format"
msgstr "Cualquier formato"

msgid "Any status"
msgstr "Cualquier estado"

msgid "Apply"
msgstr "Aplicar"

msgid "Ask the recipient for a working address."
msgstr "Pide al destinatario una dirección que funcione."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "Pide a tu proveedor de hosting que active la extensión openssl (o actívala en la configuración de PHP de tu panel de hosting)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "Pide a tu proveedor de hosting que actualice los certificados CA y OpenSSL del servidor."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "Pregunta a tu proveedor de hosting si las conexiones SMTP salientes están bloqueadas."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "Pregunta a tu proveedor de hosting si se permiten las conexiones salientes a ese puerto (firewall)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "Al menos %1$s correos fallidos en %2$s minutos"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "Como máximo una alerta por tipo en este periodo, aunque el problema continúe."

msgid "Attachments"
msgstr "Archivos adjuntos"

msgid "Attachments no longer available: %s"
msgstr "Archivos adjuntos ya no disponibles: %s"

msgid "Authentication"
msgstr "Autenticación"

msgid "Automatic TLS"
msgstr "TLS automático"

msgid "Average per day"
msgstr "Promedio por día"

msgid "Back to the email types"
msgstr "Volver a los tipos de correo"

msgid "Belongs to"
msgstr "Pertenece a"

msgid "Block again"
msgstr "Volver a bloquear"

msgid "Blocked as spam or by a blocklist"
msgstr "Bloqueado como spam o por una lista de bloqueo"

msgid "Bounced (permanent)"
msgstr "Rebotado (permanente)"

msgid "Bounced (temporary)"
msgstr "Rebotado (temporal)"

msgid "Broken characters (encoding): %1$s"
msgstr "Caracteres dañados (codificación): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "Correo masivo sin encabezado de baja (%1$s destinatarios)"

msgid "Bundle into one daily email"
msgstr "Agrupar en un correo diario"

msgid "Bundled into one daily email"
msgstr "Agrupado en un correo diario"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "La agrupación está desactivada. Los correos en espera se enviaron ahora en un resumen."

msgid "Busiest day"
msgstr "Día con más envíos"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "Cancelar"

msgid "Careful: emails to this address failed several times before."
msgstr "Cuidado: los correos a esta dirección ya fallaron varias veces."

msgid "Change in the email types"
msgstr "Cambiar en los tipos de correo"

msgid "Change staging mode"
msgstr "Cambiar el modo de pruebas"

msgid "Check"
msgstr "Revisar"

msgid "Check again"
msgstr "Volver a verificar"

msgid "Check emails"
msgstr "Revisar correos"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "Revisa el host y el puerto; prueba 587 (TLS) en lugar de 465 (SSL) o al revés."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "Revisa el host, el puerto, el cifrado, el nombre de usuario y la contraseña en tu plugin SMTP y envía desde ahí un correo de prueba."

msgid "Check sender domains"
msgstr "Verificar dominios del remitente"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "Comprueba que el cifrado coincida con el puerto: TLS para 587, SSL para 465."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "Comprueba que la clave pertenezca a la región o cuenta correcta (p. ej., endpoint de la UE frente al de EE. UU.)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "Revisa el host y el puerto SMTP: un puerto incorrecto o una conexión bloqueada a menudo terminan en un tiempo de espera agotado antes de que funcione una alternativa."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "Revisa los registros SPF, DKIM y DMARC del dominio del remitente, o usa una dirección de remitente del dominio desde el que envías."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "Revisa que la dirección no tenga errores de escritura, o tal vez tu sitio nunca envió el correo."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "Confirma la dirección con el destinatario y corrígela donde esté guardada (perfil de usuario, pedido, envío de formulario)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "Confirma la dirección con el destinatario y corrígela donde esté guardada."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "Revisa el nombre del host y el puerto: 587 con STARTTLS (TLS) o 465 con SSL. La mayoría de los proveedores de hosting bloquean el puerto 25."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "Revisa los límites y el uso actual en la cuenta de tu servicio de correo; si es necesario, cambia a un plan superior."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "Revisa que las direcciones de destinatario de este elemento no tengan errores de escritura, espacios ni partes faltantes."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
msgstr "Revisa la dirección del remitente en tu plugin SMTP y en el filtro wp_mail_from."

msgid "Check the sending limits of your mail account and the notes of this email."
msgstr "Revisa los límites de envío de tu cuenta de correo y los avisos de este correo."

msgid "Check the server IP on a blocklist checker and request delisting."
msgstr "Revisa la IP del servidor con un verificador de listas de bloqueo y solicita que la quiten."

msgid "Check the spelling of the placeholder in the template and whether the plugin supports it for this email type. Shortcodes are not processed in emails unless the sending plugin runs do_shortcode()."
msgstr "Revisa cómo está escrito el marcador de posición en la plantilla y si el plugin lo admite para este tipo de correo. Los shortcodes no se procesan en los correos, a menos que el plugin que envía ejecute do_shortcode()."

msgid "Checked %s."
msgstr "Verificado: %s."

msgid "Checked just now"
msgstr "Verificado hace un momento"

msgid "Checking DNS records …"
msgstr "Verificando registros DNS …"

msgid "Checks the DNS records of the domains your site sends from: the default sender address and the most frequent senders in the log. Missing or weak records are the most common reason why emails land in spam. Only your server's own DNS resolver is used; results are kept for one hour."
msgstr "Verifica los registros DNS de los dominios desde los que envía tu sitio: la dirección de remitente predeterminada y los remitentes más frecuentes del registro. Los registros faltantes o débiles son el motivo más común por el que los correos llegan a spam. Solo se usa el resolvedor DNS de tu servidor; los resultados se conservan durante una hora."

msgid "Choose a range of at most %s days."
msgstr "Elige un rango de %s días como máximo."

msgid "Clear selection"
msgstr "Borrar selección"

msgid "Click a bar to open these emails in the log."
msgstr "Haz clic en una barra para abrir estos correos en el registro."

msgid "Close"
msgstr "Cerrar"

msgid "Close (Esc)"
msgstr "Cerrar (Esc)"

msgid "Colour scheme"
msgstr "Esquema de colores"

msgid "Command line"
msgstr "Línea de comandos"

msgid "Compare"
msgstr "Comparar"

msgid "Compare the sources of these entries. Check whether two plugins send the same notification, or whether a hook (e.g. order status change) fires more than once."
msgstr "Compara los orígenes de estos elementos. Revisa si dos plugins envían la misma notificación o si un hook (p. ej., el cambio de estado de un pedido) se dispara más de una vez."

msgid "Component"
msgstr "Componente"

msgid "Configure alerts"
msgstr "Configurar alertas"

msgid "Content anonymised after %1$s days, %2$s"
msgstr "Contenido anonimizado después de %1$s días, %2$s"

msgid "Content change marked as seen."
msgstr "Cambio de contenido marcado como visto."

msgid "Content changed"
msgstr "Contenido modificado"

msgid "Content changed on %1$s, after the %2$s update."
msgstr "El contenido cambió el %1$s, después de la actualización de %2$s."

msgid "Content changed on %s."
msgstr "El contenido cambió el %s."

msgid "Content removed"
msgstr "Contenido quitado"

msgid "Content removed after %s days"
msgstr "Contenido quitado después de %s días"

msgid "Content, headers and attachments were removed and the addresses masked by the anonymisation setting."
msgstr "La configuración de anonimización quitó el contenido, los encabezados y los archivos adjuntos, y enmascaró las direcciones."

msgid "Copied"
msgstr "Copiado"

msgid "Copied – paste it into your reply."
msgstr "Copiado: pégalo en tu respuesta."

msgid "Copies a short sentence for answering the customer: when the email was sent to whom and whether it arrived – without technical details."
msgstr "Copia una frase corta para responder al cliente: cuándo y a quién se envió el correo y si llegó, sin detalles técnicos."

msgid "Copies the existing log of another mail logging plugin into Mailspur, so old emails can be searched and previewed here. The other plugin and its data stay untouched; running the import again only adds new entries."
msgstr "Copia a Mailspur el registro existente de otro plugin de registro de correos, para que puedas buscar y previsualizar aquí los correos antiguos. El otro plugin y sus datos no se modifican; si vuelves a ejecutar la importación, solo se agregan elementos nuevos."

msgid "Copy"
msgstr "Copiar"

msgid "Copy for support"
msgstr "Copiar para soporte"

msgid "Copying is not possible in this browser. Select the text and copy it:"
msgstr "No es posible copiar en este navegador. Selecciona el texto y cópialo:"

msgid "Correct the address (e.g. in the user profile or order) and consider an email validation in your forms."
msgstr "Corrige la dirección (p. ej., en el perfil de usuario o en el pedido) y considera validar los correos electrónicos en tus formularios."

msgid "Counted once per email."
msgstr "Se cuenta una vez por correo."

msgid "Create a new API key with send permission at your mail service and enter it in the mailer plugin."
msgstr "Crea en tu servicio de correo una nueva clave API con permiso de envío y escríbela en el plugin de envío."

msgid "Create a new webhook URL? The current URL stops working at once – paste the new URL into the webhook settings of your email provider."
msgstr "¿Crear una nueva URL de webhook? La URL actual dejará de funcionar de inmediato: pega la nueva URL en la configuración de webhooks de tu proveedor de correo."

msgid "Create new URL"
msgstr "Crear nueva URL"

msgid "Current page"
msgstr "Página actual"

msgid "Current record"
msgstr "Registro DNS actual"

msgid "Current size"
msgstr "Tamaño actual"

msgid "Custom"
msgstr "Personalizado"

msgid "DKIM key found (selector: %s)."
msgstr "Se encontró una clave DKIM (selector: %s)."

msgid "DMARC record found with p=none: reports only, spoofed mail is still delivered."
msgstr "Se encontró un registro DMARC con p=none: solo informes, los correos falsificados se siguen entregando."

msgid "DMARC record found with policy p=%s."
msgstr "Se encontró un registro DMARC con la política p=%s."

msgid "DMARC record has no valid policy (p=none, quarantine or reject)."
msgstr "El registro DMARC no tiene una política válida (p=none, quarantine o reject)."

msgid "DNS lookup failed or timed out. Try again later."
msgstr "La consulta DNS falló o tardó demasiado. Vuelve a intentarlo más tarde."

msgid "DNS lookups are not available on this server (dns_get_record() is disabled), so the sender check cannot run here."
msgstr "Las consultas DNS no están disponibles en este servidor (dns_get_record() está desactivada), así que la verificación del remitente no puede ejecutarse aquí."

msgid "DNS lookups needed: about %1$s of %2$s allowed."
msgstr "Consultas DNS necesarias: unas %1$s de %2$s permitidas."

msgid "Daily"
msgstr "Diario"

msgid "Daily digest"
msgstr "Resumen diario"

msgid "Dark"
msgstr "Oscuro"

msgid "Date"
msgstr "Fecha"

msgid "Default (%s days)"
msgstr "Predeterminado (%s días)"

msgid "Default (no time limit)"
msgstr "Predeterminado (sin límite de tiempo)"

msgid "Default sender"
msgstr "Remitente predeterminado"

msgid "Delete"
msgstr "Eliminar"

msgid "Delete %s selected log entries?"
msgstr "¿Eliminar %s elementos seleccionados del registro?"

msgid "Delete ALL log entries? This cannot be undone."
msgstr "¿Eliminar TODOS los elementos del registro? Esto no se puede deshacer."

msgid "Delete entries after"
msgstr "Eliminar elementos después de"

msgid "Delete selected"
