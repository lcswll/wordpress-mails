msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: hr\n"
"Plural-Forms: nplurals=3; plural=(n % 10 == 1 && n % 100 != 11) ? 0 : ((n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14)) ? 1 : 2);\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "„Preuzmi .eml“ ponovno sastavlja poruku iz zabilježenih, maskiranih podataka (bez privitaka)."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (prethodni tjedan: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (zakazano za %2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s vrsta e-poruke više se ne šalje: %2$s."
msgstr[1] "%1$s vrste e-poruka više se ne šalju, npr. %2$s."
msgstr[2] "%1$s vrsta e-poruka više se ne šalje, npr. %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "Vrste e-poruka: %1$s, pošiljatelji: %2$s"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "U posljednjih %2$s minuta nije uspjelo %1$s e-poruka."

msgid "%1$s emails in %2$s days"
msgstr "E-poruke: %1$s u %2$s dana"

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "E-poruke u posljednjih 30 dana: %1$s, neuspjele: %2$s"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "Unutar jednog sata poslano je %1$s e-poruka – mnogo više nego inače (prag: %2$s na sat). Kontaktni obrazac možda se zloupotrebljava ili je web-mjesto možda kompromitirano."

msgid "%1$s entries, %2$s"
msgstr "Zapisi: %1$s, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "Uvezeno: %1$s, duplikati: %2$s, prestaro: %3$s"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "Odbijeno %1$s od %2$s (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "U posljednjih %3$s dana nije poslano %1$s od %2$s e-poruka."

msgid "%1$s of %2$s entries processed …"
msgstr "Obrađeno %1$s od %2$s zapisa …"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s p. b. u odnosu na %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "%1$s poslao je prvu e-poruku %2$s i u posljednja 24 sata pisao na %3$s različitih vanjskih adresa. Ako niste instalirali ni postavili ništa što šalje takve e-poruke, provjerite web-mjesto: novi pošiljatelj može biti znak hakiranog web-mjesta."

msgid "%1$s sent, %2$s still held …"
msgstr "Poslano %1$s, još zadržano %2$s …"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s u odnosu na %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · e-poruke prikupljene od posljednjeg sažetka: %2$s"

msgid "%1$s · as of %2$s"
msgstr "%1$s · stanje na %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – stopa neuspjeha %2$s %% (prethodni tjedan: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – prijavio %2$s, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (must-use dodatak)"

msgid "%s (theme)"
msgstr "%s (tema)"

msgid "%s ago"
msgstr "prije %s"

msgid "%s days"
msgstr "%s dana"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "%s e-poruka nije uspješno poslana u posljednjih 7 dana."
msgstr[1] "%s e-poruke nisu uspješno poslane u posljednjih 7 dana."
msgstr[2] "%s e-poruka nije uspješno poslano u posljednjih 7 dana."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s e-poruka čeka vašu odluku."
msgstr[1] "%s e-poruke čekaju vašu odluku."
msgstr[2] "%s e-poruka čeka vašu odluku."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "%s e-poruka zadržana je i nije poslana u posljednjih 7 dana."
msgstr[1] "%s e-poruke zadržane su i nisu poslane u posljednjih 7 dana."
msgstr[2] "%s e-poruka zadržano je i nije poslano u posljednjih 7 dana."

msgid "%s emails are held by the emergency brake."
msgstr "Kočnica u nuždi zadržava e-poruke: %s."

msgid "%s emails are waiting and have not been delivered."
msgstr "E-poruke koje čekaju i nisu isporučene: %s."

msgid "%s entries"
msgstr "Zapisi: %s"

msgid "%s failed"
msgstr "Neuspjelo: %s"

msgid "%s held emails discarded."
msgstr "Odbačene zadržane e-poruke: %s."

msgid "%s imported entries removed."
msgstr "Uklonjeni uvezeni zapisi: %s."

msgid "%s in 30 days"
msgstr "%s u 30 dana"

msgid "%s marked as spam"
msgstr "Označeno kao neželjena pošta: %s"

msgid "%s more on the Email types page."
msgstr "Još %s na stranici Vrste e-poruka."

msgid "%s notes"
msgstr "Napomene: %s"

msgid "%s of all emails"
msgstr "%s svih e-poruka"

msgid "%s of them in the last 24 hours."
msgstr "Od toga %s u posljednja 24 sata."

msgid "%s s"
msgstr "%s s"

msgid "%s selected"
msgstr "Odabrano: %s"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s stvar zahtijeva pažnju:"
msgstr[1] "%s stvari zahtijevaju pažnju:"
msgstr[2] "%s stvari zahtijeva pažnju:"

msgid "%s to administrators in 30 days"
msgstr "%s administratorima u 30 dana"

msgid "%s unchanged lines"
msgstr "Nepromijenjeni retci: %s"

msgid "(no subject)"
msgstr "(bez predmeta)"

msgid "(no text content)"
msgstr "(bez tekstnog sadržaja)"

msgid "(the emails are no longer in the log)"
msgstr "(te e-poruke više nisu u zapisniku)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "-all je stroži; ~all je uobičajen i u redu u kombinaciji s DMARC-om."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "0 zauvijek čuva zapise. Čišćenje se pokreće jednom dnevno."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "0 znači bez ograničenja. Najstariji zapisi uklanjaju se prvi."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "0 je isključuje. Uklanja sadržaj, zaglavlja i privitke starijih zapisa i maskira adrese (a***@example.com). Datum, status, izvor, format, veličina i napomene ostaju radi statistike. Pokreće se s dnevnim čišćenjem, prije brisanja zapisa – pa ima učinka samo ako je kraća od gornjeg razdoblja brisanja."

msgid "12 months"
msgstr "12 mjeseci"

msgid "30 days"
msgstr "30 dana"

msgid "7 days"
msgstr "7 dana"

msgid "90 days"
msgstr "90 dana"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "DKIM selektor smije sadržavati samo slova, znamenke, točke, crtice i podvlake."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "Dodatak za slanje e-pošte koji šalje putem API-ja preuzeo je isporuku i javio da slanje nije uspjelo, bez navođenja razloga."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "Objavljeni ključ ne dokazuje da su vaše e-poruke njime potpisane – provjerite DKIM rezultat u zaglavljima primljene poruke."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "Primatelj ili adresa pošiljatelja nije valjana adresa e-pošte, pa je PHPMailer odbio slanje."

msgid "API key or private key in plain text: %1$s"
msgstr "API ključ ili privatni ključ kao običan tekst: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "Za procjenu ovog zapisa potrebno je oko %1$s DNS upita – više od dopuštenih %2$s, pa ga primatelji mogu zanemariti (PermError). Uklonite nekorištene stavke include:."

msgid "Access"
msgstr "Pristup"

msgid "Actions"
msgstr "Radnje"

msgid "Active: alerts on %s."
msgstr "Aktivno: upozorenja za %s."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "Svakoj slici u predlošku dodajte kratak atribut alt, npr. alt=\"Logotip Primjer Trgovine\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "Dodajte include: svog pružatelja usluge e-pošte (npr. include:_spf.google.com) ako šaljete preko njega."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "Dodajte svoj poslužitelj e-pošte ili uslugu e-pošte u SPF zapis domene pošiljatelja."

msgid "Added:"
msgstr "Dodano:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "Adrese s najmanje %s trajnih pogrešaka: poslužitelj primatelja odbio je pretinac, domena nema poslužitelj e-pošte ili je vaš pružatelj usluge e-pošte prijavio trajno odbijanje. Unosi istječu s razdobljem čuvanja zapisnika."

msgid "Admin screen"
msgstr "Administratorski zaslon"

msgid "Administrators"
msgstr "Administratori"

msgid "Aggregate reports go to %s."
msgstr "Zbirna izvješća idu na %s."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "Upozorenje"

msgid "Alert and hold further emails"
msgstr "Upozori i zadrži daljnje e-poruke"

msgid "Alert only"
msgstr "Samo upozori"

msgid "Alert when an email type that is sent regularly stops"
msgstr "Upozori kada se redovito slana vrsta e-poruke prestane slati"

msgid "Alert when emails fail repeatedly"
msgstr "Upozori kada e-poruke opetovano ne uspiju"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "Upozori kada web-mjesto neočekivano prestane slati e-poruke"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "Upozorenja su uključena, ali nemaju kanal: unesite adresu e-pošte ili URL webhooka."

msgid "Alerts are off."
msgstr "Upozorenja su isključena."

msgid "All"
msgstr "Sve"

msgid "All email types look healthy."
msgstr "Sve vrste e-poruka izgledaju u redu."

msgid "All emails are redirected to test addresses."
msgstr "Sve e-poruke preusmjeravaju se na testne adrese."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "Sve e-poruke idu na testne adrese umjesto stvarnim primateljima."

msgid "All sources"
msgstr "Svi izvori"

msgid "Allow again"
msgstr "Ponovno dopusti"

msgid "Allowed again."
msgstr "Ponovno dopušteno."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "Također jednom upozorava kada dodatak ili tema koja nikada prije nije poslala e-poruku unutar jednog dana piše na mnogo različitih vanjskih adresa – mogući znak hakiranog web-mjesta. Prva dva tjedna nakon instalacije Mailspura služe kao polazište."

msgid "Also remove the subject when anonymising"
msgstr "Pri anonimizaciji ukloni i predmet"

msgid "Also search content"
msgstr "Pretraži i sadržaj"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "Ili zamolite davatelja hostinga da omogući mail() / sendmail za ovo web-mjesto."

msgid "Always load remote images and fonts in the preview"
msgstr "Uvijek učitaj vanjske slike i fontove u pregledu"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (putem SNS-a)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "Pružatelju usluge e-pošte s HTTP API-jem umjesto SMTP-a treba manje razmjena po e-poruci."

msgid "Anonymisation"
msgstr "Anonimizacija"

msgid "Anonymise entries after"
msgstr "Anonimiziraj zapise nakon"

msgid "Anonymised"
msgstr "Anonimizirano"

msgid "Any format"
msgstr "Bilo koji format"

msgid "Any status"
msgstr "Bilo koji status"

msgid "Apply"
msgstr "Primijeni"

msgid "Ask the recipient for a working address."
msgstr "Zamolite primatelja za ispravnu adresu."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "Zamolite davatelja hostinga da omogući proširenje openssl (ili ga omogućite u PHP postavkama upravljačke ploče hostinga)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "Zamolite davatelja hostinga da ažurira CA certifikate i OpenSSL na poslužitelju."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "Pitajte davatelja hostinga jesu li odlazne SMTP veze blokirane."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "Pitajte davatelja hostinga jesu li odlazne veze na taj priključak dopuštene (vatrozid)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "Najmanje %1$s neuspjelih e-poruka unutar %2$s minuta"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "Najviše jedno upozorenje po vrsti u tom razdoblju, čak i ako problem i dalje postoji."

msgid "Attachments"
msgstr "Privici"

msgid "Attachments no longer available: %s"
msgstr "Privici više nisu dostupni: %s"

msgid "Authentication"
msgstr "Autentifikacija"

msgid "Automatic TLS"
msgstr "Automatski TLS"

msgid "Average per day"
msgstr "Prosjek po danu"

msgid "Back to the email types"
msgstr "Natrag na vrste e-poruka"

msgid "Belongs to"
msgstr "Pripada"

msgid "Block again"
msgstr "Ponovno blokiraj"

msgid "Blocked as spam or by a blocklist"
msgstr "Blokirano kao neželjena pošta ili zbog popisa blokiranih"

msgid "Bounced (permanent)"
msgstr "Odbijeno (trajno)"

msgid "Bounced (temporary)"
msgstr "Odbijeno (privremeno)"

msgid "Broken characters (encoding): %1$s"
msgstr "Pokvareni znakovi (kodiranje): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "Masovna e-poruka bez zaglavlja za odjavu (primatelja: %1$s)"

msgid "Bundle into one daily email"
msgstr "Skupi u jednu dnevnu e-poruku"

msgid "Bundled into one daily email"
msgstr "Skupljeno u jednu dnevnu e-poruku"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "Skupljanje je isključeno. E-poruke koje su čekale upravo su otišle u jednom sažetku."

msgid "Busiest day"
msgstr "Najprometniji dan"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "Odustani"

msgid "Careful: emails to this address failed several times before."
msgstr "Oprez: e-poruke na ovu adresu već nekoliko puta nisu uspjele."

msgid "Change in the email types"
msgstr "Promijeni u vrstama e-poruka"

msgid "Change staging mode"
msgstr "Promijeni testni način rada"

msgid "Check"
msgstr "Provjeri"

msgid "Check again"
msgstr "Provjeri ponovno"

msgid "Check emails"
msgstr "Provjeri e-poruke"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "Provjerite host i priključak; pokušajte 587 (TLS) umjesto 465 (SSL) ili obrnuto."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "Provjerite host, priključak, šifriranje, korisničko ime i lozinku u svom SMTP dodatku i odande pošaljite testnu e-poruku."

msgid "Check sender domains"
msgstr "Provjeri domene pošiljatelja"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "Provjerite odgovara li šifriranje priključku: TLS za 587, SSL za 465."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "Provjerite pripada li ključ ispravnoj regiji / računu (npr. EU ili US krajnja točka)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "Provjerite SMTP host i priključak: pogrešan priključak ili blokirana veza često završe istekom vremena prije nego što rezervno rješenje proradi."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "Provjerite SPF, DKIM i DMARC zapise domene pošiljatelja ili upotrijebite adresu pošiljatelja na domeni s koje šaljete."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "Provjerite ima li u adresi tipfelera – ili vaše web-mjesto tu e-poruku nikada nije poslalo."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "Provjerite adresu s primateljem i ispravite je ondje gdje je spremljena (korisnički profil, narudžba, unos obrasca)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "Provjerite adresu s primateljem i ispravite je ondje gdje je spremljena."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "Provjerite naziv hosta i priključak: 587 sa STARTTLS-om (TLS) ili 465 sa SSL-om. Priključak 25 blokira većina davatelja hostinga."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "Provjerite ograničenja i trenutačnu potrošnju na računu usluge e-pošte; po potrebi prijeđite na veći paket."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "Provjerite adrese primatelja ovog zapisa ima li tipfelera, razmaka ili dijelova koji nedostaju."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
msgstr "Provjerite adresu pošiljatelja u svom SMTP dodatku i filtar wp_mail_from."

msgid "Check the sending limits of your mail account and the notes of this email."
msgstr "Provjerite ograničenja slanja svog računa e-pošte i napomene uz ovu e-poruku."

msgid "Check the server IP on a blocklist checker and request delisting."
msgstr "Provjerite IP adresu poslužitelja alatom za provjeru popisa blokiranih i zatražite uklanjanje s popisa."

msgid "Check the spelling of the placeholder in the template and whether the plugin supports it for this email type. Shortcodes are not processed in emails unless the sending plugin runs do_shortcode()."
msgstr "Provjerite pravopis rezerviranog mjesta u predlošku i podržava li ga dodatak za ovu vrstu e-poruke. Kratki kodovi ne obrađuju se u e-porukama osim ako dodatak koji šalje ne pokreće do_shortcode()."

msgid "Checked %s."
msgstr "Provjereno %s."

msgid "Checked just now"
msgstr "Upravo provjereno"

msgid "Checking DNS records …"
msgstr "Provjera DNS zapisa …"

msgid "Checks the DNS records of the domains your site sends from: the default sender address and the most frequent senders in the log. Missing or weak records are the most common reason why emails land in spam. Only your server's own DNS resolver is used; results are kept for one hour."
msgstr "Provjerava DNS zapise domena s kojih vaše web-mjesto šalje: zadanu adresu pošiljatelja i najčešće pošiljatelje u zapisniku. Nedostajući ili slabi zapisi najčešći su razlog zašto e-poruke završavaju u neželjenoj pošti. Koristi se samo DNS resolver vašeg poslužitelja; rezultati se čuvaju jedan sat."

msgid "Choose a range of at most %s days."
msgstr "Odaberite raspon od najviše %s dana."

msgid "Clear selection"
msgstr "Poništi odabir"

msgid "Click a bar to open these emails in the log."
msgstr "Kliknite stupac da biste otvorili te e-poruke u zapisniku."

msgid "Close"
msgstr "Zatvori"

msgid "Close (Esc)"
msgstr "Zatvori (Esc)"

msgid "Colour scheme"
msgstr "Shema boja"

msgid "Command line"
msgstr "Naredbeni redak"

msgid "Compare"
msgstr "Usporedi"

msgid "Compare the sources of these entries. Check whether two plugins send the same notification, or whether a hook (e.g. order status change) fires more than once."
msgstr "Usporedite izvore ovih zapisa. Provjerite šalju li dva dodatka istu obavijest ili se neki hook (npr. promjena statusa narudžbe) pokreće više puta."

msgid "Component"
msgstr "Komponenta"

msgid "Configure alerts"
msgstr "Postavi upozorenja"

msgid "Content anonymised after %1$s days, %2$s"
msgstr "Sadržaj anonimiziran nakon %1$s dana, %2$s"

msgid "Content change marked as seen."
msgstr "Promjena sadržaja označena kao viđena."

msgid "Content changed"
msgstr "Sadržaj promijenjen"

msgid "Content changed on %1$s, after the %2$s update."
msgstr "Sadržaj promijenjen %1$s, nakon ažuriranja %2$s."

msgid "Content changed on %s."
msgstr "Sadržaj promijenjen %s."

msgid "Content removed"
msgstr "Sadržaj uklonjen"

msgid "Content removed after %s days"
msgstr "Sadržaj uklonjen nakon %s dana"

msgid "Content, headers and attachments were removed and the addresses masked by the anonymisation setting."
msgstr "Sadržaj, zaglavlja i privici uklonjeni su, a adrese maskirane postavkom anonimizacije."

msgid "Copied"
msgstr "Kopirano"

msgid "Copied – paste it into your reply."
msgstr "Kopirano – zalijepite to u svoj odgovor."

msgid "Copies a short sentence for answering the customer: when the email was sent to whom and whether it arrived – without technical details."
msgstr "Kopira kratku rečenicu za odgovor kupcu: kada je i kome e-poruka poslana i je li stigla – bez tehničkih pojedinosti."

msgid "Copies the existing log of another mail logging plugin into Mailspur, so old emails can be searched and previewed here. The other plugin and its data stay untouched; running the import again only adds new entries."
msgstr "Kopira postojeći zapisnik drugog dodatka za bilježenje e-pošte u Mailspur kako bi se stare e-poruke mogle ovdje pretraživati i pregledavati. Drugi dodatak i njegovi podaci ostaju netaknuti; ponovno pokretanje uvoza dodaje samo nove zapise."

msgid "Copy"
msgstr "Kopiraj"

