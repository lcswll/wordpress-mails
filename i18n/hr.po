msgstr "[%1$s] Obavijesti (%2$s): %3$s"

msgid "[%1$s] 1 notification: %2$s"
msgstr "[%1$s] 1 obavijest: %2$s"

msgid "[%1$s] Weekly email report %2$s"
msgstr "[%1$s] Tjedno izvješće e-poštom %2$s"

msgid "address"
msgstr "adresa"

msgid "and %s more"
msgstr "i još %s"

msgid "and %s more – see the log"
msgstr "i još %s – pogledajte zapisnik"

msgid "another plugin stopped it"
msgstr "zaustavio ju je drugi dodatak"

msgid "code"
msgstr "kôd"

msgid "date"
msgstr "datum"

msgid "days"
msgstr "dana"

msgid "deleted after %s days"
msgstr "brišu se nakon %s dana"

msgid "emails to this address failed several times before"
msgstr "e-poruke na ovu adresu već nekoliko puta nisu uspjele"

msgid "entries"
msgstr "zapisa"

msgid "failing"
msgstr "s pogreškama"

msgid "failure spikes"
msgstr "nagle poraste pogrešaka"

msgid "first seen %s"
msgstr "prvi put viđeno %s"

msgid "from a new sender"
msgstr "od novog pošiljatelja"

msgid "holding emails right now"
msgstr "trenutačno zadržava e-poruke"

msgid "https://github.com/lcswll/wordpress-mails"
msgstr "https://github.com/lcswll/wordpress-mails"

msgid "https://lucaswille.de/"
msgstr "https://lucaswille.de/"

msgid "kept until deleted manually"
msgstr "čuva se do ručnog brisanja"

msgid "link"
msgstr "poveznica"

msgid "minutes"
msgstr "minuta"

msgid "name"
msgstr "ime"

msgid "new this week"
msgstr "novo ovaj tjedan"

msgid "no"
msgstr "ne"

