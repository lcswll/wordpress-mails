msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ca\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "«Baixa el .eml» reconstrueix el missatge a partir de les dades registrades i emmascarades (sense adjunts)."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (setmana anterior: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (programat per a %2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s tipus de correu s'ha aturat: %2$s."
msgstr[1] "%1$s tipus de correu s'han aturat, p. ex. %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "%1$s tipus de correu de %2$s remitents"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "Han fallat %1$s correus en els darrers %2$s minuts."

msgid "%1$s emails in %2$s days"
msgstr "%1$s correus en %2$s dies"

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "%1$s correus en els darrers 30 dies, %2$s fallits"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "S'han enviat %1$s correus en una hora, molts més del que és habitual (llindar: %2$s per hora). Pot ser que s'estigui fent un mal ús d'un formulari de contacte o que el lloc web estigui compromès."

msgid "%1$s entries, %2$s"
msgstr "%1$s entrades, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "%1$s importades, %2$s duplicades, %3$s massa antigues"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "%1$s de %2$s han rebotat (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "No s'han pogut enviar %1$s de %2$s correus dels darrers %3$s dies."

msgid "%1$s of %2$s entries processed …"
msgstr "S'han processat %1$s de %2$s entrades…"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s punts percentuals respecte a %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "%1$s va enviar el primer correu el %2$s i ha escrit a %3$s adreces externes diferents en les darreres 24 hores. Si no heu instal·lat ni configurat res que enviï aquests correus, reviseu el lloc web: un remitent nou pot ser un senyal que el lloc web ha estat piratejat."

msgid "%1$s sent, %2$s still held …"
msgstr "%1$s enviats, %2$s encara retinguts…"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s respecte a %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · %2$s correus agrupats des de l'últim resum"

msgid "%1$s · as of %2$s"
msgstr "%1$s · a data de %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – taxa d'errors %2$s %% (setmana anterior: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – informat per %2$s, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (extensió must-use)"

msgid "%s (theme)"
msgstr "%s (tema)"

msgid "%s ago"
msgstr "fa %s"

msgid "%s days"
msgstr "%s dies"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "%s correu ha fallat en els darrers 7 dies."
msgstr[1] "%s correus han fallat en els darrers 7 dies."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s correu espera la vostra decisió."
msgstr[1] "%s correus esperen la vostra decisió."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "%s correu s'ha retingut i no s'ha enviat en els darrers 7 dies."
msgstr[1] "%s correus s'han retingut i no s'han enviat en els darrers 7 dies."

msgid "%s emails are held by the emergency brake."
msgstr "El fre d'emergència reté %s correus."

msgid "%s emails are waiting and have not been delivered."
msgstr "Hi ha %s correus en espera que no s'han lliurat."

msgid "%s entries"
msgstr "%s entrades"

msgid "%s failed"
msgstr "%s fallits"

msgid "%s held emails discarded."
msgstr "S'han descartat %s correus retinguts."

msgid "%s imported entries removed."
msgstr "S'han eliminat %s entrades importades."

msgid "%s in 30 days"
msgstr "%s en 30 dies"

msgid "%s marked as spam"
msgstr "%s marcats com a correu brossa"

msgid "%s more on the Email types page."
msgstr "%s més a la pàgina Tipus de correu."

msgid "%s notes"
msgstr "%s notes"

msgid "%s of all emails"
msgstr "%s de tots els correus"

msgid "%s of them in the last 24 hours."
msgstr "%s d'ells en les darreres 24 hores."

msgid "%s s"
msgstr "%s s"

msgid "%s selected"
msgstr "%s seleccionades"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s cosa necessita atenció:"
msgstr[1] "%s coses necessiten atenció:"

msgid "%s to administrators in 30 days"
msgstr "%s a administradors en 30 dies"

msgid "%s unchanged lines"
msgstr "%s línies sense canvis"

msgid "(no subject)"
msgstr "(sense assumpte)"

msgid "(no text content)"
msgstr "(sense contingut de text)"

msgid "(the emails are no longer in the log)"
msgstr "(els correus ja no són al registre)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "-all és més estricte; ~all és habitual i correcte juntament amb DMARC."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "0 conserva les entrades per sempre. La neteja s'executa un cop al dia."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "0 vol dir sense límit. Les entrades més antigues s'eliminen primer."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "0 ho desactiva. Elimina el contingut, les capçaleres i els adjunts de les entrades més antigues i emmascara les adreces (a***@example.com). La data, l'estat, la font, el format, la mida i les notes es conserven per a les estadístiques. S'executa amb la neteja diària, abans que s'eliminin les entrades; per tant, només té efecte si és més curt que el període d'eliminació de dalt."

msgid "12 months"
msgstr "12 mesos"

msgid "30 days"
msgstr "30 dies"

msgid "7 days"
msgstr "7 dies"

msgid "90 days"
msgstr "90 dies"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "Un selector DKIM només pot contenir lletres, xifres, punts, guions i guions baixos."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "Una extensió de correu que envia mitjançant una API s'ha encarregat del lliurament i ha informat que l'enviament ha fallat, sense indicar-ne el motiu."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "Una clau publicada no demostra que els vostres correus se signin amb ella: comproveu el resultat DKIM a les capçaleres d'un correu rebut."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "Un destinatari o l'adreça del remitent no és una adreça electrònica vàlida, de manera que PHPMailer s'ha negat a enviar."

msgid "API key or private key in plain text: %1$s"
msgstr "Clau d'API o clau privada en text pla: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "Calen unes %1$s consultes DNS per avaluar aquest registre, més de les %2$s permeses, de manera que els receptors el poden ignorar (PermError). Elimineu les entrades include: que no s'utilitzin."

msgid "Access"
msgstr "Accés"

msgid "Actions"
msgstr "Accions"

msgid "Active: alerts on %s."
msgstr "Actiu: alertes per %s."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "Afegiu un atribut alt breu a cada imatge de la plantilla, p. ex. alt=\"Logotip de la Botiga d'exemple\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "Afegiu l'include: del vostre proveïdor de correu (p. ex. include:_spf.google.com) si envieu a través seu."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "Afegiu el vostre servidor o servei de correu al registre SPF del domini del remitent."

msgid "Added:"
msgstr "Afegit:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "Adreces amb com a mínim %s errors permanents: el servidor receptor va rebutjar la bústia, el domini no té servidor de correu o el vostre proveïdor de correu va informar d'un rebot permanent. Les entrades caduquen amb el període de conservació del registre."

msgid "Admin screen"
msgstr "Pantalla d'administració"

msgid "Administrators"
msgstr "Administradors"

msgid "Aggregate reports go to %s."
msgstr "Els informes agregats van a %s."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "Alerta"

msgid "Alert and hold further emails"
msgstr "Avisa i retén els correus següents"

msgid "Alert only"
msgstr "Només avisa"

msgid "Alert when an email type that is sent regularly stops"
msgstr "Avisa quan s'aturi un tipus de correu que s'envia regularment"

msgid "Alert when emails fail repeatedly"
msgstr "Avisa quan els correus fallin repetidament"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "Avisa quan el lloc web deixi d'enviar correus inesperadament"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "Les alertes estan activades però no tenen cap canal: introduïu una adreça electrònica o un URL de webhook."

msgid "Alerts are off."
msgstr "Les alertes estan desactivades."

msgid "All"
msgstr "Tots"

msgid "All email types look healthy."
msgstr "Tots els tipus de correu semblen correctes."

msgid "All emails are redirected to test addresses."
msgstr "Tots els correus es redirigeixen a adreces de prova."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "Tots els correus van a adreces de prova en lloc dels destinataris reals."

msgid "All sources"
msgstr "Totes les fonts"

msgid "Allow again"
msgstr "Torna a permetre"

msgid "Allowed again."
msgstr "S'ha tornat a permetre."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "També avisa una vegada quan una extensió o un tema que no havia enviat mai cap correu escriu a moltes adreces externes diferents en un dia, un possible senyal que el lloc web ha estat piratejat. Les dues primeres setmanes després d'instal·lar Mailspur serveixen de referència."

msgid "Also remove the subject when anonymising"
msgstr "Elimina també l'assumpte en anonimitzar"

msgid "Also search content"
msgstr "Cerca també al contingut"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "Com a alternativa, demaneu al vostre proveïdor d'allotjament que activi mail() / sendmail per a aquest lloc web."

msgid "Always load remote images and fonts in the preview"
msgstr "Carrega sempre les imatges i els tipus de lletra externs a la previsualització"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (via SNS)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "Un proveïdor de correu amb una API HTTP en lloc de SMTP necessita menys anades i tornades per correu."

msgid "Anonymisation"
msgstr "Anonimització"

msgid "Anonymise entries after"
msgstr "Anonimitza les entrades després de"

msgid "Anonymised"
msgstr "Anonimitzat"

msgid "Any format"
msgstr "Qualsevol format"

msgid "Any status"
msgstr "Qualsevol estat"

msgid "Apply"
msgstr "Aplica"

msgid "Ask the recipient for a working address."
msgstr "Demaneu al destinatari una adreça que funcioni."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "Demaneu al vostre proveïdor d'allotjament que activi l'extensió openssl (o activeu-la als paràmetres de PHP del vostre tauler d'allotjament)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "Demaneu al vostre proveïdor d'allotjament que actualitzi els certificats CA i l'OpenSSL del servidor."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "Pregunteu al vostre proveïdor d'allotjament si les connexions SMTP sortints estan bloquejades."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "Pregunteu al vostre proveïdor d'allotjament si es permeten les connexions sortints a aquest port (tallafoc)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "Com a mínim %1$s correus fallits en %2$s minuts"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "Com a màxim una alerta per tipus en aquest temps, encara que el problema continuï."

msgid "Attachments"
msgstr "Adjunts"

msgid "Attachments no longer available: %s"
msgstr "Adjunts que ja no estan disponibles: %s"

msgid "Authentication"
msgstr "Autenticació"

msgid "Automatic TLS"
msgstr "TLS automàtic"

msgid "Average per day"
msgstr "Mitjana per dia"

msgid "Back to the email types"
msgstr "Torna als tipus de correu"

msgid "Belongs to"
msgstr "Pertany a"

msgid "Block again"
msgstr "Torna a bloquejar"

msgid "Blocked as spam or by a blocklist"
msgstr "Bloquejat com a correu brossa o per una llista de bloqueig"

msgid "Bounced (permanent)"
msgstr "Rebotat (permanent)"

msgid "Bounced (temporary)"
msgstr "Rebotat (temporal)"

msgid "Broken characters (encoding): %1$s"
msgstr "Caràcters trencats (codificació): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "Correu massiu sense capçalera de baixa (%1$s destinataris)"

msgid "Bundle into one daily email"
msgstr "Agrupa en un correu diari"

msgid "Bundled into one daily email"
msgstr "Agrupat en un correu diari"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "L'agrupació està desactivada. Els correus que esperaven s'han enviat ara en un resum."

msgid "Busiest day"
msgstr "Dia amb més activitat"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "Cancel·la"

msgid "Careful: emails to this address failed several times before."
msgstr "Atenció: els correus a aquesta adreça ja han fallat diverses vegades."

msgid "Change in the email types"
msgstr "Canvi en els tipus de correu"

msgid "Change staging mode"
msgstr "Canvia el mode de proves"

msgid "Check"
msgstr "Comprova"

msgid "Check again"
msgstr "Torna a comprovar"

msgid "Check emails"
msgstr "Comprova els correus"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "Comproveu l'amfitrió i el port; proveu el 587 (TLS) en lloc del 465 (SSL) o a l'inrevés."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "Comproveu l'amfitrió, el port, el xifratge, el nom d'usuari i la contrasenya a l'extensió SMTP i envieu-hi un correu de prova."

msgid "Check sender domains"
msgstr "Comprova els dominis de remitent"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "Comproveu que el xifratge coincideixi amb el port: TLS per al 587, SSL per al 465."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "Comproveu que la clau pertanyi a la regió o al compte correctes (p. ex. punt d'accés de la UE o dels EUA)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "Comproveu l'amfitrió i el port SMTP: un port incorrecte o una connexió bloquejada sovint acaben en un temps d'espera esgotat abans que funcioni una alternativa."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "Comproveu els registres SPF, DKIM i DMARC del domini del remitent, o feu servir una adreça de remitent del domini des del qual envieu."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "Comproveu si l'adreça té errors tipogràfics, o potser el vostre lloc web no va enviar mai el correu."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "Comproveu l'adreça amb el destinatari i corregiu-la allà on estigui desada (perfil d'usuari, comanda, entrada de formulari)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "Comproveu l'adreça amb el destinatari i corregiu-la allà on estigui desada."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "Comproveu el nom de l'amfitrió i el port: 587 amb STARTTLS (TLS) o 465 amb SSL. La majoria de proveïdors d'allotjament bloquegen el port 25."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "Comproveu els límits i l'ús actual al compte del vostre servei de correu; milloreu el pla si cal."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "Comproveu si les adreces de destinatari d'aquesta entrada tenen errors tipogràfics, espais o parts que falten."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
msgstr "Comproveu l'adreça del remitent a l'extensió SMTP i el filtre wp_mail_from."

msgid "Check the sending limits of your mail account and the notes of this email."
msgstr "Comproveu els límits d'enviament del vostre compte de correu i les notes d'aquest correu."

msgid "Check the server IP on a blocklist checker and request delisting."
msgstr "Comproveu la IP del servidor en un verificador de llistes de bloqueig i sol·liciteu-ne l'eliminació."

msgid "Check the spelling of the placeholder in the template and whether the plugin supports it for this email type. Shortcodes are not processed in emails unless the sending plugin runs do_shortcode()."
msgstr "Comproveu l'ortografia del marcador de posició a la plantilla i si l'extensió l'admet per a aquest tipus de correu. Els codis curts no es processen als correus tret que l'extensió que envia executi do_shortcode()."

msgid "Checked %s."
msgstr "Comprovat %s."

msgid "Checked just now"
msgstr "Comprovat fa un moment"

msgid "Checking DNS records …"
msgstr "S'estan comprovant els registres DNS…"

msgid "Checks the DNS records of the domains your site sends from: the default sender address and the most frequent senders in the log. Missing or weak records are the most common reason why emails land in spam. Only your server's own DNS resolver is used; results are kept for one hour."
msgstr "Comprova els registres DNS dels dominis des dels quals envia el vostre lloc web: l'adreça del remitent per defecte i els remitents més freqüents del registre. La manca de registres o els registres febles són el motiu més habitual pel qual els correus acaben al correu brossa. Només es fa servir el resolutor DNS del vostre servidor; els resultats es conserven una hora."

msgid "Choose a range of at most %s days."
msgstr "Trieu un interval de com a màxim %s dies."

msgid "Clear selection"
msgstr "Esborra la selecció"

msgid "Click a bar to open these emails in the log."
msgstr "Feu clic en una barra per obrir aquests correus al registre."

msgid "Close"
msgstr "Tanca"

msgid "Close (Esc)"
msgstr "Tanca (Esc)"

msgid "Colour scheme"
msgstr "Esquema de colors"

msgid "Command line"
msgstr "Línia d'ordres"

msgid "Compare"
msgstr "Compara"

msgid "Compare the sources of these entries. Check whether two plugins send the same notification, or whether a hook (e.g. order status change) fires more than once."
msgstr "Compareu les fonts d'aquestes entrades. Comproveu si dues extensions envien la mateixa notificació o si un ganxo (p. ex. el canvi d'estat d'una comanda) s'executa més d'una vegada."

msgid "Component"
msgstr "Component"

msgid "Configure alerts"
msgstr "Configura les alertes"

msgid "Content anonymised after %1$s days, %2$s"
msgstr "Contingut anonimitzat després de %1$s dies, %2$s"

msgid "Content change marked as seen."
msgstr "Canvi de contingut marcat com a vist."

msgid "Content changed"
msgstr "Contingut canviat"

msgid "Content changed on %1$s, after the %2$s update."
msgstr "El contingut va canviar el %1$s, després de l'actualització de %2$s."

msgid "Content changed on %s."
msgstr "El contingut va canviar el %s."

msgid "Content removed"
msgstr "Contingut eliminat"

msgid "Content removed after %s days"
msgstr "Contingut eliminat després de %s dies"

msgid "Content, headers and attachments were removed and the addresses masked by the anonymisation setting."
msgstr "El paràmetre d'anonimització ha eliminat el contingut, les capçaleres i els adjunts i ha emmascarat les adreces."

msgid "Copied"
msgstr "Copiat"

msgid "Copied – paste it into your reply."
msgstr "S'ha copiat. Enganxeu-ho a la vostra resposta."

msgid "Copies a short sentence for answering the customer: when the email was sent to whom and whether it arrived – without technical details."
msgstr "Copia una frase breu per respondre al client: quan es va enviar el correu, a qui i si va arribar, sense detalls tècnics."

msgid "Copies the existing log of another mail logging plugin into Mailspur, so old emails can be searched and previewed here. The other plugin and its data stay untouched; running the import again only adds new entries."
msgstr "Copia el registre existent d'una altra extensió de registre de correu a Mailspur, perquè els correus antics es puguin cercar i previsualitzar aquí. L'altra extensió i les seves dades no es modifiquen; si torneu a executar la importació, només s'afegeixen entrades noves."

msgid "Copy"
msgstr "Copia"

msgid "Copy for support"
msgstr "Copia per al suport"

msgid "Copying is not possible in this browser. Select the text and copy it:"
msgstr "No es pot copiar en aquest navegador. Seleccioneu el text i copieu-lo:"

msgid "Correct the address (e.g. in the user profile or order) and consider an email validation in your forms."
msgstr "Corregiu l'adreça (p. ex. al perfil d'usuari o a la comanda) i plantegeu-vos validar els correus als formularis."

msgid "Counted once per email."
msgstr "Es compta una vegada per correu."

msgid "Create a new API key with send permission at your mail service and enter it in the mailer plugin."
msgstr "Creeu una clau d'API nova amb permís d'enviament al vostre servei de correu i introduïu-la a l'extensió de correu."

msgid "Create a new webhook URL? The current URL stops working at once – paste the new URL into the webhook settings of your email provider."
msgstr "Voleu crear un URL de webhook nou? L'URL actual deixarà de funcionar immediatament: enganxeu l'URL nou als paràmetres de webhook del vostre proveïdor de correu."

msgid "Create new URL"
msgstr "Crea un URL nou"

msgid "Current page"
msgstr "Pàgina actual"

msgid "Current record"
msgstr "Registre actual"

msgid "Current size"
msgstr "Mida actual"

msgid "Custom"
msgstr "Personalitzat"

msgid "DKIM key found (selector: %s)."
msgstr "S'ha trobat una clau DKIM (selector: %s)."

msgid "DMARC record found with p=none: reports only, spoofed mail is still delivered."
msgstr "S'ha trobat un registre DMARC amb p=none: només informes; el correu falsificat encara es lliura."

msgid "DMARC record found with policy p=%s."
msgstr "S'ha trobat un registre DMARC amb la política p=%s."

msgid "DMARC record has no valid policy (p=none, quarantine or reject)."
