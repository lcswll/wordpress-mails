msgstr "%1$s رسالة في آخر 30 يومًا، فشلت منها %2$s"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "أُرسلت %1$s رسالة خلال ساعة واحدة – أكثر بكثير من المعتاد (الحد: %2$s في الساعة). ربما يُساء استخدام نموذج اتصال أو ربما تم اختراق الموقع."

msgid "%1$s entries, %2$s"
msgstr "%1$s إدخالات، %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "%1$s مستوردة، %2$s مكررة، %3$s قديمة جدًا"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "ارتدّت %1$s من %2$s (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "تعذّر إرسال %1$s من أصل %2$s رسالة في آخر %3$s يومًا."

msgid "%1$s of %2$s entries processed …"
msgstr "تمت معالجة %1$s من %2$s إدخالات …"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s نقطة مئوية مقابل %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "أرسل %1$s أول رسالة له في %2$s، وراسل %3$s عناوين خارجية مختلفة خلال آخر 24 ساعة. إن لم تثبّت أو تُعِدّ شيئًا يرسل مثل هذه الرسائل، فافحص الموقع: قد يكون المرسِل الجديد علامة على موقع مخترق."

msgid "%1$s sent, %2$s still held …"
msgstr "أُرسلت %1$s، ولا تزال %2$s محتجزة …"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s مقابل %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · %2$s رسالة مجمّعة منذ آخر ملخص"

msgid "%1$s · as of %2$s"
msgstr "%1$s · حتى %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – معدل الفشل %2$s %% (الأسبوع السابق: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – أبلغ عنها %2$s، %3$s"

