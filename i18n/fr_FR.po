msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: fr_FR\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "« Télécharger le .eml » reconstruit le message à partir des données enregistrées et masquées (sans pièces jointes)."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (semaine précédente : %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (prévu à %2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s type d’e-mail ne part plus : %2$s."
msgstr[1] "%1$s types d’e-mails ne partent plus, par exemple %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "%1$s types d’e-mails provenant de %2$s expéditeurs"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "%1$s e-mails ont échoué au cours des %2$s dernières minutes."

msgid "%1$s emails in %2$s days"
msgstr "%1$s e-mails en %2$s jours"

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "%1$s e-mails au cours des 30 derniers jours, %2$s en échec"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "%1$s e-mails ont été envoyés en une heure – bien plus que d’habitude (seuil : %2$s par heure). Un formulaire de contact est peut-être utilisé abusivement ou le site est peut-être compromis."

msgid "%1$s entries, %2$s"
msgstr "%1$s entrées, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "%1$s importées, %2$s doublons, %3$s trop anciennes"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "%1$s sur %2$s rejetés (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "%1$s e-mails sur %2$s n’ont pas pu être envoyés au cours des %3$s derniers jours."

msgid "%1$s of %2$s entries processed …"
msgstr "%1$s entrées sur %2$s traitées…"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s pts par rapport à %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "%1$s a envoyé son premier e-mail le %2$s et a écrit à %3$s adresses externes différentes au cours des dernières 24 heures. Si vous n’avez rien installé ni configuré qui envoie ce type d’e-mails, vérifiez le site : un nouvel expéditeur peut être le signe d’un site piraté."

msgid "%1$s sent, %2$s still held …"
msgstr "%1$s envoyés, %2$s encore retenus…"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s par rapport à %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · %2$s e-mails regroupés depuis le dernier récapitulatif"

msgid "%1$s · as of %2$s"
msgstr "%1$s · au %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – taux d’échec %2$s %% (semaine précédente : %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – signalé par %2$s, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (extension indispensable)"

msgid "%s (theme)"
msgstr "%s (thème)"

msgid "%s ago"
msgstr "il y a %s"

msgid "%s days"
msgstr "%s jours"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "%s e-mail a échoué au cours des 7 derniers jours."
msgstr[1] "%s e-mails ont échoué au cours des 7 derniers jours."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s e-mail attend votre décision."
msgstr[1] "%s e-mails attendent votre décision."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "%s e-mail a été retenu et non envoyé au cours des 7 derniers jours."
msgstr[1] "%s e-mails ont été retenus et non envoyés au cours des 7 derniers jours."

msgid "%s emails are held by the emergency brake."
msgstr "%s e-mails sont retenus par le frein d’urgence."

msgid "%s emails are waiting and have not been delivered."
msgstr "%s e-mails sont en attente et n’ont pas été distribués."

msgid "%s entries"
msgstr "%s entrées"

msgid "%s failed"
msgstr "%s en échec"

msgid "%s held emails discarded."
msgstr "%s e-mails retenus abandonnés."

msgid "%s imported entries removed."
msgstr "%s entrées importées supprimées."

msgid "%s in 30 days"
msgstr "%s en 30 jours"

msgid "%s marked as spam"
msgstr "%s signalés comme spam"

msgid "%s more on the Email types page."
msgstr "%s de plus sur la page Types d’e-mails."

msgid "%s notes"
msgstr "%s notes"

msgid "%s of all emails"
msgstr "%s de tous les e-mails"

msgid "%s of them in the last 24 hours."
msgstr "Dont %s au cours des dernières 24 heures."

msgid "%s s"
msgstr "%s s"

msgid "%s selected"
msgstr "%s sélectionnées"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s point nécessite votre attention :"
msgstr[1] "%s points nécessitent votre attention :"

msgid "%s to administrators in 30 days"
msgstr "%s aux administrateurs en 30 jours"

msgid "%s unchanged lines"
msgstr "%s lignes inchangées"

msgid "(no subject)"
msgstr "(aucun objet)"

msgid "(no text content)"
msgstr "(aucun contenu texte)"

msgid "(the emails are no longer in the log)"
msgstr "(les e-mails ne sont plus dans le journal)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "-all est plus strict ; ~all est courant et convient en combinaison avec DMARC."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "0 conserve les entrées indéfiniment. Le nettoyage s’exécute une fois par jour."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "0 signifie aucune limite. Les entrées les plus anciennes sont supprimées en premier."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "0 la désactive. Supprime le contenu, les en-têtes et les pièces jointes des entrées plus anciennes et masque les adresses (a***@example.com). La date, l’état, la source, le format, la taille et les notes sont conservés pour les statistiques. S’exécute avec le nettoyage quotidien, avant la suppression des entrées – elle n’a donc d’effet que si sa durée est plus courte que la durée de suppression ci-dessus."

msgid "12 months"
msgstr "12 mois"

msgid "30 days"
msgstr "30 jours"

msgid "7 days"
msgstr "7 jours"

msgid "90 days"
msgstr "90 jours"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "Un sélecteur DKIM ne peut contenir que des lettres, des chiffres, des points, des tirets et des tirets bas."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "Une extension d’envoi qui passe par une API a pris en charge l’envoi et a signalé un échec, sans en indiquer la raison."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "Une clé publiée ne prouve pas que vos e-mails sont signés avec elle – vérifiez le résultat DKIM dans les en-têtes d’un e-mail reçu."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "Un destinataire ou l’adresse d’expédition n’est pas une adresse e-mail valide, PHPMailer a donc refusé l’envoi."

msgid "API key or private key in plain text: %1$s"
msgstr "Clé d’API ou clé privée en clair : %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "Environ %1$s requêtes DNS sont nécessaires pour évaluer cet enregistrement – plus que les %2$s autorisées, les destinataires risquent donc de l’ignorer (PermError). Supprimez les entrées include: inutilisées."

msgid "Access"
msgstr "Accès"

msgid "Actions"
msgstr "Actions"

msgid "Active: alerts on %s."
msgstr "Actives : alertes en cas de %s."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "Ajoutez un attribut alt court à chaque image du modèle, par exemple alt=\"Logo Boutique Exemple\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "Ajoutez l’include: de votre fournisseur de messagerie (par exemple include:_spf.google.com) si vous envoyez par son intermédiaire."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "Ajoutez votre serveur de messagerie ou votre service d’envoi à l’enregistrement SPF du domaine d’expédition."

msgid "Added:"
msgstr "Ajouté :"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "Adresses ayant au moins %s échecs définitifs : le serveur destinataire a rejeté la boîte aux lettres, le domaine n’a pas de serveur de messagerie, ou votre fournisseur d’envoi d’e-mails a signalé un rebond définitif. Les entrées expirent selon la durée de conservation du journal."

msgid "Admin screen"
msgstr "Écran d’administration"

msgid "Administrators"
msgstr "Administrateurs"

msgid "Aggregate reports go to %s."
msgstr "Les rapports agrégés sont envoyés à %s."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "Alerte"

msgid "Alert and hold further emails"
msgstr "Alerter et retenir les e-mails suivants"

msgid "Alert only"
msgstr "Alerter uniquement"

msgid "Alert when an email type that is sent regularly stops"
msgstr "Alerter lorsqu’un type d’e-mail envoyé régulièrement ne part plus"

msgid "Alert when emails fail repeatedly"
msgstr "Alerter lorsque des e-mails échouent de manière répétée"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "Alerter lorsque le site cesse inopinément d’envoyer des e-mails"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "Les alertes sont activées mais n’ont aucun canal : saisissez une adresse e-mail ou une URL de webhook."

msgid "Alerts are off."
msgstr "Les alertes sont désactivées."

msgid "All"
msgstr "Tous"

msgid "All email types look healthy."
msgstr "Tous les types d’e-mails semblent en bonne santé."

msgid "All emails are redirected to test addresses."
msgstr "Tous les e-mails sont redirigés vers des adresses de test."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "Tous les e-mails sont envoyés à des adresses de test au lieu des vrais destinataires."

msgid "All sources"
msgstr "Toutes les sources"

msgid "Allow again"
msgstr "Autoriser à nouveau"

msgid "Allowed again."
msgstr "Autorisé à nouveau."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "Alerte aussi une fois lorsqu’une extension ou un thème qui n’avait jamais envoyé d’e-mail écrit à de nombreuses adresses externes différentes en une journée – un signe possible de site piraté. Les deux premières semaines après l’installation de Mailspur servent de référence."

msgid "Also remove the subject when anonymising"
msgstr "Supprimer aussi l’objet lors de l’anonymisation"

msgid "Also search content"
msgstr "Rechercher aussi dans le contenu"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "Vous pouvez aussi demander à votre hébergeur d’activer mail() / sendmail pour ce site."

msgid "Always load remote images and fonts in the preview"
msgstr "Toujours charger les images et polices distantes dans l’aperçu"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (via SNS)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "Un fournisseur d’envoi d’e-mails doté d’une API HTTP plutôt que SMTP nécessite moins d’allers-retours par e-mail."

msgid "Anonymisation"
msgstr "Anonymisation"

msgid "Anonymise entries after"
msgstr "Anonymiser les entrées après"

msgid "Anonymised"
msgstr "Anonymisé"

msgid "Any format"
msgstr "Tous les formats"

msgid "Any status"
msgstr "Tous les états"

msgid "Apply"
msgstr "Appliquer"

msgid "Ask the recipient for a working address."
msgstr "Demandez au destinataire une adresse qui fonctionne."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "Demandez à votre hébergeur d’activer l’extension openssl (ou activez-la dans les réglages PHP de votre panneau d’hébergement)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "Demandez à votre hébergeur de mettre à jour les certificats CA et OpenSSL du serveur."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "Demandez à votre hébergeur si les connexions SMTP sortantes sont bloquées."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "Demandez à votre hébergeur si les connexions sortantes vers ce port sont autorisées (pare-feu)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "Au moins %1$s e-mails en échec en %2$s minutes"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "Au maximum une alerte par type pendant cette durée, même si le problème persiste."

msgid "Attachments"
msgstr "Pièces jointes"

msgid "Attachments no longer available: %s"
msgstr "Pièces jointes qui ne sont plus disponibles : %s"

msgid "Authentication"
msgstr "Authentification"

msgid "Automatic TLS"
msgstr "TLS automatique"

msgid "Average per day"
msgstr "Moyenne par jour"

msgid "Back to the email types"
msgstr "Retour aux types d’e-mails"

msgid "Belongs to"
msgstr "Appartient à"

msgid "Block again"
msgstr "Bloquer à nouveau"

msgid "Blocked as spam or by a blocklist"
msgstr "Bloqué comme spam ou par une liste de blocage"

msgid "Bounced (permanent)"
msgstr "Rejeté (définitif)"

msgid "Bounced (temporary)"
msgstr "Rejeté (temporaire)"

msgid "Broken characters (encoding): %1$s"
msgstr "Caractères corrompus (encodage) : %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "E-mail en masse sans en-tête de désabonnement (%1$s destinataires)"

msgid "Bundle into one daily email"
msgstr "Regrouper en un seul e-mail quotidien"

msgid "Bundled into one daily email"
msgstr "Regroupé en un seul e-mail quotidien"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "Le regroupement est désactivé. Les e-mails en attente viennent d’être envoyés dans un récapitulatif."

msgid "Busiest day"
msgstr "Jour le plus chargé"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "Annuler"

msgid "Careful: emails to this address failed several times before."
msgstr "Attention : des e-mails envoyés à cette adresse ont déjà échoué plusieurs fois."

msgid "Change in the email types"
msgstr "Changement dans les types d’e-mails"

msgid "Change staging mode"
msgstr "Modifier le mode préproduction"

msgid "Check"
msgstr "Vérifier"

msgid "Check again"
msgstr "Vérifier à nouveau"

msgid "Check emails"
msgstr "Vérifier les e-mails"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "Vérifiez l’hôte et le port ; essayez 587 (TLS) au lieu de 465 (SSL), ou inversement."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "Vérifiez l’hôte, le port, le chiffrement, l’identifiant et le mot de passe dans votre extension SMTP et envoyez un e-mail de test depuis celle-ci."

msgid "Check sender domains"
msgstr "Vérifier les domaines d’expédition"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "Vérifiez que le chiffrement correspond au port : TLS pour 587, SSL pour 465."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "Vérifiez que la clé appartient à la bonne région / au bon compte (par exemple point de terminaison UE ou US)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "Vérifiez l’hôte et le port SMTP : un mauvais port ou une connexion bloquée se termine souvent par un délai dépassé avant qu’une solution de repli ne fonctionne."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "Vérifiez les enregistrements SPF, DKIM et DMARC du domaine d’expédition, ou utilisez une adresse d’expédition sur le domaine depuis lequel vous envoyez."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "Vérifiez que l’adresse ne contient pas de faute de frappe – ou bien l’e-mail n’a jamais été envoyé par votre site."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "Vérifiez l’adresse auprès du destinataire et corrigez-la là où elle est stockée (profil utilisateur, commande, saisie de formulaire)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "Vérifiez l’adresse auprès du destinataire et corrigez-la là où elle est stockée."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "Vérifiez le nom d’hôte et le port : 587 avec STARTTLS (TLS) ou 465 avec SSL. Le port 25 est bloqué par la plupart des hébergeurs."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "Vérifiez les limites et la consommation actuelle dans votre compte de service d’envoi ; changez de formule si nécessaire."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "Vérifiez que les adresses des destinataires de cette entrée ne contiennent pas de fautes de frappe, d’espaces ou de parties manquantes."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
msgstr "Vérifiez l’adresse d’expédition dans votre extension SMTP et le filtre wp_mail_from."

msgid "Check the sending limits of your mail account and the notes of this email."
msgstr "Vérifiez les limites d’envoi de votre compte de messagerie et les notes de cet e-mail."

msgid "Check the server IP on a blocklist checker and request delisting."
msgstr "Vérifiez l’IP du serveur avec un outil de contrôle des listes de blocage et demandez son retrait."

msgid "Check the spelling of the placeholder in the template and whether the plugin supports it for this email type. Shortcodes are not processed in emails unless the sending plugin runs do_shortcode()."
msgstr "Vérifiez l’orthographe de la variable dans le modèle et si l’extension la prend en charge pour ce type d’e-mail. Les codes courts ne sont pas traités dans les e-mails, sauf si l’extension d’envoi exécute do_shortcode()."

msgid "Checked %s."
msgstr "Vérifié %s."

msgid "Checked just now"
msgstr "Vérifié à l’instant"

msgid "Checking DNS records …"
msgstr "Vérification des enregistrements DNS…"

msgid "Checks the DNS records of the domains your site sends from: the default sender address and the most frequent senders in the log. Missing or weak records are the most common reason why emails land in spam. Only your server's own DNS resolver is used; results are kept for one hour."
msgstr "Vérifie les enregistrements DNS des domaines depuis lesquels votre site envoie : l’adresse d’expédition par défaut et les expéditeurs les plus fréquents du journal. Des enregistrements manquants ou faibles sont la raison la plus courante pour laquelle des e-mails arrivent dans les indésirables. Seul le résolveur DNS de votre serveur est utilisé ; les résultats sont conservés pendant une heure."

msgid "Choose a range of at most %s days."
msgstr "Choisissez une période de %s jours au maximum."

msgid "Clear selection"
msgstr "Effacer la sélection"

msgid "Click a bar to open these emails in the log."
msgstr "Cliquez sur une barre pour ouvrir ces e-mails dans le journal."

msgid "Close"
msgstr "Fermer"

msgid "Close (Esc)"
msgstr "Fermer (Échap)"

msgid "Colour scheme"
msgstr "Jeu de couleurs"

msgid "Command line"
msgstr "Ligne de commande"

msgid "Compare"
msgstr "Comparer"

msgid "Compare the sources of these entries. Check whether two plugins send the same notification, or whether a hook (e.g. order status change) fires more than once."
msgstr "Comparez les sources de ces entrées. Vérifiez si deux extensions envoient la même notification, ou si un crochet (par exemple le changement d’état d’une commande) se déclenche plusieurs fois."

msgid "Component"
msgstr "Composant"

msgid "Configure alerts"
msgstr "Configurer les alertes"

msgid "Content anonymised after %1$s days, %2$s"
msgstr "Contenu anonymisé après %1$s jours, %2$s"

msgid "Content change marked as seen."
msgstr "Changement de contenu marqué comme vu."

msgid "Content changed"
msgstr "Contenu modifié"

msgid "Content changed on %1$s, after the %2$s update."
msgstr "Contenu modifié le %1$s, après la mise à jour de %2$s."

msgid "Content changed on %s."
msgstr "Contenu modifié le %s."

msgid "Content removed"
msgstr "Contenu supprimé"

msgid "Content removed after %s days"
msgstr "Contenu supprimé après %s jours"

msgid "Content, headers and attachments were removed and the addresses masked by the anonymisation setting."
msgstr "Le contenu, les en-têtes et les pièces jointes ont été supprimés et les adresses masquées par le réglage d’anonymisation."

msgid "Copied"
msgstr "Copié"

msgid "Copied – paste it into your reply."
msgstr "Copié – collez-le dans votre réponse."

msgid "Copies a short sentence for answering the customer: when the email was sent to whom and whether it arrived – without technical details."
msgstr "Copie une courte phrase pour répondre au client : quand l’e-mail a été envoyé, à qui et s’il est arrivé – sans détails techniques."

msgid "Copies the existing log of another mail logging plugin into Mailspur, so old emails can be searched and previewed here. The other plugin and its data stay untouched; running the import again only adds new entries."
msgstr "Copie le journal existant d’une autre extension de journalisation des e-mails dans Mailspur, afin de pouvoir rechercher et prévisualiser ici les anciens e-mails. L’autre extension et ses données restent intactes ; relancer l’importation n’ajoute que les nouvelles entrées."

msgid "Copy"
msgstr "Copier"

msgid "Copy for support"
msgstr "Copier pour le support"

msgid "Copying is not possible in this browser. Select the text and copy it:"
msgstr "La copie n’est pas possible dans ce navigateur. Sélectionnez le texte et copiez-le :"

msgid "Correct the address (e.g. in the user profile or order) and consider an email validation in your forms."
msgstr "Corrigez l’adresse (par exemple dans le profil utilisateur ou la commande) et envisagez une validation des adresses e-mail dans vos formulaires."

msgid "Counted once per email."
msgstr "Compté une fois par e-mail."

msgid "Create a new API key with send permission at your mail service and enter it in the mailer plugin."
msgstr "Créez une nouvelle clé d’API avec l’autorisation d’envoi dans votre service d’envoi et saisissez-la dans l’extension d’envoi."

msgid "Create a new webhook URL? The current URL stops working at once – paste the new URL into the webhook settings of your email provider."
msgstr "Créer une nouvelle URL de webhook ? L’URL actuelle cesse immédiatement de fonctionner – collez la nouvelle URL dans les réglages de webhook de votre fournisseur d’envoi d’e-mails."

msgid "Create new URL"
msgstr "Créer une nouvelle URL"

msgid "Current page"
msgstr "Page actuelle"

msgid "Current record"
msgstr "Enregistrement actuel"

msgid "Current size"
msgstr "Taille actuelle"

msgid "Custom"
msgstr "Personnalisée"

msgid "DKIM key found (selector: %s)."
msgstr "Clé DKIM trouvée (sélecteur : %s)."

msgid "DMARC record found with p=none: reports only, spoofed mail is still delivered."
msgstr "Enregistrement DMARC trouvé avec p=none : rapports uniquement, les e-mails usurpés sont toujours distribués."

msgid "DMARC record found with policy p=%s."
msgstr "Enregistrement DMARC trouvé avec la politique p=%s."

msgid "DMARC record has no valid policy (p=none, quarantine or reject)."
msgstr "L’enregistrement DMARC n’a pas de politique valide (p=none, quarantine ou reject)."

msgid "DNS lookup failed or timed out. Try again later."
msgstr "La requête DNS a échoué ou a expiré. Réessayez plus tard."

