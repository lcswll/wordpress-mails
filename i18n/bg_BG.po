msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: bg_BG\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "„Изтегляне на .eml“ пресъздава съобщението от записаните, редактирани данни (без прикачени файлове)."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (предходна седмица: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (планиран за %2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s тип имейл вече не се изпраща: %2$s."
msgstr[1] "%1$s типа имейли вече не се изпращат, напр. %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "Типове имейли: %1$s, податели: %2$s"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "%1$s имейла бяха неуспешни през последните %2$s минути."

msgid "%1$s emails in %2$s days"
msgstr "%1$s имейла за %2$s дни"

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "Имейли през последните 30 дни: %1$s, неуспешни: %2$s"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "За един час бяха изпратени %1$s имейла – много повече от обикновено (праг: %2$s на час). Възможно е формуляр за контакт да се злоупотребява или сайтът да е компрометиран."

msgid "%1$s entries, %2$s"
msgstr "Записи: %1$s, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "импортирани: %1$s, дубликати: %2$s, твърде стари: %3$s"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "%1$s от %2$s върнати (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "%1$s от %2$s имейла през последните %3$s дни не можаха да бъдат изпратени."

msgid "%1$s of %2$s entries processed …"
msgstr "Обработени %1$s от %2$s записа …"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s п.п. спрямо %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "%1$s изпрати първия си имейл на %2$s и през последните 24 часа е писал до различни външни адреси (брой: %3$s). Ако не сте инсталирали или настроили нищо, което изпраща такива имейли, проверете сайта: нов подател може да е признак за хакнат сайт."

msgid "%1$s sent, %2$s still held …"
msgstr "Изпратени: %1$s, все още задържани: %2$s …"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s спрямо %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · обединени имейли от последния обобщен имейл: %2$s"

msgid "%1$s · as of %2$s"
msgstr "%1$s · към %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – процент неуспешни %2$s %% (предходна седмица: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – съобщено от %2$s, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (задължително разширение)"

msgid "%s (theme)"
msgstr "%s (тема)"

msgid "%s ago"
msgstr "преди %s"

msgid "%s days"
msgstr "%s дни"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "%s имейл е неуспешен през последните 7 дни."
msgstr[1] "%s имейла са неуспешни през последните 7 дни."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s имейл чака вашето решение."
msgstr[1] "%s имейла чакат вашето решение."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "%s имейл беше задържан и не е изпратен през последните 7 дни."
msgstr[1] "%s имейла бяха задържани и не са изпратени през последните 7 дни."

msgid "%s emails are held by the emergency brake."
msgstr "Аварийната спирачка задържа %s имейла."

msgid "%s emails are waiting and have not been delivered."
msgstr "%s имейла чакат и не са доставени."

msgid "%s entries"
msgstr "Записи: %s"

msgid "%s failed"
msgstr "Неуспешни: %s"

msgid "%s held emails discarded."
msgstr "Отхвърлени задържани имейли: %s."

msgid "%s imported entries removed."
msgstr "Премахнати импортирани записи: %s."

msgid "%s in 30 days"
msgstr "%s за 30 дни"

msgid "%s marked as spam"
msgstr "Маркирани като спам: %s"

msgid "%s more on the Email types page."
msgstr "Още %s на страницата „Типове имейли“."

msgid "%s notes"
msgstr "%s бележки"

msgid "%s of all emails"
msgstr "%s от всички имейли"

msgid "%s of them in the last 24 hours."
msgstr "%s от тях през последните 24 часа."

msgid "%s s"
msgstr "%s сек."

msgid "%s selected"
msgstr "Избрани: %s"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s нещо изисква внимание:"
msgstr[1] "%s неща изискват внимание:"

msgid "%s to administrators in 30 days"
msgstr "До администратори за 30 дни: %s"

msgid "%s unchanged lines"
msgstr "Непроменени редове: %s"

msgid "(no subject)"
msgstr "(без тема)"

msgid "(no text content)"
msgstr "(няма текстово съдържание)"

msgid "(the emails are no longer in the log)"
msgstr "(имейлите вече не са в дневника)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "-all е по-строг; ~all е често срещан и е добре заедно с DMARC."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "0 запазва записите завинаги. Почистването се изпълнява веднъж дневно."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "0 означава без ограничение. Най-старите записи се премахват първи."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "0 го изключва. Премахва съдържанието, заглавките и прикачените файлове на по-старите записи и маскира адресите (a***@example.com). Датата, състоянието, източникът, форматът, размерът и бележките остават за статистиката. Изпълнява се с ежедневното почистване, преди записите да бъдат изтрити – затова има ефект само ако е по-кратко от периода за изтриване по-горе."

msgid "12 months"
msgstr "12 месеца"

msgid "30 days"
msgstr "30 дни"

msgid "7 days"
msgstr "7 дни"

msgid "90 days"
msgstr "90 дни"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "DKIM селекторът може да съдържа само букви, цифри, точки, тирета и долни черти."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "Разширение за изпращане на поща чрез API пое доставката и съобщи, че изпращането е неуспешно, без да посочи причина."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "Публикуваният ключ не доказва, че имейлите ви се подписват с него – проверете резултата от DKIM в заглавките на получен имейл."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "Адресът на получател или на подателя не е валиден имейл адрес, затова PHPMailer отказа изпращането."

msgid "API key or private key in plain text: %1$s"
msgstr "API ключ или частен ключ в открит текст: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "За оценката на този запис са нужни около %1$s DNS заявки – повече от позволените %2$s, затова получателите може да го пренебрегнат (PermError). Премахнете неизползваните записи include:."

msgid "Access"
msgstr "Достъп"

msgid "Actions"
msgstr "Действия"

msgid "Active: alerts on %s."
msgstr "Активно: предупреждения при %s."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "Добавете кратък атрибут alt към всяко изображение в шаблона, напр. alt=\"Logo Example Shop\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "Добавете include: на вашия пощенски доставчик (напр. include:_spf.google.com), ако изпращате чрез такъв."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "Добавете вашия пощенски сървър или пощенска услуга в SPF записа на домейна на подателя."

msgid "Added:"
msgstr "Добавено:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "Адреси с поне %s трайни неуспеха: получаващият сървър е отхвърлил пощенската кутия, домейнът няма пощенски сървър или вашият имейл доставчик е съобщил за твърдо връщане. Записите изтичат със срока на съхранение на дневника."

msgid "Admin screen"
msgstr "Административен екран"

msgid "Administrators"
msgstr "Администратори"

msgid "Aggregate reports go to %s."
msgstr "Обобщените отчети отиват до %s."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "Предупреждение"

msgid "Alert and hold further emails"
msgstr "Предупреждение и задържане на следващите имейли"

msgid "Alert only"
msgstr "Само предупреждение"

msgid "Alert when an email type that is sent regularly stops"
msgstr "Известяване, когато тип имейл, който се изпраща редовно, спре"

msgid "Alert when emails fail repeatedly"
msgstr "Предупреждение при многократно неуспешни имейли"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "Предупреждение, когато сайтът неочаквано спре да изпраща имейли"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "Предупрежденията са включени, но нямат канал: въведете имейл адрес или URL адрес на уебкук."

msgid "Alerts are off."
msgstr "Предупрежденията са изключени."

msgid "All"
msgstr "Всички"

msgid "All email types look healthy."
msgstr "Всички типове имейли изглеждат наред."

msgid "All emails are redirected to test addresses."
msgstr "Всички имейли се пренасочват към тестови адреси."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "Всички имейли отиват до тестови адреси вместо до истинските получатели."

msgid "All sources"
msgstr "Всички източници"

msgid "Allow again"
msgstr "Разрешаване отново"

msgid "Allowed again."
msgstr "Отново е разрешено."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "Също така известява еднократно, когато разширение или тема, които досега не са изпращали имейли, пишат до много различни външни адреси в рамките на един ден – възможен признак за хакнат сайт. Първите две седмици след инсталирането на Mailspur служат за база за сравнение."

msgid "Also remove the subject when anonymising"
msgstr "Премахване и на темата при анонимизиране"

msgid "Also search content"
msgstr "Търсене и в съдържанието"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "Като алтернатива помолете хостинг доставчика си да активира mail() / sendmail за този сайт."

msgid "Always load remote images and fonts in the preview"
msgstr "Винаги зареждане на външни изображения и шрифтове в прегледа"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (чрез SNS)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "Имейл доставчик с HTTP API вместо SMTP изисква по-малко обмени на данни за всеки имейл."

msgid "Anonymisation"
msgstr "Анонимизиране"

msgid "Anonymise entries after"
msgstr "Анонимизиране на записите след"

msgid "Anonymised"
msgstr "Анонимизиран"

msgid "Any format"
msgstr "Всеки формат"

msgid "Any status"
msgstr "Всяко състояние"

msgid "Apply"
msgstr "Прилагане"

msgid "Ask the recipient for a working address."
msgstr "Помолете получателя за работещ адрес."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "Помолете хостинг доставчика да активира PHP разширението openssl (или го активирайте в PHP настройките на хостинг панела)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "Помолете хостинг доставчика да обнови CA сертификатите и OpenSSL на сървъра."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "Попитайте хостинг доставчика дали изходящите SMTP връзки са блокирани."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "Попитайте хостинг доставчика дали изходящите връзки към този порт са разрешени (защитна стена)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "Поне %1$s неуспешни имейла в рамките на %2$s минути"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "Най-много едно предупреждение от вид за това време, дори ако проблемът продължава."

msgid "Attachments"
msgstr "Прикачени файлове"

msgid "Attachments no longer available: %s"
msgstr "Прикачените файлове вече не са налични: %s"

msgid "Authentication"
msgstr "Удостоверяване"

msgid "Automatic TLS"
msgstr "Автоматичен TLS"

msgid "Average per day"
msgstr "Средно на ден"

msgid "Back to the email types"
msgstr "Обратно към типовете имейли"

msgid "Belongs to"
msgstr "Принадлежи към"

msgid "Block again"
msgstr "Блокиране отново"

msgid "Blocked as spam or by a blocklist"
msgstr "Блокиран като спам или от черен списък"

msgid "Bounced (permanent)"
msgstr "Върнат (трайно)"

msgid "Bounced (temporary)"
msgstr "Върнат (временно)"

msgid "Broken characters (encoding): %1$s"
msgstr "Повредени символи (кодировка): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "Масов имейл без заглавка за отписване (получатели: %1$s)"

msgid "Bundle into one daily email"
msgstr "Обединяване в един ежедневен имейл"

msgid "Bundled into one daily email"
msgstr "Обединени в един ежедневен имейл"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "Обединяването е изключено. Чакащите имейли бяха изпратени сега в един обобщен имейл."

msgid "Busiest day"
msgstr "Най-натоварен ден"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "Отказ"

msgid "Careful: emails to this address failed several times before."
msgstr "Внимание: имейлите до този адрес вече са били неуспешни няколко пъти."

msgid "Change in the email types"
msgstr "Промяна в типовете имейли"

msgid "Change staging mode"
msgstr "Промяна на тестовия режим"

msgid "Check"
msgstr "Проверка"

msgid "Check again"
msgstr "Нова проверка"

msgid "Check emails"
msgstr "Проверка на имейлите"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "Проверете хоста и порта; опитайте 587 (TLS) вместо 465 (SSL) или обратното."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "Проверете хоста, порта, шифроването, потребителското име и паролата във вашето SMTP разширение и изпратете тестов имейл оттам."

msgid "Check sender domains"
msgstr "Проверка на домейните на подателите"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "Проверете дали шифроването съответства на порта: TLS за 587, SSL за 465."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "Проверете дали ключът принадлежи на правилния регион / акаунт (напр. крайна точка EU или US)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "Проверете SMTP хоста и порта: грешен порт или блокирана връзка често завършват с изтичане на времето, преди да сработи резервен вариант."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "Проверете SPF, DKIM и DMARC записите на домейна на подателя или използвайте адрес на подател в домейна, от който изпращате."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "Проверете адреса за грешки – или имейлът никога не е бил изпратен от сайта ви."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "Проверете адреса с получателя и го коригирайте там, където е записан (потребителски профил, поръчка, запис от формуляр)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "Проверете адреса с получателя и го коригирайте там, където е записан."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "Проверете името на хоста и порта: 587 със STARTTLS (TLS) или 465 със SSL. Порт 25 е блокиран от повечето хостинг доставчици."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "Проверете лимитите и текущото използване в акаунта на пощенската услуга; при нужда надградете плана."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "Проверете адресите на получателите в този запис за грешки, интервали или липсващи части."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
msgstr "Проверете адреса на подателя във вашето SMTP разширение и филтъра wp_mail_from."

msgid "Check the sending limits of your mail account and the notes of this email."
msgstr "Проверете лимитите за изпращане на пощенския си акаунт и бележките към този имейл."

msgid "Check the server IP on a blocklist checker and request delisting."
msgstr "Проверете IP адреса на сървъра в услуга за проверка на черни списъци и поискайте премахване."

msgid "Check the spelling of the placeholder in the template and whether the plugin supports it for this email type. Shortcodes are not processed in emails unless the sending plugin runs do_shortcode()."
msgstr "Проверете изписването на заместителя в шаблона и дали разширението го поддържа за този тип имейл. Кратките кодове не се обработват в имейли, освен ако изпращащото разширение не извиква do_shortcode()."

msgid "Checked %s."
msgstr "Проверено %s."

msgid "Checked just now"
msgstr "Проверено току-що"

msgid "Checking DNS records …"
msgstr "Проверка на DNS записите …"

msgid "Checks the DNS records of the domains your site sends from: the default sender address and the most frequent senders in the log. Missing or weak records are the most common reason why emails land in spam. Only your server's own DNS resolver is used; results are kept for one hour."
msgstr "Проверява DNS записите на домейните, от които изпраща сайтът ви: адреса на подателя по подразбиране и най-честите податели в дневника. Липсващите или слаби записи са най-честата причина имейлите да попадат в спам. Използва се само собственият DNS резолвер на сървъра ви; резултатите се пазят един час."

msgid "Choose a range of at most %s days."
msgstr "Изберете период от най-много %s дни."

msgid "Clear selection"
msgstr "Изчистване на избора"

msgid "Click a bar to open these emails in the log."
msgstr "Щракнете върху стълбче, за да отворите тези имейли в дневника."

msgid "Close"
msgstr "Затваряне"

msgid "Close (Esc)"
msgstr "Затваряне (Esc)"

msgid "Colour scheme"
msgstr "Цветова схема"

msgid "Command line"
msgstr "Команден ред"

msgid "Compare"
msgstr "Сравняване"

msgid "Compare the sources of these entries. Check whether two plugins send the same notification, or whether a hook (e.g. order status change) fires more than once."
