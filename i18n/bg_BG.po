msgstr "Аварийна спирачка: %1$s имейла през последния час – много повече от обикновено (праг: %2$s на час)."

msgid "Emergency brake: unusual email flood"
msgstr "Аварийна спирачка: необичаен поток от имейли"

msgid "Empty = automatic: three times the busiest hour of the last 14 days, at least 50 – currently %s."
msgstr "Празно = автоматично: три пъти най-натоварения час от последните 14 дни, най-малко 50 – в момента %s."

msgid "Empty log"
msgstr "Изпразване на дневника"

msgid "Empty subject"
msgstr "Празна тема"

msgid "Enable 2-step verification for the Google account and create an app password (Google account → Security → App passwords)."
msgstr "Активирайте потвърждаването в две стъпки за профила в Google и създайте парола за приложение (Google account → Security → App passwords)."

msgid "Enable DKIM signing at your mail provider or host and publish the key it gives you. If you already sign, enter your selector (the s= value of the DKIM-Signature header) and check again."
msgstr "Включете DKIM подписване при вашия пощенски доставчик или хостинг и публикувайте ключа, който ви дава. Ако вече подписвате, въведете селектора си (стойността s= на заглавката DKIM-Signature) и проверете отново."

msgid "Enable DKIM signing at your mail service and publish its DNS record."
msgstr "Активирайте DKIM подписването в пощенската услуга и публикувайте нейния DNS запис."

msgid "Enable authentication in your SMTP plugin and enter user name and password."
msgstr "Активирайте удостоверяването във вашето SMTP разширение и въведете потребителско име и парола."

msgid "Enable authentication in your SMTP plugin."
msgstr "Активирайте удостоверяването във вашето SMTP разширение."

msgid "Encrypted SMTP connections (TLS/SSL) need the PHP extension openssl, which is not installed or not enabled on this server."
msgstr "Шифрованите SMTP връзки (TLS/SSL) изискват PHP разширението openssl, което не е инсталирано или не е активирано на този сървър."

msgid "Encryption"
msgstr "Криптиране"

msgid "Encryption (TLS/SSL) failed"
msgstr "Неуспешно шифроване (TLS/SSL)"

msgid "Enter an email address or a webhook URL and save the settings first."
msgstr "Първо въведете имейл адрес или URL адрес на уебкук и запазете настройките."

msgid "Enter an email address or an order number."
msgstr "Въведете имейл адрес или номер на поръчка."

