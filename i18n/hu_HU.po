msgstr "WooCommerce › Beállítások › E-mailek"

msgid "WordPress"
msgstr "WordPress"

msgid "WordPress core emails have no editor; they can be changed with filters."
msgstr "A WordPress alapvető e-mailjeinek nincs szerkesztője; szűrőkkel módosíthatók."

