msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: hu_HU\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "Az „.eml letöltése” a naplózott, maszkolt adatokból építi újra az üzenetet (mellékletek nélkül)."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (előző hét: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (ütemezve: %2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s e-mail-típus kiküldése leállt: %2$s."
msgstr[1] "%1$s e-mail-típus kiküldése leállt, pl. %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "%1$s e-mail-típus %2$s feladótól"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "Az elmúlt %2$s percben %1$s e-mail küldése volt sikertelen."

msgid "%1$s emails in %2$s days"
msgstr "%1$s e-mail %2$s nap alatt"

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "%1$s e-mail az elmúlt 30 napban, ebből %2$s sikertelen"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "Egy órán belül %1$s e-mail ment ki – sokkal több a szokásosnál (küszöb: %2$s óránként). Lehet, hogy visszaélnek egy kapcsolatfelvételi űrlappal, vagy a honlapot feltörték."

msgid "%1$s entries, %2$s"
msgstr "%1$s bejegyzés, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "%1$s importálva, %2$s ismétlődés, %3$s túl régi"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "%2$s e-mailből %1$s visszapattant (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "Az elmúlt %3$s napban %2$s e-mailből %1$s nem lett elküldve."

msgid "%1$s of %2$s entries processed …"
msgstr "%1$s / %2$s bejegyzés feldolgozva …"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s százalékpont vs. %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "A(z) %1$s %2$s napon küldte első e-mailjét, és az elmúlt 24 órában %3$s különböző külső címre írt. Ha nem telepítettél vagy állítottál be semmit, ami ilyen e-maileket küld, ellenőrizd a honlapot: egy új feladó feltört honlapra utalhat."

msgid "%1$s sent, %2$s still held …"
msgstr "%1$s elküldve, még %2$s visszatartva …"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s vs. %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · %2$s e-mail összegyűjtve az utolsó összesítő óta"

msgid "%1$s · as of %2$s"
msgstr "%1$s · állapot: %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – hibaarány %2$s %% (előző hét: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – jelentette: %2$s, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (must-use bővítmény)"

msgid "%s (theme)"
msgstr "%s (sablon)"

msgid "%s ago"
msgstr "%s ezelőtt"

msgid "%s days"
msgstr "%s nap"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "%s e-mail küldése sikertelen volt az elmúlt 7 napban."
msgstr[1] "%s e-mail küldése sikertelen volt az elmúlt 7 napban."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s e-mail vár a döntésedre."
msgstr[1] "%s e-mail vár a döntésedre."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "%s e-mailt visszatartottunk és nem küldtünk el az elmúlt 7 napban."
msgstr[1] "%s e-mailt visszatartottunk és nem küldtünk el az elmúlt 7 napban."

msgid "%s emails are held by the emergency brake."
msgstr "%s e-mailt tart vissza a vészfék."

msgid "%s emails are waiting and have not been delivered."
msgstr "%s e-mail várakozik, és nincs kézbesítve."

msgid "%s entries"
msgstr "%s bejegyzés"

msgid "%s failed"
msgstr "%s sikertelen"

msgid "%s held emails discarded."
msgstr "%s visszatartott e-mail elvetve."

msgid "%s imported entries removed."
msgstr "%s importált bejegyzés eltávolítva."

msgid "%s in 30 days"
msgstr "%s 30 nap alatt"

msgid "%s marked as spam"
msgstr "%s spamnek jelölve"

msgid "%s more on the Email types page."
msgstr "Még %s az E-mail-típusok oldalon."

msgid "%s notes"
msgstr "%s megjegyzés"

msgid "%s of all emails"
msgstr "az összes e-mail %s-a"

msgid "%s of them in the last 24 hours."
msgstr "Ebből %s az elmúlt 24 órában."

msgid "%s s"
msgstr "%s mp"

msgid "%s selected"
msgstr "%s kiválasztva"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s dolog figyelmet igényel:"
msgstr[1] "%s dolog figyelmet igényel:"

msgid "%s to administrators in 30 days"
msgstr "%s adminisztrátoroknak 30 nap alatt"

msgid "%s unchanged lines"
msgstr "%s változatlan sor"

msgid "(no subject)"
msgstr "(nincs tárgy)"

msgid "(no text content)"
msgstr "(nincs szöveges tartalom)"

msgid "(the emails are no longer in the log)"
msgstr "(az e-mailek már nincsenek a naplóban)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "A -all szigorúbb; a ~all elterjedt, és DMARC-kal együtt rendben van."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "0 esetén a bejegyzések örökre megmaradnak. A takarítás naponta egyszer fut."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "0 esetén nincs korlát. A legrégebbi bejegyzések törlődnek először."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "0 esetén kikapcsolva. Eltávolítja a régebbi bejegyzések tartalmát, fejléceit és mellékleteit, és maszkolja a címeket (a***@example.com). A dátum, az állapot, a forrás, a formátum, a méret és a megjegyzések a statisztikák miatt megmaradnak. A napi takarítással fut, a bejegyzések törlése előtt – így csak akkor van hatása, ha rövidebb a fenti törlési időnél."

msgid "12 months"
msgstr "12 hónap"

msgid "30 days"
msgstr "30 nap"

msgid "7 days"
msgstr "7 nap"

msgid "90 days"
msgstr "90 nap"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "A DKIM-szelektor csak betűket, számjegyeket, pontokat, kötőjeleket és aláhúzásjeleket tartalmazhat."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "Egy API-n keresztül küldő levelező bővítmény vette át a kézbesítést, és sikertelen küldést jelzett, ok megadása nélkül."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "Egy közzétett kulcs nem bizonyítja, hogy az e-mailjeid alá vannak vele írva – ellenőrizd a DKIM eredményét egy fogadott levél fejléceiben."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "Egy címzett vagy a feladó címe nem érvényes e-mail-cím, ezért a PHPMailer megtagadta a küldést."

msgid "API key or private key in plain text: %1$s"
msgstr "API-kulcs vagy privát kulcs nyílt szövegként: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "A rekord kiértékeléséhez kb. %1$s DNS-lekérdezés kell – több a megengedett %2$s-nál, így a fogadók figyelmen kívül hagyhatják (PermError). Távolítsd el a nem használt include: bejegyzéseket."

msgid "Access"
msgstr "Hozzáférés"

msgid "Actions"
msgstr "Műveletek"

msgid "Active: alerts on %s."
msgstr "Aktív: értesítés ezekről: %s."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "Adj rövid alt attribútumot a sablon minden képéhez, pl. alt=\"Példa Bolt logója\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "Ha levelezési szolgáltatón keresztül küldesz, add hozzá annak include: bejegyzését (pl. include:_spf.google.com)."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "Add hozzá a levelezőszerveredet vagy levelezési szolgáltatásodat a feladó domainjének SPF-rekordjához."

msgid "Added:"
msgstr "Hozzáadva:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "Legalább %s végleges hibával rendelkező címek: a fogadó szerver elutasította a postafiókot, a domainnek nincs levelezőszervere, vagy az e-mail-szolgáltatód kemény visszapattanást jelzett. A bejegyzések a napló megőrzési idejével járnak le."

msgid "Admin screen"
msgstr "Admin képernyő"

msgid "Administrators"
msgstr "Adminisztrátorok"

msgid "Aggregate reports go to %s."
msgstr "Az összesítő jelentések ide mennek: %s."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "Értesítés"

msgid "Alert and hold further emails"
msgstr "Értesítés és további e-mailek visszatartása"

msgid "Alert only"
msgstr "Csak értesítés"

msgid "Alert when an email type that is sent regularly stops"
msgstr "Értesítés, ha egy rendszeresen küldött e-mail-típus leáll"

msgid "Alert when emails fail repeatedly"
msgstr "Értesítés, ha az e-mailek ismételten sikertelenek"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "Értesítés, ha a honlap váratlanul leáll az e-mailek küldésével"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "Az értesítések be vannak kapcsolva, de nincs csatornájuk: adj meg egy e-mail-címet vagy egy webhook URL-t."

msgid "Alerts are off."
msgstr "Az értesítések ki vannak kapcsolva."

msgid "All"
msgstr "Összes"

msgid "All email types look healthy."
msgstr "Minden e-mail-típus rendben van."

msgid "All emails are redirected to test addresses."
msgstr "Minden e-mail tesztcímekre van átirányítva."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "Minden e-mail tesztcímekre megy a valódi címzettek helyett."

msgid "All sources"
msgstr "Összes forrás"

msgid "Allow again"
msgstr "Újra engedélyezés"

msgid "Allowed again."
msgstr "Újra engedélyezve."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "Egyszer akkor is értesít, ha egy bővítmény vagy sablon, amely korábban soha nem küldött e-mailt, egy napon belül sok különböző külső címre ír – ez feltört honlapra utalhat. A Mailspur telepítése utáni első két hét szolgál alapként."

msgid "Also remove the subject when anonymising"
msgstr "A tárgy eltávolítása is anonimizáláskor"

msgid "Also search content"
msgstr "Keresés a tartalomban is"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "Vagy kérd meg a tárhelyszolgáltatót, hogy engedélyezze a mail() / sendmail használatát ennél a honlapnál."

msgid "Always load remote images and fonts in the preview"
msgstr "Külső képek és betűtípusok mindig betöltése az előnézetben"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (SNS-en keresztül)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "Egy SMTP helyett HTTP API-t használó e-mail-szolgáltatónak e-mailenként kevesebb oda-vissza kommunikáció kell."

msgid "Anonymisation"
msgstr "Anonimizálás"

msgid "Anonymise entries after"
msgstr "Bejegyzések anonimizálása"

msgid "Anonymised"
msgstr "Anonimizálva"

msgid "Any format"
msgstr "Bármely formátum"

msgid "Any status"
msgstr "Bármely állapot"

msgid "Apply"
msgstr "Alkalmazás"

msgid "Ask the recipient for a working address."
msgstr "Kérj a címzettől egy működő címet."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "Kérd meg a tárhelyszolgáltatót, hogy engedélyezze az openssl kiterjesztést (vagy engedélyezd a tárhelypanel PHP-beállításaiban)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "Kérd meg a tárhelyszolgáltatót, hogy frissítse a szerver CA-tanúsítványait és az OpenSSL-t."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "Kérdezd meg a tárhelyszolgáltatót, hogy blokkolja-e a kimenő SMTP-kapcsolatokat."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "Kérdezd meg a tárhelyszolgáltatót, hogy engedélyezettek-e a kimenő kapcsolatok erre a portra (tűzfal)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "Legalább %1$s sikertelen e-mail %2$s percen belül"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "Ezen az időn belül típusonként legfeljebb egy értesítés, még ha a probléma fennáll is."

msgid "Attachments"
msgstr "Mellékletek"

msgid "Attachments no longer available: %s"
msgstr "Már nem elérhető mellékletek: %s"

msgid "Authentication"
msgstr "Hitelesítés"

msgid "Automatic TLS"
msgstr "Automatikus TLS"

msgid "Average per day"
msgstr "Napi átlag"

msgid "Back to the email types"
msgstr "Vissza az e-mail-típusokhoz"

msgid "Belongs to"
msgstr "Ehhez tartozik"

msgid "Block again"
msgstr "Újra blokkolás"

msgid "Blocked as spam or by a blocklist"
msgstr "Spamként vagy tiltólista miatt blokkolva"

msgid "Bounced (permanent)"
msgstr "Visszapattant (végleges)"

msgid "Bounced (temporary)"
msgstr "Visszapattant (átmeneti)"

msgid "Broken characters (encoding): %1$s"
msgstr "Hibás karakterek (kódolás): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "Tömeges e-mail leiratkozási fejléc nélkül (%1$s címzett)"

msgid "Bundle into one daily email"
msgstr "Összegyűjtés egy napi e-mailbe"

msgid "Bundled into one daily email"
msgstr "Egy napi e-mailbe gyűjtve"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "Az összegyűjtés ki van kapcsolva. A várakozó e-mailek most egy összesítőben kimentek."

msgid "Busiest day"
msgstr "Legforgalmasabb nap"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "Mégse"

msgid "Careful: emails to this address failed several times before."
msgstr "Figyelem: az erre a címre küldött e-mailek már többször sikertelenek voltak."

msgid "Change in the email types"
msgstr "Módosítás az e-mail-típusoknál"

msgid "Change staging mode"
msgstr "Teszt mód módosítása"

msgid "Check"
msgstr "Ellenőrzés"

msgid "Check again"
msgstr "Újraellenőrzés"

msgid "Check emails"
msgstr "E-mailek ellenőrzése"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "Ellenőrizd a hosztot és a portot; próbáld a 587-et (TLS) a 465 (SSL) helyett, vagy fordítva."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "Ellenőrizd a hosztot, a portot, a titkosítást, a felhasználónevet és a jelszót az SMTP-bővítményedben, és küldj onnan egy teszt e-mailt."

msgid "Check sender domains"
msgstr "Feladó domainek ellenőrzése"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "Ellenőrizd, hogy a titkosítás illik-e a porthoz: TLS a 587-hez, SSL a 465-höz."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "Ellenőrizd, hogy a kulcs a megfelelő régióhoz / fiókhoz tartozik-e (pl. EU vs. US végpont)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "Ellenőrizd az SMTP-hosztot és a portot: egy hibás port vagy blokkolt kapcsolat gyakran időtúllépéssel végződik, mielőtt egy tartalékmegoldás működésbe lépne."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "Ellenőrizd a feladó domainjének SPF-, DKIM- és DMARC-rekordjait, vagy használj olyan feladócímet, amely azon a domainen van, ahonnan küldesz."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "Ellenőrizd, nincs-e elírás a címben – vagy a honlapod el sem küldte az e-mailt."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "Egyeztesd a címet a címzettel, és javítsd ott, ahol tárolva van (felhasználói profil, rendelés, űrlapbejegyzés)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "Egyeztesd a címet a címzettel, és javítsd ott, ahol tárolva van."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "Ellenőrizd a hosztnevet és a portot: 587 STARTTLS-sel (TLS) vagy 465 SSL-lel. A 25-ös portot a legtöbb tárhelyszolgáltató blokkolja."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "Ellenőrizd a korlátokat és az aktuális használatot a levelezési szolgáltatásod fiókjában; szükség esetén válts nagyobb csomagra."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "Ellenőrizd ennek a bejegyzésnek a címzettjeit elírások, szóközök vagy hiányzó részek szempontjából."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
msgstr "Ellenőrizd a feladó címét az SMTP-bővítményedben és a wp_mail_from szűrőt."

msgid "Check the sending limits of your mail account and the notes of this email."
msgstr "Ellenőrizd a levelezőfiókod küldési korlátait és ennek az e-mailnek a megjegyzéseit."

msgid "Check the server IP on a blocklist checker and request delisting."
msgstr "Ellenőrizd a szerver IP-címét egy tiltólista-ellenőrzővel, és kérd a törlést a listáról."

msgid "Check the spelling of the placeholder in the template and whether the plugin supports it for this email type. Shortcodes are not processed in emails unless the sending plugin runs do_shortcode()."
msgstr "Ellenőrizd a helyőrző helyesírását a sablonban, és hogy a bővítmény támogatja-e ennél az e-mail-típusnál. A rövidkódokat az e-mailekben nem dolgozza fel a rendszer, hacsak a küldő bővítmény nem futtatja a do_shortcode() függvényt."

msgid "Checked %s."
msgstr "Ellenőrizve: %s."

msgid "Checked just now"
msgstr "Épp most ellenőrizve"

msgid "Checking DNS records …"
msgstr "DNS-rekordok ellenőrzése …"

msgid "Checks the DNS records of the domains your site sends from: the default sender address and the most frequent senders in the log. Missing or weak records are the most common reason why emails land in spam. Only your server's own DNS resolver is used; results are kept for one hour."
msgstr "Ellenőrzi azoknak a domaineknek a DNS-rekordjait, amelyekről a honlapod küld: az alapértelmezett feladócímet és a naplóban leggyakoribb feladókat. A hiányzó vagy gyenge rekordok a leggyakoribb okai annak, hogy az e-mailek a spam mappában landolnak. Csak a szervered saját DNS-feloldóját használjuk; az eredményeket egy óráig őrizzük meg."

msgid "Choose a range of at most %s days."
msgstr "Legfeljebb %s napos időszakot válassz."

msgid "Clear selection"
msgstr "Kijelölés törlése"

msgid "Click a bar to open these emails in the log."
msgstr "Kattints egy oszlopra, hogy megnyisd ezeket az e-maileket a naplóban."

msgid "Close"
msgstr "Bezárás"

msgid "Close (Esc)"
msgstr "Bezárás (Esc)"

msgid "Colour scheme"
msgstr "Színséma"

msgid "Command line"
msgstr "Parancssor"

msgid "Compare"
msgstr "Összehasonlítás"

msgid "Compare the sources of these entries. Check whether two plugins send the same notification, or whether a hook (e.g. order status change) fires more than once."
msgstr "Hasonlítsd össze ezeknek a bejegyzéseknek a forrását. Ellenőrizd, hogy nem küldi-e két bővítmény ugyanazt az értesítést, vagy nem fut-e le egy hook (pl. rendelési állapot változása) többször."

msgid "Component"
msgstr "Összetevő"

msgid "Configure alerts"
msgstr "Értesítések beállítása"

msgid "Content anonymised after %1$s days, %2$s"
msgstr "Tartalom anonimizálva %1$s nap után, %2$s"

msgid "Content change marked as seen."
msgstr "A tartalomváltozás megjelölve látottként."

msgid "Content changed"
msgstr "Tartalom megváltozott"

msgid "Content changed on %1$s, after the %2$s update."
msgstr "A tartalom megváltozott: %1$s, a(z) %2$s frissítése után."

