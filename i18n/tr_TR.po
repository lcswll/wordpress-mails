msgstr "Bu URL'yi gizli tutun: bu sitenin gizli bir anahtarını içerir. Webhook'u test etmeden önce ayarları kaydedin."

msgid "Kept: %s"
msgstr "Saklama: %s"

msgid "Key figures"
msgstr "Temel rakamlar"

msgid "Last 30 days"
msgstr "Son 30 gün"

msgid "Last email before the change"
msgstr "Değişiklikten önceki son e-posta"

msgid "Last failure"
msgstr "Son hata"

msgid "Last page"
msgstr "Son sayfa"

