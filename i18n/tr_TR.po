msgstr "Yok sayılan notlar"

msgid "Ignored notes are no longer recorded for new emails and are hidden for existing entries."
msgstr "Yok sayılan notlar yeni e-postalar için artık kaydedilmez ve mevcut kayıtlarda gizlenir."

msgid "Images without alt text (%1$s)"
msgstr "Alternatif metni olmayan görseller (%1$s)"

msgid "Import"
msgstr "İçe aktar"

