msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: tr_TR\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "\".eml indir\", iletiyi kaydedilmiş ve gizlenmiş verilerden yeniden oluşturur (ekler olmadan)."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (önceki hafta: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (%2$s için zamanlandı)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s e-posta türünün gönderimi durdu: %2$s."
msgstr[1] "%1$s e-posta türünün gönderimi durdu, örneğin %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "%2$s gönderenden %1$s e-posta türü"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "Son %2$s dakika içinde %1$s e-posta başarısız oldu."

msgid "%1$s emails in %2$s days"
msgstr "%2$s günde %1$s e-posta"

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "Son 30 günde %1$s e-posta, %2$s başarısız"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "Bir saat içinde %1$s e-posta gönderildi – normalden çok daha fazla (eşik: saatte %2$s). Bir iletişim formu kötüye kullanılıyor veya site ele geçirilmiş olabilir."

msgid "%1$s entries, %2$s"
msgstr "%1$s kayıt, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "%1$s içe aktarıldı, %2$s yinelenen, %3$s çok eski"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "%2$s e-postadan %1$s tanesi geri döndü (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "Son %3$s günde %2$s e-postadan %1$s tanesi gönderilemedi."

msgid "%1$s of %2$s entries processed …"
msgstr "%2$s kayıttan %1$s tanesi işlendi …"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%2$s – %3$s dönemine göre %1$s puan"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "%1$s ilk e-postasını %2$s tarihinde gönderdi ve son 24 saatte %3$s farklı harici adrese yazdı. Bu tür e-postalar gönderen bir şey kurmadıysanız veya ayarlamadıysanız siteyi kontrol edin: yeni bir gönderen, sitenin hacklendiğinin bir işareti olabilir."

msgid "%1$s sent, %2$s still held …"
msgstr "%1$s gönderildi, %2$s hâlâ bekletiliyor …"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%2$s – %3$s dönemine göre %1$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · son özetten bu yana toplanan %2$s e-posta"

msgid "%1$s · as of %2$s"
msgstr "%1$s · %2$s itibarıyla"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – hata oranı %2$s %% (önceki hafta: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – %2$s tarafından bildirildi, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (zorunlu eklenti)"

msgid "%s (theme)"
msgstr "%s (tema)"

msgid "%s ago"
msgstr "%s önce"

msgid "%s days"
msgstr "%s gün"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "Son 7 günde %s e-posta başarısız oldu."
msgstr[1] "Son 7 günde %s e-posta başarısız oldu."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s e-posta kararınızı bekliyor."
msgstr[1] "%s e-posta kararınızı bekliyor."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "Son 7 günde %s e-posta bekletildi ve gönderilmedi."
msgstr[1] "Son 7 günde %s e-posta bekletildi ve gönderilmedi."

msgid "%s emails are held by the emergency brake."
msgstr "Acil durum freni %s e-postayı bekletiyor."

msgid "%s emails are waiting and have not been delivered."
msgstr "%s e-posta bekliyor ve teslim edilmedi."

msgid "%s entries"
msgstr "%s kayıt"

msgid "%s failed"
msgstr "%s başarısız"

msgid "%s held emails discarded."
msgstr "Bekletilen %s e-posta iptal edildi."

msgid "%s imported entries removed."
msgstr "İçe aktarılan %s kayıt kaldırıldı."

msgid "%s in 30 days"
msgstr "30 günde %s"

msgid "%s marked as spam"
msgstr "%s istenmeyen posta olarak işaretlendi"

msgid "%s more on the Email types page."
msgstr "E-posta türleri sayfasında %s tane daha."

msgid "%s notes"
msgstr "%s not"

msgid "%s of all emails"
msgstr "Tüm e-postaların %s kadarı"

msgid "%s of them in the last 24 hours."
msgstr "Bunların %s tanesi son 24 saatte."

msgid "%s s"
msgstr "%s sn"

msgid "%s selected"
msgstr "%s seçildi"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s konu ilgi bekliyor:"
msgstr[1] "%s konu ilgi bekliyor:"

msgid "%s to administrators in 30 days"
msgstr "30 günde yöneticilere %s"

msgid "%s unchanged lines"
msgstr "%s değişmemiş satır"

msgid "(no subject)"
msgstr "(konu yok)"

msgid "(no text content)"
msgstr "(metin içeriği yok)"

msgid "(the emails are no longer in the log)"
msgstr "(e-postalar artık günlükte değil)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "-all daha katıdır; ~all yaygındır ve DMARC ile birlikte uygundur."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "0 kayıtları sonsuza dek saklar. Temizlik günde bir kez çalışır."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "0 sınırsız demektir. Önce en eski kayıtlar kaldırılır."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "0 bunu kapatır. Eski kayıtların içeriğini, üst bilgilerini ve eklerini kaldırır ve adresleri maskeler (a***@example.com). Tarih, durum, kaynak, biçim, boyut ve notlar istatistikler için kalır. Kayıtlar silinmeden önce günlük temizlikle birlikte çalışır – bu nedenle yalnızca yukarıdaki silme süresinden kısaysa etkisi olur."

msgid "12 months"
msgstr "12 ay"

msgid "30 days"
msgstr "30 gün"

msgid "7 days"
msgstr "7 gün"

msgid "90 days"
msgstr "90 gün"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "DKIM seçicisi yalnızca harf, rakam, nokta, kısa çizgi ve alt çizgi içerebilir."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "API üzerinden gönderen bir posta gönderme eklentisi teslimatı devraldı ve neden belirtmeden gönderimin başarısız olduğunu bildirdi."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "Yayımlanmış bir anahtar, e-postalarınızın onunla imzalandığını kanıtlamaz – alınan bir e-postanın üst bilgilerindeki DKIM sonucunu kontrol edin."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "Bir alıcı veya gönderen adresi geçerli bir e-posta adresi değil, bu yüzden PHPMailer göndermeyi reddetti."

msgid "API key or private key in plain text: %1$s"
msgstr "Düz metin olarak API anahtarı veya özel anahtar: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "Bu kaydı değerlendirmek için yaklaşık %1$s DNS sorgusu gerekiyor – izin verilen %2$s sınırından fazla, bu yüzden alıcılar onu yok sayabilir (PermError). Kullanılmayan include: girdilerini kaldırın."

msgid "Access"
msgstr "Erişim"

msgid "Actions"
msgstr "İşlemler"

msgid "Active: alerts on %s."
msgstr "Etkin: %s için uyarılar."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "Şablondaki her görsele kısa bir alt özniteliği ekleyin, örn. alt=\"Logo Example Shop\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "Bir posta sağlayıcısı üzerinden gönderiyorsanız onun include: girdisini ekleyin (ör. include:_spf.google.com)."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "Posta sunucunuzu veya posta hizmetinizi gönderen alan adının SPF kaydına ekleyin."

msgid "Added:"
msgstr "Eklenen:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "En az %s kalıcı hatası olan adresler: alıcı sunucu posta kutusunu reddetti, alan adının posta sunucusu yok veya e-posta sağlayıcınız kalıcı geri dönme (hard bounce) bildirdi. Kayıtlar günlüğün saklama süresiyle birlikte sona erer."

msgid "Admin screen"
msgstr "Yönetim ekranı"

msgid "Administrators"
msgstr "Yöneticiler"

msgid "Aggregate reports go to %s."
msgstr "Toplu raporlar %s adresine gider."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "Uyarı"

msgid "Alert and hold further emails"
msgstr "Uyar ve sonraki e-postaları beklet"

msgid "Alert only"
msgstr "Yalnızca uyar"

msgid "Alert when an email type that is sent regularly stops"
msgstr "Düzenli gönderilen bir e-posta türü durduğunda uyar"

msgid "Alert when emails fail repeatedly"
msgstr "E-postalar tekrar tekrar başarısız olduğunda uyar"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "Site beklenmedik şekilde e-posta göndermeyi bıraktığında uyar"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "Uyarılar etkin ancak kanal yok: bir e-posta adresi veya webhook URL'si girin."

msgid "Alerts are off."
msgstr "Uyarılar kapalı."

msgid "All"
msgstr "Tümü"

msgid "All email types look healthy."
msgstr "Tüm e-posta türleri sağlıklı görünüyor."

msgid "All emails are redirected to test addresses."
msgstr "Tüm e-postalar test adreslerine yönlendiriliyor."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "Tüm e-postalar gerçek alıcılar yerine test adreslerine gidiyor."

msgid "All sources"
msgstr "Tüm kaynaklar"

msgid "Allow again"
msgstr "Yeniden izin ver"

msgid "Allowed again."
msgstr "Yeniden izin verildi."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "Daha önce hiç e-posta göndermemiş bir eklenti veya tema bir gün içinde çok sayıda farklı harici adrese yazdığında da bir kez uyarır – sitenin hacklendiğine dair olası bir işaret. Mailspur kurulduktan sonraki ilk iki hafta temel referans olarak kullanılır."

msgid "Also remove the subject when anonymising"
msgstr "Anonimleştirirken konuyu da kaldır"

msgid "Also search content"
msgstr "İçerikte de ara"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "Alternatif olarak barındırma sağlayıcınızdan bu site için mail() / sendmail özelliğini etkinleştirmesini isteyin."

msgid "Always load remote images and fonts in the preview"
msgstr "Önizlemede uzak görselleri ve yazı tiplerini her zaman yükle"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (SNS üzerinden)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "SMTP yerine HTTP API kullanan bir e-posta sağlayıcısı, e-posta başına daha az gidiş-dönüş gerektirir."

msgid "Anonymisation"
msgstr "Anonimleştirme"

msgid "Anonymise entries after"
msgstr "Kayıtları şu süreden sonra anonimleştir"

msgid "Anonymised"
msgstr "Anonimleştirildi"

msgid "Any format"
msgstr "Herhangi bir biçim"

msgid "Any status"
msgstr "Herhangi bir durum"

msgid "Apply"
msgstr "Uygula"

msgid "Ask the recipient for a working address."
msgstr "Alıcıdan çalışan bir adres isteyin."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "Barındırma sağlayıcınızdan openssl uzantısını etkinleştirmesini isteyin (veya barındırma panelinizin PHP ayarlarından etkinleştirin)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "Barındırma sağlayıcınızdan sunucunun CA sertifikalarını ve OpenSSL'i güncellemesini isteyin."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "Barındırma sağlayıcınıza giden SMTP bağlantılarının engellenip engellenmediğini sorun."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "Barındırma sağlayıcınıza bu porta giden bağlantılara izin verilip verilmediğini sorun (güvenlik duvarı)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "%2$s dakika içinde en az %1$s başarısız e-posta"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "Sorun devam etse bile bu süre içinde tür başına en fazla bir uyarı."

msgid "Attachments"
msgstr "Ekler"

msgid "Attachments no longer available: %s"
msgstr "Ekler artık mevcut değil: %s"

msgid "Authentication"
msgstr "Kimlik doğrulama"

msgid "Automatic TLS"
msgstr "Otomatik TLS"

msgid "Average per day"
msgstr "Günlük ortalama"

msgid "Back to the email types"
msgstr "E-posta türlerine dön"

msgid "Belongs to"
msgstr "Ait olduğu"

msgid "Block again"
msgstr "Yeniden engelle"

msgid "Blocked as spam or by a blocklist"
msgstr "İstenmeyen posta olarak veya bir engel listesi tarafından engellendi"

msgid "Bounced (permanent)"
msgstr "Geri döndü (kalıcı)"

msgid "Bounced (temporary)"
msgstr "Geri döndü (geçici)"

msgid "Broken characters (encoding): %1$s"
msgstr "Bozuk karakterler (kodlama): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "Abonelikten çıkma başlığı olmayan toplu e-posta (%1$s alıcı)"

msgid "Bundle into one daily email"
msgstr "Tek bir günlük e-postada topla"

msgid "Bundled into one daily email"
msgstr "Tek bir günlük e-postada toplandı"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "Toplama kapatıldı. Bekleyen e-postalar şimdi tek bir özet hâlinde gönderildi."

msgid "Busiest day"
msgstr "En yoğun gün"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "İptal"

msgid "Careful: emails to this address failed several times before."
msgstr "Dikkat: bu adrese giden e-postalar daha önce birkaç kez başarısız oldu."

msgid "Change in the email types"
msgstr "E-posta türlerinde değiştir"

msgid "Change staging mode"
msgstr "Test modunu değiştir"

msgid "Check"
msgstr "Denetle"

msgid "Check again"
msgstr "Yeniden denetle"

msgid "Check emails"
msgstr "E-postaları denetle"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "Sunucuyu ve portu kontrol edin; 465 (SSL) yerine 587 (TLS) deneyin veya tam tersini."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "SMTP eklentinizde sunucu, port, şifreleme, kullanıcı adı ve parolayı kontrol edin ve oradan bir test e-postası gönderin."

msgid "Check sender domains"
msgstr "Gönderen alan adlarını denetle"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "Şifrelemenin portla eşleştiğini kontrol edin: 587 için TLS, 465 için SSL."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "Anahtarın doğru bölgeye / hesaba ait olduğunu kontrol edin (örn. EU veya US uç noktası)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "SMTP sunucusunu ve portunu kontrol edin: yanlış bir port veya engellenmiş bir bağlantı, yedek yöntem devreye girmeden önce çoğu zaman zaman aşımıyla sonuçlanır."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "Gönderen alan adının SPF, DKIM ve DMARC kayıtlarını kontrol edin veya gönderim yaptığınız alan adında bir gönderen adresi kullanın."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "Adreste yazım hatası olup olmadığını kontrol edin – ya da e-posta siteniz tarafından hiç gönderilmedi."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "Adresi alıcıyla teyit edin ve saklandığı yerde düzeltin (kullanıcı profili, sipariş, form kaydı)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "Adresi alıcıyla teyit edin ve saklandığı yerde düzeltin."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "Sunucu adını ve portu kontrol edin: STARTTLS (TLS) ile 587 veya SSL ile 465. Port 25 çoğu barındırma sağlayıcısı tarafından engellenir."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "Posta hizmeti hesabınızdaki limitleri ve mevcut kullanımı kontrol edin; gerekirse planı yükseltin."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "Bu kaydın alıcı adreslerinde yazım hatası, boşluk veya eksik kısım olup olmadığını kontrol edin."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
msgstr "SMTP eklentinizdeki gönderen adresini ve wp_mail_from filtresini kontrol edin."

msgid "Check the sending limits of your mail account and the notes of this email."
msgstr "Posta hesabınızın gönderim limitlerini ve bu e-postanın notlarını kontrol edin."

msgid "Check the server IP on a blocklist checker and request delisting."
msgstr "Sunucu IP'sini bir engel listesi denetleyicisinde kontrol edin ve listeden çıkarılmayı talep edin."

msgid "Check the spelling of the placeholder in the template and whether the plugin supports it for this email type. Shortcodes are not processed in emails unless the sending plugin runs do_shortcode()."
msgstr "Şablondaki yer tutucunun yazımını ve eklentinin bunu bu e-posta türü için destekleyip desteklemediğini kontrol edin. Gönderen eklenti do_shortcode() çalıştırmadıkça kısa kodlar e-postalarda işlenmez."

msgid "Checked %s."
msgstr "%s denetlendi."

msgid "Checked just now"
msgstr "Az önce denetlendi"

msgid "Checking DNS records …"
msgstr "DNS kayıtları denetleniyor …"

msgid "Checks the DNS records of the domains your site sends from: the default sender address and the most frequent senders in the log. Missing or weak records are the most common reason why emails land in spam. Only your server's own DNS resolver is used; results are kept for one hour."
msgstr "Sitenizin gönderdiği alan adlarının DNS kayıtlarını denetler: varsayılan gönderen adresi ve günlükteki en sık gönderenler. Eksik veya zayıf kayıtlar, e-postaların istenmeyen postaya düşmesinin en yaygın nedenidir. Yalnızca sunucunuzun kendi DNS çözümleyicisi kullanılır; sonuçlar bir saat saklanır."

msgid "Choose a range of at most %s days."
msgstr "En fazla %s günlük bir aralık seçin."

msgid "Clear selection"
msgstr "Seçimi temizle"

msgid "Click a bar to open these emails in the log."
msgstr "Bu e-postaları günlükte açmak için bir çubuğa tıklayın."

msgid "Close"
msgstr "Kapat"

msgid "Close (Esc)"
msgstr "Kapat (Esc)"

msgid "Colour scheme"
msgstr "Renk düzeni"

msgid "Command line"
msgstr "Komut satırı"

msgid "Compare"
msgstr "Karşılaştır"

msgid "Compare the sources of these entries. Check whether two plugins send the same notification, or whether a hook (e.g. order status change) fires more than once."
msgstr "Bu kayıtların kaynaklarını karşılaştırın. İki eklentinin aynı bildirimi gönderip göndermediğini veya bir kancanın (örn. sipariş durumu değişikliği) birden fazla kez tetiklenip tetiklenmediğini kontrol edin."

msgid "Component"
msgstr "Bileşen"

msgid "Configure alerts"
msgstr "Uyarıları yapılandır"

msgid "Content anonymised after %1$s days, %2$s"
msgstr "İçerik %1$s gün sonra anonimleştirildi, %2$s"

msgid "Content change marked as seen."
msgstr "İçerik değişikliği görüldü olarak işaretlendi."

msgid "Content changed"
msgstr "İçerik değişti"

msgid "Content changed on %1$s, after the %2$s update."
msgstr "İçerik %1$s tarihinde, %2$s güncellemesinden sonra değişti."

msgid "Content changed on %s."
msgstr "İçerik %s tarihinde değişti."

msgid "Content removed"
msgstr "İçerik kaldırıldı"

msgid "Content removed after %s days"
msgstr "İçerik %s gün sonra kaldırıldı"

msgid "Content, headers and attachments were removed and the addresses masked by the anonymisation setting."
msgstr "İçerik, üst bilgiler ve ekler kaldırıldı ve adresler anonimleştirme ayarıyla maskelendi."

msgid "Copied"
msgstr "Kopyalandı"

msgid "Copied – paste it into your reply."
msgstr "Kopyalandı – yanıtınıza yapıştırın."

msgid "Copies a short sentence for answering the customer: when the email was sent to whom and whether it arrived – without technical details."
msgstr "Müşteriye yanıt vermek için kısa bir cümle kopyalar: e-postanın ne zaman kime gönderildiği ve ulaşıp ulaşmadığı – teknik ayrıntılar olmadan."

msgid "Copies the existing log of another mail logging plugin into Mailspur, so old emails can be searched and previewed here. The other plugin and its data stay untouched; running the import again only adds new entries."
