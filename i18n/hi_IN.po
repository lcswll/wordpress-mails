msgstr "पिछला पृष्ठ"

msgid "Print"
msgstr "प्रिंट करें"

msgid "Privacy"
msgstr "गोपनीयता"

msgid "Privacy & security"
msgstr "गोपनीयता और सुरक्षा"

msgid "Probably yes: %s email type has stopped."
msgid_plural "Probably yes: %s email types have stopped."
msgstr[0] "शायद हाँ: %s ईमेल प्रकार बंद हो गया है।"
msgstr[1] "शायद हाँ: %s ईमेल प्रकार बंद हो गए हैं।"

msgid "Probe emails are only sent to an administrator."
msgstr "परीक्षण ईमेल केवल किसी प्रशासक को भेजे जाते हैं।"

msgid "Problem"
msgstr "समस्या"

msgid "Problem recipients"
msgstr "समस्याग्रस्त प्राप्तकर्ता"

msgid "Protects your domain when far more emails leave than usual, e.g. because spam bots abuse a contact form. Alerts use the channels of the monitoring alerts; password reset emails are never held."
msgstr "जब सामान्य से कहीं अधिक ईमेल जाते हैं, उदाहरण के लिए स्पैम बॉट किसी संपर्क फ़ॉर्म का दुरुपयोग करते हैं, तब आपके डोमेन की रक्षा करता है। सूचनाएँ निगरानी सूचनाओं के चैनलों का उपयोग करती हैं; पासवर्ड रीसेट ईमेल कभी नहीं रोके जाते।"

msgid "Provider status"
msgstr "प्रदाता स्थिति"

msgid "Providers like %2$s publish a strict DMARC policy. An email \"from\" their domain that was sent by your web server fails that check and is rejected or lands in spam."
msgstr "%2$s जैसे प्रदाता एक सख़्त DMARC नीति प्रकाशित करते हैं। उनके डोमेन \"से\" भेजा गया ईमेल, जिसे आपके वेब सर्वर ने भेजा हो, उस जाँच में विफल होता है और अस्वीकार कर दिया जाता है या स्पैम में चला जाता है।"

msgid "Put the important content into real text and use images only in addition to it."
msgstr "महत्वपूर्ण सामग्री को असली टेक्स्ट में रखें और चित्रों का उपयोग केवल उसके अतिरिक्त करें।"

msgid "Put the important information first and keep the subject under about 80 characters."
msgstr "महत्वपूर्ण जानकारी पहले रखें और विषय को लगभग 80 अक्षरों से कम रखें।"

msgid "REST API"
msgstr "REST API"

msgid "REST route"
msgstr "REST रूट"

msgid "Rarely"
msgstr "कभी-कभार"

msgid "Rate Mailspur on WordPress.org"
msgstr "WordPress.org पर Mailspur को रेट करें"

msgid "Raw source"
msgstr "कच्चा स्रोत"

msgid "Reason"
msgstr "कारण"

msgid "Rebuild from the log"
msgstr "लॉग से फिर से बनाएँ"

msgid "Recipient"
msgstr "प्राप्तकर्ता"

msgid "Recipient domain cannot receive email: %1$s"
msgstr "प्राप्तकर्ता डोमेन ईमेल प्राप्त नहीं कर सकता: %1$s"

msgid "Recipient domain does not accept email: %1$s"
msgstr "प्राप्तकर्ता डोमेन ईमेल स्वीकार नहीं करता: %1$s"

msgid "Recipients"
msgstr "प्राप्तकर्ता"

msgid "Recommended. Otherwise anyone with log access could use a logged reset link or password to take over an account. Resending such an email sends the masked version."
msgstr "अनुशंसित। अन्यथा लॉग तक पहुँच वाला कोई भी व्यक्ति लॉग किए गए रीसेट लिंक या पासवर्ड से किसी खाते पर कब्ज़ा कर सकता है। ऐसा ईमेल दोबारा भेजने पर छिपाया गया संस्करण भेजा जाता है।"

msgid "Record for every email"
msgstr "हर ईमेल के लिए दर्ज करें"

msgid "Record for failed emails only"
msgstr "केवल विफल ईमेल के लिए दर्ज करें"

msgid "Records the conversation with the SMTP server (only when emails are sent via SMTP). Login data and the message content are never recorded. Skipped while another plugin has SMTP debugging switched on."
msgstr "SMTP सर्वर के साथ बातचीत दर्ज करता है (केवल तब जब ईमेल SMTP के माध्यम से भेजे जाते हैं)। लॉगिन डेटा और संदेश की सामग्री कभी दर्ज नहीं की जाती। जब कोई दूसरा प्लगइन SMTP डिबगिंग चालू रखता है, तब इसे छोड़ दिया जाता है।"

msgid "Recovery"
msgstr "सुधार"

msgid "Redact secrets"
msgstr "गोपनीय जानकारी छिपाएँ"

