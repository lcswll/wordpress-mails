msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: vi\n"
"Plural-Forms: nplurals=1; plural=0;\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "“Tải xuống .eml” dựng lại thư từ dữ liệu đã ghi nhật ký và đã che (không có tệp đính kèm)."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (tuần trước: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (lên lịch lúc %2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s loại email đã ngừng gửi: %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "%1$s loại email từ %2$s người gửi"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "%1$s email bị lỗi trong %2$s phút qua."

msgid "%1$s emails in %2$s days"
msgstr "%1$s email trong %2$s ngày"

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "%1$s email trong 30 ngày qua, %2$s bị lỗi"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "%1$s email đã được gửi trong vòng một giờ – nhiều hơn bình thường rất nhiều (ngưỡng: %2$s mỗi giờ). Có thể một biểu mẫu liên hệ đang bị lạm dụng hoặc trang web đã bị xâm nhập."

msgid "%1$s entries, %2$s"
msgstr "%1$s mục, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "%1$s đã nhập, %2$s trùng lặp, %3$s quá cũ"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "%1$s trên %2$s bị trả về (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "%1$s trong số %2$s email của %3$s ngày qua không thể gửi được."

msgid "%1$s of %2$s entries processed …"
msgstr "Đã xử lý %1$s / %2$s mục …"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s điểm phần trăm so với %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "%1$s đã gửi email đầu tiên vào %2$s và đã gửi đến %3$s địa chỉ bên ngoài khác nhau trong 24 giờ qua. Nếu bạn không cài đặt hay thiết lập gì gửi những email như vậy, hãy kiểm tra trang web: một người gửi mới có thể là dấu hiệu trang web bị hack."

msgid "%1$s sent, %2$s still held …"
msgstr "Đã gửi %1$s, còn %2$s đang bị giữ lại …"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s so với %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · %2$s email được gộp kể từ email tổng hợp gần nhất"

msgid "%1$s · as of %2$s"
msgstr "%1$s · tính đến %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – tỷ lệ lỗi %2$s %% (tuần trước: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – được báo bởi %2$s, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (plugin must-use)"

msgid "%s (theme)"
msgstr "%s (giao diện)"

msgid "%s ago"
msgstr "%s trước"

msgid "%s days"
msgstr "%s ngày"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "%s email bị lỗi trong 7 ngày qua."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s email đang chờ bạn quyết định."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "%s email bị giữ lại và không được gửi trong 7 ngày qua."

msgid "%s emails are held by the emergency brake."
msgstr "%s email đang bị phanh khẩn cấp giữ lại."

msgid "%s emails are waiting and have not been delivered."
msgstr "%s email đang chờ và chưa được chuyển phát."

msgid "%s entries"
msgstr "%s mục"

msgid "%s failed"
msgstr "%s bị lỗi"

msgid "%s held emails discarded."
msgstr "Đã hủy %s email bị giữ lại."

msgid "%s imported entries removed."
msgstr "Đã xóa %s mục đã nhập."

msgid "%s in 30 days"
msgstr "%s trong 30 ngày"

msgid "%s marked as spam"
msgstr "%s bị đánh dấu là spam"

msgid "%s more on the Email types page."
msgstr "Còn %s mục khác trên trang Loại email."

msgid "%s notes"
msgstr "%s ghi chú"

msgid "%s of all emails"
msgstr "%s tổng số email"

msgid "%s of them in the last 24 hours."
msgstr "Trong đó %s trong 24 giờ qua."

msgid "%s s"
msgstr "%s giây"

msgid "%s selected"
msgstr "Đã chọn %s"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s việc cần bạn chú ý:"

msgid "%s to administrators in 30 days"
msgstr "%s gửi đến quản trị viên trong 30 ngày"

msgid "%s unchanged lines"
msgstr "%s dòng không thay đổi"

msgid "(no subject)"
msgstr "(không có tiêu đề)"

msgid "(no text content)"
msgstr "(không có nội dung văn bản)"

msgid "(the emails are no longer in the log)"
msgstr "(các email không còn trong nhật ký)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "-all nghiêm ngặt hơn; ~all phổ biến và ổn khi đi kèm DMARC."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "0 nghĩa là giữ các mục vĩnh viễn. Việc dọn dẹp chạy mỗi ngày một lần."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "0 nghĩa là không giới hạn. Các mục cũ nhất sẽ bị xóa trước."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "0 để tắt. Xóa nội dung, header và tệp đính kèm của các mục cũ hơn và che địa chỉ (a***@example.com). Ngày, trạng thái, nguồn, định dạng, kích thước và ghi chú được giữ lại cho thống kê. Chạy cùng đợt dọn dẹp hằng ngày, trước khi các mục bị xóa – nên chỉ có tác dụng nếu ngắn hơn thời hạn xóa ở trên."

msgid "12 months"
msgstr "12 tháng"

msgid "30 days"
msgstr "30 ngày"

msgid "7 days"
msgstr "7 ngày"

msgid "90 days"
msgstr "90 ngày"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "Selector DKIM chỉ được chứa chữ cái, chữ số, dấu chấm, dấu gạch ngang và dấu gạch dưới."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "Một plugin gửi thư qua API đã đảm nhận việc chuyển phát và báo gửi thất bại mà không cho biết lý do."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "Khóa đã công bố không chứng minh rằng email của bạn được ký bằng nó – hãy kiểm tra kết quả DKIM trong header của một email đã nhận."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "Một người nhận hoặc địa chỉ người gửi không phải là địa chỉ email hợp lệ, nên PHPMailer đã từ chối gửi."

msgid "API key or private key in plain text: %1$s"
msgstr "Khóa API hoặc khóa riêng tư ở dạng văn bản thuần: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "Cần khoảng %1$s lượt truy vấn DNS để đánh giá bản ghi này – nhiều hơn mức cho phép %2$s, nên bên nhận có thể bỏ qua nó (PermError). Hãy xóa các mục include: không dùng đến."

msgid "Access"
msgstr "Quyền truy cập"

msgid "Actions"
msgstr "Hành động"

msgid "Active: alerts on %s."
msgstr "Đang hoạt động: cảnh báo khi có %s."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "Thêm thuộc tính alt ngắn cho mọi hình ảnh trong mẫu, ví dụ alt=\"Logo Cửa hàng Mẫu\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "Thêm include: của nhà cung cấp email (ví dụ include:_spf.google.com) nếu bạn gửi qua nhà cung cấp đó."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "Thêm máy chủ thư hoặc dịch vụ email của bạn vào bản ghi SPF của tên miền người gửi."

msgid "Added:"
msgstr "Đã thêm:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "Các địa chỉ có ít nhất %s lỗi cứng: máy chủ nhận đã từ chối hộp thư, tên miền không có máy chủ thư, hoặc nhà cung cấp email của bạn báo hard bounce. Các mục hết hạn theo thời gian lưu giữ của nhật ký."

msgid "Admin screen"
msgstr "Màn hình quản trị"

msgid "Administrators"
msgstr "Quản trị viên"

msgid "Aggregate reports go to %s."
msgstr "Báo cáo tổng hợp được gửi đến %s."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "Cảnh báo"

msgid "Alert and hold further emails"
msgstr "Cảnh báo và giữ lại các email tiếp theo"

msgid "Alert only"
msgstr "Chỉ cảnh báo"

msgid "Alert when an email type that is sent regularly stops"
msgstr "Cảnh báo khi một loại email được gửi định kỳ ngừng gửi"

msgid "Alert when emails fail repeatedly"
msgstr "Cảnh báo khi email liên tục bị lỗi"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "Cảnh báo khi trang web bất ngờ ngừng gửi email"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "Cảnh báo đã bật nhưng chưa có kênh nhận: hãy nhập địa chỉ email hoặc URL webhook."

msgid "Alerts are off."
msgstr "Cảnh báo đang tắt."

msgid "All"
msgstr "Tất cả"

msgid "All email types look healthy."
msgstr "Mọi loại email đều có vẻ hoạt động tốt."

msgid "All emails are redirected to test addresses."
msgstr "Mọi email được chuyển hướng đến địa chỉ thử nghiệm."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "Mọi email được gửi đến địa chỉ thử nghiệm thay vì người nhận thật."

msgid "All sources"
msgstr "Tất cả nguồn"

msgid "Allow again"
msgstr "Cho phép lại"

msgid "Allowed again."
msgstr "Đã cho phép lại."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "Đồng thời cảnh báo một lần khi một plugin hoặc giao diện chưa từng gửi email lại gửi đến nhiều địa chỉ bên ngoài khác nhau trong một ngày – có thể là dấu hiệu trang web bị hack. Hai tuần đầu sau khi cài Mailspur được dùng làm mốc so sánh."

msgid "Also remove the subject when anonymising"
msgstr "Xóa cả tiêu đề khi ẩn danh hóa"

msgid "Also search content"
msgstr "Tìm cả trong nội dung"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "Hoặc nhờ nhà cung cấp hosting bật mail() / sendmail cho trang web này."

msgid "Always load remote images and fonts in the preview"
msgstr "Luôn tải hình ảnh và phông chữ bên ngoài trong bản xem trước"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (qua SNS)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "Nhà cung cấp email có HTTP API thay vì SMTP cần ít lượt trao đổi hơn cho mỗi email."

msgid "Anonymisation"
msgstr "Ẩn danh hóa"

msgid "Anonymise entries after"
msgstr "Ẩn danh hóa các mục sau"

msgid "Anonymised"
msgstr "Đã ẩn danh hóa"

msgid "Any format"
msgstr "Mọi định dạng"

msgid "Any status"
msgstr "Mọi trạng thái"

msgid "Apply"
msgstr "Áp dụng"

msgid "Ask the recipient for a working address."
msgstr "Hãy hỏi người nhận một địa chỉ đang hoạt động."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "Nhờ nhà cung cấp hosting bật tiện ích mở rộng openssl (hoặc tự bật trong phần cài đặt PHP của bảng điều khiển hosting)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "Nhờ nhà cung cấp hosting cập nhật chứng chỉ CA và OpenSSL của máy chủ."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "Hỏi nhà cung cấp hosting xem kết nối SMTP ra ngoài có bị chặn không."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "Hỏi nhà cung cấp hosting xem kết nối ra ngoài đến cổng đó có được cho phép không (tường lửa)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "Ít nhất %1$s email bị lỗi trong vòng %2$s phút"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "Tối đa một cảnh báo cho mỗi loại trong khoảng thời gian này, kể cả khi sự cố vẫn tiếp diễn."

msgid "Attachments"
msgstr "Tệp đính kèm"

msgid "Attachments no longer available: %s"
msgstr "Tệp đính kèm không còn tồn tại: %s"

msgid "Authentication"
msgstr "Xác thực"

msgid "Automatic TLS"
msgstr "TLS tự động"

msgid "Average per day"
msgstr "Trung bình mỗi ngày"

msgid "Back to the email types"
msgstr "Quay lại loại email"

msgid "Belongs to"
msgstr "Thuộc về"

msgid "Block again"
msgstr "Chặn lại"

msgid "Blocked as spam or by a blocklist"
msgstr "Bị chặn vì là spam hoặc do danh sách chặn"

msgid "Bounced (permanent)"
msgstr "Bị trả về (vĩnh viễn)"

msgid "Bounced (temporary)"
msgstr "Bị trả về (tạm thời)"

msgid "Broken characters (encoding): %1$s"
msgstr "Ký tự bị lỗi (mã hóa ký tự): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "Email hàng loạt không có header hủy đăng ký (%1$s người nhận)"

msgid "Bundle into one daily email"
msgstr "Gộp vào một email mỗi ngày"

msgid "Bundled into one daily email"
msgstr "Đã gộp vào một email mỗi ngày"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "Đã tắt gộp. Các email đang chờ vừa được gửi trong một email tổng hợp."

msgid "Busiest day"
msgstr "Ngày nhiều nhất"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "Hủy"

msgid "Careful: emails to this address failed several times before."
msgstr "Lưu ý: email gửi đến địa chỉ này đã bị lỗi nhiều lần trước đây."

msgid "Change in the email types"
msgstr "Thay đổi trong loại email"

msgid "Change staging mode"
msgstr "Thay đổi chế độ staging"

msgid "Check"
msgstr "Kiểm tra"

msgid "Check again"
msgstr "Kiểm tra lại"

msgid "Check emails"
msgstr "Kiểm tra email"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "Kiểm tra máy chủ và cổng; thử 587 (TLS) thay cho 465 (SSL) hoặc ngược lại."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "Kiểm tra máy chủ, cổng, mã hóa, tên người dùng và mật khẩu trong plugin SMTP của bạn và gửi email thử từ đó."

msgid "Check sender domains"
msgstr "Kiểm tra tên miền người gửi"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "Kiểm tra xem mã hóa có khớp với cổng không: TLS cho 587, SSL cho 465."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "Kiểm tra xem khóa có thuộc đúng khu vực / tài khoản không (ví dụ endpoint EU so với US)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "Kiểm tra máy chủ và cổng SMTP: cổng sai hoặc kết nối bị chặn thường dẫn đến hết thời gian chờ trước khi phương án dự phòng hoạt động."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "Kiểm tra bản ghi SPF, DKIM và DMARC của tên miền người gửi, hoặc dùng địa chỉ người gửi thuộc tên miền mà bạn gửi từ đó."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "Hãy kiểm tra địa chỉ xem có lỗi chính tả không – hoặc trang web của bạn chưa bao giờ gửi email này."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "Xác nhận địa chỉ với người nhận và sửa lại ở nơi lưu trữ (hồ sơ người dùng, đơn hàng, mục biểu mẫu)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "Xác nhận địa chỉ với người nhận và sửa lại ở nơi lưu trữ."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "Kiểm tra tên máy chủ và cổng: 587 với STARTTLS (TLS) hoặc 465 với SSL. Hầu hết nhà cung cấp hosting chặn cổng 25."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "Kiểm tra giới hạn và mức sử dụng hiện tại trong tài khoản dịch vụ email; nâng cấp gói nếu cần."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "Kiểm tra địa chỉ người nhận của mục này xem có lỗi chính tả, khoảng trắng hoặc phần bị thiếu không."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
msgstr "Kiểm tra địa chỉ người gửi trong plugin SMTP và bộ lọc wp_mail_from."

msgid "Check the sending limits of your mail account and the notes of this email."
msgstr "Kiểm tra giới hạn gửi của tài khoản email và các ghi chú của email này."

msgid "Check the server IP on a blocklist checker and request delisting."
msgstr "Kiểm tra IP máy chủ bằng công cụ kiểm tra danh sách chặn và yêu cầu gỡ khỏi danh sách."

msgid "Check the spelling of the placeholder in the template and whether the plugin supports it for this email type. Shortcodes are not processed in emails unless the sending plugin runs do_shortcode()."
msgstr "Kiểm tra chính tả của biến giữ chỗ trong mẫu và xem plugin có hỗ trợ nó cho loại email này không. Shortcode không được xử lý trong email trừ khi plugin gửi thư chạy do_shortcode()."

msgid "Checked %s."
msgstr "Đã kiểm tra %s."

msgid "Checked just now"
msgstr "Vừa kiểm tra"

msgid "Checking DNS records …"
msgstr "Đang kiểm tra bản ghi DNS …"

msgid "Checks the DNS records of the domains your site sends from: the default sender address and the most frequent senders in the log. Missing or weak records are the most common reason why emails land in spam. Only your server's own DNS resolver is used; results are kept for one hour."
msgstr "Kiểm tra bản ghi DNS của các tên miền mà trang web của bạn dùng để gửi: địa chỉ người gửi mặc định và những người gửi thường gặp nhất trong nhật ký. Bản ghi thiếu hoặc yếu là lý do phổ biến nhất khiến email bị đưa vào spam. Chỉ dùng DNS resolver của chính máy chủ của bạn; kết quả được lưu trong một giờ."

msgid "Choose a range of at most %s days."
msgstr "Chọn khoảng thời gian tối đa %s ngày."

msgid "Clear selection"
msgstr "Bỏ chọn"

msgid "Click a bar to open these emails in the log."
msgstr "Nhấp vào một cột để mở các email này trong nhật ký."

msgid "Close"
msgstr "Đóng"

