msgstr "Đã đặt lại phanh khẩn cấp."

msgid "Emergency brake settings"
msgstr "Cài đặt phanh khẩn cấp"

msgid "Emergency brake: %1$s emails in the last hour – far more than usual (threshold: %2$s per hour)."
msgstr "Phanh khẩn cấp: %1$s email trong giờ vừa qua – nhiều hơn bình thường rất nhiều (ngưỡng: %2$s mỗi giờ)."

msgid "Emergency brake: unusual email flood"
msgstr "Phanh khẩn cấp: lượng email tăng đột biến bất thường"

msgid "Empty = automatic: three times the busiest hour of the last 14 days, at least 50 – currently %s."
msgstr "Để trống = tự động: gấp ba lần giờ cao điểm nhất trong 14 ngày qua, tối thiểu 50 – hiện tại là %s."

msgid "Empty log"
msgstr "Làm trống nhật ký"

msgid "Empty subject"
msgstr "Tiêu đề trống"

msgid "Enable 2-step verification for the Google account and create an app password (Google account → Security → App passwords)."
msgstr "Bật xác minh 2 bước cho tài khoản Google và tạo mật khẩu ứng dụng (Tài khoản Google → Bảo mật → Mật khẩu ứng dụng)."

msgid "Enable DKIM signing at your mail provider or host and publish the key it gives you. If you already sign, enter your selector (the s= value of the DKIM-Signature header) and check again."
msgstr "Bật ký DKIM tại nhà cung cấp email hoặc nhà cung cấp hosting của bạn và công bố khóa được cấp. Nếu bạn đã ký, hãy nhập selector của bạn (giá trị s= trong header DKIM-Signature) và kiểm tra lại."

msgid "Enable DKIM signing at your mail service and publish its DNS record."
msgstr "Bật ký DKIM tại dịch vụ email và công bố bản ghi DNS tương ứng."

msgid "Enable authentication in your SMTP plugin and enter user name and password."
msgstr "Bật xác thực trong plugin SMTP và nhập tên người dùng cùng mật khẩu."

msgid "Enable authentication in your SMTP plugin."
msgstr "Bật xác thực trong plugin SMTP."

msgid "Encrypted SMTP connections (TLS/SSL) need the PHP extension openssl, which is not installed or not enabled on this server."
msgstr "Kết nối SMTP được mã hóa (TLS/SSL) cần tiện ích mở rộng PHP openssl, nhưng nó chưa được cài hoặc chưa được bật trên máy chủ này."

msgid "Encryption"
msgstr "Mã hóa"

msgid "Encryption (TLS/SSL) failed"
msgstr "Mã hóa (TLS/SSL) thất bại"

msgid "Enter an email address or a webhook URL and save the settings first."
msgstr "Hãy nhập địa chỉ email hoặc URL webhook và lưu cài đặt trước."

msgid "Enter an email address or an order number."
msgstr "Nhập địa chỉ email hoặc mã đơn hàng."

msgid "Enter an email address under “Send alerts by email to” and save the settings first."
msgstr "Hãy nhập địa chỉ email trong “Gửi cảnh báo qua email đến” và lưu cài đặt trước."

msgid "Enter between 1 and 10 email addresses."
msgstr "Nhập từ 1 đến 10 địa chỉ email."

msgid "Enter one or more email addresses."
msgstr "Nhập một hoặc nhiều địa chỉ email."

msgid "Enter the app password in your SMTP plugin, or use the plugin's \"Sign in with Google\" (OAuth) connection."
msgstr "Nhập mật khẩu ứng dụng vào plugin SMTP, hoặc dùng kết nối “Đăng nhập bằng Google” (OAuth) của plugin."

msgid "Entries"
msgstr "Mục"

msgid "Entries older than %s days are skipped because the retention setting would delete them anyway. Change the retention above first to import everything."
msgstr "Các mục cũ hơn %s ngày sẽ bị bỏ qua vì cài đặt thời gian lưu giữ cũng sẽ xóa chúng. Hãy thay đổi thời gian lưu giữ ở trên trước để nhập tất cả."

msgid "Error"
msgstr "Lỗi"

msgid "Errors"
msgstr "Lỗi"

msgid "Every %s days"
msgstr "Mỗi %s ngày"

msgid "Every 15 minutes (Mailspur alerts)"
msgstr "Mỗi 15 phút (cảnh báo Mailspur)"

msgid "Every Monday morning, only when there is something to report: emails and failure rate compared with the previous week, new, stopped and changed email types, emails with notes and emergency-brake incidents. Counts and subject patterns only."
msgstr "Mỗi sáng thứ Hai, chỉ khi có điều cần báo cáo: số email và tỷ lệ lỗi so với tuần trước, các loại email mới, ngừng gửi và đã thay đổi, email có ghi chú và các lần kích hoạt phanh khẩn cấp. Chỉ có số liệu và mẫu tiêu đề."

msgid "Every kind of email this site sends, generated from the Mailspur email log – e.g. for a record of processing activities or a handover. Recipient groups are derived from the latest emails of each sender, data categories from the latest email of each type. The list contains no email contents and no addresses."
msgstr "Mọi loại email mà trang web này gửi, được tạo từ nhật ký email của Mailspur – ví dụ cho hồ sơ hoạt động xử lý dữ liệu hoặc khi bàn giao. Nhóm người nhận được suy ra từ các email mới nhất của mỗi người gửi, danh mục dữ liệu từ email mới nhất của mỗi loại. Danh sách không chứa nội dung email hay địa chỉ."

msgid "Every kind of email your site sends, found automatically in the log: grouped by the plugin that sends it and by subject, with numbers, addresses and names as placeholders. Mailspur learns how often each type is sent and notices when one stops – for example after a plugin update."
msgstr "Mọi loại email mà trang web của bạn gửi, được tự động tìm thấy trong nhật ký: nhóm theo plugin gửi và theo tiêu đề, với số, địa chỉ và tên được thay bằng biến giữ chỗ. Mailspur học xem mỗi loại được gửi thường xuyên đến mức nào và nhận ra khi một loại ngừng gửi – ví dụ sau khi cập nhật plugin."

msgid "Everything looks fine: %s email in the last 7 days, without errors."
msgid_plural "Everything looks fine: %s emails in the last 7 days, none failed."
msgstr[0] "Mọi thứ đều ổn: %s email trong 7 ngày qua, không có lỗi."

