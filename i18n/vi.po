msgstr "Đã bắt đầu xuất – việc tải xuống sẽ bắt đầu ngay."

msgid "Failed"
msgstr "Bị lỗi"

msgid "Failed (%s %%)"
msgstr "Bị lỗi (%s %%)"

msgid "Failing"
msgstr "Đang lỗi"

msgid "Failure rate"
msgstr "Tỷ lệ lỗi"

msgid "Failure spike"
msgstr "Lỗi tăng đột biến"

