msgid "Providers like %2$s publish a strict DMARC policy. An email \"from\" their domain that was sent by your web server fails that check and is rejected or lands in spam."
msgstr "Các nhà cung cấp như %2$s công bố chính sách DMARC nghiêm ngặt. Email “từ” tên miền của họ nhưng do máy chủ web của bạn gửi sẽ không vượt qua kiểm tra đó và bị từ chối hoặc bị đưa vào spam."

msgid "Put the important content into real text and use images only in addition to it."
msgstr "Đưa nội dung quan trọng vào văn bản thật và chỉ dùng hình ảnh để bổ sung."

msgid "Put the important information first and keep the subject under about 80 characters."
msgstr "Đặt thông tin quan trọng lên đầu và giữ tiêu đề dưới khoảng 80 ký tự."

msgid "REST API"
msgstr "REST API"

msgid "REST route"
msgstr "Route REST"

msgid "Rarely"
msgstr "Hiếm khi"

msgid "Rate Mailspur on WordPress.org"
msgstr "Đánh giá Mailspur trên WordPress.org"

msgid "Raw source"
msgstr "Mã nguồn thô"

msgid "Reason"
msgstr "Lý do"

msgid "Rebuild from the log"
msgstr "Dựng lại từ nhật ký"

msgid "Recipient"
msgstr "Người nhận"

msgid "Recipient domain cannot receive email: %1$s"
msgstr "Tên miền người nhận không thể nhận email: %1$s"

msgid "Recipient domain does not accept email: %1$s"
msgstr "Tên miền người nhận không chấp nhận email: %1$s"

msgid "Recipients"
msgstr "Người nhận"

msgid "Recommended. Otherwise anyone with log access could use a logged reset link or password to take over an account. Resending such an email sends the masked version."
msgstr "Khuyến nghị. Nếu không, bất kỳ ai có quyền truy cập nhật ký đều có thể dùng liên kết đặt lại hoặc mật khẩu đã ghi để chiếm quyền một tài khoản. Khi gửi lại email như vậy, phiên bản đã che sẽ được gửi."

msgid "Record for every email"
msgstr "Ghi lại cho mọi email"

msgid "Record for failed emails only"
msgstr "Chỉ ghi lại cho email bị lỗi"

msgid "Records the conversation with the SMTP server (only when emails are sent via SMTP). Login data and the message content are never recorded. Skipped while another plugin has SMTP debugging switched on."
msgstr "Ghi lại cuộc trao đổi với máy chủ SMTP (chỉ khi email được gửi qua SMTP). Thông tin đăng nhập và nội dung thư không bao giờ được ghi lại. Bỏ qua khi một plugin khác đang bật gỡ lỗi SMTP."

msgid "Recovery"
msgstr "Đã phục hồi"

msgid "Redact secrets"
msgstr "Che thông tin bí mật"

msgid "Redirect all emails to the addresses below"
msgstr "Chuyển hướng mọi email đến các địa chỉ bên dưới"

msgid "Redirect to"
msgstr "Chuyển hướng đến"

msgid "Redirect to test addresses"
msgstr "Chuyển hướng đến địa chỉ thử nghiệm"

msgid "Redirected by staging mode."
msgstr "Đã được chế độ staging chuyển hướng."

msgid "Reduce the HTML: remove unused CSS, inline styles that repeat, comments and long tracking URLs. Images are not counted, only the HTML itself."
msgstr "Giảm dung lượng HTML: xóa CSS không dùng, style nội tuyến lặp lại, chú thích và URL theo dõi dài. Hình ảnh không được tính, chỉ tính bản thân HTML."

msgid "Registered users"
msgstr "Người dùng đã đăng ký"

msgid "Rejected by SPF, DKIM or DMARC"
msgstr "Bị từ chối do SPF, DKIM hoặc DMARC"

msgid "Relative links or images (%1$s), e.g. %2$s"
msgstr "Liên kết hoặc hình ảnh tương đối (%1$s), ví dụ %2$s"

msgid "Release held emails"
msgstr "Cho gửi email bị giữ lại"

msgid "Released from staging (held entry #%s)."
msgstr "Đã cho gửi từ staging (mục bị giữ lại #%s)."

msgid "Released from the emergency brake (held entry #%s)."
msgstr "Đã cho gửi từ phanh khẩn cấp (mục bị giữ lại #%s)."

msgid "Remote content"
msgstr "Nội dung bên ngoài"

msgid "Remote content is loaded."
msgstr "Nội dung bên ngoài đã được tải."

msgid "Remote images and fonts are blocked so senders cannot track when you open this entry."
msgstr "Hình ảnh và phông chữ bên ngoài bị chặn để người gửi không thể theo dõi khi nào bạn mở mục này."

msgid "Remove all entries imported from %s? The data in the other plugin is not affected."
msgstr "Xóa tất cả mục đã nhập từ %s? Dữ liệu trong plugin kia không bị ảnh hưởng."

msgid "Remove imported entries"
msgstr "Xóa các mục đã nhập"

msgid "Remove the card field from the notification of the form or plugin that sent this email – card data belongs to the payment provider only. Show at most the last four digits. Ask the recipient to delete the email."
msgstr "Xóa trường số thẻ khỏi thông báo của biểu mẫu hoặc plugin đã gửi email này – dữ liệu thẻ chỉ thuộc về nhà cung cấp thanh toán. Chỉ hiển thị tối đa bốn chữ số cuối. Hãy nhờ người nhận xóa email."

msgid "Removed:"
msgstr "Đã xóa:"

msgid "Repeat alerts after"
msgstr "Lặp lại cảnh báo sau"

msgid "Replies cannot reach you: sent from %1$s without Reply-To"
msgstr "Thư trả lời không đến được bạn: gửi từ %1$s mà không có Reply-To"

msgid "Reported by your email provider in the last 30 days; only emails it reported on count."
msgstr "Do nhà cung cấp email của bạn báo trong 30 ngày qua; chỉ tính những email mà nhà cung cấp đã báo về."

msgid "Request"
msgstr "Yêu cầu"

msgid "Request failed: %s"
msgstr "Yêu cầu thất bại: %s"

msgid "Resend"
msgstr "Gửi lại"

msgid "Resend the email from the log in a few minutes."
msgstr "Gửi lại email từ nhật ký sau vài phút."

msgid "Resend the email from the log later."
msgstr "Gửi lại email từ nhật ký sau."

msgid "Resend the email from the log once delivery works."
msgstr "Gửi lại email từ nhật ký khi việc chuyển phát hoạt động trở lại."

msgid "Resend the failed emails once the limit resets."
msgstr "Gửi lại các email bị lỗi khi giới hạn được đặt lại."

msgid "Resent from log"
msgstr "Đã gửi lại từ nhật ký"

msgid "Reset filters"
msgstr "Đặt lại bộ lọc"

msgid "Result"
msgstr "Kết quả"

msgid "Result from the cache – use \"Check again\" after changing DNS records."
msgstr "Kết quả từ bộ nhớ đệm – hãy dùng “Kiểm tra lại” sau khi thay đổi bản ghi DNS."

msgid "Retention"
msgstr "Thời gian lưu giữ"

msgid "Retention in the log"
msgstr "Thời gian lưu giữ trong nhật ký"

msgid "Retention of this email type saved. It applies with the next daily cleanup."
msgstr "Đã lưu thời gian lưu giữ của loại email này. Thiết lập có hiệu lực từ lần dọn dẹp hằng ngày tiếp theo."

msgid "Review held emails"
msgstr "Xem lại email bị giữ lại"

msgid "Review the notes of this email (links, sender, placeholders)."
msgstr "Xem lại các ghi chú của email này (liên kết, người gửi, biến giữ chỗ)."

msgid "Revoke the key in the service's dashboard and create a new one. Then find out why it ended up in an email (debug or error reports, a form that echoes settings) and stop that."
msgstr "Thu hồi khóa trong bảng điều khiển của dịch vụ và tạo khóa mới. Sau đó tìm hiểu vì sao nó lọt vào email (báo cáo gỡ lỗi hoặc báo lỗi, một biểu mẫu hiển thị lại cài đặt) và ngăn chặn điều đó."

msgid "Revoked keys (empty p=): %s."
msgstr "Khóa đã thu hồi (p= trống): %s."

msgid "Rhythm"
msgstr "Nhịp gửi"

msgid "Run a search & replace of the old domain in the database and check hard-coded URLs in email templates and plugin settings."
msgstr "Chạy tìm kiếm & thay thế tên miền cũ trong cơ sở dữ liệu và kiểm tra các URL được gán cứng trong mẫu email và cài đặt plugin."

msgid "Run the full sender check"
msgstr "Chạy kiểm tra người gửi đầy đủ"

msgid "SMTP AUTH is disabled in Microsoft 365"
msgstr "SMTP AUTH đang bị tắt trong Microsoft 365"

msgid "SMTP host"
msgstr "Máy chủ SMTP"

msgid "SMTP login failed"
msgstr "Đăng nhập SMTP thất bại"

msgid "SMTP transcript"
msgstr "Bản ghi SMTP"

msgid "SPF record allows every server in the world to send for this domain (+all)."
msgstr "Bản ghi SPF cho phép mọi máy chủ trên thế giới gửi thay cho tên miền này (+all)."

msgid "SPF record ends with ?all (neutral): it does not protect the domain against spoofing."
msgstr "Bản ghi SPF kết thúc bằng ?all (trung lập): nó không bảo vệ tên miền khỏi bị giả mạo."

msgid "SPF record found (redirect= to another policy)."
msgstr "Đã tìm thấy bản ghi SPF (redirect= đến một chính sách khác)."

msgid "SPF record found. Other servers are marked as suspicious (~all, softfail)."
msgstr "Đã tìm thấy bản ghi SPF. Các máy chủ khác bị đánh dấu là đáng ngờ (~all, softfail)."

msgid "SPF record found. Other servers are rejected (-all)."
msgstr "Đã tìm thấy bản ghi SPF. Các máy chủ khác bị từ chối (-all)."

msgid "SPF record has no \"all\" term, so mail from other servers is treated as neutral."
msgstr "Bản ghi SPF không có phần “all”, nên email từ các máy chủ khác được coi là trung lập."

msgid "Saturday"
msgstr "Thứ Bảy"

msgid "Save"
msgstr "Lưu"

msgid "Saved – leave empty to keep it"
msgstr "Đã lưu – để trống để giữ nguyên"

msgid "Scheduled for later today:"
msgstr "Đã lên lịch cho cuối ngày hôm nay:"

msgid "Search recipient or subject"
msgstr "Tìm người nhận hoặc tiêu đề"

msgid "Search recipient or subject …"
msgstr "Tìm người nhận hoặc tiêu đề …"

msgid "Search the email template, plugin settings and database for the old address (e.g. after migrating the site) and replace it with the live domain."
msgstr "Tìm địa chỉ cũ trong mẫu email, cài đặt plugin và cơ sở dữ liệu (ví dụ sau khi chuyển trang web) và thay bằng tên miền đang chạy thật."

msgid "See why"
msgstr "Xem lý do"

msgid "Seen"
msgstr "Đã xem"

msgid "Select all"
msgstr "Chọn tất cả"

msgid "Selector \"%s\" has no key either."
msgstr "Selector “%s” cũng không có khóa."

msgid "Send"
msgstr "Gửi"

msgid "Send a link where the user sets a password instead – WordPress core's new-user email does exactly that. Look for an option such as \"Send password by email\" or \"Include password\" in the plugin that sent this email and turn it off."
msgstr "Thay vào đó, hãy gửi liên kết để người dùng tự đặt mật khẩu – email người dùng mới của WordPress làm đúng như vậy. Tìm tùy chọn như “Gửi mật khẩu qua email” hoặc “Kèm mật khẩu” trong plugin đã gửi email này và tắt nó đi."

msgid "Send a message when the problem is resolved"
msgstr "Gửi tin nhắn khi sự cố đã được khắc phục"

msgid "Send a test email from the mailer plugin's settings."
msgstr "Gửi email thử từ phần cài đặt của plugin gửi thư."

msgid "Send a weekly email report to the addresses above"
msgstr "Gửi báo cáo email hằng tuần đến các địa chỉ ở trên"

msgid "Send again"
msgstr "Gửi lại"

msgid "Send alerts by email to"
msgstr "Gửi cảnh báo qua email đến"

msgid "Send all %s held emails to their original recipients now?"
msgstr "Gửi ngay tất cả %s email bị giữ lại đến người nhận gốc?"

msgid "Send large files as a download link instead of an attachment."
msgstr "Gửi tệp lớn dưới dạng liên kết tải xuống thay vì tệp đính kèm."

msgid "Send latest to me"
msgstr "Gửi email mới nhất cho tôi"

msgid "Send newsletters with a newsletter plugin or service that adds List-Unsubscribe and List-Unsubscribe-Post headers, and do not send to many people in one email via Bcc."
msgstr "Gửi bản tin bằng plugin hoặc dịch vụ bản tin có thêm header List-Unsubscribe và List-Unsubscribe-Post, và đừng gửi một email cho nhiều người qua Bcc."

msgid "Send now"
msgstr "Gửi ngay"

msgid "Send report now"
msgstr "Gửi báo cáo ngay"

msgid "Send such emails to each recipient individually or put the recipients in Bcc. For newsletters use a newsletter plugin that sends one email per recipient. If customers' addresses were disclosed, check with your data protection officer whether the incident has to be reported."
msgstr "Hãy gửi những email như vậy riêng cho từng người nhận hoặc đưa người nhận vào Bcc. Với bản tin, hãy dùng plugin bản tin gửi một email cho mỗi người nhận. Nếu địa chỉ của khách hàng đã bị lộ, hãy hỏi cán bộ bảo vệ dữ liệu xem sự cố có phải báo cáo không."

msgid "Send test alert"
msgstr "Gửi cảnh báo thử"

msgid "Send the email with the header \"Content-Type: text/html; charset=UTF-8\" or set the content type with the wp_mail_content_type filter. Many form and shop plugins have an \"HTML email\" option."
msgstr "Gửi email với header “Content-Type: text/html; charset=UTF-8” hoặc đặt loại nội dung bằng bộ lọc wp_mail_content_type. Nhiều plugin biểu mẫu và cửa hàng có tùy chọn “Email HTML”."

msgid "Send the latest email of this type to %s?"
msgstr "Gửi email mới nhất thuộc loại này đến %s?"

msgid "Send this email again to %s?"
msgstr "Gửi lại email này đến %s?"

msgid "Send this email to (up to 10 addresses, separated by commas):"
msgstr "Gửi email này đến (tối đa 10 địa chỉ, phân cách bằng dấu phẩy):"

msgid "Send this held email now to %s? Staging mode is bypassed for this one email."
msgstr "Gửi ngay email bị giữ lại này đến %s? Chế độ staging sẽ được bỏ qua cho riêng email này."

msgid "Send through a reputable SMTP service instead of the web server, especially on shared hosting."
msgstr "Gửi qua một dịch vụ SMTP uy tín thay vì máy chủ web, đặc biệt trên shared hosting."

msgid "Send to…"
msgstr "Gửi đến…"

msgid "Sender check (SPF, DKIM, DMARC)"
msgstr "Kiểm tra người gửi (SPF, DKIM, DMARC)"

msgid "Sender domain %1$s differs from the site (%2$s)"
msgstr "Tên miền người gửi %1$s khác với trang web (%2$s)"

msgid "Sender domain (SPF and DMARC)"
msgstr "Tên miền người gửi (SPF và DMARC)"

msgid "Sender domain or address not verified"
msgstr "Tên miền hoặc địa chỉ người gửi chưa được xác minh"

msgid "Sender of %s of the last 200 emails"
msgstr "Người gửi của %s trong 200 email gần nhất"

msgid "Sending failed – see the log."
msgstr "Gửi thất bại – xem nhật ký."

msgid "Sending failed – see the new log entry for details."
msgstr "Gửi thất bại – xem chi tiết trong mục nhật ký mới."

msgid "Sending in the background (a mailer plugin with a queue) lets the page finish without waiting."
msgstr "Gửi ở chế độ nền (một plugin gửi thư có hàng đợi) giúp trang tải xong mà không phải chờ."

msgid "Sending limit or quota reached"
msgstr "Đã đạt giới hạn gửi hoặc hạn mức"

msgid "Sending report …"
msgstr "Đang gửi báo cáo …"

msgid "Sending test alert …"
msgstr "Đang gửi cảnh báo thử …"

msgid "Sending works again: no more failure spike."
msgstr "Việc gửi đã hoạt động trở lại: không còn lỗi tăng đột biến."

msgid "Sending…"
msgstr "Đang gửi…"

msgid "Sent"
msgstr "Đã gửi"

msgid "Sent as a free mail address: %1$s"
msgstr "Được gửi bằng địa chỉ email miễn phí: %1$s"

msgid "Sent by"
msgstr "Được gửi bởi"

msgid "Sent by WP-Cron."
msgstr "Được gửi bởi WP-Cron."

msgid "Sent by the cron event %1$s – it is overdue by %2$s while WP-Cron runs other events; it may fail with an error."
msgstr "Được gửi bởi sự kiện cron %1$s – sự kiện đã trễ %2$s trong khi WP-Cron vẫn chạy các sự kiện khác; có thể nó đang bị lỗi."

msgid "Sent by the cron event %1$s – it is scheduled (next run in %2$s) and WP-Cron runs, so the event no longer sends this email."
msgstr "Được gửi bởi sự kiện cron %1$s – sự kiện đã được lên lịch (lần chạy tiếp theo sau %2$s) và WP-Cron đang chạy, nên sự kiện không còn gửi email này nữa."

msgid "Sent by the cron event %s – this event is no longer scheduled."
msgstr "Được gửi bởi sự kiện cron %s – sự kiện này không còn được lên lịch."

msgid "Sent by the cron event %s."
msgstr "Được gửi bởi sự kiện cron %s."

msgid "Sent repeatedly: %1$s more identical emails within %2$s minutes"
msgstr "Gửi lặp lại: thêm %1$s email giống hệt trong vòng %2$s phút"

msgid "Sent to %s."
msgstr "Đã gửi đến %s."

msgid "Sent to the same address around the order date, but not linked to this order (for example logged before the link existed, or imported)."
msgstr "Được gửi đến cùng địa chỉ vào khoảng ngày đặt hàng, nhưng không được liên kết với đơn hàng này (ví dụ được ghi nhật ký trước khi có liên kết, hoặc được nhập)."

msgid "Set a Reply-To address that someone reads, e.g. in WooCommerce → Settings → Emails or in the email settings of your form plugin. Or send from an address that can receive replies."
msgstr "Đặt địa chỉ Reply-To có người đọc, ví dụ trong WooCommerce → Cài đặt → Email hoặc trong cài đặt email của plugin biểu mẫu. Hoặc gửi từ một địa chỉ có thể nhận thư trả lời."

msgid "Set a sender address on your domain in your SMTP plugin or via the wp_mail_from filter."
msgstr "Đặt địa chỉ người gửi thuộc tên miền của bạn trong plugin SMTP hoặc qua bộ lọc wp_mail_from."

msgid "Set a sender address on your real domain, e.g. in your SMTP plugin or via the wp_mail_from filter, and check the site address under Settings → General."
msgstr "Đặt địa chỉ người gửi thuộc tên miền thật của bạn, ví dụ trong plugin SMTP hoặc qua bộ lọc wp_mail_from, và kiểm tra địa chỉ trang web trong Cài đặt → Tổng quan."

msgid "Set a subject in the template or form settings of the sending plugin."
msgstr "Đặt tiêu đề trong mẫu hoặc cài đặt biểu mẫu của plugin gửi thư."

msgid "Set the From address in your SMTP plugin to the mailbox you log in with and enable \"force From address\"."
msgstr "Đặt địa chỉ From trong plugin SMTP thành hộp thư bạn dùng để đăng nhập và bật “bắt buộc địa chỉ From”."

msgid "Set up staging mode"
msgstr "Thiết lập chế độ staging"

msgid "Settings"
msgstr "Cài đặt"

msgid "Settings › Discussion"
msgstr "Cài đặt › Thảo luận"

msgid "Several exclamation marks are typical of advertising spam. Spam filters may count this against the email, which can make delivery worse."
msgstr "Nhiều dấu chấm than là đặc trưng của spam quảng cáo. Bộ lọc spam có thể đánh giá thấp email vì điều này, làm việc chuyển phát kém đi."

msgid "Several of the latest emails of this type failed."
msgstr "Một số email gần nhất thuộc loại này bị lỗi."

msgid "Share of failed emails per day (per week for long periods)."
msgstr "Tỷ lệ email bị lỗi mỗi ngày (mỗi tuần đối với khoảng thời gian dài)."

msgid "Shop managers and above"
msgstr "Quản lý cửa hàng trở lên"

msgid "Shortened links hide where they lead. Spammers use them a lot, so spam filters may count them against the email, which can make delivery worse."
msgstr "Liên kết rút gọn che giấu nơi chúng dẫn đến. Kẻ gửi spam dùng chúng rất nhiều, nên bộ lọc spam có thể đánh giá thấp email, làm việc chuyển phát kém đi."

msgid "Show all email types"
msgstr "Hiển thị tất cả loại email"

msgid "Show all in Mail Log"
msgstr "Hiển thị tất cả trong Nhật ký email"

msgid "Show as"
msgstr "Hiển thị dạng"

msgid "Show data as table"
msgstr "Hiển thị dữ liệu dạng bảng"

msgid "Show email types"
msgstr "Hiển thị loại email"

msgid "Show emails"
msgstr "Hiển thị email"

msgid "Show emails for %s in the log"
msgstr "Hiển thị email cho %s trong nhật ký"

msgid "Show failed emails"
msgstr "Hiển thị email bị lỗi"

msgid "Show held emails"
msgstr "Hiển thị email bị giữ lại"

msgid "Show these emails in the log"
msgstr "Hiển thị các email này trong nhật ký"

msgid "Silence"
msgstr "Im lặng"

msgid "Simulated dark mode, using the dark-mode styles of the email itself. Every mail app handles dark mode a little differently."
msgstr "Chế độ tối mô phỏng, dùng các kiểu chế độ tối của chính email. Mỗi ứng dụng email xử lý chế độ tối hơi khác nhau."

msgid "Simulation of apps that force dark mode by inverting the colours. Images keep their colours; real apps differ in detail."
msgstr "Mô phỏng các ứng dụng ép chế độ tối bằng cách đảo ngược màu. Hình ảnh giữ nguyên màu; ứng dụng thực tế khác nhau ở chi tiết."

msgid "Since 2024 Gmail and Yahoo require a one-click unsubscribe (List-Unsubscribe header) for bulk mail. Without it newsletters are more likely to be rejected or filtered."
msgstr "Từ năm 2024, Gmail và Yahoo yêu cầu hủy đăng ký bằng một cú nhấp (header List-Unsubscribe) cho email hàng loạt. Nếu thiếu, bản tin dễ bị từ chối hoặc bị lọc hơn."

msgid "Single failures, e.g. because of a mistyped address, are normal."
msgstr "Lỗi đơn lẻ, ví dụ do gõ sai địa chỉ, là bình thường."

msgid "Some emails could not be sent recently"
msgstr "Gần đây một số email không thể gửi được"

msgid "Some lookups were skipped because DNS answered too slowly."
msgstr "Một số truy vấn đã bị bỏ qua vì DNS phản hồi quá chậm."

msgid "Sorry, you are not allowed to access this page."
msgstr "Xin lỗi, bạn không được phép truy cập trang này."

msgid "Sorry, you are not allowed to do that."
msgstr "Xin lỗi, bạn không được phép thực hiện thao tác này."

msgid "Sorry, you are not allowed to export the mail log."
msgstr "Xin lỗi, bạn không được phép xuất nhật ký email."

msgid "Source"
msgstr "Nguồn"

msgid "Staging"
msgstr "Staging"

msgid "Staging mode"
msgstr "Chế độ staging"

msgid "Staging mode is active: all emails are redirected to %s."
msgstr "Chế độ staging đang hoạt động: mọi email được chuyển hướng đến %s."

msgid "Staging mode is active: emails are logged but not delivered."
msgstr "Chế độ staging đang hoạt động: email được ghi nhật ký nhưng không được chuyển phát."

msgid "Staging mode is active: emails should be redirected, but no valid redirect address is set – all emails are held and not delivered."
msgstr "Chế độ staging đang hoạt động: email cần được chuyển hướng, nhưng chưa đặt địa chỉ chuyển hướng hợp lệ – mọi email bị giữ lại và không được chuyển phát."

msgid "Staging mode is off"
msgstr "Chế độ staging đang tắt"

msgid "Staging mode is on although this is a live site"
msgstr "Chế độ staging đang bật mặc dù đây là trang web đang chạy thật"

msgid "Staging mode is on for this staging site"
msgstr "Chế độ staging đang bật cho trang web staging này"

msgid "Staging mode is on: all emails go to your test addresses, not to the real recipients."
msgstr "Chế độ staging đang bật: mọi email được gửi đến địa chỉ thử nghiệm của bạn, không phải đến người nhận thật."

msgid "Staging mode is on: emails are logged but not sent."
msgstr "Chế độ staging đang bật: email được ghi nhật ký nhưng không được gửi."

msgid "Staging mode settings"
msgstr "Cài đặt chế độ staging"

msgid "Start with p=none to receive reports, then tighten to quarantine or reject once SPF and DKIM pass."
msgstr "Bắt đầu với p=none để nhận báo cáo, sau đó siết chặt thành quarantine hoặc reject khi SPF và DKIM đều đạt."

msgid "Statistics"
msgstr "Thống kê"

msgid "Status"
msgstr "Trạng thái"

msgid "Still sorting %s older emails into types in the background. Reload the page in a minute."
msgstr "Vẫn đang phân loại %s email cũ hơn ở chế độ nền. Hãy tải lại trang sau một phút."

msgid "Stop bundling (sends what waits now)"
msgstr "Ngừng gộp (gửi ngay các email đang chờ)"

msgid "Stop these emails"
msgstr "Chặn các email này"

msgid "Stopped"
msgstr "Đã ngừng gửi"

msgid "Stopped by Mailspur."
msgstr "Bị Mailspur chặn."

msgid "Stopped email types"
msgstr "Loại email đã ngừng gửi"

msgid "Store the exact raw MIME source of every email"
msgstr "Lưu chính xác mã nguồn MIME thô của mọi email"

msgid "Subject"
msgstr "Tiêu đề"

msgid "Subject mostly in capital letters"
msgstr "Tiêu đề chủ yếu viết hoa"

msgid "Subjects in capitals read like shouting and are common in spam. Spam filters may count this against the email, which can make delivery worse."
msgstr "Tiêu đề viết hoa đọc như đang la hét và rất phổ biến trong spam. Bộ lọc spam có thể đánh giá thấp email vì điều này, làm việc chuyển phát kém đi."

msgid "Subjects often contain names or order numbers."
msgstr "Tiêu đề thường chứa tên hoặc mã đơn hàng."

msgid "Suggested TXT record for %s"
msgstr "Bản ghi TXT đề xuất cho %s"

msgid "Sunday"
msgstr "Chủ Nhật"

msgid "Supported: %s."
msgstr "Được hỗ trợ: %s."

msgid "Switch it off under %1$s: “%2$s”."
msgstr "Tắt trong %1$s: “%2$s”."

msgid "Taken out of the daily digest and sent on its own."
msgstr "Đã được tách khỏi email tổng hợp hằng ngày và gửi riêng."

msgid "Temporary rejection – try again later"
msgstr "Bị từ chối tạm thời – hãy thử lại sau"

msgid "Test"
msgstr "Thử"

msgid "Test alert"
msgstr "Cảnh báo thử"

msgid "Text changes"
msgstr "Thay đổi văn bản"

msgid "Text version derived from the HTML. Whether the email also had its own plain-text version was not recorded."
msgstr "Phiên bản văn bản được tạo từ HTML. Không ghi nhận được liệu email có phiên bản văn bản thuần riêng hay không."

msgid "That is fine if your mail server is allowed to send for that domain. Otherwise SPF and DMARC fail and the email lands in spam."
msgstr "Điều này ổn nếu máy chủ thư của bạn được phép gửi thay cho tên miền đó. Nếu không, SPF và DMARC sẽ thất bại và email bị đưa vào spam."

msgid "That is right for a test copy, but on a live site customers receive no order confirmations, password resets or answers to their forms. Turn staging mode off if this is the live site."
msgstr "Điều này đúng với bản sao thử nghiệm, nhưng trên trang web đang chạy thật, khách hàng sẽ không nhận được xác nhận đơn hàng, email đặt lại mật khẩu hay phản hồi cho biểu mẫu của họ. Hãy tắt chế độ staging nếu đây là trang web đang chạy thật."

msgid "The API key was rejected"
msgstr "Khóa API đã bị từ chối"

msgid "The DNS lookup failed or timed out. Try the sender check again later."
msgstr "Truy vấn DNS thất bại hoặc hết thời gian chờ. Hãy chạy lại kiểm tra người gửi sau."

msgid "The HTML email contains images but hardly any text. Spam filters cannot read images and distrust such emails, which can make delivery worse. If the mail client blocks images, the reader sees an almost empty email."
msgstr "Email HTML có hình ảnh nhưng hầu như không có văn bản. Bộ lọc spam không đọc được hình ảnh và không tin những email như vậy, làm việc chuyển phát kém đi. Nếu trình đọc email chặn hình ảnh, người đọc sẽ thấy một email gần như trống."

msgid "The SMTP account may only send with its own address (or verified aliases). WordPress or a plugin used a different From address."
msgstr "Tài khoản SMTP chỉ được gửi bằng địa chỉ của chính nó (hoặc các bí danh đã xác minh). WordPress hoặc một plugin đã dùng địa chỉ From khác."

msgid "The SMTP server conversation was empty."
msgstr "Cuộc trao đổi với máy chủ SMTP trống."

msgid "The SMTP server could not be reached at all: wrong host name or port, the server is down, or the web host blocks outgoing mail ports."
msgstr "Hoàn toàn không kết nối được máy chủ SMTP: sai tên máy chủ hoặc cổng, máy chủ ngừng hoạt động, hoặc nhà cung cấp hosting chặn các cổng thư gửi đi."

msgid "The SMTP server refuses to relay"
msgstr "Máy chủ SMTP từ chối chuyển tiếp"

msgid "The SMTP server rejected the user name or password (reply code 535)."
msgstr "Máy chủ SMTP đã từ chối tên người dùng hoặc mật khẩu (mã phản hồi 535)."

msgid "The SMTP server requires a login or encryption"
msgstr "Máy chủ SMTP yêu cầu đăng nhập hoặc mã hóa"

msgid "The address seems invalid – check it for typos or ask for another one."
msgstr "Địa chỉ có vẻ không hợp lệ – hãy kiểm tra lỗi chính tả hoặc yêu cầu một địa chỉ khác."

msgid "The body contains HTML tags, but the email was sent as text/plain (the WordPress default). Recipients see the raw tags instead of formatted text."
msgstr "Nội dung có thẻ HTML, nhưng email được gửi dưới dạng text/plain (mặc định của WordPress). Người nhận thấy các thẻ thô thay vì văn bản đã định dạng."

msgid "The connection or the transfer took too long. Usually a firewall silently drops the connection, or host and port are wrong."
msgstr "Kết nối hoặc truyền tải mất quá nhiều thời gian. Thường là do tường lửa âm thầm ngắt kết nối, hoặc sai máy chủ và cổng."

msgid "The default sender address has no public domain, or this server cannot look up DNS records."
msgstr "Địa chỉ người gửi mặc định không có tên miền công khai, hoặc máy chủ này không thể truy vấn bản ghi DNS."

msgid "The domain has neither an MX nor an A record in DNS. Emails to it bounce. Usually the address is misspelled or the domain no longer exists."
msgstr "Tên miền không có bản ghi MX hay bản ghi A trong DNS. Email gửi đến sẽ bị trả về. Thường là địa chỉ bị viết sai hoặc tên miền không còn tồn tại."

msgid "The domain publishes a \"null MX\" record, which explicitly says that it receives no email. Every email to it bounces."
msgstr "Tên miền công bố bản ghi “null MX”, nói rõ rằng nó không nhận email. Mọi email gửi đến đều bị trả về."

msgid "The email API answers slowly: check the region or endpoint configured in your mailer plugin."
msgstr "API email phản hồi chậm: hãy kiểm tra khu vực hoặc endpoint được cấu hình trong plugin gửi thư."

msgid "The email comes from a no-reply address and has no Reply-To header. When a customer clicks \"Reply\", the answer goes to an address nobody reads, or it bounces."
msgstr "Email được gửi từ địa chỉ no-reply và không có header Reply-To. Khi khách hàng nhấp “Trả lời”, thư trả lời sẽ đến một địa chỉ không ai đọc, hoặc bị trả về."

msgid "The email contains a password in readable form. Emails stay in inboxes, backups and forwarded threads for years – anyone who gets hold of one of them can log in. The email log stores it as well, unless \"Redact secrets\" is on (then the log keeps a masked copy, but the recipient still got the password)."
msgstr "Email chứa mật khẩu ở dạng đọc được. Email nằm trong hộp thư, bản sao lưu và chuỗi thư chuyển tiếp nhiều năm – bất kỳ ai có được một trong số đó đều có thể đăng nhập. Nhật ký email cũng lưu mật khẩu, trừ khi bật “Che thông tin bí mật” (khi đó nhật ký giữ bản đã che, nhưng người nhận vẫn đã nhận được mật khẩu)."

msgid "The email contains an access key (e.g. for Stripe, GitHub, Slack, AWS, Google or SendGrid) or a private key. Whoever reads the email – now or years later in an inbox or backup – can use it. The email log stores it as well, unless \"Redact secrets\" is on."
msgstr "Email chứa khóa truy cập (ví dụ cho Stripe, GitHub, Slack, AWS, Google hoặc SendGrid) hoặc khóa riêng tư. Bất kỳ ai đọc email – bây giờ hoặc nhiều năm sau trong hộp thư hay bản sao lưu – đều có thể dùng nó. Nhật ký email cũng lưu khóa này, trừ khi bật “Che thông tin bí mật”."

msgid "The email contains template variables that were not filled in. Recipients see them literally."
msgstr "Email chứa các biến mẫu chưa được điền. Người nhận thấy nguyên văn các biến đó."

msgid "The email contains what looks like a full payment card number (it passes the check-digit test). Card numbers must never be sent by email (PCI DSS): inboxes keep them for years. The email log stores it as well, unless \"Redact secrets\" is on."
msgstr "Email có vẻ chứa số thẻ thanh toán đầy đủ (vượt qua kiểm tra chữ số kiểm tra). Không bao giờ được gửi số thẻ qua email (PCI DSS): hộp thư lưu giữ chúng nhiều năm. Nhật ký email cũng lưu số thẻ, trừ khi bật “Che thông tin bí mật”."

msgid "The email is too large"
msgstr "Email quá lớn"

msgid "The email links to WordPress files on a related host. This typically happens on a staging copy that still contains URLs of the live site – or the other way round."
msgstr "Email liên kết đến các tệp WordPress trên một máy chủ liên quan. Điều này thường xảy ra trên bản sao staging vẫn còn chứa URL của trang web đang chạy thật – hoặc ngược lại."

msgid "The email links to an address on this site that answers \"page not found\" (404). This typically happens after a page or product was renamed or deleted: the template still points to the old address and every recipient lands on an error page."
msgstr "Email liên kết đến một địa chỉ trên trang web này trả về “không tìm thấy trang” (404). Điều này thường xảy ra sau khi một trang hoặc sản phẩm bị đổi tên hay bị xóa: mẫu vẫn trỏ đến địa chỉ cũ và mọi người nhận đều gặp trang lỗi."

msgid "The email types are being rebuilt from the log."
msgstr "Loại email đang được dựng lại từ nhật ký."

msgid "The email went to several people outside your domain in To or Cc. Every recipient sees all other addresses. With customers or members this discloses personal data to strangers – under the GDPR usually a data breach."
msgstr "Email đã được gửi đến nhiều người ngoài tên miền của bạn trong To hoặc Cc. Mỗi người nhận đều thấy tất cả địa chỉ còn lại. Với khách hàng hoặc thành viên, điều này làm lộ dữ liệu cá nhân cho người lạ – theo GDPR thường là một vi phạm dữ liệu."

msgid "The email “%1$s” to %2$s from %3$s at %4$s was briefly held back by a safety check on our side and sent afterwards. Please also check your spam folder."
msgstr "Email “%1$s” gửi đến %2$s vào %3$s lúc %4$s đã bị một bước kiểm tra an toàn phía chúng tôi tạm giữ trong thời gian ngắn và sau đó đã được gửi. Quý khách vui lòng kiểm tra cả thư mục spam."

msgid "The email “%1$s” to %2$s from %3$s at %4$s was held back by a safety check on our side and has not been sent. We will send it again."
msgstr "Email “%1$s” gửi đến %2$s vào %3$s lúc %4$s đã bị một bước kiểm tra an toàn phía chúng tôi giữ lại và chưa được gửi. Chúng tôi sẽ gửi lại cho Quý khách."

msgid "The email “%1$s” to %2$s from %3$s at %4$s was not sent because sending emails was paused on our side at that time. We will send it again."
msgstr "Email “%1$s” gửi đến %2$s vào %3$s lúc %4$s chưa được gửi vì khi đó việc gửi email phía chúng tôi đang tạm dừng. Chúng tôi sẽ gửi lại cho Quý khách."

msgid "The email “%1$s” to %2$s on %3$s at %4$s could not be delivered. We will send it again."
msgstr "Email “%1$s” gửi đến %2$s vào %3$s lúc %4$s không thể chuyển phát. Chúng tôi sẽ gửi lại cho Quý khách."

msgid "The email “%1$s” to %2$s was created on %3$s at %4$s, but we cannot confirm whether it was delivered. We will check this and send it again if needed."
msgstr "Email “%1$s” gửi đến %2$s đã được tạo vào %3$s lúc %4$s, nhưng chúng tôi không thể xác nhận email đã được chuyển phát hay chưa. Chúng tôi sẽ kiểm tra và gửi lại nếu cần."

msgid "The email “%1$s” was sent to %2$s on %3$s at %4$s and accepted by the mail server. Please also check your spam folder."
msgstr "Email “%1$s” đã được gửi đến %2$s vào %3$s lúc %4$s và đã được máy chủ thư chấp nhận. Quý khách vui lòng kiểm tra cả thư mục spam."

msgid "The emergency brake holds outgoing emails until you release or discard them."
msgstr "Phanh khẩn cấp giữ lại email gửi đi cho đến khi bạn cho gửi hoặc hủy chúng."

msgid "The emergency brake is holding emails"
msgstr "Phanh khẩn cấp đang giữ lại email"

msgid "The emergency brake is not holding any emails"
msgstr "Phanh khẩn cấp không giữ lại email nào"

msgid "The emergency brake is on: your site suddenly sent far more emails than usual."
msgstr "Phanh khẩn cấp đang bật: trang web của bạn đột nhiên gửi nhiều email hơn bình thường rất nhiều."

msgid "The emergency brake noticed an unusual number of emails within one hour. A contact form may be abused. Emails are still being sent."
msgstr "Phanh khẩn cấp phát hiện số email bất thường trong vòng một giờ. Có thể một biểu mẫu liên hệ đang bị lạm dụng. Email vẫn đang được gửi."

msgid "The exact raw source is stored – \"Download .eml\" returns it unchanged (not redacted)."
msgstr "Mã nguồn thô chính xác đã được lưu – “Tải xuống .eml” trả về nguyên trạng (không che)."

msgid "The last %s emails all failed. Sending from this site may be broken, e.g. because of a wrong SMTP login or a mail service that refuses the site. Customers may not receive order confirmations or password resets."
msgstr "%s email gần nhất đều bị lỗi. Việc gửi email từ trang web này có thể đang hỏng, ví dụ do sai thông tin đăng nhập SMTP hoặc dịch vụ email từ chối trang web. Khách hàng có thể không nhận được xác nhận đơn hàng hay email đặt lại mật khẩu."

msgid "The latest emails could not be sent"
msgstr "Các email gần nhất không thể gửi được"

msgid "The log keeps emails for %s day."
msgid_plural "The log keeps emails for %s days."
msgstr[0] "Nhật ký lưu email trong %s ngày."

msgid "The log shows the reason for each failed email."
msgstr "Nhật ký hiển thị lý do cho từng email bị lỗi."

msgid "The mail log requires JavaScript."
msgstr "Nhật ký email cần JavaScript."

msgid "The mail server did not answer in time"
msgstr "Máy chủ thư không phản hồi kịp thời"

msgid "The mail server is temporarily unavailable"
msgstr "Máy chủ thư tạm thời không khả dụng"

msgid "The mail server rejected the size of the email (reply code 552). Attachments grow by about a third when encoded."
msgstr "Máy chủ thư đã từ chối kích thước email (mã phản hồi 552). Tệp đính kèm tăng khoảng một phần ba kích thước khi được mã hóa."

msgid "The mail service only sends from domains or addresses you have verified there."
msgstr "Dịch vụ email chỉ gửi từ các tên miền hoặc địa chỉ bạn đã xác minh tại đó."

msgid "The mail service or mailbox refused further emails because a rate limit, daily quota or plan limit was hit."
msgstr "Dịch vụ email hoặc hộp thư đã từ chối thêm email vì đã chạm giới hạn tốc độ, hạn mức hằng ngày hoặc giới hạn của gói."

msgid "The mail service refused the request because the API key is wrong, expired, revoked or lacks the permission to send."
msgstr "Dịch vụ email đã từ chối yêu cầu vì khóa API sai, hết hạn, đã bị thu hồi hoặc không có quyền gửi."

msgid "The mailer plugin reported a failure"
msgstr "Plugin gửi thư đã báo lỗi"

msgid "The policy only applies to %s%% of the mail (pct)."
msgstr "Chính sách chỉ áp dụng cho %s%% số email (pct)."

msgid "The reason: %s."
msgstr "Lý do: %s."

msgid "The receiving server asked to retry later (reply code 450/451/452): greylisting, a full mailbox or too many emails in a short time."
msgstr "Máy chủ nhận yêu cầu thử lại sau (mã phản hồi 450/451/452): greylisting, hộp thư đầy hoặc quá nhiều email trong thời gian ngắn."

msgid "The receiving server could not confirm that your server may send for the sender domain."
msgstr "Máy chủ nhận không thể xác nhận rằng máy chủ của bạn được phép gửi thay cho tên miền người gửi."

msgid "The receiving server does not know this mailbox (reply code 550 / 5.1.1) – the address is misspelled or no longer exists."
msgstr "Máy chủ nhận không biết hộp thư này (mã phản hồi 550 / 5.1.1) – địa chỉ bị viết sai hoặc không còn tồn tại."

msgid "The receiving server may still accept it on a later try."
msgstr "Máy chủ nhận vẫn có thể chấp nhận ở lần thử sau."

msgid "The receiving server rejected the email because of its content or because the sending server's IP address is on a blocklist."
msgstr "Máy chủ nhận đã từ chối email vì nội dung hoặc vì địa chỉ IP của máy chủ gửi nằm trong danh sách chặn."

msgid "The recipient address was rejected"
msgstr "Địa chỉ người nhận đã bị từ chối"

msgid "The recipient domain accepts no email (null MX)"
msgstr "Tên miền người nhận không nhận email (null MX)"

msgid "The recipient domain has no mail server"
msgstr "Tên miền người nhận không có máy chủ thư"

msgid "The recipient domain looks like a misspelling of a popular email provider. Such emails bounce – or reach a stranger who registered the typo domain."
msgstr "Tên miền người nhận có vẻ là lỗi chính tả của một nhà cung cấp email phổ biến. Những email như vậy sẽ bị trả về – hoặc đến tay người lạ đã đăng ký tên miền gõ sai đó."

msgid "The same subject went to the same recipients several times in a short time. Typical causes are double order confirmations, a form submitted twice, a cron job running in parallel or a loop in a plugin."
msgstr "Cùng một tiêu đề đã được gửi đến cùng người nhận nhiều lần trong thời gian ngắn. Nguyên nhân thường gặp là xác nhận đơn hàng bị trùng, biểu mẫu được gửi hai lần, cron job chạy song song hoặc vòng lặp trong một plugin."

msgid "The secure connection to the SMTP server could not be established: the certificate does not match the host name, has expired, or the server does not support the chosen encryption."
msgstr "Không thể thiết lập kết nối bảo mật đến máy chủ SMTP: chứng chỉ không khớp với tên máy chủ, đã hết hạn, hoặc máy chủ không hỗ trợ kiểu mã hóa đã chọn."

msgid "The sender address is not allowed"
msgstr "Địa chỉ người gửi không được phép"

msgid "The sender check found a problem with %s. Emails may land in spam."
msgstr "Kiểm tra người gửi phát hiện sự cố với %s. Email có thể bị đưa vào spam."

msgid "The sender domain %s has SPF and DMARC records"
msgstr "Tên miền người gửi %s có bản ghi SPF và DMARC"

msgid "The sender domain could not be checked"
msgstr "Không thể kiểm tra tên miền người gửi"

msgid "The sender has no public domain (e.g. wordpress@localhost). Most mail servers reject such emails or put them in spam."
msgstr "Người gửi không có tên miền công khai (ví dụ wordpress@localhost). Hầu hết máy chủ thư từ chối những email như vậy hoặc đưa chúng vào spam."

msgid "The server cannot send email with PHP mail()"
msgstr "Máy chủ không thể gửi email bằng PHP mail()"

msgid "The server closed the connection (reply code 421), e.g. because of maintenance, overload or too many connections from your server."
msgstr "Máy chủ đã đóng kết nối (mã phản hồi 421), ví dụ do bảo trì, quá tải hoặc quá nhiều kết nối từ máy chủ của bạn."

msgid "The server does not forward email for you, usually because you are not logged in or the sender address does not belong to the account."
msgstr "Máy chủ không chuyển tiếp email cho bạn, thường vì bạn chưa đăng nhập hoặc địa chỉ người gửi không thuộc tài khoản."

msgid "The server only accepts email after authentication or after switching to an encrypted connection (reply code 530)."
msgstr "Máy chủ chỉ chấp nhận email sau khi xác thực hoặc sau khi chuyển sang kết nối mã hóa (mã phản hồi 530)."

msgid "The server rejected the content"
msgstr "Máy chủ đã từ chối nội dung"

msgid "The server’s local mail program answers slowly: an SMTP or API mailer plugin hands emails to a provider instead."
msgstr "Chương trình gửi thư cục bộ của máy chủ phản hồi chậm: một plugin gửi thư qua SMTP hoặc API sẽ chuyển email cho nhà cung cấp thay thế."

msgid "The start date must not be after the end date."
msgstr "Ngày bắt đầu không được sau ngày kết thúc."

msgid "The statistics require JavaScript."
msgstr "Phần thống kê cần JavaScript."

msgid "The text is the same; only the layout changed. Compare the previews."
msgstr "Văn bản vẫn giống nhau; chỉ bố cục thay đổi. Hãy so sánh các bản xem trước."

msgid "The user name is usually the full email address. Watch for spaces copied along with the password."
msgstr "Tên người dùng thường là địa chỉ email đầy đủ. Hãy chú ý các khoảng trắng bị sao chép kèm mật khẩu."

msgid "The webhook URL was removed: only valid https URLs are allowed."
msgstr "URL webhook đã bị xóa: chỉ cho phép URL https hợp lệ."

msgid "The weekly report is enabled but has no recipient: enter an email address under “Send alerts by email to”."
msgstr "Báo cáo hằng tuần đã bật nhưng chưa có người nhận: hãy nhập địa chỉ email trong “Gửi cảnh báo qua email đến”."

msgid "These emails are sent again; their email type is monitored again."
msgstr "Các email này được gửi trở lại; loại email của chúng được giám sát lại."

msgid "These kinds of email have not been sent for longer than usual. A plugin update, a changed setting or a stuck scheduled task may be the reason."
msgstr "Những loại email này đã không được gửi lâu hơn bình thường. Nguyên nhân có thể là một bản cập nhật plugin, một cài đặt bị thay đổi hoặc một tác vụ theo lịch bị kẹt."

msgid "This email has its own plain-text version, but the log does not store it. Shown here: a text version derived from the HTML."
msgstr "Email này có phiên bản văn bản thuần riêng, nhưng nhật ký không lưu nó. Hiển thị ở đây: phiên bản văn bản được tạo từ HTML."

msgid "This email has no dark-mode styles of its own. Some apps show it unchanged, others recolour it – see Forced dark."
msgstr "Email này không có kiểu chế độ tối riêng. Một số ứng dụng hiển thị nguyên trạng, số khác đổi màu – xem “Ép chế độ tối”."

msgid "This email has no plain-text version – some clients and spam filters prefer one. Shown here: a text version derived from the HTML."
msgstr "Email này không có phiên bản văn bản thuần – một số trình đọc email và bộ lọc spam ưu tiên có nó. Hiển thị ở đây: phiên bản văn bản được tạo từ HTML."

msgid "This email type has no content change."
msgstr "Loại email này không có thay đổi nội dung."

msgid "This email type is ignored now: no status, no alerts."
msgstr "Loại email này giờ bị bỏ qua: không có trạng thái, không có cảnh báo."

msgid "This email type is monitored again."
msgstr "Loại email này được giám sát lại."

msgid "This entry was anonymised; its content can no longer be sent."
msgstr "Mục này đã được ẩn danh hóa; không thể gửi nội dung của nó nữa."

msgid "This import is already running in another tab."
msgstr "Việc nhập này đang chạy trong một tab khác."

msgid "This is a test alert. Your alert channels work."
msgstr "Đây là cảnh báo thử. Các kênh cảnh báo của bạn hoạt động tốt."

msgid "This production site sent a link to a local or test address. Recipients cannot open it."
msgstr "Trang web đang chạy thật này đã gửi liên kết đến một địa chỉ cục bộ hoặc thử nghiệm. Người nhận không thể mở nó."

msgid "This question requires JavaScript. You can search the log instead."
msgstr "Câu hỏi này cần JavaScript. Bạn có thể tìm kiếm trong nhật ký thay thế."

msgid "This site keeps a log of emails it sends (recipient, subject, content and delivery status) to verify delivery and troubleshoot problems. Log entries are deleted automatically after the configured retention period."
msgstr "Trang web này lưu nhật ký các email mà nó gửi (người nhận, tiêu đề, nội dung và trạng thái chuyển phát) để xác minh việc chuyển phát và khắc phục sự cố. Các mục nhật ký được tự động xóa sau thời gian lưu giữ đã cấu hình."

msgid "This site runs as a %s environment, and staging mode keeps its emails from reaching real people."
msgstr "Trang web này đang chạy dưới dạng môi trường %s, và chế độ staging ngăn email của nó đến tay người thật."

msgid "This site runs as a %s environment. Turn on staging mode so that no real customer gets an email from it."
msgstr "Trang web này đang chạy dưới dạng môi trường %s. Hãy bật chế độ staging để không khách hàng thật nào nhận được email từ đây."

msgid "Threshold (emails per hour)"
msgstr "Ngưỡng (email mỗi giờ)"

msgid "Thursday"
msgstr "Thứ Năm"

msgid "Timeline"
msgstr "Dòng thời gian"

msgid "To"
msgstr "Đến"

msgid "To date"
msgstr "Đến ngày"

msgid "To keep them but get only one email a day, choose “Bundle into one daily email” in the … menu of the type."
msgstr "Để giữ chúng nhưng chỉ nhận một email mỗi ngày, hãy chọn “Gộp vào một email mỗi ngày” trong menu … của loại email."

msgid "Top lists are based on the latest %s emails of this period."
msgstr "Các danh sách hàng đầu dựa trên %s email mới nhất của khoảng thời gian này."

msgid "Top recipient domains"
msgstr "Tên miền người nhận nhiều nhất"

msgid "Top recipients: %s"
msgstr "Người nhận nhiều nhất: %s"

msgid "Top sources"
msgstr "Nguồn nhiều nhất"

msgid "Top subjects"
msgstr "Tiêu đề nhiều nhất"

msgid "Total"
msgstr "Tổng"

msgid "Total: %s ms"
msgstr "Tổng: %s ms"

msgid "Trace"
msgstr "Dấu vết"

msgid "Transcript copied."
msgstr "Đã sao chép bản ghi."

msgid "Transport"
msgstr "Phương thức truyền"

msgid "Trigger"
msgstr "Kích hoạt"

msgid "Trigger a real password reset email for your own account? WordPress creates a new reset link for you, so earlier reset links stop working; your password stays the same. Only %s receives it."
msgstr "Kích hoạt một email đặt lại mật khẩu thật cho tài khoản của chính bạn? WordPress sẽ tạo liên kết đặt lại mới cho bạn, nên các liên kết đặt lại trước đó sẽ không còn hoạt động; mật khẩu của bạn vẫn giữ nguyên. Chỉ %s nhận được email này."

msgid "Trigger the new user notifications for your own account (the notice to the administrator and the login details)? WordPress creates a new password link for you, so earlier links stop working. No user is created; only %s receives them."
msgstr "Kích hoạt thông báo người dùng mới cho tài khoản của chính bạn (thông báo cho quản trị viên và thông tin đăng nhập)? WordPress sẽ tạo liên kết mật khẩu mới cho bạn, nên các liên kết trước đó sẽ không còn hoạt động. Không có người dùng nào được tạo; chỉ %s nhận được các email này."

msgid "Trigger to me"
msgstr "Kích hoạt gửi cho tôi"

msgid "Triggering…"
msgstr "Đang kích hoạt…"

msgid "Tuesday"
msgstr "Thứ Ba"

msgid "Type"
msgstr "Loại"

msgid "Types are updated hourly and whenever you open this page. Only counters, subject patterns and content fingerprints are stored (no recipients, no contents), and they follow the retention period of the log."
msgstr "Loại email được cập nhật mỗi giờ và mỗi khi bạn mở trang này. Chỉ lưu bộ đếm, mẫu tiêu đề và dấu vân tay nội dung (không có người nhận, không có nội dung), và chúng tuân theo thời gian lưu giữ của nhật ký."

msgid "Typo in recipient domain? %1$s → %2$s"
msgstr "Lỗi chính tả trong tên miền người nhận? %1$s → %2$s"

msgid "Umlauts or quotes appear as garbled characters such as \"Ã¤\" or \"â€™\". UTF-8 text was read as a different character set somewhere on the way – in a template, an import or the database."
msgstr "Ký tự có dấu hoặc dấu ngoặc kép hiển thị thành ký tự lỗi như “Ã¤” hoặc “â€™”. Văn bản UTF-8 đã bị đọc bằng một bảng mã khác ở đâu đó trên đường đi – trong mẫu, khi nhập hoặc trong cơ sở dữ liệu."

msgid "Unclear. “%1$s” to %2$s was handed over for sending %3$s, but Mailspur got no result back."
msgstr "Không rõ. “%1$s” gửi đến %2$s đã được chuyển đi để gửi %3$s, nhưng Mailspur không nhận được kết quả."

msgid "Under Tools"
msgstr "Trong Công cụ"

msgid "Uninstall"
msgstr "Gỡ cài đặt"

msgid "Unknown"
msgstr "Không rõ"

msgid "Unknown probe."
msgstr "Email thử không xác định."

msgid "Unknown: no delivery result was reported (replaced wp_mail() function?)."
msgstr "Không rõ: không có kết quả chuyển phát nào được báo về (hàm wp_mail() đã bị thay thế?)."

msgid "Unreplaced placeholders: %1$s"
msgstr "Biến giữ chỗ chưa được thay thế: %1$s"

msgid "Until the log limit"
msgstr "Đến giới hạn của nhật ký"

msgid "Up to 10 addresses, separated by commas. Cc and Bcc are removed and the subject shows the original recipients. Without a valid address, emails are held instead."
msgstr "Tối đa 10 địa chỉ, phân cách bằng dấu phẩy. Cc và Bcc bị loại bỏ và tiêu đề hiển thị người nhận gốc. Nếu không có địa chỉ hợp lệ, email sẽ bị giữ lại."

msgid "Up to 5 addresses, separated by commas. Alert emails appear in the log with the source “Mailspur alerts” and never trigger alerts themselves."
msgstr "Tối đa 5 địa chỉ, phân cách bằng dấu phẩy. Email cảnh báo xuất hiện trong nhật ký với nguồn “Cảnh báo Mailspur” và không bao giờ tự kích hoạt cảnh báo."

msgid "Update the link in the email template or in the settings of the plugin that sends this email, or add a redirect from the old address to the new page (e.g. with a redirection plugin)."
msgstr "Cập nhật liên kết trong mẫu email hoặc trong cài đặt của plugin gửi email này, hoặc thêm chuyển hướng từ địa chỉ cũ sang trang mới (ví dụ bằng một plugin chuyển hướng)."

msgid "Updated in between: %s"
msgstr "Đã cập nhật trong khoảng đó: %s"

msgid "Updated since the last one:"
msgstr "Đã cập nhật kể từ lần gần nhất:"

msgid "Updated since then: %s."
msgstr "Đã cập nhật kể từ đó: %s."

msgid "Use TLS on port 587 or SSL on port 465."
msgstr "Dùng TLS trên cổng 587 hoặc SSL trên cổng 465."

msgid "Use a descriptive link text (e.g. \"View order\") or show the address the link really leads to."
msgstr "Dùng văn bản liên kết có tính mô tả (ví dụ “Xem đơn hàng”) hoặc hiển thị địa chỉ mà liên kết thật sự dẫn đến."

msgid "Use a sender address on your own domain and put the free address in Reply-To. Only if you really send through that provider's own SMTP server with its login is this fine."
msgstr "Dùng địa chỉ người gửi thuộc tên miền của chính bạn và đặt địa chỉ miễn phí vào Reply-To. Chỉ khi bạn thật sự gửi qua máy chủ SMTP của chính nhà cung cấp đó với thông tin đăng nhập của nó thì mới ổn."

msgid "Use absolute URLs including https:// and the domain, e.g. with home_url() or wp_get_attachment_url() in the template."
msgstr "Dùng URL tuyệt đối gồm https:// và tên miền, ví dụ với home_url() hoặc wp_get_attachment_url() trong mẫu."

msgid "Use exactly the host name the certificate was issued for (e.g. the provider's smtp.… host instead of an IP or your own domain)."
msgstr "Dùng chính xác tên máy chủ mà chứng chỉ được cấp cho (ví dụ máy chủ smtp.… của nhà cung cấp thay vì IP hoặc tên miền của bạn)."

msgid "Use one exclamation mark at most."
msgstr "Dùng tối đa một dấu chấm than."

msgid "Use the arrow keys to move between cells."
msgstr "Dùng các phím mũi tên để di chuyển giữa các ô."

msgid "Use the arrow keys to move between values, Enter to open them in the log."
msgstr "Dùng các phím mũi tên để di chuyển giữa các giá trị, Enter để mở chúng trong nhật ký."

msgid "Use the mailbox address of the SMTP account as sender (From)."
msgstr "Dùng địa chỉ hộp thư của tài khoản SMTP làm người gửi (From)."

msgid "User"
msgstr "Người dùng"

msgid "User: %s"
msgstr "Người dùng: %s"

msgid "Username"
msgstr "Tên người dùng"

msgid "Uses the saved settings – save your changes first."
msgstr "Dùng cài đặt đã lưu – hãy lưu thay đổi của bạn trước."

msgid "Verify the sender domain at your mail service (add its DNS records) or use an already verified sender address."
msgstr "Xác minh tên miền người gửi tại dịch vụ email (thêm các bản ghi DNS của nó) hoặc dùng địa chỉ người gửi đã được xác minh."

msgid "Very likely. “%1$s” went out to %2$s %3$s."
msgstr "Rất có thể. “%1$s” đã được gửi đến %2$s %3$s."

msgid "Very long subject (%1$s characters)"
msgstr "Tiêu đề rất dài (%1$s ký tự)"

msgid "View"
msgstr "Xem"

msgid "View %s failed emails"
msgstr "Xem %s email bị lỗi"

msgid "WP-Cron"
msgstr "WP-Cron"

msgid "WP-Cron has not run for %s (DISABLE_WP_CRON is set – check your server cron job)."
msgstr "WP-Cron đã không chạy trong %s (DISABLE_WP_CRON đang được đặt – hãy kiểm tra cron job trên máy chủ)."

msgid "WP-Cron has not run for %s – it only runs when the site gets visits, or it fails with an error."
msgstr "WP-Cron đã không chạy trong %s – nó chỉ chạy khi trang web có lượt truy cập, hoặc nó đang bị lỗi."

msgid "WP-Cron runs normally."
msgstr "WP-Cron chạy bình thường."

msgid "Waiting for the daily digest – not sent on its own."
msgstr "Đang chờ email tổng hợp hằng ngày – không được gửi riêng."

msgid "Waits %s s for the mail server"
msgstr "Chờ máy chủ thư %s giây"

msgid "Warnings"
msgstr "Cảnh báo"

msgid "Webhook URL"
msgstr "URL webhook"

msgid "Webhook signing key"
msgstr "Khóa ký webhook"

msgid "Webhook: %s"
msgstr "Webhook: %s"

msgid "Wednesday"
msgstr "Thứ Tư"

msgid "Week"
msgstr "Tuần"

msgid "Week of %s"
msgstr "Tuần từ %s"

msgid "Weekday"
msgstr "Ngày trong tuần"

msgid "Weekly"
msgstr "Hằng tuần"

msgid "Weekly email report"
msgstr "Báo cáo email hằng tuần"

msgid "Weekly report"
msgstr "Báo cáo hằng tuần"

msgid "What to do"
msgstr "Cần làm gì"

msgid "When emails are sent"
msgstr "Thời điểm gửi email"

msgid "When far more emails than usual are sent, the emergency brake warns you and can hold further emails."
msgstr "Khi số email được gửi nhiều hơn bình thường rất nhiều, phanh khẩn cấp sẽ cảnh báo bạn và có thể giữ lại các email tiếp theo."

msgid "When off, tracking pixels cannot tell when you open an entry. You can still load remote content for a single email. Scripts and forms are always blocked."
msgstr "Khi tắt, pixel theo dõi không thể biết khi nào bạn mở một mục. Bạn vẫn có thể tải nội dung bên ngoài cho từng email. Script và biểu mẫu luôn bị chặn."

msgid "Who can view the log"
msgstr "Ai có thể xem nhật ký"

msgid "Why did an email fail?"
msgstr "Tại sao email bị lỗi?"

msgid "With attachments"
msgstr "Có tệp đính kèm"

msgid "With notes"
msgstr "Có ghi chú"

msgid "Without these DNS records, mailbox providers cannot verify that your site may send emails for this domain, so emails are more likely to land in spam. The sender check suggests records you can add at your domain provider."
msgstr "Nếu thiếu các bản ghi DNS này, nhà cung cấp hộp thư không thể xác minh rằng trang web của bạn được phép gửi email thay cho tên miền này, nên email dễ bị đưa vào spam hơn. Kiểm tra người gửi sẽ đề xuất các bản ghi bạn có thể thêm tại nhà cung cấp tên miền."

msgid "WooCommerce email"
msgstr "Email WooCommerce"

msgid "WooCommerce › Settings › Emails"
msgstr "WooCommerce › Cài đặt › Email"

msgid "WordPress"
msgstr "WordPress"

msgid "WordPress core emails have no editor; they can be changed with filters."
msgstr "Email của lõi WordPress không có trình chỉnh sửa; có thể thay đổi chúng bằng bộ lọc."

msgid "WordPress did not send an email – a plugin may have turned this email off."
msgstr "WordPress đã không gửi email – có thể một plugin đã tắt email này."

msgid "WordPress has no setting for this email. Mailspur can stop the notice to administrators; the new user still receives their own email."
msgstr "WordPress không có cài đặt cho email này. Mailspur có thể chặn thông báo gửi quản trị viên; người dùng mới vẫn nhận được email của riêng họ."

msgid "WordPress has no setting for this email. Mailspur can stop the success notices of automatic updates; notices about failed updates still arrive."
msgstr "WordPress không có cài đặt cho email này. Mailspur có thể chặn thông báo thành công của các bản cập nhật tự động; thông báo về cập nhật thất bại vẫn được gửi."

msgid "WordPress sends via the PHP mail() function by default. On this server it is disabled or no mail program (sendmail) is installed – common on local setups, Docker and many managed hosts."
msgstr "Theo mặc định, WordPress gửi qua hàm PHP mail(). Trên máy chủ này, hàm đó bị tắt hoặc chưa cài chương trình gửi thư (sendmail) – thường gặp ở môi trường cục bộ, Docker và nhiều dịch vụ managed hosting."

msgid "Write the subject in normal upper and lower case and emphasize at most a single word."
msgstr "Viết tiêu đề với chữ hoa và chữ thường bình thường, chỉ nhấn mạnh tối đa một từ."

msgid "XML-RPC"
msgstr "XML-RPC"

msgid "Yes, but “%1$s” to %2$s (%3$s) was marked as spam by the recipient, says %4$s."
msgstr "Có, nhưng theo %4$s, người nhận đã đánh dấu “%1$s” gửi đến %2$s (%3$s) là spam."

msgid "Yes. “%1$s” went to %2$s %3$s and %4$s confirmed delivery."
msgstr "Có. “%1$s” đã được gửi đến %2$s %3$s và %4$s đã xác nhận chuyển phát."

msgid "You can still send it from the log (“Send now”)."
msgstr "Bạn vẫn có thể gửi email này từ nhật ký (“Gửi ngay”)."

msgid "You receive this digest because these email types are bundled into one daily email in Mailspur. Each email stays in the log."
msgstr "Bạn nhận được email tổng hợp này vì các loại email này được gộp vào một email mỗi ngày trong Mailspur. Mỗi email vẫn được giữ trong nhật ký."

msgid "You receive this email because monitoring alerts are enabled in the Mailspur settings of this site."
msgstr "Bạn nhận được email này vì cảnh báo giám sát đã được bật trong cài đặt Mailspur của trang web này."

msgid "You receive this email because the weekly report is enabled in the Mailspur settings of this site. It contains counts and subject patterns only – no email contents or recipients."
msgstr "Bạn nhận được email này vì báo cáo hằng tuần đã được bật trong cài đặt Mailspur của trang web này. Báo cáo chỉ chứa số liệu và mẫu tiêu đề – không có nội dung email hay người nhận."

msgid "Your DKIM selector (optional)"
msgstr "Selector DKIM của bạn (tùy chọn)"

msgid "Your site sent no emails in the last 7 days."
msgstr "Trang web của bạn không gửi email nào trong 7 ngày qua."

