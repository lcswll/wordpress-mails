msgstr "SPF-record gevonden (redirect= naar een ander beleid)."

msgid "SPF record found. Other servers are marked as suspicious (~all, softfail)."
msgstr "SPF-record gevonden. Andere servers worden als verdacht gemarkeerd (~all, softfail)."

msgid "SPF record found. Other servers are rejected (-all)."
msgstr "SPF-record gevonden. Andere servers worden geweigerd (-all)."

msgid "SPF record has no \"all\" term, so mail from other servers is treated as neutral."
msgstr "SPF-record heeft geen “all”-term, dus e-mail van andere servers wordt als neutraal behandeld."

msgid "Saturday"
msgstr "zaterdag"

msgid "Save"
msgstr "Opslaan"

