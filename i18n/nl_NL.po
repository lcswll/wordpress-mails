msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: nl_NL\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "“.eml downloaden” bouwt het bericht opnieuw op uit de gelogde, afgeschermde gegevens (zonder bijlagen)."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (vorige week: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (gepland voor %2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s e-mailtype is gestopt: %2$s."
msgstr[1] "%1$s e-mailtypes zijn gestopt, bijv. %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "%1$s e-mailtypes van %2$s afzenders"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "%1$s e-mails zijn mislukt in de afgelopen %2$s minuten."

msgid "%1$s emails in %2$s days"
msgstr "%1$s e-mails in %2$s dagen"

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "%1$s e-mails in de afgelopen 30 dagen, %2$s mislukt"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "Er zijn %1$s e-mails binnen één uur verzonden – veel meer dan normaal (drempel: %2$s per uur). Mogelijk wordt een contactformulier misbruikt of is de site gehackt."

msgid "%1$s entries, %2$s"
msgstr "%1$s items, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "%1$s geïmporteerd, %2$s duplicaten, %3$s te oud"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "%1$s van %2$s gebounced (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "%1$s van de %2$s e-mails in de afgelopen %3$s dagen konden niet worden verzonden."

msgid "%1$s of %2$s entries processed …"
msgstr "%1$s van %2$s items verwerkt …"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s procentpunt t.o.v. %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "%1$s verstuurde zijn eerste e-mail op %2$s en heeft in de afgelopen 24 uur naar %3$s verschillende externe adressen geschreven. Als je niets hebt geïnstalleerd of ingesteld dat zulke e-mails verstuurt, controleer dan de site: een nieuwe afzender kan een teken zijn dat de site gehackt is."

msgid "%1$s sent, %2$s still held …"
msgstr "%1$s verzonden, %2$s nog tegengehouden …"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s t.o.v. %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · %2$s e-mails gebundeld sinds de laatste samenvatting"

msgid "%1$s · as of %2$s"
msgstr "%1$s · per %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – foutpercentage %2$s %% (vorige week: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – gemeld door %2$s, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (must-use-plugin)"

msgid "%s (theme)"
msgstr "%s (thema)"

msgid "%s ago"
msgstr "%s geleden"

msgid "%s days"
msgstr "%s dagen"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "%s e-mail is de afgelopen 7 dagen mislukt."
msgstr[1] "%s e-mails zijn de afgelopen 7 dagen mislukt."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s e-mail wacht op je beslissing."
msgstr[1] "%s e-mails wachten op je beslissing."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "%s e-mail is de afgelopen 7 dagen tegengehouden en niet verzonden."
msgstr[1] "%s e-mails zijn de afgelopen 7 dagen tegengehouden en niet verzonden."

msgid "%s emails are held by the emergency brake."
msgstr "%s e-mails worden door de noodrem tegengehouden."

msgid "%s emails are waiting and have not been delivered."
msgstr "%s e-mails wachten en zijn niet afgeleverd."

msgid "%s entries"
msgstr "%s items"

msgid "%s failed"
msgstr "%s mislukt"

msgid "%s held emails discarded."
msgstr "%s tegengehouden e-mails verworpen."

msgid "%s imported entries removed."
msgstr "%s geïmporteerde items verwijderd."

msgid "%s in 30 days"
msgstr "%s in 30 dagen"

msgid "%s marked as spam"
msgstr "%s als spam gemarkeerd"

msgid "%s more on the Email types page."
msgstr "Nog %s op de pagina E-mailtypes."

msgid "%s notes"
msgstr "%s opmerkingen"

msgid "%s of all emails"
msgstr "%s van alle e-mails"

msgid "%s of them in the last 24 hours."
msgstr "Daarvan %s in de afgelopen 24 uur."

msgid "%s s"
msgstr "%s s"

msgid "%s selected"
msgstr "%s geselecteerd"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s punt vraagt aandacht:"
msgstr[1] "%s punten vragen aandacht:"

msgid "%s to administrators in 30 days"
msgstr "%s aan beheerders in 30 dagen"

msgid "%s unchanged lines"
msgstr "%s ongewijzigde regels"

msgid "(no subject)"
msgstr "(geen onderwerp)"

msgid "(no text content)"
msgstr "(geen tekstinhoud)"

msgid "(the emails are no longer in the log)"
msgstr "(de e-mails staan niet meer in het logboek)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "-all is strenger; ~all is gebruikelijk en prima in combinatie met DMARC."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "0 bewaart items voor altijd. Het opschonen gebeurt één keer per dag."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "0 betekent geen limiet. De oudste items worden eerst verwijderd."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "0 schakelt het uit. Verwijdert inhoud, headers en bijlagen van oudere items en maskeert de adressen (a***@example.com). Datum, status, bron, formaat, grootte en opmerkingen blijven bewaard voor de statistieken. Wordt uitgevoerd met de dagelijkse opschoning, voordat items worden verwijderd – heeft dus alleen effect als de periode korter is dan de bewaartermijn hierboven."

msgid "12 months"
msgstr "12 maanden"

msgid "30 days"
msgstr "30 dagen"

msgid "7 days"
msgstr "7 dagen"

msgid "90 days"
msgstr "90 dagen"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "Een DKIM-selector mag alleen letters, cijfers, punten, koppeltekens en underscores bevatten."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "Een mailerplugin die via een API verstuurt, heeft de aflevering overgenomen en gemeld dat het verzenden is mislukt, zonder een reden door te geven."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "Een gepubliceerde sleutel bewijst niet dat je e-mails ermee ondertekend worden – controleer het DKIM-resultaat in de headers van een ontvangen e-mail."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "Een ontvanger of het afzenderadres is geen geldig e-mailadres, daarom weigerde PHPMailer te verzenden."

msgid "API key or private key in plain text: %1$s"
msgstr "API-sleutel of privésleutel in platte tekst: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "Er zijn ongeveer %1$s DNS-opvragingen nodig om dit record te evalueren – meer dan de toegestane %2$s, dus ontvangers kunnen het negeren (PermError). Verwijder ongebruikte include:-vermeldingen."

msgid "Access"
msgstr "Toegang"

msgid "Actions"
msgstr "Acties"

msgid "Active: alerts on %s."
msgstr "Actief: meldingen bij %s."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "Voeg aan elke afbeelding in de sjabloon een kort alt-attribuut toe, bijv. alt=\"Logo Voorbeeldwinkel\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "Voeg de include: van je mailprovider toe (bijv. include:_spf.google.com) als je via een provider verstuurt."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "Voeg je mailserver of maildienst toe aan het SPF-record van het afzenderdomein."

msgid "Added:"
msgstr "Toegevoegd:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "Adressen met minstens %s harde fouten: de ontvangende server weigerde de mailbox, het domein heeft geen mailserver of je e-mailprovider meldde een hard bounce. Items verlopen met de bewaartermijn van het logboek."

msgid "Admin screen"
msgstr "Beheerscherm"

msgid "Administrators"
msgstr "Beheerders"

msgid "Aggregate reports go to %s."
msgstr "Geaggregeerde rapporten gaan naar %s."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "Melding"

msgid "Alert and hold further emails"
msgstr "Melden en verdere e-mails tegenhouden"

msgid "Alert only"
msgstr "Alleen melden"

msgid "Alert when an email type that is sent regularly stops"
msgstr "Melden als een regelmatig verzonden e-mailtype stopt"

msgid "Alert when emails fail repeatedly"
msgstr "Melden als e-mails herhaaldelijk mislukken"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "Melden als de site onverwacht stopt met het verzenden van e-mails"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "Meldingen zijn ingeschakeld, maar hebben geen kanaal: voer een e-mailadres of een webhook-URL in."

msgid "Alerts are off."
msgstr "Meldingen zijn uitgeschakeld."

msgid "All"
msgstr "Alle"

msgid "All email types look healthy."
msgstr "Alle e-mailtypes zien er gezond uit."

msgid "All emails are redirected to test addresses."
msgstr "Alle e-mails worden omgeleid naar testadressen."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "Alle e-mails gaan naar testadressen in plaats van naar de echte ontvangers."

msgid "All sources"
msgstr "Alle bronnen"

msgid "Allow again"
msgstr "Weer toestaan"

msgid "Allowed again."
msgstr "Weer toegestaan."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "Meldt ook eenmalig wanneer een plugin of thema die nog nooit een e-mail heeft verzonden binnen een dag naar veel verschillende externe adressen schrijft – een mogelijk teken van een gehackte site. De eerste twee weken na installatie van Mailspur vormen de basislijn."

msgid "Also remove the subject when anonymising"
msgstr "Bij anonimiseren ook het onderwerp verwijderen"

msgid "Also search content"
msgstr "Ook inhoud doorzoeken"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "Of vraag je hostingprovider om mail() / sendmail voor deze site in te schakelen."

msgid "Always load remote images and fonts in the preview"
msgstr "Externe afbeeldingen en lettertypen altijd laden in het voorbeeld"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (via SNS)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "Een e-mailprovider met een HTTP-API in plaats van SMTP heeft minder round trips per e-mail nodig."

msgid "Anonymisation"
msgstr "Anonimisering"

msgid "Anonymise entries after"
msgstr "Items anonimiseren na"

msgid "Anonymised"
msgstr "Geanonimiseerd"

msgid "Any format"
msgstr "Elk formaat"

msgid "Any status"
msgstr "Elke status"

msgid "Apply"
msgstr "Toepassen"

msgid "Ask the recipient for a working address."
msgstr "Vraag de ontvanger om een werkend adres."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "Vraag je hostingprovider om de openssl-extensie in te schakelen (of schakel hem in bij de PHP-instellingen van je hostingpaneel)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "Vraag je hostingprovider om de CA-certificaten en OpenSSL van de server bij te werken."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "Vraag je hostingprovider of uitgaande SMTP-verbindingen worden geblokkeerd."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "Vraag je hostingprovider of uitgaande verbindingen naar die poort zijn toegestaan (firewall)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "Minstens %1$s mislukte e-mails binnen %2$s minuten"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "Maximaal één melding per type binnen deze tijd, ook als het probleem aanhoudt."

msgid "Attachments"
msgstr "Bijlagen"

msgid "Attachments no longer available: %s"
msgstr "Bijlagen niet meer beschikbaar: %s"

msgid "Authentication"
msgstr "Authenticatie"

msgid "Automatic TLS"
msgstr "Automatische TLS"

msgid "Average per day"
msgstr "Gemiddeld per dag"

msgid "Back to the email types"
msgstr "Terug naar de e-mailtypes"

msgid "Belongs to"
msgstr "Hoort bij"

msgid "Block again"
msgstr "Weer blokkeren"

msgid "Blocked as spam or by a blocklist"
msgstr "Geblokkeerd als spam of door een blokkeerlijst"

msgid "Bounced (permanent)"
msgstr "Gebounced (permanent)"

msgid "Bounced (temporary)"
msgstr "Gebounced (tijdelijk)"

msgid "Broken characters (encoding): %1$s"
msgstr "Kapotte tekens (codering): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "Massamail zonder afmeldheader (%1$s ontvangers)"

msgid "Bundle into one daily email"
msgstr "Bundelen in één dagelijkse e-mail"

msgid "Bundled into one daily email"
msgstr "Gebundeld in één dagelijkse e-mail"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "Bundelen staat uit. Wachtende e-mails zijn nu in één samenvatting verzonden."

msgid "Busiest day"
msgstr "Drukste dag"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "Annuleren"

msgid "Careful: emails to this address failed several times before."
msgstr "Let op: e-mails naar dit adres zijn al eerder meerdere keren mislukt."

msgid "Change in the email types"
msgstr "Wijziging in de e-mailtypes"

msgid "Change staging mode"
msgstr "Stagingmodus wijzigen"

msgid "Check"
msgstr "Controleren"

msgid "Check again"
msgstr "Opnieuw controleren"

msgid "Check emails"
msgstr "E-mails controleren"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "Controleer host en poort; probeer 587 (TLS) in plaats van 465 (SSL) of andersom."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "Controleer host, poort, versleuteling, gebruikersnaam en wachtwoord in je SMTP-plugin en stuur van daaruit een test-e-mail."

msgid "Check sender domains"
msgstr "Afzenderdomeinen controleren"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "Controleer of de versleuteling bij de poort past: TLS voor 587, SSL voor 465."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "Controleer of de sleutel bij de juiste regio / het juiste account hoort (bijv. EU- vs. US-endpoint)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "Controleer de SMTP-host en -poort: een verkeerde poort of een geblokkeerde verbinding eindigt vaak in een time-out voordat een alternatief werkt."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "Controleer de SPF-, DKIM- en DMARC-records van het afzenderdomein, of gebruik een afzenderadres op het domein waarvandaan je verstuurt."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "Controleer het adres op typfouten – of de e-mail is nooit door je site verzonden."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "Controleer het adres met de ontvanger en corrigeer het waar het is opgeslagen (gebruikersprofiel, bestelling, formulierinzending)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "Controleer het adres met de ontvanger en corrigeer het waar het is opgeslagen."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "Controleer de hostnaam en poort: 587 met STARTTLS (TLS) of 465 met SSL. Poort 25 wordt door de meeste hostingproviders geblokkeerd."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "Controleer de limieten en het huidige gebruik in je account bij de maildienst; upgrade zo nodig het abonnement."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "Controleer de ontvangeradressen van dit item op typfouten, spaties of ontbrekende delen."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
msgstr "Controleer het afzenderadres in je SMTP-plugin en het filter wp_mail_from."

msgid "Check the sending limits of your mail account and the notes of this email."
msgstr "Controleer de verzendlimieten van je mailaccount en de opmerkingen bij deze e-mail."

msgid "Check the server IP on a blocklist checker and request delisting."
msgstr "Controleer het IP-adres van de server met een blokkeerlijstcontrole en vraag om verwijdering."

msgid "Check the spelling of the placeholder in the template and whether the plugin supports it for this email type. Shortcodes are not processed in emails unless the sending plugin runs do_shortcode()."
msgstr "Controleer de spelling van de plaatshouder in de sjabloon en of de plugin hem voor dit e-mailtype ondersteunt. Shortcodes worden in e-mails niet verwerkt, tenzij de verzendende plugin do_shortcode() uitvoert."

msgid "Checked %s."
msgstr "Gecontroleerd %s."

msgid "Checked just now"
msgstr "Zojuist gecontroleerd"

msgid "Checking DNS records …"
msgstr "DNS-records controleren …"

msgid "Checks the DNS records of the domains your site sends from: the default sender address and the most frequent senders in the log. Missing or weak records are the most common reason why emails land in spam. Only your server's own DNS resolver is used; results are kept for one hour."
msgstr "Controleert de DNS-records van de domeinen waarvandaan je site verstuurt: het standaard afzenderadres en de meest voorkomende afzenders in het logboek. Ontbrekende of zwakke records zijn de meest voorkomende reden dat e-mails in de spam belanden. Alleen de eigen DNS-resolver van je server wordt gebruikt; resultaten worden een uur bewaard."

msgid "Choose a range of at most %s days."
msgstr "Kies een periode van maximaal %s dagen."

msgid "Clear selection"
msgstr "Selectie wissen"

msgid "Click a bar to open these emails in the log."
msgstr "Klik op een balk om deze e-mails in het logboek te openen."

msgid "Close"
msgstr "Sluiten"

msgid "Close (Esc)"
msgstr "Sluiten (Esc)"

msgid "Colour scheme"
msgstr "Kleurenschema"

msgid "Command line"
msgstr "Opdrachtregel"

msgid "Compare"
msgstr "Vergelijken"

msgid "Compare the sources of these entries. Check whether two plugins send the same notification, or whether a hook (e.g. order status change) fires more than once."
msgstr "Vergelijk de bronnen van deze items. Controleer of twee plugins dezelfde melding versturen, of dat een hook (bijv. wijziging van de bestelstatus) meer dan eens wordt uitgevoerd."

msgid "Component"
msgstr "Component"

msgid "Configure alerts"
msgstr "Meldingen instellen"

msgid "Content anonymised after %1$s days, %2$s"
msgstr "Inhoud geanonimiseerd na %1$s dagen, %2$s"

msgid "Content change marked as seen."
msgstr "Inhoudswijziging als gezien gemarkeerd."

msgid "Content changed"
msgstr "Inhoud gewijzigd"

msgid "Content changed on %1$s, after the %2$s update."
msgstr "Inhoud gewijzigd op %1$s, na de update van %2$s."

msgid "Content changed on %s."
msgstr "Inhoud gewijzigd op %s."

msgid "Content removed"
msgstr "Inhoud verwijderd"

msgid "Content removed after %s days"
msgstr "Inhoud verwijderd na %s dagen"

msgid "Content, headers and attachments were removed and the addresses masked by the anonymisation setting."
msgstr "Inhoud, headers en bijlagen zijn verwijderd en de adressen gemaskeerd door de anonimiseringsinstelling."

msgid "Copied"
msgstr "Gekopieerd"

msgid "Copied – paste it into your reply."
msgstr "Gekopieerd – plak het in je antwoord."

msgid "Copies a short sentence for answering the customer: when the email was sent to whom and whether it arrived – without technical details."
msgstr "Kopieert een korte zin om de klant te antwoorden: wanneer de e-mail naar wie is verzonden en of hij is aangekomen – zonder technische details."

msgid "Copies the existing log of another mail logging plugin into Mailspur, so old emails can be searched and previewed here. The other plugin and its data stay untouched; running the import again only adds new entries."
msgstr "Kopieert het bestaande logboek van een andere plugin voor e-maillogging naar Mailspur, zodat oude e-mails hier doorzocht en bekeken kunnen worden. De andere plugin en zijn gegevens blijven onaangetast; de import opnieuw uitvoeren voegt alleen nieuwe items toe."

msgid "Copy"
msgstr "Kopiëren"

msgid "Copy for support"
msgstr "Kopiëren voor support"

msgid "Copying is not possible in this browser. Select the text and copy it:"
msgstr "Kopiëren is in deze browser niet mogelijk. Selecteer de tekst en kopieer hem:"

msgid "Correct the address (e.g. in the user profile or order) and consider an email validation in your forms."
msgstr "Corrigeer het adres (bijv. in het gebruikersprofiel of de bestelling) en overweeg e-mailvalidatie in je formulieren."

msgid "Counted once per email."
msgstr "Eén keer per e-mail geteld."

msgid "Create a new API key with send permission at your mail service and enter it in the mailer plugin."
msgstr "Maak bij je maildienst een nieuwe API-sleutel met verzendrechten aan en voer die in de mailerplugin in."

msgid "Create a new webhook URL? The current URL stops working at once – paste the new URL into the webhook settings of your email provider."
msgstr "Een nieuwe webhook-URL aanmaken? De huidige URL werkt dan direct niet meer – plak de nieuwe URL in de webhookinstellingen van je e-mailprovider."

msgid "Create new URL"
msgstr "Nieuwe URL aanmaken"

msgid "Current page"
msgstr "Huidige pagina"

msgid "Current record"
msgstr "Huidig record"

msgid "Current size"
msgstr "Huidige grootte"

msgid "Custom"
msgstr "Aangepast"

msgid "DKIM key found (selector: %s)."
msgstr "DKIM-sleutel gevonden (selector: %s)."

msgid "DMARC record found with p=none: reports only, spoofed mail is still delivered."
msgstr "DMARC-record gevonden met p=none: alleen rapporten, vervalste e-mail wordt nog steeds afgeleverd."

msgid "DMARC record found with policy p=%s."
msgstr "DMARC-record gevonden met beleid p=%s."

msgid "DMARC record has no valid policy (p=none, quarantine or reject)."
msgstr "DMARC-record heeft geen geldig beleid (p=none, quarantine of reject)."

msgid "DNS lookup failed or timed out. Try again later."
msgstr "DNS-opvraging mislukt of verlopen. Probeer het later opnieuw."

msgid "DNS lookups are not available on this server (dns_get_record() is disabled), so the sender check cannot run here."
msgstr "DNS-opvragingen zijn niet beschikbaar op deze server (dns_get_record() is uitgeschakeld), dus de afzendercontrole kan hier niet worden uitgevoerd."

msgid "DNS lookups needed: about %1$s of %2$s allowed."
msgstr "Benodigde DNS-opvragingen: ongeveer %1$s van de toegestane %2$s."

msgid "Daily"
msgstr "Dagelijks"

msgid "Daily digest"
msgstr "Dagelijkse samenvatting"

msgid "Dark"
msgstr "Donker"

msgid "Date"
msgstr "Datum"

msgid "Default (%s days)"
msgstr "Standaard (%s dagen)"

