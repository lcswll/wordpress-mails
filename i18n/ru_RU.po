msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ru_RU\n"
"Plural-Forms: nplurals=3; plural=(n % 10 == 1 && n % 100 != 11) ? 0 : ((n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14)) ? 1 : 2);\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "«Скачать .eml» восстанавливает сообщение из записанных данных, очищенных от секретов (без вложений)."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (предыдущая неделя: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (запланировано на %2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s тип писем перестал отправляться: %2$s."
msgstr[1] "%1$s типа писем перестали отправляться, например: %2$s."
msgstr[2] "%1$s типов писем перестали отправляться, например: %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "Типов писем: %1$s, отправителей: %2$s"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "За последние %2$s мин. не удалось отправить писем: %1$s."

msgid "%1$s emails in %2$s days"
msgstr "Писем: %1$s за %2$s дн."

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "Писем за последние 30 дней: %1$s, с ошибкой: %2$s"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "За один час было отправлено писем: %1$s — гораздо больше, чем обычно (порог: %2$s в час). Возможно, злоумышленники используют контактную форму или сайт взломан."

msgid "%1$s entries, %2$s"
msgstr "Записей: %1$s, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "Импортировано: %1$s, дубликатов: %2$s, слишком старых: %3$s"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "Возвращено %1$s из %2$s (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "За последние %3$s дн. не удалось отправить %1$s из %2$s писем."

msgid "%1$s of %2$s entries processed …"
msgstr "Обработано записей: %1$s из %2$s…"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s п. п. по сравнению с %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "%1$s отправил первое письмо %2$s и за последние 24 часа написал на %3$s разных внешних адресов. Если вы не устанавливали и не настраивали ничего, что отправляет такие письма, проверьте сайт: новый отправитель может быть признаком взлома."

msgid "%1$s sent, %2$s still held …"
msgstr "Отправлено: %1$s, ещё задержано: %2$s…"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s по сравнению с %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · писем объединено с последней сводки: %2$s"

msgid "%1$s · as of %2$s"
msgstr "%1$s · по состоянию на %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – доля ошибок %2$s %% (предыдущая неделя: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s — сообщено %2$s, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (обязательный плагин)"

msgid "%s (theme)"
msgstr "%s (тема)"

msgid "%s ago"
msgstr "%s назад"

msgid "%s days"
msgstr "%s дн."

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "%s письмо не удалось отправить за последние 7 дней."
msgstr[1] "%s письма не удалось отправить за последние 7 дней."
msgstr[2] "%s писем не удалось отправить за последние 7 дней."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s письмо ожидает вашего решения."
msgstr[1] "%s письма ожидают вашего решения."
msgstr[2] "%s писем ожидают вашего решения."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "%s письмо было задержано и не отправлено за последние 7 дней."
msgstr[1] "%s письма были задержаны и не отправлены за последние 7 дней."
msgstr[2] "%s писем были задержаны и не отправлены за последние 7 дней."

msgid "%s emails are held by the emergency brake."
msgstr "Писем, задержанных аварийным тормозом: %s."

msgid "%s emails are waiting and have not been delivered."
msgstr "Писем, ожидающих и не доставленных: %s."

msgid "%s entries"
msgstr "Записей: %s"

msgid "%s failed"
msgstr "Ошибок: %s"

msgid "%s held emails discarded."
msgstr "Отклонено задержанных писем: %s."

msgid "%s imported entries removed."
msgstr "Удалено импортированных записей: %s."

msgid "%s in 30 days"
msgstr "%s за 30 дней"

msgid "%s marked as spam"
msgstr "Отмечено как спам: %s"

msgid "%s more on the Email types page."
msgstr "Ещё %s — на странице «Типы писем»."

msgid "%s notes"
msgstr "Заметки: %s"

msgid "%s of all emails"
msgstr "%s от всех писем"

msgid "%s of them in the last 24 hours."
msgstr "Из них за последние 24 часа: %s."

msgid "%s s"
msgstr "%s с"

msgid "%s selected"
msgstr "Выбрано: %s"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s пункт требует внимания:"
msgstr[1] "%s пункта требуют внимания:"
msgstr[2] "%s пунктов требуют внимания:"

msgid "%s to administrators in 30 days"
msgstr "Администраторам за 30 дней: %s"

msgid "%s unchanged lines"
msgstr "Неизменённых строк: %s"

msgid "(no subject)"
msgstr "(без темы)"

msgid "(no text content)"
msgstr "(нет текстового содержимого)"

msgid "(the emails are no longer in the log)"
msgstr "(письма больше нет в журнале)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "-all строже; ~all распространён и вполне подходит вместе с DMARC."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "0 — хранить записи бессрочно. Очистка выполняется раз в день."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "0 — без ограничений. Сначала удаляются самые старые записи."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "0 — отключено. Удаляет содержимое, заголовки и вложения старых записей и маскирует адреса (a***@example.com). Дата, статус, источник, формат, размер и заметки сохраняются для статистики. Выполняется при ежедневной очистке до удаления записей — поэтому действует, только если этот срок короче указанного выше срока удаления."

msgid "12 months"
msgstr "12 месяцев"

msgid "30 days"
msgstr "30 дней"

msgid "7 days"
msgstr "7 дней"

msgid "90 days"
msgstr "90 дней"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "Селектор DKIM может содержать только буквы, цифры, точки, дефисы и подчёркивания."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "Почтовый плагин, отправляющий через API, взял доставку на себя и сообщил об ошибке отправки, не указав причину."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "Опубликованный ключ не доказывает, что ваши письма им подписываются — проверьте результат DKIM в заголовках полученного письма."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "Адрес получателя или отправителя не является допустимым адресом email, поэтому PHPMailer отказался отправлять письмо."

msgid "API key or private key in plain text: %1$s"
msgstr "Ключ API или закрытый ключ открытым текстом: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "Для обработки этой записи требуется около %1$s запросов DNS — больше допустимых %2$s, поэтому получатели могут её игнорировать (PermError). Удалите неиспользуемые записи include:."

msgid "Access"
msgstr "Доступ"

msgid "Actions"
msgstr "Действия"

msgid "Active: alerts on %s."
msgstr "Включено: оповещения о следующем: %s."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "Добавьте короткий атрибут alt к каждому изображению в шаблоне, например alt=\"Logo Example Shop\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "Добавьте include: вашего почтового провайдера (например, include:_spf.google.com), если вы отправляете письма через него."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "Добавьте ваш почтовый сервер или почтовый сервис в запись SPF домена отправителя."

msgid "Added:"
msgstr "Добавлено:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "Адреса, по которым было не менее %s постоянных ошибок: принимающий сервер отклонил почтовый ящик, у домена нет почтового сервера или ваш почтовый провайдер сообщил о жёстком отказе (hard bounce). Записи удаляются по истечении срока хранения журнала."

msgid "Admin screen"
msgstr "Админ-панель"

msgid "Administrators"
msgstr "Администраторы"

msgid "Aggregate reports go to %s."
msgstr "Сводные отчёты отправляются на %s."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "Оповещение"

msgid "Alert and hold further emails"
msgstr "Оповещать и задерживать следующие письма"

msgid "Alert only"
msgstr "Только оповещать"

msgid "Alert when an email type that is sent regularly stops"
msgstr "Оповещать, если регулярно отправляемый тип писем перестал отправляться"

msgid "Alert when emails fail repeatedly"
msgstr "Оповещать, если письма неоднократно не удаётся отправить"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "Оповещать, если сайт неожиданно перестал отправлять письма"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "Оповещения включены, но не указан канал: введите адрес email или URL веб-хука."

msgid "Alerts are off."
msgstr "Оповещения отключены."

msgid "All"
msgstr "Все"

msgid "All email types look healthy."
msgstr "Все типы писем в порядке."

msgid "All emails are redirected to test addresses."
msgstr "Все письма перенаправляются на тестовые адреса."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "Все письма уходят на тестовые адреса вместо реальных получателей."

msgid "All sources"
msgstr "Все источники"

msgid "Allow again"
msgstr "Снова разрешить"

msgid "Allowed again."
msgstr "Снова разрешено."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "Также однократно оповещает, если плагин или тема, которые раньше никогда не отправляли писем, в течение дня пишут на множество разных внешних адресов — возможный признак взлома сайта. Первые две недели после установки Mailspur служат базой для сравнения."

msgid "Also remove the subject when anonymising"
msgstr "Также удалять тему письма при анонимизации"

msgid "Also search content"
msgstr "Искать также в содержимом"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "Или попросите хостинг-провайдера включить mail() / sendmail для этого сайта."

msgid "Always load remote images and fonts in the preview"
msgstr "Всегда загружать внешние изображения и шрифты в предпросмотре"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (через SNS)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "Почтовому провайдеру с HTTP API вместо SMTP требуется меньше обменов данными на каждое письмо."

msgid "Anonymisation"
msgstr "Анонимизация"

msgid "Anonymise entries after"
msgstr "Анонимизировать записи через"

msgid "Anonymised"
msgstr "Анонимизировано"

msgid "Any format"
msgstr "Любой формат"

msgid "Any status"
msgstr "Любой статус"

msgid "Apply"
msgstr "Применить"

msgid "Ask the recipient for a working address."
msgstr "Попросите у получателя рабочий адрес."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "Попросите хостинг-провайдера включить расширение openssl (или включите его в настройках PHP в панели хостинга)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "Попросите хостинг-провайдера обновить сертификаты CA и OpenSSL на сервере."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "Спросите хостинг-провайдера, не блокируются ли исходящие SMTP-соединения."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "Спросите хостинг-провайдера, разрешены ли исходящие соединения на этот порт (файрвол)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "Не менее %1$s писем с ошибкой за %2$s мин."

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "Не более одного оповещения каждого типа за этот период, даже если проблема сохраняется."

msgid "Attachments"
msgstr "Вложения"

msgid "Attachments no longer available: %s"
msgstr "Вложения больше недоступны: %s"

msgid "Authentication"
msgstr "Аутентификация"

msgid "Automatic TLS"
msgstr "Автоматический TLS"

msgid "Average per day"
msgstr "В среднем за день"

msgid "Back to the email types"
msgstr "Назад к типам писем"

msgid "Belongs to"
msgstr "Относится к"

msgid "Block again"
msgstr "Снова блокировать"

msgid "Blocked as spam or by a blocklist"
msgstr "Заблокировано как спам или по чёрному списку"

msgid "Bounced (permanent)"
msgstr "Возврат (постоянный)"

msgid "Bounced (temporary)"
msgstr "Возврат (временный)"

msgid "Broken characters (encoding): %1$s"
msgstr "Повреждённые символы (кодировка): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "Массовая рассылка без заголовка отписки (получателей: %1$s)"

msgid "Bundle into one daily email"
msgstr "Объединять в одно ежедневное письмо"

msgid "Bundled into one daily email"
msgstr "Объединяется в одно ежедневное письмо"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "Объединение отключено. Ожидавшие письма только что отправлены одной сводкой."

msgid "Busiest day"
msgstr "Самый загруженный день"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "Отмена"

msgid "Careful: emails to this address failed several times before."
msgstr "Осторожно: письма на этот адрес уже несколько раз не удавалось отправить."

msgid "Change in the email types"
msgstr "Изменение в типах писем"

msgid "Change staging mode"
msgstr "Изменить тестовый режим"

msgid "Check"
msgstr "Проверить"

msgid "Check again"
msgstr "Проверить снова"

msgid "Check emails"
msgstr "Проверка писем"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "Проверьте хост и порт; попробуйте 587 (TLS) вместо 465 (SSL) или наоборот."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "Проверьте хост, порт, шифрование, имя пользователя и пароль в вашем SMTP-плагине и отправьте оттуда тестовое письмо."

msgid "Check sender domains"
msgstr "Проверить домены отправителей"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "Убедитесь, что шифрование соответствует порту: TLS для 587, SSL для 465."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "Убедитесь, что ключ относится к нужному региону / учётной записи (например, конечная точка EU или US)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "Проверьте SMTP-хост и порт: неверный порт или заблокированное соединение часто заканчиваются тайм-аутом до срабатывания запасного варианта."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "Проверьте записи SPF, DKIM и DMARC домена отправителя или используйте адрес отправителя на домене, с которого вы отправляете письма."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "Проверьте адрес на опечатки — или ваш сайт вообще не отправлял это письмо."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "Уточните адрес у получателя и исправьте его там, где он хранится (профиль пользователя, заказ, запись формы)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "Уточните адрес у получателя и исправьте его там, где он хранится."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "Проверьте имя хоста и порт: 587 со STARTTLS (TLS) или 465 с SSL. Порт 25 блокируется большинством хостинг-провайдеров."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "Проверьте лимиты и текущее использование в учётной записи почтового сервиса; при необходимости смените тариф."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "Проверьте адреса получателей этой записи на опечатки, пробелы или недостающие части."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
msgstr "Проверьте адрес отправителя в вашем SMTP-плагине и фильтр wp_mail_from."

msgid "Check the sending limits of your mail account and the notes of this email."
msgstr "Проверьте лимиты отправки вашей почтовой учётной записи и заметки к этому письму."

msgid "Check the server IP on a blocklist checker and request delisting."
msgstr "Проверьте IP-адрес сервера в сервисе проверки чёрных списков и запросите исключение из списка."

msgid "Check the spelling of the placeholder in the template and whether the plugin supports it for this email type. Shortcodes are not processed in emails unless the sending plugin runs do_shortcode()."
msgstr "Проверьте написание заполнителя в шаблоне и поддерживает ли его плагин для этого типа писем. Шорткоды в письмах не обрабатываются, если отправляющий плагин не вызывает do_shortcode()."

msgid "Checked %s."
msgstr "Проверено %s."

msgid "Checked just now"
msgstr "Только что проверено"

msgid "Checking DNS records …"
msgstr "Проверка записей DNS…"

msgid "Checks the DNS records of the domains your site sends from: the default sender address and the most frequent senders in the log. Missing or weak records are the most common reason why emails land in spam. Only your server's own DNS resolver is used; results are kept for one hour."
msgstr "Проверяет записи DNS доменов, с которых отправляет ваш сайт: адрес отправителя по умолчанию и самых частых отправителей в журнале. Отсутствующие или слабые записи — самая частая причина попадания писем в спам. Используется только собственный DNS-резолвер вашего сервера; результаты хранятся один час."

msgid "Choose a range of at most %s days."
msgstr "Выберите период не более %s дн."

msgid "Clear selection"
msgstr "Снять выделение"

msgid "Click a bar to open these emails in the log."
msgstr "Нажмите на столбец, чтобы открыть эти письма в журнале."

msgid "Close"
msgstr "Закрыть"

msgid "Close (Esc)"
msgstr "Закрыть (Esc)"

msgid "Colour scheme"
msgstr "Цветовая схема"

msgid "Command line"
msgstr "Командная строка"

msgid "Compare"
msgstr "Сравнить"

msgid "Compare the sources of these entries. Check whether two plugins send the same notification, or whether a hook (e.g. order status change) fires more than once."
