msgid "No trace is available for this entry. It was logged before the trace existed or by a version without it."
msgstr "Tidak ada jejak untuk entri ini. Entri dicatat sebelum fitur jejak ada atau oleh versi tanpa fitur tersebut."

msgid "No unusual email failures"
msgstr "Tidak ada kegagalan email yang tidak biasa"

msgid "No, on purpose. “%1$s” to %2$s was held %3$s and not sent. Reason: %4$s."
msgstr "Tidak, dengan sengaja. “%1$s” ke %2$s ditahan %3$s dan tidak dikirim. Alasan: %4$s."

msgid "No. Every email that goes out regularly arrived on schedule."
msgstr "Tidak. Setiap email yang rutin dikirim keluar sesuai jadwal."

msgid "No. “%1$s” to %2$s failed %3$s. Reason: %4$s."
msgstr "Tidak. “%1$s” ke %2$s gagal %3$s. Alasan: %4$s."

msgid "No. “%1$s” to %2$s left your site %3$s, but %4$s reports that the receiving server rejected it."
msgstr "Tidak. “%1$s” ke %2$s keluar dari situs Anda %3$s, tetapi %4$s melaporkan bahwa server penerima menolaknya."

msgid "None"
msgstr "Tidak ada"

msgid "Normally sent at least every %1$s days, now overdue by %2$s."
msgstr "Biasanya dikirim setidaknya setiap %1$s hari, kini terlambat %2$s."

msgid "Not all selectors could be checked in time."
msgstr "Tidak semua selektor dapat diperiksa tepat waktu."

