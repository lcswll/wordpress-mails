msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: id_ID\n"
"Plural-Forms: nplurals=1; plural=0;\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "\"Unduh .eml\" menyusun ulang pesan dari data yang dicatat dan disamarkan (tanpa lampiran)."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (minggu sebelumnya: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (dijadwalkan untuk %2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s jenis email berhenti dikirim: %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "%1$s jenis email dari %2$s pengirim"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "%1$s email gagal dalam %2$s menit terakhir."

msgid "%1$s emails in %2$s days"
msgstr "%1$s email dalam %2$s hari"

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "%1$s email dalam 30 hari terakhir, %2$s gagal"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "%1$s email dikirim dalam satu jam – jauh lebih banyak dari biasanya (ambang batas: %2$s per jam). Formulir kontak mungkin disalahgunakan atau situs mungkin telah disusupi."

msgid "%1$s entries, %2$s"
msgstr "%1$s entri, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "%1$s diimpor, %2$s duplikat, %3$s terlalu lama"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "%1$s dari %2$s mengalami bounce (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "%1$s dari %2$s email dalam %3$s hari terakhir tidak dapat dikirim."

msgid "%1$s of %2$s entries processed …"
msgstr "%1$s dari %2$s entri diproses …"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s pp vs. %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "%1$s mengirim email pertamanya pada %2$s dan telah mengirim ke %3$s alamat eksternal berbeda dalam 24 jam terakhir. Jika Anda tidak memasang atau mengatur apa pun yang mengirim email seperti itu, periksa situs Anda: pengirim baru bisa menjadi tanda situs diretas."

msgid "%1$s sent, %2$s still held …"
msgstr "%1$s terkirim, %2$s masih ditahan …"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s vs. %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · %2$s email digabung sejak ringkasan terakhir"

msgid "%1$s · as of %2$s"
msgstr "%1$s · per %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – tingkat kegagalan %2$s %% (minggu sebelumnya: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – dilaporkan oleh %2$s, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (plugin must-use)"

msgid "%s (theme)"
msgstr "%s (tema)"

msgid "%s ago"
msgstr "%s yang lalu"

msgid "%s days"
msgstr "%s hari"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "%s email gagal dalam 7 hari terakhir."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s email menunggu keputusan Anda."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "%s email ditahan dan tidak dikirim dalam 7 hari terakhir."

msgid "%s emails are held by the emergency brake."
msgstr "%s email ditahan oleh rem darurat."

msgid "%s emails are waiting and have not been delivered."
msgstr "%s email sedang menunggu dan belum dikirim."

msgid "%s entries"
msgstr "%s entri"

msgid "%s failed"
msgstr "%s gagal"

msgid "%s held emails discarded."
msgstr "%s email yang ditahan telah dibuang."

msgid "%s imported entries removed."
msgstr "%s entri impor dihapus."

msgid "%s in 30 days"
msgstr "%s dalam 30 hari"

msgid "%s marked as spam"
msgstr "%s ditandai sebagai spam"

msgid "%s more on the Email types page."
msgstr "%s lainnya di halaman Jenis email."

msgid "%s notes"
msgstr "%s catatan"

msgid "%s of all emails"
msgstr "%s dari semua email"

msgid "%s of them in the last 24 hours."
msgstr "%s di antaranya dalam 24 jam terakhir."

msgid "%s s"
msgstr "%s dtk"

msgid "%s selected"
msgstr "%s dipilih"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s hal perlu perhatian:"

msgid "%s to administrators in 30 days"
msgstr "%s ke administrator dalam 30 hari"

msgid "%s unchanged lines"
msgstr "%s baris tidak berubah"

msgid "(no subject)"
msgstr "(tanpa subjek)"

msgid "(no text content)"
msgstr "(tanpa konten teks)"

msgid "(the emails are no longer in the log)"
msgstr "(email tersebut sudah tidak ada di log)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "-all lebih ketat; ~all umum dipakai dan cukup jika digabung dengan DMARC."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "0 menyimpan entri selamanya. Pembersihan berjalan sekali sehari."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "0 berarti tanpa batas. Entri terlama dihapus lebih dulu."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "0 menonaktifkannya. Menghapus konten, header, dan lampiran entri lama serta menyamarkan alamat (a***@example.com). Tanggal, status, sumber, format, ukuran, dan catatan tetap disimpan untuk statistik. Berjalan bersama pembersihan harian, sebelum entri dihapus – jadi hanya berpengaruh jika lebih pendek dari periode penghapusan di atas."

msgid "12 months"
msgstr "12 bulan"

msgid "30 days"
msgstr "30 hari"

msgid "7 days"
msgstr "7 hari"

msgid "90 days"
msgstr "90 hari"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "Selektor DKIM hanya boleh berisi huruf, angka, titik, tanda hubung, dan garis bawah."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "Plugin mailer yang mengirim melalui API mengambil alih pengiriman dan melaporkan bahwa pengiriman gagal, tanpa menyebutkan alasannya."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "Kunci yang dipublikasikan tidak membuktikan bahwa email Anda ditandatangani dengannya – periksa hasil DKIM di header email yang diterima."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "Alamat penerima atau pengirim bukan alamat email yang valid, sehingga PHPMailer menolak mengirim."

msgid "API key or private key in plain text: %1$s"
msgstr "Kunci API atau kunci privat dalam teks biasa: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "Sekitar %1$s pencarian DNS diperlukan untuk mengevaluasi record ini – lebih dari %2$s yang diizinkan, sehingga penerima mungkin mengabaikannya (PermError). Hapus entri include: yang tidak dipakai."

msgid "Access"
msgstr "Akses"

msgid "Actions"
msgstr "Tindakan"

msgid "Active: alerts on %s."
msgstr "Aktif: peringatan untuk %s."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "Tambahkan atribut alt singkat ke setiap gambar di templat, mis. alt=\"Logo Example Shop\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "Tambahkan include: dari penyedia email Anda (mis. include:_spf.google.com) jika Anda mengirim melaluinya."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "Tambahkan server email atau layanan email Anda ke record SPF domain pengirim."

msgid "Added:"
msgstr "Ditambahkan:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "Alamat dengan setidaknya %s kegagalan permanen: server penerima menolak kotak surat, domain tidak memiliki server email, atau penyedia email Anda melaporkan hard bounce. Entri kedaluwarsa sesuai masa simpan log."

msgid "Admin screen"
msgstr "Layar admin"

msgid "Administrators"
msgstr "Administrator"

msgid "Aggregate reports go to %s."
msgstr "Laporan agregat dikirim ke %s."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "Peringatan"

msgid "Alert and hold further emails"
msgstr "Peringatkan dan tahan email berikutnya"

msgid "Alert only"
msgstr "Hanya peringatkan"

msgid "Alert when an email type that is sent regularly stops"
msgstr "Peringatkan jika jenis email yang rutin dikirim berhenti"

msgid "Alert when emails fail repeatedly"
msgstr "Peringatkan jika email berulang kali gagal"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "Peringatkan jika situs tiba-tiba berhenti mengirim email"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "Peringatan diaktifkan tetapi tidak memiliki saluran: masukkan alamat email atau URL webhook."

msgid "Alerts are off."
msgstr "Peringatan nonaktif."

msgid "All"
msgstr "Semua"

msgid "All email types look healthy."
msgstr "Semua jenis email tampak sehat."

msgid "All emails are redirected to test addresses."
msgstr "Semua email dialihkan ke alamat uji."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "Semua email dikirim ke alamat uji, bukan ke penerima sebenarnya."

msgid "All sources"
msgstr "Semua sumber"

msgid "Allow again"
msgstr "Izinkan lagi"

msgid "Allowed again."
msgstr "Diizinkan lagi."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "Juga memberi peringatan sekali jika plugin atau tema yang belum pernah mengirim email tiba-tiba mengirim ke banyak alamat eksternal berbeda dalam sehari – kemungkinan tanda situs diretas. Dua minggu pertama setelah memasang Mailspur menjadi acuan dasar."

msgid "Also remove the subject when anonymising"
msgstr "Hapus juga subjek saat menganonimkan"

msgid "Also search content"
msgstr "Cari juga di konten"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "Atau minta penyedia hosting Anda mengaktifkan mail() / sendmail untuk situs ini."

msgid "Always load remote images and fonts in the preview"
msgstr "Selalu muat gambar dan font eksternal di pratinjau"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (melalui SNS)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "Penyedia email dengan HTTP API alih-alih SMTP memerlukan lebih sedikit bolak-balik komunikasi per email."

msgid "Anonymisation"
msgstr "Anonimisasi"

msgid "Anonymise entries after"
msgstr "Anonimkan entri setelah"

msgid "Anonymised"
msgstr "Dianonimkan"

msgid "Any format"
msgstr "Format apa pun"

msgid "Any status"
msgstr "Status apa pun"

msgid "Apply"
msgstr "Terapkan"

msgid "Ask the recipient for a working address."
msgstr "Minta alamat yang berfungsi kepada penerima."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "Minta penyedia hosting Anda mengaktifkan ekstensi openssl (atau aktifkan di pengaturan PHP panel hosting Anda)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "Minta penyedia hosting Anda memperbarui sertifikat CA dan OpenSSL server."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "Tanyakan kepada penyedia hosting Anda apakah koneksi SMTP keluar diblokir."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "Tanyakan kepada penyedia hosting Anda apakah koneksi keluar ke port tersebut diizinkan (firewall)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "Setidaknya %1$s email gagal dalam %2$s menit"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "Paling banyak satu peringatan per jenis dalam waktu ini, meskipun masalahnya berlanjut."

msgid "Attachments"
msgstr "Lampiran"

msgid "Attachments no longer available: %s"
msgstr "Lampiran tidak tersedia lagi: %s"

msgid "Authentication"
msgstr "Autentikasi"

msgid "Automatic TLS"
msgstr "TLS otomatis"

msgid "Average per day"
msgstr "Rata-rata per hari"

msgid "Back to the email types"
msgstr "Kembali ke jenis email"

msgid "Belongs to"
msgstr "Milik"

msgid "Block again"
msgstr "Blokir lagi"

msgid "Blocked as spam or by a blocklist"
msgstr "Diblokir sebagai spam atau oleh daftar blokir"

msgid "Bounced (permanent)"
msgstr "Bounce (permanen)"

msgid "Bounced (temporary)"
msgstr "Bounce (sementara)"

msgid "Broken characters (encoding): %1$s"
msgstr "Karakter rusak (pengodean): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "Email massal tanpa header berhenti berlangganan (%1$s penerima)"

msgid "Bundle into one daily email"
msgstr "Gabungkan menjadi satu email harian"

msgid "Bundled into one daily email"
msgstr "Digabung menjadi satu email harian"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "Penggabungan nonaktif. Email yang sedang menunggu kini dikirim dalam satu ringkasan."

msgid "Busiest day"
msgstr "Hari tersibuk"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "Batal"

msgid "Careful: emails to this address failed several times before."
msgstr "Hati-hati: email ke alamat ini sudah beberapa kali gagal sebelumnya."

msgid "Change in the email types"
msgstr "Perubahan pada jenis email"

msgid "Change staging mode"
msgstr "Ubah mode staging"

msgid "Check"
msgstr "Periksa"

msgid "Check again"
msgstr "Periksa lagi"

msgid "Check emails"
msgstr "Periksa email"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "Periksa host dan port; coba 587 (TLS) alih-alih 465 (SSL) atau sebaliknya."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "Periksa host, port, enkripsi, nama pengguna, dan kata sandi di plugin SMTP Anda, lalu kirim email uji dari sana."

msgid "Check sender domains"
msgstr "Periksa domain pengirim"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "Pastikan enkripsi sesuai dengan port: TLS untuk 587, SSL untuk 465."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "Pastikan kunci tersebut milik wilayah / akun yang benar (mis. endpoint EU vs. US)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "Periksa host dan port SMTP: port yang salah atau koneksi yang diblokir sering berakhir dengan kehabisan waktu sebelum cadangan berfungsi."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "Periksa record SPF, DKIM, dan DMARC domain pengirim, atau gunakan alamat pengirim pada domain yang Anda pakai untuk mengirim."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "Periksa apakah ada salah ketik di alamat – atau situs Anda memang tidak pernah mengirim email itu."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "Periksa alamat bersama penerima dan perbaiki di tempat alamat itu disimpan (profil pengguna, pesanan, entri formulir)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "Periksa alamat bersama penerima dan perbaiki di tempat alamat itu disimpan."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "Periksa nama host dan port: 587 dengan STARTTLS (TLS) atau 465 dengan SSL. Port 25 diblokir oleh sebagian besar penyedia hosting."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "Periksa batas dan pemakaian saat ini di akun layanan email Anda; tingkatkan paket jika perlu."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "Periksa alamat penerima entri ini dari salah ketik, spasi, atau bagian yang hilang."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
msgstr "Periksa alamat pengirim di plugin SMTP Anda dan filter wp_mail_from."

msgid "Check the sending limits of your mail account and the notes of this email."
msgstr "Periksa batas pengiriman akun email Anda dan catatan email ini."

msgid "Check the server IP on a blocklist checker and request delisting."
msgstr "Periksa IP server di pemeriksa daftar blokir dan minta penghapusan dari daftar."

msgid "Check the spelling of the placeholder in the template and whether the plugin supports it for this email type. Shortcodes are not processed in emails unless the sending plugin runs do_shortcode()."
msgstr "Periksa ejaan placeholder di templat dan apakah plugin mendukungnya untuk jenis email ini. Shortcode tidak diproses dalam email kecuali plugin pengirim menjalankan do_shortcode()."

msgid "Checked %s."
msgstr "Diperiksa %s."

msgid "Checked just now"
msgstr "Baru saja diperiksa"

msgid "Checking DNS records …"
msgstr "Memeriksa record DNS …"

msgid "Checks the DNS records of the domains your site sends from: the default sender address and the most frequent senders in the log. Missing or weak records are the most common reason why emails land in spam. Only your server's own DNS resolver is used; results are kept for one hour."
msgstr "Memeriksa record DNS dari domain yang dipakai situs Anda untuk mengirim: alamat pengirim bawaan dan pengirim yang paling sering muncul di log. Record yang tidak ada atau lemah adalah alasan paling umum email masuk ke spam. Hanya resolver DNS milik server Anda yang digunakan; hasil disimpan selama satu jam."

msgid "Choose a range of at most %s days."
msgstr "Pilih rentang paling lama %s hari."

msgid "Clear selection"
msgstr "Hapus pilihan"

msgid "Click a bar to open these emails in the log."
msgstr "Klik sebuah batang untuk membuka email ini di log."

msgid "Close"
msgstr "Tutup"

msgid "Close (Esc)"
msgstr "Tutup (Esc)"

msgid "Colour scheme"
msgstr "Skema warna"

msgid "Command line"
msgstr "Baris perintah"

msgid "Compare"
msgstr "Bandingkan"

msgid "Compare the sources of these entries. Check whether two plugins send the same notification, or whether a hook (e.g. order status change) fires more than once."
msgstr "Bandingkan sumber entri-entri ini. Periksa apakah dua plugin mengirim notifikasi yang sama, atau apakah sebuah hook (mis. perubahan status pesanan) terpicu lebih dari sekali."

msgid "Component"
msgstr "Komponen"

msgid "Configure alerts"
msgstr "Atur peringatan"

msgid "Content anonymised after %1$s days, %2$s"
msgstr "Konten dianonimkan setelah %1$s hari, %2$s"

msgid "Content change marked as seen."
msgstr "Perubahan konten ditandai sudah dilihat."

msgid "Content changed"
msgstr "Konten berubah"

msgid "Content changed on %1$s, after the %2$s update."
msgstr "Konten berubah pada %1$s, setelah pembaruan %2$s."

msgid "Content changed on %s."
msgstr "Konten berubah pada %s."

msgid "Content removed"
msgstr "Konten dihapus"

msgid "Content removed after %s days"
msgstr "Konten dihapus setelah %s hari"

msgid "Content, headers and attachments were removed and the addresses masked by the anonymisation setting."
msgstr "Konten, header, dan lampiran telah dihapus dan alamat disamarkan oleh pengaturan anonimisasi."

msgid "Copied"
msgstr "Disalin"

msgid "Copied – paste it into your reply."
msgstr "Disalin – tempelkan ke balasan Anda."

msgid "Copies a short sentence for answering the customer: when the email was sent to whom and whether it arrived – without technical details."
msgstr "Menyalin kalimat singkat untuk menjawab pelanggan: kapan email dikirim, kepada siapa, dan apakah sudah sampai – tanpa detail teknis."

msgid "Copies the existing log of another mail logging plugin into Mailspur, so old emails can be searched and previewed here. The other plugin and its data stay untouched; running the import again only adds new entries."
msgstr "Menyalin log yang ada dari plugin pencatat email lain ke Mailspur, sehingga email lama dapat dicari dan dipratinjau di sini. Plugin lain beserta datanya tidak diubah; menjalankan impor lagi hanya menambahkan entri baru."

msgid "Copy"
msgstr "Salin"

msgid "Copy for support"
msgstr "Salin untuk dukungan"

msgid "Copying is not possible in this browser. Select the text and copy it:"
msgstr "Penyalinan tidak dapat dilakukan di peramban ini. Pilih teks lalu salin:"

msgid "Correct the address (e.g. in the user profile or order) and consider an email validation in your forms."
msgstr "Perbaiki alamat (mis. di profil pengguna atau pesanan) dan pertimbangkan validasi email di formulir Anda."

msgid "Counted once per email."
msgstr "Dihitung sekali per email."

msgid "Create a new API key with send permission at your mail service and enter it in the mailer plugin."
msgstr "Buat kunci API baru dengan izin kirim di layanan email Anda dan masukkan ke plugin mailer."

msgid "Create a new webhook URL? The current URL stops working at once – paste the new URL into the webhook settings of your email provider."
msgstr "Buat URL webhook baru? URL saat ini langsung berhenti berfungsi – tempelkan URL baru ke pengaturan webhook penyedia email Anda."

msgid "Create new URL"
msgstr "Buat URL baru"

msgid "Current page"
msgstr "Halaman saat ini"

msgid "Current record"
msgstr "Record saat ini"

msgid "Current size"
msgstr "Ukuran saat ini"

msgid "Custom"
msgstr "Khusus"

msgid "DKIM key found (selector: %s)."
msgstr "Kunci DKIM ditemukan (selektor: %s)."

msgid "DMARC record found with p=none: reports only, spoofed mail is still delivered."
msgstr "Record DMARC ditemukan dengan p=none: hanya laporan, email palsu tetap dikirim."

msgid "DMARC record found with policy p=%s."
msgstr "Record DMARC ditemukan dengan kebijakan p=%s."

msgid "DMARC record has no valid policy (p=none, quarantine or reject)."
msgstr "Record DMARC tidak memiliki kebijakan yang valid (p=none, quarantine, atau reject)."

msgid "DNS lookup failed or timed out. Try again later."
msgstr "Pencarian DNS gagal atau kehabisan waktu. Coba lagi nanti."

msgid "DNS lookups are not available on this server (dns_get_record() is disabled), so the sender check cannot run here."
msgstr "Pencarian DNS tidak tersedia di server ini (dns_get_record() dinonaktifkan), sehingga pemeriksaan pengirim tidak dapat dijalankan di sini."

msgid "DNS lookups needed: about %1$s of %2$s allowed."
msgstr "Pencarian DNS yang diperlukan: sekitar %1$s dari %2$s yang diizinkan."

msgid "Daily"
msgstr "Harian"

msgid "Daily digest"
msgstr "Ringkasan harian"

msgid "Dark"
msgstr "Gelap"

msgid "Date"
msgstr "Tanggal"

msgid "Default (%s days)"
msgstr "Bawaan (%s hari)"

msgid "Default (no time limit)"
msgstr "Bawaan (tanpa batas waktu)"

msgid "Default sender"
msgstr "Pengirim bawaan"

msgid "Delete"
msgstr "Hapus"

msgid "Delete %s selected log entries?"
msgstr "Hapus %s entri log yang dipilih?"

msgid "Delete ALL log entries? This cannot be undone."
