msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: sk_SK\n"
"Plural-Forms: nplurals=3; plural=(n == 1) ? 0 : ((n >= 2 && n <= 4) ? 1 : 2);\n"
"X-Domain: mailspur-email-log\n"

msgid "\"Download .eml\" rebuilds the message from the logged, redacted data (without attachments)."
msgstr "„Stiahnuť .eml“ zostaví správu znova zo zaznamenaných, maskovaných údajov (bez príloh)."

msgid "%1$s (previous week: %2$s)"
msgstr "%1$s (predchádzajúci týždeň: %2$s)"

msgid "%1$s (scheduled for %2$s)"
msgstr "%1$s (naplánované na %2$s)"

msgid "%1$s email type has stopped: %2$s."
msgid_plural "%1$s email types have stopped, e.g. %2$s."
msgstr[0] "%1$s typ e-mailu sa prestal odosielať: %2$s."
msgstr[1] "%1$s typy e-mailov sa prestali odosielať, napr. %2$s."
msgstr[2] "%1$s typov e-mailov sa prestalo odosielať, napr. %2$s."

msgid "%1$s email types from %2$s senders"
msgstr "Typy e-mailov: %1$s, odosielatelia: %2$s"

msgid "%1$s emails failed within the last %2$s minutes."
msgstr "Za posledných %2$s minút zlyhalo %1$s e-mailov."

msgid "%1$s emails in %2$s days"
msgstr "E-maily: %1$s za %2$s dní"

msgid "%1$s emails in the last 30 days, %2$s failed"
msgstr "E-maily za posledných 30 dní: %1$s, neúspešné: %2$s"

msgid "%1$s emails were sent within one hour – far more than usual (threshold: %2$s per hour). A contact form may be abused or the site may be compromised."
msgstr "Počas jednej hodiny bolo odoslaných %1$s e-mailov – oveľa viac ako zvyčajne (limit: %2$s za hodinu). Kontaktný formulár môže byť zneužívaný alebo môže byť web napadnutý."

msgid "%1$s entries, %2$s"
msgstr "Záznamy: %1$s, %2$s"

msgid "%1$s imported, %2$s duplicates, %3$s too old"
msgstr "Importované: %1$s, duplicity: %2$s, príliš staré: %3$s"

msgid "%1$s of %2$s bounced (%3$s)"
msgstr "Vrátené %1$s z %2$s (%3$s)"

msgid "%1$s of %2$s emails in the last %3$s days could not be sent."
msgstr "Za posledných %3$s dní sa nepodarilo odoslať %1$s z %2$s e-mailov."

msgid "%1$s of %2$s entries processed …"
msgstr "Spracovaných %1$s z %2$s záznamov …"

msgid "%1$s pp vs. %2$s – %3$s"
msgstr "%1$s p. b. oproti %2$s – %3$s"

msgid "%1$s sent its first email on %2$s and has written to %3$s different external addresses within the last 24 hours. If you did not install or set up anything that sends such emails, check the site: a new sender can be a sign of a hacked site."
msgstr "%1$s odoslal prvý e-mail %2$s a za posledných 24 hodín napísal na %3$s rôznych externých adries. Ak ste neinštalovali ani nenastavovali nič, čo takéto e-maily odosiela, skontrolujte web: nový odosielateľ môže byť znakom napadnutého webu."

msgid "%1$s sent, %2$s still held …"
msgstr "Odoslané %1$s, stále zadržané %2$s …"

msgid "%1$s vs. %2$s – %3$s"
msgstr "%1$s oproti %2$s – %3$s"

msgid "%1$s · %2$s emails bundled since the last digest"
msgstr "%1$s · e-maily zhromaždené od posledného súhrnu: %2$s"

msgid "%1$s · as of %2$s"
msgstr "%1$s · stav k %2$s"

msgid "%1$s – failure rate %2$s %% (previous week: %3$s %%)"
msgstr "%1$s – miera zlyhaní %2$s %% (predchádzajúci týždeň: %3$s %%)"

msgid "%1$s – reported by %2$s, %3$s"
msgstr "%1$s – nahlásil %2$s, %3$s"

msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

msgid "%s (must-use plugin)"
msgstr "%s (plugin must-use)"

msgid "%s (theme)"
msgstr "%s (téma)"

msgid "%s ago"
msgstr "pred %s"

msgid "%s days"
msgstr "%s dní"

msgid "%s email failed in the last 7 days."
msgid_plural "%s emails failed in the last 7 days."
msgstr[0] "%s e-mail sa za posledných 7 dní nepodarilo odoslať."
msgstr[1] "%s e-maily sa za posledných 7 dní nepodarilo odoslať."
msgstr[2] "%s e-mailov sa za posledných 7 dní nepodarilo odoslať."

msgid "%s email is waiting for your decision."
msgid_plural "%s emails are waiting for your decision."
msgstr[0] "%s e-mail čaká na vaše rozhodnutie."
msgstr[1] "%s e-maily čakajú na vaše rozhodnutie."
msgstr[2] "%s e-mailov čaká na vaše rozhodnutie."

msgid "%s email was held and not sent in the last 7 days."
msgid_plural "%s emails were held and not sent in the last 7 days."
msgstr[0] "%s e-mail bol za posledných 7 dní zadržaný a neodoslaný."
msgstr[1] "%s e-maily boli za posledných 7 dní zadržané a neodoslané."
msgstr[2] "%s e-mailov bolo za posledných 7 dní zadržaných a neodoslaných."

msgid "%s emails are held by the emergency brake."
msgstr "Núdzová brzda zadržiava e-maily: %s."

msgid "%s emails are waiting and have not been delivered."
msgstr "Čakajúce a nedoručené e-maily: %s."

msgid "%s entries"
msgstr "Záznamy: %s"

msgid "%s failed"
msgstr "Neúspešné: %s"

msgid "%s held emails discarded."
msgstr "Zahodené zadržané e-maily: %s."

msgid "%s imported entries removed."
msgstr "Odstránené importované záznamy: %s."

msgid "%s in 30 days"
msgstr "%s za 30 dní"

msgid "%s marked as spam"
msgstr "Označené ako spam: %s"

msgid "%s more on the Email types page."
msgstr "Ďalších %s na stránke Typy e-mailov."

msgid "%s notes"
msgstr "Poznámky: %s"

msgid "%s of all emails"
msgstr "%s všetkých e-mailov"

msgid "%s of them in the last 24 hours."
msgstr "Z toho %s za posledných 24 hodín."

msgid "%s s"
msgstr "%s s"

msgid "%s selected"
msgstr "Vybrané: %s"

msgid "%s thing needs attention:"
msgid_plural "%s things need attention:"
msgstr[0] "%s vec vyžaduje pozornosť:"
msgstr[1] "%s veci vyžadujú pozornosť:"
msgstr[2] "%s vecí vyžaduje pozornosť:"

msgid "%s to administrators in 30 days"
msgstr "%s administrátorom za 30 dní"

msgid "%s unchanged lines"
msgstr "Nezmenené riadky: %s"

msgid "(no subject)"
msgstr "(bez predmetu)"

msgid "(no text content)"
msgstr "(bez textového obsahu)"

msgid "(the emails are no longer in the log)"
msgstr "(tieto e-maily už nie sú v protokole)"

msgid "-all is stricter; ~all is common and fine together with DMARC."
msgstr "-all je prísnejšie; ~all je bežné a v spojení s DMARC v poriadku."

msgid "0 keeps entries forever. Cleanup runs once a day."
msgstr "0 uchováva záznamy navždy. Čistenie prebieha raz denne."

msgid "0 means no limit. The oldest entries are removed first."
msgstr "0 znamená bez obmedzenia. Najstaršie záznamy sa odstraňujú ako prvé."

msgid "0 turns it off. Removes content, headers and attachments of older entries and masks the addresses (a***@example.com). Date, status, source, format, size and notes stay for statistics. Runs with the daily cleanup, before entries are deleted – so it only has an effect if it is shorter than the deletion period above."
msgstr "0 ju vypne. Odstráni obsah, hlavičky a prílohy starších záznamov a zamaskuje adresy (a***@example.com). Dátum, stav, zdroj, formát, veľkosť a poznámky zostanú pre štatistiky. Beží s denným čistením, pred vymazaním záznamov – má teda účinok len vtedy, ak je kratšia ako vyššie uvedená doba na mazanie."

msgid "12 months"
msgstr "12 mesiacov"

msgid "30 days"
msgstr "30 dní"

msgid "7 days"
msgstr "7 dní"

msgid "90 days"
msgstr "90 dní"

msgid "A DKIM selector may only contain letters, digits, dots, hyphens and underscores."
msgstr "Selektor DKIM môže obsahovať len písmená, číslice, bodky, spojovníky a podčiarkovníky."

msgid "A mailer plugin that sends via an API took over delivery and reported that sending failed, without passing on a reason."
msgstr "Plugin mailera, ktorý odosiela cez API, prevzal doručenie a nahlásil, že odoslanie zlyhalo, bez uvedenia dôvodu."

msgid "A published key does not prove that your mails are signed with it – check the DKIM result in the headers of a received mail."
msgstr "Zverejnený kľúč nedokazuje, že sú ním vaše e-maily podpísané – skontrolujte výsledok DKIM v hlavičkách prijatej správy."

msgid "A recipient or the sender address is not a valid email address, so PHPMailer refused to send."
msgstr "Príjemca alebo adresa odosielateľa nie je platná e-mailová adresa, takže PHPMailer odmietol odoslať."

msgid "API key or private key in plain text: %1$s"
msgstr "Kľúč API alebo súkromný kľúč v obyčajnom texte: %1$s"

msgid "About %1$s DNS lookups are needed to evaluate this record – more than the allowed %2$s, so receivers may ignore it (PermError). Remove unused include: entries."
msgstr "Na vyhodnotenie tohto záznamu treba asi %1$s dopytov DNS – viac ako povolených %2$s, takže ho príjemcovia môžu ignorovať (PermError). Odstráňte nepoužívané položky include:."

msgid "Access"
msgstr "Prístup"

msgid "Actions"
msgstr "Akcie"

msgid "Active: alerts on %s."
msgstr "Aktívne: upozornenia pri %s."

msgid "Add a short alt attribute to every image in the template, e.g. alt=\"Logo Example Shop\"."
msgstr "Ku každému obrázku v šablóne pridajte krátky atribút alt, napr. alt=\"Logo Ukážkový obchod\"."

msgid "Add the include: of your mail provider (e.g. include:_spf.google.com) if you send through one."
msgstr "Ak odosielate cez poskytovateľa e-mailu, pridajte jeho include: (napr. include:_spf.google.com)."

msgid "Add your mail server or mail service to the SPF record of the sender domain."
msgstr "Pridajte svoj poštový server alebo poštovú službu do záznamu SPF domény odosielateľa."

msgid "Added:"
msgstr "Pridané:"

msgid "Addresses with at least %s hard failures: the receiving server rejected the mailbox, the domain has no mail server, or your email provider reported a hard bounce. Entries expire with the retention period of the log."
msgstr "Adresy s aspoň %s trvalými zlyhaniami: prijímajúci server odmietol schránku, doména nemá poštový server alebo váš poskytovateľ e-mailu nahlásil tvrdý bounce. Položky vypršia s dobou uchovávania protokolu."

msgid "Admin screen"
msgstr "Obrazovka administrácie"

msgid "Administrators"
msgstr "Administrátori"

msgid "Aggregate reports go to %s."
msgstr "Súhrnné správy chodia na %s."

msgid "Ajax"
msgstr "Ajax"

msgid "Alert"
msgstr "Upozornenie"

msgid "Alert and hold further emails"
msgstr "Upozorniť a zadržať ďalšie e-maily"

msgid "Alert only"
msgstr "Iba upozorniť"

msgid "Alert when an email type that is sent regularly stops"
msgstr "Upozorniť, keď sa pravidelne odosielaný typ e-mailu prestane odosielať"

msgid "Alert when emails fail repeatedly"
msgstr "Upozorniť, keď e-maily opakovane zlyhávajú"

msgid "Alert when the site unexpectedly stops sending emails"
msgstr "Upozorniť, keď web nečakane prestane odosielať e-maily"

msgid "Alerts are enabled but have no channel: enter an email address or a webhook URL."
msgstr "Upozornenia sú zapnuté, ale nemajú žiadny kanál: zadajte e-mailovú adresu alebo URL webhooku."

msgid "Alerts are off."
msgstr "Upozornenia sú vypnuté."

msgid "All"
msgstr "Všetko"

msgid "All email types look healthy."
msgstr "Všetky typy e-mailov vyzerajú v poriadku."

msgid "All emails are redirected to test addresses."
msgstr "Všetky e-maily sú presmerované na testovacie adresy."

msgid "All emails go to test addresses instead of the real recipients."
msgstr "Všetky e-maily idú na testovacie adresy namiesto skutočným príjemcom."

msgid "All sources"
msgstr "Všetky zdroje"

msgid "Allow again"
msgstr "Znova povoliť"

msgid "Allowed again."
msgstr "Znova povolené."

msgid "Also alerts once when a plugin or theme that never sent an email before writes to many different external addresses within a day – a possible sign of a hacked site. The first two weeks after installing Mailspur are the baseline."
msgstr "Upozorní aj raz, keď plugin alebo téma, ktorá doteraz nikdy neodoslala e-mail, počas dňa napíše na mnoho rôznych externých adries – možný znak napadnutého webu. Prvé dva týždne po inštalácii Mailspuru slúžia ako východiskový stav."

msgid "Also remove the subject when anonymising"
msgstr "Pri anonymizácii odstrániť aj predmet"

msgid "Also search content"
msgstr "Prehľadávať aj obsah"

msgid "Alternatively ask your host to enable mail() / sendmail for this site."
msgstr "Prípadne požiadajte hostiteľa o povolenie mail() / sendmail pre tento web."

msgid "Always load remote images and fonts in the preview"
msgstr "V náhľade vždy načítavať externé obrázky a písma"

msgid "Amazon SES (via SNS)"
msgstr "Amazon SES (cez SNS)"

msgid "An email provider with an HTTP API instead of SMTP needs fewer round trips per email."
msgstr "Poskytovateľ e-mailu s HTTP API namiesto SMTP potrebuje na jeden e-mail menej výmen."

msgid "Anonymisation"
msgstr "Anonymizácia"

msgid "Anonymise entries after"
msgstr "Anonymizovať záznamy po"

msgid "Anonymised"
msgstr "Anonymizované"

msgid "Any format"
msgstr "Ľubovoľný formát"

msgid "Any status"
msgstr "Ľubovoľný stav"

msgid "Apply"
msgstr "Použiť"

msgid "Ask the recipient for a working address."
msgstr "Požiadajte príjemcu o funkčnú adresu."

msgid "Ask your host to enable the openssl extension (or enable it in the PHP settings of your hosting panel)."
msgstr "Požiadajte hostiteľa o povolenie rozšírenia openssl (alebo ho povoľte v nastaveniach PHP v paneli hostingu)."

msgid "Ask your host to update the CA certificates and OpenSSL of the server."
msgstr "Požiadajte hostiteľa o aktualizáciu certifikátov CA a OpenSSL na serveri."

msgid "Ask your host whether outgoing SMTP connections are blocked."
msgstr "Opýtajte sa hostiteľa, či nie sú blokované odchádzajúce pripojenia SMTP."

msgid "Ask your host whether outgoing connections to that port are allowed (firewall)."
msgstr "Opýtajte sa hostiteľa, či sú odchádzajúce pripojenia na tento port povolené (firewall)."

msgid "At least %1$s failed emails within %2$s minutes"
msgstr "Aspoň %1$s neúspešných e-mailov počas %2$s minút"

msgid "At most one alert per type within this time, even if the problem persists."
msgstr "Najviac jedno upozornenie daného druhu v tomto čase, aj keď problém trvá."

msgid "Attachments"
msgstr "Prílohy"

msgid "Attachments no longer available: %s"
msgstr "Prílohy už nie sú k dispozícii: %s"

msgid "Authentication"
msgstr "Overovanie"

msgid "Automatic TLS"
msgstr "Automatické TLS"

msgid "Average per day"
msgstr "Priemer za deň"

msgid "Back to the email types"
msgstr "Späť na typy e-mailov"

msgid "Belongs to"
msgstr "Patrí k"

msgid "Block again"
msgstr "Znova blokovať"

msgid "Blocked as spam or by a blocklist"
msgstr "Zablokované ako spam alebo blocklistom"

msgid "Bounced (permanent)"
msgstr "Nedoručiteľné (trvalo)"

msgid "Bounced (temporary)"
msgstr "Nedoručiteľné (dočasne)"

msgid "Broken characters (encoding): %1$s"
msgstr "Poškodené znaky (kódovanie): %1$s"

msgid "Bulk email without unsubscribe header (%1$s recipients)"
msgstr "Hromadný e-mail bez hlavičky na odhlásenie (príjemcov: %1$s)"

msgid "Bundle into one daily email"
msgstr "Zhromažďovať do jedného denného e-mailu"

msgid "Bundled into one daily email"
msgstr "Zhromažďované do jedného denného e-mailu"

msgid "Bundling is off. Emails that were waiting went out in one digest now."
msgstr "Zhromažďovanie je vypnuté. Čakajúce e-maily práve odišli v jednom súhrne."

msgid "Busiest day"
msgstr "Najrušnejší deň"

msgid "CSV"
msgstr "CSV"

msgid "Cancel"
msgstr "Zrušiť"

msgid "Careful: emails to this address failed several times before."
msgstr "Pozor: e-maily na túto adresu už niekoľkokrát zlyhali."

msgid "Change in the email types"
msgstr "Zmeniť v typoch e-mailov"

msgid "Change staging mode"
msgstr "Zmeniť testovací režim"

msgid "Check"
msgstr "Skontrolovať"

msgid "Check again"
msgstr "Skontrolovať znova"

msgid "Check emails"
msgstr "Skontrolovať e-maily"

msgid "Check host and port; try 587 (TLS) instead of 465 (SSL) or the other way round."
msgstr "Skontrolujte hostiteľa a port; skúste 587 (TLS) namiesto 465 (SSL) alebo naopak."

msgid "Check host, port, encryption, user name and password in your SMTP plugin and send a test email from there."
msgstr "Skontrolujte hostiteľa, port, šifrovanie, používateľské meno a heslo vo svojom plugine SMTP a odošlite z neho testovací e-mail."

msgid "Check sender domains"
msgstr "Skontrolovať domény odosielateľa"

msgid "Check that the encryption matches the port: TLS for 587, SSL for 465."
msgstr "Skontrolujte, či šifrovanie zodpovedá portu: TLS pre 587, SSL pre 465."

msgid "Check that the key belongs to the right region / account (e.g. EU vs. US endpoint)."
msgstr "Skontrolujte, či kľúč patrí k správnemu regiónu / účtu (napr. koncový bod EU vs. US)."

msgid "Check the SMTP host and port: a wrong port or a blocked connection often ends in a timeout before a fallback works."
msgstr "Skontrolujte hostiteľa a port SMTP: chybný port alebo blokované pripojenie často skončí vypršaním časového limitu skôr, než zafunguje záložné riešenie."

msgid "Check the SPF, DKIM and DMARC records of the sender domain, or use a sender address on the domain you send from."
msgstr "Skontrolujte záznamy SPF, DKIM a DMARC domény odosielateľa alebo použite adresu odosielateľa v doméne, z ktorej odosielate."

msgid "Check the address for typos – or the email was never sent by your site."
msgstr "Skontrolujte, či adresa neobsahuje preklep – alebo váš web e-mail nikdy neodoslal."

msgid "Check the address with the recipient and correct it where it is stored (user profile, order, form entry)."
msgstr "Overte adresu u príjemcu a opravte ju tam, kde je uložená (používateľský profil, objednávka, záznam formulára)."

msgid "Check the address with the recipient and correct it where it is stored."
msgstr "Overte adresu u príjemcu a opravte ju tam, kde je uložená."

msgid "Check the host name and port: 587 with STARTTLS (TLS) or 465 with SSL. Port 25 is blocked by most hosts."
msgstr "Skontrolujte názov hostiteľa a port: 587 so STARTTLS (TLS) alebo 465 so SSL. Port 25 väčšina hostiteľov blokuje."

msgid "Check the limits and current usage in your mail service account; upgrade the plan if needed."
msgstr "Skontrolujte limity a aktuálne využitie v účte poštovej služby; v prípade potreby prejdite na vyšší program."

msgid "Check the recipient addresses of this entry for typos, spaces or missing parts."
msgstr "Skontrolujte adresy príjemcov tohto záznamu, či neobsahujú preklepy, medzery alebo chýbajúce časti."

msgid "Check the sender address in your SMTP plugin and the wp_mail_from filter."
msgstr "Skontrolujte adresu odosielateľa vo svojom plugine SMTP a filter wp_mail_from."

msgid "Check the sending limits of your mail account and the notes of this email."
msgstr "Skontrolujte limity odosielania svojho poštového účtu a poznámky k tomuto e-mailu."

msgid "Check the server IP on a blocklist checker and request delisting."
msgstr "Skontrolujte IP adresu servera v nástroji na kontrolu blocklistov a požiadajte o vyradenie."

msgid "Check the spelling of the placeholder in the template and whether the plugin supports it for this email type. Shortcodes are not processed in emails unless the sending plugin runs do_shortcode()."
msgstr "Skontrolujte pravopis zástupného symbolu v šablóne a či ho plugin pre tento typ e-mailu podporuje. Shortcody sa v e-mailoch nespracúvajú, ak odosielajúci plugin nespúšťa do_shortcode()."

msgid "Checked %s."
msgstr "Skontrolované %s."

msgid "Checked just now"
msgstr "Skontrolované práve teraz"

msgid "Checking DNS records …"
msgstr "Kontrola záznamov DNS …"

msgid "Checks the DNS records of the domains your site sends from: the default sender address and the most frequent senders in the log. Missing or weak records are the most common reason why emails land in spam. Only your server's own DNS resolver is used; results are kept for one hour."
msgstr "Kontroluje záznamy DNS domén, z ktorých váš web odosiela: predvolenú adresu odosielateľa a najčastejších odosielateľov v protokole. Chýbajúce alebo slabé záznamy sú najčastejším dôvodom, prečo e-maily končia v spame. Používa sa len DNS resolver vášho servera; výsledky sa uchovávajú jednu hodinu."

msgid "Choose a range of at most %s days."
msgstr "Zvoľte rozsah najviac %s dní."

msgid "Clear selection"
msgstr "Zrušiť výber"

msgid "Click a bar to open these emails in the log."
msgstr "Kliknutím na stĺpec otvoríte tieto e-maily v protokole."

msgid "Close"
msgstr "Zavrieť"

msgid "Close (Esc)"
msgstr "Zavrieť (Esc)"

msgid "Colour scheme"
msgstr "Farebná schéma"

msgid "Command line"
msgstr "Príkazový riadok"

msgid "Compare"
msgstr "Porovnať"

msgid "Compare the sources of these entries. Check whether two plugins send the same notification, or whether a hook (e.g. order status change) fires more than once."
msgstr "Porovnajte zdroje týchto záznamov. Skontrolujte, či dva pluginy neposielajú rovnaké oznámenie alebo či sa hook (napr. zmena stavu objednávky) nespúšťa viackrát."

msgid "Component"
msgstr "Komponent"

msgid "Configure alerts"
msgstr "Nastaviť upozornenia"

msgid "Content anonymised after %1$s days, %2$s"
msgstr "Obsah anonymizovaný po %1$s dňoch, %2$s"

msgid "Content change marked as seen."
msgstr "Zmena obsahu označená ako zobrazená."

msgid "Content changed"
msgstr "Obsah zmenený"

msgid "Content changed on %1$s, after the %2$s update."
msgstr "Obsah zmenený %1$s, po aktualizácii %2$s."

msgid "Content changed on %s."
msgstr "Obsah zmenený %s."

msgid "Content removed"
msgstr "Obsah odstránený"

msgid "Content removed after %s days"
msgstr "Obsah odstránený po %s dňoch"

msgid "Content, headers and attachments were removed and the addresses masked by the anonymisation setting."
msgstr "Obsah, hlavičky a prílohy boli odstránené a adresy zamaskované nastavením anonymizácie."

msgid "Copied"
msgstr "Skopírované"

msgid "Copied – paste it into your reply."
msgstr "Skopírované – vložte to do svojej odpovede."

msgid "Copies a short sentence for answering the customer: when the email was sent to whom and whether it arrived – without technical details."
msgstr "Skopíruje krátku vetu na odpoveď zákazníkovi: kedy a komu bol e-mail odoslaný a či dorazil – bez technických podrobností."

msgid "Copies the existing log of another mail logging plugin into Mailspur, so old emails can be searched and previewed here. The other plugin and its data stay untouched; running the import again only adds new entries."
